{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "sorafiles-license-service",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {"enabled": false},
  "durable_objects": {
    "bindings": [{"name": "LICENSE_LEDGER", "class_name": "LicenseLedgerObject"}]
  },
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["LicenseLedgerObject"]}],
  "vars": {"DODO_MODE": "test_mode", "REDEMPTION_ENABLED": "false"}
}
