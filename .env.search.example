# Copy to .env.search.local. Never commit real credentials.
# Optional service-account JSON path. The service-account email must also have
# access to the SoraFiles Search Console property.
GOOGLE_APPLICATION_CREDENTIALS=
# Optional override. When omitted, the CLI lists accessible properties and
# selects sc-domain:sorafiles.com or https://sorafiles.com/ only if accessible.
GOOGLE_SEARCH_CONSOLE_PROPERTY=
# OAuth is also supported when all three values are supplied together.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
BING_WEBMASTER_API_KEY=
