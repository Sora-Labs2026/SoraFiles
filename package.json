{
  "name": "sorafiles.com",
  "type": "module",
  "version": "0.0.1",
  "description": "Free, privacy-first PDF and image tools that process files locally in the browser.",
  "license": "AGPL-3.0-only",
  "author": "Sora Labs",
  "homepage": "https://sorafiles.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sora-Labs2026/SoraFiles.git"
  },
  "bugs": {
    "url": "https://github.com/Sora-Labs2026/SoraFiles/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run generate:popularity && astro build",
    "build:production": "node scripts/build-production.mjs",
    "preview": "astro preview",
    "preview:cloudflare": "npm run build && wrangler dev",
    "deploy": "npm run build:production && wrangler deploy && npm run submit:search",
    "indexnow": "node scripts/ping-search-engines.js --live --indexnow-only",
    "indexnow:bing": "node scripts/ping-search-engines.js --live --indexnow-only --indexnow-endpoint https://www.bing.com/indexnow",
    "assets:brand": "node scripts/generate-brand-icons.mjs",
    "verify:brand": "node scripts/verify-search-branding.mjs",
    "verify:monetization": "node scripts/verify-monetization.mjs",
    "sync:ocr": "node scripts/sync-ocr-assets.mjs",
    "verify:ocr": "node scripts/verify-ocr-assets.mjs",
    "verify:optimizer": "node scripts/optimizer/validate.mjs",
    "generate:popularity": "node scripts/generate-popularity-registry.mjs",
    "popularity:status": "npx wrangler d1 execute sorafiles-popularity --remote --command=\"SELECT key, updated_at, value FROM popularity_state WHERE key = 'current'\"",
    "optimizer:audit": "node scripts/optimizer/run.mjs audit",
    "optimizer:apply": "node scripts/optimizer/run.mjs apply",
    "optimizer:visual:baseline": "node scripts/optimizer/visual-resilience.mjs --capture-baseline",
    "optimizer:visual:compare": "node scripts/optimizer/visual-resilience.mjs --compare",
    "fixtures:ocr": "node tests/fixtures/generate-ocr-fixtures.mjs",
    "validate:i18n": "node scripts/validate-i18n.mjs",
    "validate:truth": "node scripts/validate-content-truth.mjs",
    "submit:search": "node --env-file-if-exists=.env.search.local scripts/ping-search-engines.js --live",
    "submit:search:dry": "node scripts/ping-search-engines.js --dry-run",
    "search-console": "node --env-file-if-exists=.env.search.local scripts/ping-search-engines.js --live",
    "audit:seo": "node scripts/audit-indexability.mjs",
    "audit:seo:live": "node scripts/audit-indexability.mjs --live",
    "audit:performance": "node scripts/audit-performance.mjs",
    "test:tools": "node tests/e2e/tool-flows.mjs",
    "test:tools:smoke": "node tests/e2e/tool-flows.mjs --smoke",
    "test:pdf-preview": "node tests/e2e/pdf-preview-layout.mjs",
    "test:chapter3-tools": "node tests/e2e/chapter3-tools.mjs",
    "test:ocr": "node tests/e2e/ocr-flows.mjs",
    "test:ocr:languages": "node tests/e2e/ocr-flows.mjs --all-languages",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "test:site": "npm run build && node tests/e2e/site-shell.mjs",
    "test:ads": "node tests/e2e/monetization-layout.mjs",
    "test:resilience": "node scripts/optimizer/visual-resilience.mjs --stress",
    "astro": "astro"
  },
  "dependencies": {
    "@jsquash/resize": "^2.1.1",
    "@pdfsmaller/pdf-decrypt": "^1.0.1",
    "@pdfsmaller/pdf-encrypt": "^1.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "ag-psd": "^31.0.2",
    "astro": "^7.2.0",
    "docx": "^9.7.1",
    "fflate": "^0.8.3",
    "heic-to": "^1.5.2",
    "jspdf": "^4.2.1",
    "mammoth": "^1.12.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "scanic": "^1.6.0",
    "tailwindcss": "^4.3.3",
    "tesseract.js": "^7.0.0",
    "tesseract.js-core": "^7.0.0",
    "utif": "^3.1.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "fast-png": "^6.4.0",
    "playwright": "^1.62.1",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "wrangler": "^4.120.0"
  },
  "allowScripts": {
    "core-js@3.50.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260801.1": true
  }
}
