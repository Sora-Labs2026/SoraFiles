---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import LocalizedHome from '../../components/LocalizedHome.astro';
import LocalizedToolPage from '../../components/LocalizedToolPage.astro';
import LiveInfoPage from '../../components/LiveInfoPage.astro';
import LiveToolsHub from '../../components/LiveToolsHub.astro';
import { liveTools, liveToolBySlug } from '../../data/liveTools';
import liveCopy from '../../data/liveCopy';
import { liveRaw, liveText, liveToolCopy } from '../../data/liveI18n';
import { localeContent, getLocaleContent } from '../../i18n';
import { localeByPath, localizedPath, localizedRoutePaths, type LocalePath, type LocalizedRoutePath } from '../../i18n/config';

type InfoSlug = 'about' | 'contact' | 'privacy' | 'terms' | 'open-source';
const infoSlugs = new Set<InfoSlug>(['about', 'contact', 'privacy', 'terms', 'open-source']);

export function getStaticPaths() {
  return Object.keys(localeContent).filter((locale) => locale !== 'en').flatMap((locale) => localizedRoutePaths.map((route) => ({
    params: { locale, path: route === '/' ? undefined : route.slice(1) },
    props: { locale, basePath: route },
  })));
}

interface Props { locale: LocalePath; basePath: LocalizedRoutePath; }
const { locale, basePath } = Astro.props as Props;
const content = getLocaleContent(locale);
const localeMeta = localeByPath.get(locale)!;
const routeSlug = basePath.slice(1);
const tool = liveToolBySlug.get(routeSlug);
const infoSlug = infoSlugs.has(routeSlug as InfoSlug) ? routeSlug as InfoSlug : undefined;
const infoPage = infoSlug ? liveRaw<typeof liveCopy.page[InfoSlug]>(locale, `page.${infoSlug}`) : undefined;
const reviewedInfoPage = infoSlug === 'about'
  ? content.pages.about
  : infoSlug === 'contact'
    ? content.pages.contact
    : infoSlug === 'privacy'
      ? content.pages.privacy
      : infoSlug === 'terms'
        ? content.pages.terms
        : infoSlug === 'open-source'
          ? content.pages.openSource
          : undefined;
const toolWords = tool ? liveToolCopy(locale, tool.id) : undefined;
const isHome = basePath === '/';
const isToolsHub = basePath === '/tools';
const canonicalPath = localizedPath(locale, basePath);
const title = isHome ? content.home.title : toolWords ? `${toolWords.n} | SoraFiles` : isToolsHub ? `${liveText(locale, 'nav.allTools')} | SoraFiles` : infoPage ? `${infoPage.title} | SoraFiles` : 'SoraFiles';
const description = isHome ? content.home.description : toolWords ? `${toolWords.t} ${toolWords.d}` : isToolsHub ? `${liveText(locale, 'nav.allTools')}. ${liveText(locale, 'hero.desc')}` : reviewedInfoPage?.intro || infoPage?.intro.replace('{{n}}', String(liveTools.length)) || liveText(locale, 'hero.desc');
const schema = isHome ? {
  '@context': 'https://schema.org', '@graph': [
    { '@type': 'CollectionPage', name: title, url: new URL(canonicalPath, 'https://sorafiles.com').toString(), inLanguage: localeMeta.code, description },
    { '@type': 'ItemList', itemListElement: liveTools.map((item, index) => ({ '@type': 'ListItem', position: index + 1, name: liveToolCopy(locale, item.id).n, url: new URL(localizedPath(locale, `/${item.slug}`), 'https://sorafiles.com').toString() })) },
  ],
} : tool ? {
  '@context': 'https://schema.org', '@graph': [
    { '@type': 'WebPage', name: `${toolWords?.n} — SoraFiles`, url: new URL(canonicalPath, 'https://sorafiles.com').toString(), inLanguage: localeMeta.code, description, isPartOf: { '@id': 'https://sorafiles.com/#website' } },
    { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: liveText(locale, 'nav.home'), item: new URL(localizedPath(locale, '/'), 'https://sorafiles.com').toString() }, { '@type': 'ListItem', position: 2, name: toolWords?.n, item: new URL(canonicalPath, 'https://sorafiles.com').toString() }] },
  ],
} : { '@context': 'https://schema.org', '@type': infoSlug === 'contact' ? 'ContactPage' : infoSlug === 'about' ? 'AboutPage' : 'WebPage', name: infoPage?.title ?? title, url: new URL(canonicalPath, 'https://sorafiles.com').toString(), inLanguage: localeMeta.code, description };
---
<Layout {title} {description} {canonicalPath} alternatePath={basePath} {schema} {locale}>
  <Header {locale} />
  {isHome && <LocalizedHome {locale} {content} />}
  {tool && <LocalizedToolPage {locale} {content} {tool} />}
  {isToolsHub && <LiveToolsHub {locale} />}
  {infoSlug && <LiveInfoPage slug={infoSlug} {locale} />}
  <Footer {locale} />
</Layout>
