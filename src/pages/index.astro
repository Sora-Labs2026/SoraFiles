---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LocalizedHome from '../components/LocalizedHome.astro';
import { liveTools } from '../data/liveTools';
import liveCopy from '../data/liveCopy';
import { getLocaleContent } from '../i18n';

const locale = 'en' as const;
const content = getLocaleContent(locale);
const description = liveCopy.hero.desc;
const keywords = 'compress PDF no upload, private PDF compressor, merge PDF local, split PDF without uploading, image converter, compress image online free, HEIC to JPG, PDF to image, image to PDF';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://sorafiles.com/#organization',
      name: 'Sora Labs',
      url: 'https://sorafiles.com/',
      logo: {
        '@type': 'ImageObject',
        url: 'https://sorafiles.com/favicon.png',
        width: 512,
        height: 512,
      },
    },
    {
      '@type': 'WebSite',
      '@id': 'https://sorafiles.com/#website',
      name: 'SoraFiles',
      alternateName: ['sorafiles.com'],
      url: 'https://sorafiles.com/',
      description,
      publisher: { '@id': 'https://sorafiles.com/#organization' },
    },
    {
      '@type': 'ItemList',
      '@id': 'https://sorafiles.com/#tools',
      name: 'Featured Tools',
      numberOfItems: liveTools.length,
      itemListElement: liveTools.map((tool, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: tool.name,
        url: new URL(`/${tool.slug}`, 'https://sorafiles.com').href,
      })),
    },
  ],
};
---

<Layout title="SoraFiles — Free File Tools. Zero Uploads." {description} {keywords} canonicalPath="/" alternatePath="/" {schema} {locale} monetized>
  <Header {locale} />
  <LocalizedHome {locale} {content} />
  <Footer {locale} />
</Layout>
