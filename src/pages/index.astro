---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LocalizedHome from '../components/LocalizedHome.astro';
import { liveTools } from '../data/liveTools';
import { getLocaleContent } from '../i18n';
import { getBrandPositioning } from '../i18n/brandPositioning';
import { CONTENT_PROVENANCE } from '../data/contentProvenance';

const locale = 'en' as const;
const content = getLocaleContent(locale);
const brand = getBrandPositioning(locale);
const description = brand.description;
const keywords = 'free file tools, private PDF tools, compress PDF without uploading, merge PDF locally, split PDF pages, image converter, compress image, HEIC to JPG, PDF to JPG, JPG to PDF';
const applicationId = 'https://sorafiles.com/#application';
const faqId = 'https://sorafiles.com/#faq';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://sorafiles.com/#organization',
      name: 'Sora Labs',
      url: 'https://sorafiles.com/',
      logo: {
        '@type': 'ImageObject',
        url: 'https://sorafiles.com/favicon.png',
        width: 512,
        height: 512,
      },
    },
    {
      '@type': 'WebSite',
      '@id': 'https://sorafiles.com/#website',
      name: 'SoraFiles',
      url: 'https://sorafiles.com/',
      description,
      publisher: { '@id': 'https://sorafiles.com/#organization' },
    },
    {
      '@type': 'WebPage',
      '@id': 'https://sorafiles.com/#webpage',
      url: 'https://sorafiles.com/',
      name: 'SoraFiles',
      description,
      inLanguage: 'en',
      datePublished: CONTENT_PROVENANCE.publishedIso,
      dateModified: CONTENT_PROVENANCE.modifiedIso,
      isPartOf: { '@id': 'https://sorafiles.com/#website' },
      about: { '@id': applicationId },
      mainEntity: [{ '@id': applicationId }, { '@id': faqId }],
      author: { '@id': CONTENT_PROVENANCE.publisherId },
      publisher: { '@id': CONTENT_PROVENANCE.publisherId },
    },
    {
      '@type': 'WebApplication',
      '@id': applicationId,
      name: 'SoraFiles',
      url: 'https://sorafiles.com/',
      description,
      applicationCategory: 'UtilitiesApplication',
      applicationSuite: 'SoraFiles',
      operatingSystem: 'Any operating system with a supported modern browser',
      browserRequirements: 'JavaScript, WebAssembly, File API, Web Workers, and Canvas support',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      featureList: ['Local browser file processing', 'PDF tools', 'Image tools', 'No account required', 'No SoraFiles watermark'],
      datePublished: CONTENT_PROVENANCE.publishedIso,
      dateModified: CONTENT_PROVENANCE.modifiedIso,
      author: { '@id': CONTENT_PROVENANCE.publisherId },
      publisher: { '@id': CONTENT_PROVENANCE.publisherId },
      sameAs: ['https://github.com/Sora-Labs2026/SoraFiles'],
      license: 'https://github.com/Sora-Labs2026/SoraFiles/blob/main/LICENSE',
    },
    {
      '@type': 'FAQPage',
      '@id': faqId,
      url: 'https://sorafiles.com/#faq',
      name: content.home.faqTitle,
      inLanguage: 'en',
      dateModified: CONTENT_PROVENANCE.modifiedIso,
      author: { '@id': CONTENT_PROVENANCE.publisherId },
      publisher: { '@id': CONTENT_PROVENANCE.publisherId },
      mainEntity: content.home.faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    },
    {
      '@type': 'ItemList',
      '@id': 'https://sorafiles.com/#tools',
      name: 'SoraFiles File Workflows',
      numberOfItems: liveTools.length,
      itemListElement: liveTools.map((tool, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: tool.name,
        url: new URL(`/${tool.slug}`, 'https://sorafiles.com').href,
      })),
    },
  ],
};
---

<Layout title={brand.homeTitle} {description} {keywords} canonicalPath="/" alternatePath="/" {schema} {locale}>
  <Header {locale} />
  <LocalizedHome {locale} {content} />
  <Footer {locale} />
</Layout>
