---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<Layout title="Open-source software — Sora Files" description="Open-source libraries used by Sora Files." canonicalPath="/open-source">
  <Header />
  <main id="main" class="px-5 py-20 sm:px-6 sm:py-28">
    <article class="mx-auto max-w-3xl">
      <p class="eyebrow text-xs font-semibold text-blue">Open source</p>
      <h1 class="mt-4 text-balance text-[clamp(2.25rem,5.5vw,3.5rem)] font-semibold leading-[1.05] tracking-[-0.05em]">The engines behind local processing.</h1>
      <p class="mt-6 text-lg leading-8 text-muted">Sora Files builds on established open-source projects. They run as application code in your browser and do not receive your files over a network.</p>
      <div class="mt-12 divide-y divide-line border-y border-line">
        <section class="py-7"><h2 class="text-xl font-semibold">PDF.js</h2><p class="mt-2 text-sm leading-7 text-muted">Mozilla’s Apache-2.0 PDF parser and renderer.</p><a class="mt-3 inline-block text-sm font-medium text-blue underline underline-offset-4" href="https://github.com/mozilla/pdf.js">View source and license</a></section>
        <section class="py-7"><h2 class="text-xl font-semibold">pdf-lib</h2><p class="mt-2 text-sm leading-7 text-muted">The MIT-licensed library used to assemble new PDF documents.</p><a class="mt-3 inline-block text-sm font-medium text-blue underline underline-offset-4" href="https://github.com/Hopding/pdf-lib">View source and license</a></section>
        <section class="py-7"><h2 class="text-xl font-semibold">heic-to and libheif</h2><p class="mt-2 text-sm leading-7 text-muted">LGPL-3.0 browser decoding built on the libheif codec engine.</p><div class="mt-3 flex flex-wrap gap-5"><a class="text-sm font-medium text-blue underline underline-offset-4" href="https://github.com/hoppergee/heic-to">heic-to source</a><a class="text-sm font-medium text-blue underline underline-offset-4" href="https://github.com/strukturag/libheif">libheif source</a></div></section>
        <section class="py-7"><h2 class="text-xl font-semibold">Document and ZIP engines</h2><p class="mt-2 text-sm leading-7 text-muted">Mammoth.js, docx, jsPDF, and fflate power local Word, PDF, and ZIP workflows under BSD or MIT licenses.</p><div class="mt-3 flex flex-wrap gap-5"><a class="text-sm font-medium text-blue underline underline-offset-4" href="https://github.com/mwilliamson/mammoth.js">Mammoth.js source</a><a class="text-sm font-medium text-blue underline underline-offset-4" href="https://github.com/dolanmiu/docx">docx source</a><a class="text-sm font-medium text-blue underline underline-offset-4" href="https://github.com/parallax/jsPDF">jsPDF source</a><a class="text-sm font-medium text-blue underline underline-offset-4" href="https://github.com/101arrowz/fflate">fflate source</a></div></section>
      </div>
    </article>
  </main>
  <Footer />
</Layout>
