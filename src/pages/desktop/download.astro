---
import DesktopLayout from '../../layouts/DesktopLayout.astro';
import releaseManifest from '../../../desktop/releases/manifest.json';
const published = releaseManifest.releases.filter(release => ['active','maintenance'].includes(release.status) && release.security === 'clear');
const platforms = [{id:'windows',name:'Windows'},{id:'macos',name:'macOS'},{id:'linux',name:'Linux'}];
const formatBytes = (bytes:number) => `${(bytes / 1024 ** 2).toFixed(1)} MB`;
const requirements = [
 ['Memory','No special requirement beyond what your operating system normally needs'],
 ['Processor','A modern 64-bit processor'],
 ['Storage','Enough free space for SoraFiles and the files you work with'],
 ['Internet','Needed for setup, activation and online services. File processing works offline'],
];
const platformMinimum = (platform:string,rows:typeof published) => {
  const minimums=[...new Set(rows.map(row=>row.minOS))];
  if(!minimums.length)return '';
  if(platform==='windows')return `Windows ${minimums.map(value=>value==='10.0'?'10':value).join(' / ')} or later · x64 · Microsoft Edge WebView2 Runtime`;
  if(platform==='macos')return `macOS ${minimums.join(' / ')} or later · Apple Silicon and Intel`;
  return `Ubuntu ${minimums.join(' / ')} or later · x64`;
};
---
<DesktopLayout title="SoraFiles Desktop downloads" description="Download SoraFiles Desktop for Windows, macOS and Linux." path="/desktop/download">
  <div class="dw-container">
    <header class="dw-intro"><p class="dw-eyebrow">SoraFiles Desktop</p><h1>Download for your computer</h1><p>Choose your operating system. Installers, package sizes and checksums are listed below.</p></header>
    <div class="download-platforms">{platforms.map(platform=>{const rows=published.filter(release=>release.platform===platform.id);return <section id={platform.id} class="download-platform" aria-labelledby={`${platform.id}-title`}><div class="download-platform-intro"><h2 id={`${platform.id}-title`}>{platform.name}</h2><p>{platformMinimum(platform.id,rows)}</p></div>{rows.length?<table class="download-table"><caption class="sr-only">{platform.name} installers</caption><thead><tr><th scope="col">Version</th><th scope="col">Package</th><th scope="col">Size</th><th scope="col">SHA-256</th><th scope="col" class="download-cell">Download</th></tr></thead><tbody>{rows.map(release=><tr><th scope="row" data-label="Version">{release.version}</th><td data-label="Package">{release.package} · {release.arch}</td><td data-label="Size">{formatBytes(release.bytes)}</td><td data-label="SHA-256"><details class="checksum"><summary aria-label={`Show SHA-256 for ${platform.name} ${release.arch} ${release.package}`}>{release.sha256.slice(0,12)}…</summary><code>{release.sha256}</code></details></td><td class="download-cell" data-label="Download"><a href={release.url} rel="noreferrer" class="dw-button" aria-label={`Download ${platform.name} ${release.arch} ${release.package} ${release.version}`}>↓ &nbsp; Download</a></td></tr>)}</tbody></table>:<p class="download-empty">No compatible installer is published yet.</p>}{platform.id==='windows'&&rows.some(row=>row.signing==='unsigned')&&<p class="download-note">The current installer is unsigned. <a class="dw-link" href="/desktop/help#windows-unsigned">Windows first-launch help</a>.</p>}{platform.id==='macos'&&rows.some(row=>!row.notarized)&&<p class="download-note">Current Mac builds are ad-hoc signed and not notarized. <a class="dw-link" href="/desktop/help#macos-open-anyway">Open Anyway instructions</a>.</p>}{platform.id==='linux'&&<p class="download-note">For AppImage, allow the file to run as a program before opening it. Other Linux distributions are not yet validated.</p>}</section>;})}</div>
    <section id="requirements" class="dw-ruled requirements" aria-labelledby="requirements-heading"><h2 id="requirements-heading">System requirements</h2><p>SoraFiles Desktop is designed to be lightweight and processes files locally. It works offline after setup.</p><table class="dw-table"><caption class="sr-only">System requirements</caption><tbody>{requirements.map(([name,description])=><tr><th scope="row">{name}</th><td>{description}</td></tr>)}</tbody></table><p class="requirements-note">Larger PDFs, images, or batch jobs may naturally use more memory and storage while processing. Setup, activation and subscription renewals need an internet connection. A Lifetime license continues to work offline after activation.</p><a href="/desktop/help" class="dw-link">Installation and activation help →</a></section>
  </div>
</DesktopLayout>
<style>
  .download-platforms{display:grid;gap:24px}.download-platform{padding:28px 32px;border:1px solid var(--line);border-radius:16px;background:var(--surface);scroll-margin-top:96px}.download-platform-intro h2{font-size:22px}.download-platform-intro p{font-size:14px;margin-top:8px}.download-table{width:100%;table-layout:fixed;border-collapse:collapse;text-align:left;font-size:13px;margin-top:24px}.download-table th,.download-table td{padding:16px 12px 16px 0;border-bottom:1px solid var(--line);vertical-align:top;font-variant-numeric:tabular-nums;color:var(--ink-secondary)}.download-table thead th{font-size:11px;text-transform:uppercase;letter-spacing:.1em}.download-table th:first-child{width:13%}.download-table th:nth-child(2){width:23%}.download-table th:nth-child(3){width:14%}.download-table th:nth-child(4){width:28%}.download-table th:last-child{width:22%}.download-table tbody th{color:var(--ink);font-weight:700}.download-table .download-cell{text-align:right;padding-right:0}.download-cell .dw-button{min-height:40px;font-size:12px;padding:8px 16px}.checksum{max-width:100%}.checksum summary{cursor:pointer;text-decoration:underline;text-underline-offset:4px;list-style:none;font-family:ui-monospace,Consolas,monospace;font-size:11px;padding-block:3px}.checksum code{display:block;overflow-wrap:anywhere;white-space:normal;font-size:11px;line-height:1.7;margin-top:10px}.download-note,.download-empty{font-size:13px;margin-top:18px}.requirements{max-width:52rem}.requirements>p{margin-top:16px}.requirements table{margin-top:24px}.requirements th{width:22%}.requirements-note{font-size:14px}.requirements>.dw-link{display:inline-block;margin-top:20px;font-size:14px}@media(max-width:639px){.download-platform{padding:24px 20px}.download-table thead{display:none}.download-table tr{display:grid;grid-template-columns:minmax(0,1fr);padding:16px 0;border-bottom:1px solid var(--line);gap:10px}.download-table tbody th,.download-table td{display:grid;grid-template-columns:78px minmax(0,1fr);width:100%!important;border:0;padding:0!important;align-items:start;font-size:13px}.download-table td:before,.download-table tbody th:before{content:attr(data-label);font-size:11px;font-weight:500;text-transform:uppercase;letter-spacing:.06em;color:var(--ink-secondary);padding-top:3px}.download-table .download-cell{text-align:left;align-items:center}.download-cell .dw-button{justify-self:start}.requirements th{width:30%}.dw-intro h1{max-width:15ch}}
</style>
