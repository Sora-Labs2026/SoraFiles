---
import DesktopLayout from '../../layouts/PrototypeDesktopLayout.astro';
import icons from '../../data/prototypeIcons.json';
import MsStoreBadge from '../../components/MsStoreBadge.astro';
import releaseManifest from '../../../desktop/releases/manifest.json';
const published = releaseManifest.releases.filter(release => ['active','maintenance'].includes(release.status) && release.security === 'clear');
const platforms = [{id:'windows',name:'Windows'},{id:'macos',name:'macOS'},{id:'linux',name:'Linux'}];
const formatBytes = (bytes:number) => `${(bytes / 1024 ** 2).toFixed(1)} MB`;
const requirements = [
 ['Memory','No special requirement beyond what your operating system normally needs'],
 ['Processor','A modern 64-bit processor'],
 ['Storage','Enough free space for SoraFiles and the files you work with'],
 ['Internet','Needed for setup, activation and online services. File processing works offline'],
];
const platformMinimum = (platform:string,rows:typeof published) => {
  const minimums=[...new Set(rows.map(row=>row.minOS))];
  if(!minimums.length)return '';
  if(platform==='windows')return `Windows ${minimums.map(value=>value==='10.0'?'10':value).join(' / ')} or later · x64`;
  if(platform==='macos')return `macOS ${minimums.join(' / ')} or later · Apple Silicon and Intel`;
  return `Ubuntu ${minimums.join(' / ')} or later · x64`;
};
---
<DesktopLayout title="SoraFiles Desktop downloads" description="Download SoraFiles Desktop for Windows, macOS and Linux." path="/desktop/download">
 <header class="container page-intro"><p class="eyebrow eyebrow--pill page-intro__eyebrow">SoraFiles Desktop</p><h1 class="t-h1 page-intro__title"><span class="line-reveal"><span class="line-reveal__inner">Download for your computer</span></span></h1><p class="t-lead page-intro__lead">Choose the installer for your operating system. Every published file includes a SHA-256 checksum so you can verify the download before opening it.</p></header>
 <section class="container downloads" aria-label="Download for your computer">{platforms.map(platform=>{const rows=published.filter(release=>release.platform===platform.id);return <article class="dl-platform" id={platform.id} aria-labelledby={`dl-${platform.id}`}><div class="dl-platform__head"><h2 id={`dl-${platform.id}`} class="t-h2">{platform.name}</h2>{rows.length>0&&<span class="tag tag--accent">Available</span>}<p class="t-small dl-platform__req">{platformMinimum(platform.id,rows)}</p></div>{platform.id==='windows'&&<MsStoreBadge class="dl-platform__store"/>}{rows.length?<table class="dl-table"><thead><tr>{['Version','Package','Size','Checksum','Download'].map(label=><th scope="col">{label}</th>)}</tr></thead><tbody>{rows.map(release=><tr><td data-label="Version" class="tnum">{release.version}</td><td data-label="Package" class="tnum">{release.package} · {release.arch}</td><td data-label="Size" class="tnum">{formatBytes(release.bytes)}</td><td data-label="Checksum" class="code dl-table__sum">{release.sha256}</td><td class="dl-table__act"><a class="btn btn--secondary btn--sm" href={release.url} rel="noreferrer" aria-label={`Download ${platform.name} ${release.arch} ${release.package} ${release.version}`}><Fragment set:html={icons.Download.replace('class="','class="btn__icon ')}/><span class="btn__label">Download</span></a></td></tr>)}</tbody></table>:<p>No compatible installer is published yet.</p>}</article>})}</section>
 <section class="section section--ruled sysreq" aria-labelledby="sysreq-title"><div class="container"><h2 id="sysreq-title" class="t-h2">System requirements</h2><p class="t-lead sysreq__lead">SoraFiles Desktop is designed to be lightweight and processes files locally. It works offline after setup.</p><table class="sysreq__table"><thead><tr><th scope="col">Requirement</th><th scope="col"><span class="sr-only">Details</span></th></tr></thead><tbody>{requirements.map(([name,description])=><tr><th scope="row">{name}</th><td>{description}</td></tr>)}</tbody></table><p class="t-small sysreq__note">Larger PDFs, images, or batch jobs may naturally use more memory and storage while processing.</p><p class="t-small sysreq__foot">Linux packages target Ubuntu 22.04 x64. macOS first-launch approval steps are in <a href="/desktop/help#macos-open-anyway" class="link">Help</a>.</p></div></section>
</DesktopLayout>
