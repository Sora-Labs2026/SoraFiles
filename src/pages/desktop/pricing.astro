---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import pricing from '../../data/prototypePricing.json';
import '../../styles/v10-site-exact.css';
import '../../styles/v10-contact-controls.css';
---
<Layout title="SoraFiles Desktop plans" description="Personal and Team plans for SoraFiles Desktop." canonicalPath="/desktop/pricing" noIndex={true}>
 <Header/><main id="main" data-prototype-info data-prototype-controls><Fragment set:html={pricing.monthly.html}/></main><Footer/>
</Layout>
<script>
import pricing from '../../data/prototypePricing.json';
const root=document.querySelector<HTMLElement>('[data-prototype-controls]');
root?.querySelectorAll<HTMLInputElement>('[data-testid=billing-period] input').forEach(input=>input.addEventListener('change',()=>{
 const period=input.value as keyof typeof pricing;
 if(!Object.hasOwn(pricing,period))return;
 root.querySelector('.plans')!.outerHTML=pricing[period].plans;
 root.querySelectorAll<HTMLInputElement>('[data-testid=billing-period] input').forEach(radio=>radio.closest<HTMLElement>('label')!.toggleAttribute('data-checked',radio.checked));
}));
</script>
