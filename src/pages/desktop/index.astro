---
import DesktopLayout from '../../layouts/DesktopLayout.astro';
import ToolIcon from '../../components/ToolIcon.astro';
import Workflow from './_Workflow.astro';
const benefits = [
  {icon:'merge' as const,title:'Less repetition',text:'Batch actions and file-manager shortcuts keep repeat tasks close to your files.'},
  {icon:'resize' as const,title:'Saved beside the originals',text:'New copies land next to the source files, or in another folder you choose.'},
  {icon:'lock' as const,title:'Processed on your computer',text:'Supported workflows run on this device. Payment and licensing are separate from your files.'},
];
const questions = [
 ['Is SoraFiles Web still free?', 'Yes. The web app stays free and keeps getting fixes and improvements. You don’t need Desktop to use sorafiles.com.'],
 ['Does Desktop upload my files?', 'Supported Desktop workflows process files on your computer. Payment and licensing are handled separately from file processing.'],
 ['Does it work offline?', 'Works offline after setup. File processing runs locally; setup, activation and subscription renewals need an internet connection.'],
 ['How many devices does a license cover?', 'Personal covers one active device. Team covers up to five.'],
 ['How does the trial work?', 'Your 7-day trial starts when you first open SoraFiles Desktop on Windows, macOS or Linux. Connect to finish setup; waiting to connect does not extend the trial. When it ends, processing needs a valid license; settings stay available.'],
];
---
<DesktopLayout title="SoraFiles Desktop" description="File tools, right where your files are. Process PDFs and images on your computer with SoraFiles Desktop. SoraFiles Web stays free." path="/desktop">
  <section class="dw-container desktop-hero" aria-labelledby="desktop-title"><p class="dw-eyebrow">SoraFiles Desktop · Windows, macOS and Linux</p><h1 id="desktop-title"><span>File tools, right where</span><span>your files are.</span></h1><p class="desktop-lead">A native app for people who work with PDFs and images often. Select files, right-click, choose a tool.</p><div class="desktop-actions"><a href="/desktop/download" class="dw-button dw-button-primary">↓ &nbsp; Download</a><a href="/desktop/pricing" class="dw-button">View plans</a></div><p class="desktop-note">Includes a 7-day free trial.</p></section>
  <Workflow />
  <div class="dw-container">
    <section class="desktop-benefits" aria-label="Desktop benefits">{benefits.map(item=><article><span class="benefit-icon"><ToolIcon icon={item.icon}/></span><h2>{item.title}</h2><p>{item.text}</p></article>)}</section>
    <section class="desktop-platforms" aria-labelledby="platforms-title"><div><h2 id="platforms-title">Windows, macOS and Linux.</h2><p>Works offline after setup.</p></div><div class="platform-links">{['Windows','macOS','Linux'].map(platform=><a href={`/desktop/download#${platform.toLowerCase()}`}><strong>{platform}</strong><span>Installer and checksum ↗</span></a>)}</div></section>
    <section class="dw-ruled" aria-labelledby="comparison-title"><h2 id="comparison-title">Web or Desktop?</h2><table class="dw-table comparison"><caption class="sr-only">SoraFiles Web compared with SoraFiles Desktop</caption><thead><tr><td></td><th scope="col">SoraFiles Web</th><th scope="col">SoraFiles Desktop</th></tr></thead><tbody>{[
      ['Cost','Free','Paid app'],['Installation','None, runs in your browser','Installer for Windows, macOS or Linux'],['File processing','Supported tools run locally in your browser','Supported workflows run on your computer'],['File-manager actions','Open files in a web tool','Right-click actions, where the platform build supports them'],['Updates','Updates available when you visit','Download releases from this website'],
    ].map(row=><tr><th scope="row">{row[0]}</th><td data-label="Web">{row[1]}</td><td data-label="Desktop">{row[2]}</td></tr>)}</tbody></table><p class="comparison-note"><strong>SoraFiles Web stays free.</strong><a class="dw-link" href="/tools">Open the web tools →</a></p></section>
    <section class="desktop-cta" aria-labelledby="trial-title"><h2 id="trial-title">Start your 7-day trial.</h2><p>Installers and checksums are listed on the Downloads page.</p><div class="desktop-actions"><a href="/desktop/download" class="dw-button dw-button-primary">↓ &nbsp; Download</a><a href="/desktop/pricing" class="dw-button">View plans</a></div></section>
    <section class="dw-ruled desktop-faq" aria-labelledby="questions-title"><h2 id="questions-title">Questions</h2><div>{questions.map(([question,answer],i)=><details open={i===0}><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div></section>
  </div>
</DesktopLayout>
<style>
  .desktop-hero{padding-top:clamp(40px,6vw,84px);padding-bottom:48px}.desktop-hero h1{font-size:clamp(2.625rem,3.6vw,3rem);max-width:24ch;margin-top:20px;font-weight:800;letter-spacing:-.045em;line-height:1.04}.desktop-hero h1 span{display:block;animation:hero-line .56s cubic-bezier(.16,1,.3,1) both}.desktop-hero h1 span+span{animation-delay:.08s}.desktop-lead{max-width:32rem;margin-top:20px;font-size:19px;line-height:1.55}.desktop-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:32px}.desktop-actions .dw-button{min-height:48px}.desktop-note{font-size:12px;margin-top:16px}.desktop-benefits{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:40px;padding-top:40px;border-top:1px solid var(--line)}.benefit-icon{display:inline-flex;padding:10px;border:1px solid var(--line);border-radius:12px;margin-bottom:20px}.benefit-icon :global(svg){width:20px;height:20px}.desktop-benefits h2{font-size:17px}.desktop-benefits p{font-size:14px;line-height:1.6;margin-top:8px;max-width:21rem}.desktop-platforms{display:grid;grid-template-columns:5fr 7fr;align-items:end;gap:64px;padding-top:80px}.desktop-platforms p{margin-top:12px;font-size:18px}.platform-links{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.platform-links a{display:flex;flex-direction:column;gap:32px;padding:20px;border:1px solid var(--line);border-radius:16px;background:var(--surface);transition:transform .2s,border-color .2s}.platform-links a:hover{transform:translateY(-2px);border-color:var(--line-strong)}.platform-links strong{font-size:18px;letter-spacing:-.025em}.platform-links span{font-size:12px;color:var(--ink-secondary)}.comparison{margin-top:32px}.comparison tbody th{width:26%}.comparison td{width:37%}.comparison-note{display:flex;flex-wrap:wrap;gap:16px;margin-top:28px;font-size:14px}.comparison-note strong{color:var(--ink)}.desktop-cta{--ink:#f4f5f7;--ink-secondary:#c3c7ce;--surface:#101217;--line-strong:#2f343d;--action:#f4f5f7;--action-hover:#fff;--on-action:#0a0b0f;background:radial-gradient(50% 120% at 100% 0%,rgba(251,191,36,.09),transparent 70%),#0a0b0f;padding:clamp(32px,5vw,64px);border-radius:22px;margin-top:80px}.desktop-cta h2{font-size:clamp(30px,4vw,48px)}.desktop-cta p{max-width:32rem;font-size:19px;margin-top:12px}.desktop-faq{display:grid;grid-template-columns:5fr 7fr;gap:64px}.desktop-faq details{border-bottom:1px solid var(--line)}.desktop-faq details:first-child{border-top:1px solid var(--line)}.desktop-faq summary{display:flex;justify-content:space-between;gap:16px;align-items:center;list-style:none;cursor:pointer;padding:20px 0;font-weight:700;font-size:15px;min-height:56px}.desktop-faq summary::-webkit-details-marker{display:none}.desktop-faq summary span{display:grid;place-items:center;border:1px solid var(--line-strong);width:26px;height:26px;border-radius:50%;flex-shrink:0;font-size:18px;transition:transform .2s}.desktop-faq details[open] summary span{transform:rotate(45deg);background:var(--action);color:var(--on-action);border-color:var(--action)}.desktop-faq details p{font-size:14px;line-height:1.7;padding-bottom:20px}@keyframes hero-line{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}@media(max-width:1023px){.desktop-platforms,.desktop-faq{grid-template-columns:1fr;gap:28px}}@media(max-width:767px){.desktop-benefits{grid-template-columns:1fr;gap:32px}.desktop-platforms{padding-top:56px}.desktop-cta{margin-top:56px}.desktop-hero h1 span{display:inline}.desktop-hero h1 span+span:before{content:' '}}@media(max-width:479px){.platform-links{grid-template-columns:1fr}.platform-links a{flex-direction:row;align-items:center;justify-content:space-between;gap:16px}.comparison thead{display:none}.comparison tr{display:grid;grid-template-columns:1fr 1fr;gap:8px 16px;padding:16px 0;border-bottom:1px solid var(--line)}.comparison tbody th{grid-column:1/-1;width:auto;border:0;padding:0}.comparison td{width:auto;border:0;padding:0;font-size:13px}.comparison td:before{content:attr(data-label);display:block;font-size:11px;font-weight:700;margin-bottom:4px}}
</style>
