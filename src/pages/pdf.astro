---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PdfWorkbench from '../components/PdfWorkbench.astro';
import ToolPageHero from '../components/ToolPageHero.astro';
import ToolFaq from '../components/ToolFaq.astro';
import RelatedTools from '../components/RelatedTools.astro';
import { toolBySlug } from '../data/tools';
const description = 'Compress PDF files locally in your browser. Nothing is uploaded to a server. Free private PDF compressor with no account, watermark, or changed original.';
const keywords = 'compress PDF no upload, compress PDF without uploading, compress PDF local, browser based PDF compressor, private PDF compressor, client side PDF compressor, compress PDF free, compress PDF for email, compress PDF under 1MB';
const tool = toolBySlug.get('compress-pdf')!;
const faqItems = [
  { question: 'Can I compress a PDF without uploading it?', answer: 'Yes. Sora Files renders and rebuilds the PDF in your browser. The document is not sent to a Sora Files processing server.' },
  { question: 'Will PDF compression keep selectable text and links?', answer: 'No. This compressor creates image-based pages to reduce size, so selectable text, links, forms, signatures, bookmarks, and accessibility structure are not retained.' },
  { question: 'Can it guarantee a PDF under 1MB or 100KB?', answer: 'No honest compressor can guarantee every target without considering page count and detail. Choose a stronger level, check readability, and keep the original when a strict limit matters.' },
  { question: 'Does Sora Files overwrite the original PDF?', answer: 'No. It creates a separate compressed download. Your original document remains unchanged on this device.' },
];
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebApplication', name: 'Sora Files PDF Compressor', url: 'https://sorafiles.com/pdf', applicationCategory: 'UtilitiesApplication', operatingSystem: 'Any operating system with a modern web browser', isAccessibleForFree: true, offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, description },
    { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://sorafiles.com/' }, { '@type': 'ListItem', position: 2, name: 'Compress PDF', item: 'https://sorafiles.com/pdf' }] },
    { '@type': 'FAQPage', mainEntity: faqItems.map(({ question, answer }) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } })) },
  ],
};
---
<Layout title="Compress PDF Without Uploading — Free | Sora Files" {description} {keywords} canonicalPath="/pdf" {schema}>
  <Header />
  <main id="main">
    <ToolPageHero tool={tool} h1="Compress PDF files without uploading them." intro="Reduce a PDF for email or an upload limit entirely in your browser. No account, no watermark, and no server copy of your document." limitations={['Pages become images. Selectable text, links, forms, signatures, bookmarks, and accessibility structure are not retained.', 'Safety limits: 50 MB, 40 pages, and a 16-megapixel render ceiling per page.']} />
    <div class="bg-canvas pb-20 pt-8 sm:pb-28 sm:pt-10"><PdfWorkbench /></div>
    <section class="border-t border-line px-5 py-20 sm:px-6">
      <div class="mx-auto max-w-5xl">
        <div class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr]">
          <article>
            <h2 class="text-balance text-3xl font-semibold tracking-[-0.035em]">A browser-based PDF compressor built for privacy</h2>
            <p class="mt-5 text-sm leading-7 text-muted">Many PDF compression workflows begin by transferring the document to a remote server. Sora Files takes a different approach: the selected PDF is read, rendered, compressed, and rebuilt on this device. This client-side PDF compressor is useful for personal records, schoolwork, scans, and completed forms you would prefer not to place in an upload queue.</p>
            <p class="mt-4 text-sm leading-7 text-muted">Choose Balanced first when you need a smaller PDF for email. Use Smaller file when a portal has a tighter limit, then check fine text before sharing the result. A target such as under 1MB or 100KB cannot be guaranteed because page count, dimensions, and image detail determine how far a file can shrink without becoming unreadable.</p>
          </article>
          <div class="grid gap-6 sm:grid-cols-3 lg:grid-cols-1">
            <article><h2 class="font-semibold">Best for</h2><p class="mt-3 text-sm leading-6 text-muted">Scans, slide exports, completed paperwork, and documents intended mainly for reading.</p></article>
            <article><h2 class="font-semibold">Important trade-off</h2><p class="mt-3 text-sm leading-6 text-muted">Pages become images. Selectable text, links, forms, signatures, bookmarks, and accessibility structure are not retained.</p></article>
            <article><h2 class="font-semibold">Safety limits</h2><p class="mt-3 text-sm leading-6 text-muted">50 MB, 40 pages, and a 16-megapixel render ceiling per page protect device memory.</p></article>
          </div>
        </div>
        <div class="mt-12 border-y border-line py-8"><h2 class="text-xl font-semibold">How to compress a PDF privately</h2><ol class="mt-5 grid gap-5 text-sm leading-6 text-muted sm:grid-cols-3"><li><span class="font-medium text-ink">1. Choose the PDF.</span><br />The file is opened by this browser, not uploaded to Sora Files.</li><li><span class="font-medium text-ink">2. Pick a level.</span><br />Start Balanced, or choose Smaller file for a stronger reduction.</li><li><span class="font-medium text-ink">3. Check the download.</span><br />A new file is created; your original PDF is never overwritten.</li></ol></div>
      </div>
    </section>
    <ToolFaq items={faqItems} title="PDF compression questions" />
    <RelatedTools slugs={tool.related} />
  </main>
  <Footer />
</Layout>
