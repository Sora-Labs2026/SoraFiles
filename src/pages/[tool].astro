---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DocumentActionWorkbench from '../components/DocumentActionWorkbench.astro';
import ToolPageHero from '../components/ToolPageHero.astro';
import ToolFaq, { type FaqItem } from '../components/ToolFaq.astro';
import RelatedTools from '../components/RelatedTools.astro';
import { actionTools, type ToolDefinition, type ToolSlug } from '../data/tools';

export function getStaticPaths() {
  return actionTools.map((tool) => ({ params: { tool: tool.slug }, props: { tool } }));
}

interface Props { tool: ToolDefinition & { slug: ToolSlug }; }
interface PageContent {
  title: string;
  description: string;
  keywords: string;
  h1: string;
  intro: string;
  sectionTitle: string;
  paragraphs: string[];
  steps: string[];
  note: string;
  faqs: FaqItem[];
}

const { tool } = Astro.props;
const pages: Record<ToolSlug, PageContent> = {
  'merge-pdf': {
    title: 'Merge PDF Without Uploading — Free | Sora Files',
    description: 'Merge PDF files locally in your browser. Free private PDF merge with no uploads, account, watermark, or changed original files.',
    keywords: 'merge PDF no upload, local PDF merge, merge PDF free online, merge PDF files, how to merge PDF files',
    h1: 'Merge PDF files locally—no upload required.',
    intro: 'Combine PDFs in your chosen order inside this browser. Your source documents stay on your device, and the result has no watermark.',
    sectionTitle: 'A free local PDF merge for private documents',
    paragraphs: ['Use Merge PDF when separate reports, invoices, forms, or chapters belong in one document. Sora Files reads and combines complete pages locally, so the PDF contents are not transferred to a Sora Files server. This makes the tool a practical choice when an upload-based merge would expose more information than necessary.', 'The output preserves the pages from each source PDF in the order selected. It creates a new combined download and never overwrites the originals. Review the file list before processing, especially when similar filenames could make the intended sequence unclear.'],
    steps: ['Choose two or more PDF files.', 'Confirm the order shown in the file list.', 'Merge locally and download the new PDF.'],
    note: 'Encrypted PDFs may need to be unlocked first. Keep every original until you have checked the merged result.',
    faqs: [
      { question: 'Can I merge PDF files without uploading them?', answer: 'Yes. The selected PDFs are read and combined inside this browser. Their contents are not sent to a Sora Files processing server.' },
      { question: 'Does merging change the original PDFs?', answer: 'No. The tool creates one separate combined download. Every source PDF remains unchanged on your device.' },
      { question: 'Can I choose the PDF order?', answer: 'Yes. Choose the files in the order they should appear and review the displayed list before you start. The output follows that order.' },
    ],
  },
  'split-pdf': {
    title: 'Split PDF Without Uploading — Free | Sora Files',
    description: 'Split a PDF into separate page files locally in your browser. Free private PDF splitter with no upload, account, or watermark.',
    keywords: 'split PDF without uploading, split PDF free, split PDF online free, split PDF pages, how to split PDF files',
    h1: 'Split a PDF without uploading it.',
    intro: 'Create one PDF for every page and download the results as a ZIP. Processing stays on your device from selection to download.',
    sectionTitle: 'Split PDF pages privately in your browser',
    paragraphs: ['Sora Files separates a document into one PDF per page without sending the source file to a processing server. It is useful for certificates, invoices, worksheets, evidence pages, or any document whose pages need to be stored and shared independently.', 'The individual PDFs are packaged in a ZIP so your browser can download them together. Each output is a new file, and the original PDF remains unchanged. The current tool splits every page; it does not yet provide custom page-range extraction.'],
    steps: ['Choose one supported PDF.', 'Start the local split process.', 'Download and extract the ZIP of page files.'],
    note: 'The browser may need extra memory for long or image-heavy documents. The tool displays its current safety limits before processing.',
    faqs: [
      { question: 'Can I split a PDF without uploading it?', answer: 'Yes. Sora Files separates the pages in your browser, so the source PDF stays on your device.' },
      { question: 'Why is the result a ZIP file?', answer: 'A split can create many one-page PDFs. The ZIP is only a convenient download container; it does not change the individual PDF files.' },
      { question: 'Can I split only selected page ranges?', answer: 'Not yet. The current verified tool creates one PDF for every page and clearly names each result.' },
    ],
  },
  'rotate-pdf': {
    title: 'Rotate PDF Locally — Free, No Upload | Sora Files',
    description: 'Rotate every PDF page by 90, 180, or 270 degrees locally. Free browser-based PDF rotation with no upload, account, or watermark.',
    keywords: 'rotate PDF locally, rotate PDF no upload, rotate PDF pages, rotate PDF online free',
    h1: 'Rotate PDF pages locally—without an upload.',
    intro: 'Fix sideways or upside-down pages by rotating the complete document in this browser. Your PDF stays on this device.',
    sectionTitle: 'Correct PDF orientation without sending the file away',
    paragraphs: ['Scanners, phone cameras, and export tools can leave an entire PDF facing the wrong direction. Choose a 90, 180, or 270-degree rotation and Sora Files will apply it to every page locally. No account is required, and no watermark is added.', 'The tool creates a separate corrected PDF, so the source document is never overwritten. The current action rotates all pages by the same amount; use a desktop editor when individual pages require different angles.'],
    steps: ['Choose the PDF with the wrong orientation.', 'Select the rotation angle.', 'Process locally and download the corrected copy.'],
    note: 'Check the completed PDF before sharing it, particularly when some pages originally used mixed orientations.',
    faqs: [
      { question: 'Can I rotate a PDF without uploading it?', answer: 'Yes. Page rotation is applied locally in your browser and the original PDF remains on your device.' },
      { question: 'Which rotation angles are available?', answer: 'You can rotate the document by 90°, 180°, or 270°. The chosen angle is applied to every page.' },
      { question: 'Can I rotate individual pages differently?', answer: 'Not in the current tool. It applies one angle to all pages; use a full PDF editor for mixed per-page rotations.' },
    ],
  },
  'jpg-to-pdf': {
    title: 'JPG to PDF Without Uploading — Free | Sora Files',
    description: 'Convert JPG and PNG images to one PDF locally in your browser. Free private image-to-PDF converter with no upload, account, or watermark.',
    keywords: 'image to PDF no upload, convert image to PDF free, image to PDF converter, JPG to PDF local, how to convert image to PDF',
    h1: 'Convert images to PDF without uploading them.',
    intro: 'Combine JPG and PNG images into one clean PDF in the order selected. Everything is created locally on your device.',
    sectionTitle: 'A private image-to-PDF converter for everyday documents',
    paragraphs: ['Turn photographed notes, receipts, application evidence, or portfolio images into a single PDF without transferring the source pictures to Sora Files. The browser places the selected JPG and PNG files into a new document and prepares it for download.', 'Choose images in the sequence they should appear and review the list before processing. The original pictures remain unchanged, the new PDF has no watermark, and you do not need an account. HEIC photos should first be converted to JPG with the private image tool.'],
    steps: ['Choose one or more JPG or PNG images.', 'Review their order and page setting.', 'Create and download the PDF locally.'],
    note: 'Large source photos can produce a large PDF. Compress the images first when the final document must meet a strict upload limit.',
    faqs: [
      { question: 'Can I convert images to PDF without uploading?', answer: 'Yes. JPG and PNG images are read in this browser and placed into a new PDF locally.' },
      { question: 'Can I put several images into one PDF?', answer: 'Yes. Select multiple JPG or PNG files and review their order before creating the document.' },
      { question: 'Does Sora Files change my original images?', answer: 'No. It creates a separate PDF download and leaves every source image unchanged.' },
    ],
  },
  'pdf-to-jpg': {
    title: 'PDF to JPG Without Uploading — Free | Sora Files',
    description: 'Convert every PDF page to a JPG locally in your browser. Free private PDF-to-image converter with no upload, account, or watermark.',
    keywords: 'PDF to image no upload, PDF to image converter free, convert PDF to image, PDF to JPG local, PDF to image free',
    h1: 'Convert PDF pages to JPG without uploading.',
    intro: 'Render every page as an image on your device, then download the results together as a ZIP file.',
    sectionTitle: 'Private PDF-to-image conversion in your browser',
    paragraphs: ['Use PDF to JPG when a form accepts images but not documents, when you need page previews, or when a PDF page must be placed into a presentation. Sora Files renders the pages locally and does not send the PDF contents to a conversion server.', 'Each page becomes a separate JPG and multiple results are packaged in a ZIP. The images are visual copies, so text is no longer selectable or searchable. Your original PDF remains unchanged and no watermark is placed on the images.'],
    steps: ['Choose the PDF to convert.', 'Let this browser render its pages.', 'Download the ZIP of numbered JPG files.'],
    note: 'Rendering can use significant memory for long or high-resolution PDFs, so the tool applies protective limits.',
    faqs: [
      { question: 'Can I convert PDF pages to JPG without uploading?', answer: 'Yes. Each page is rendered to a JPG inside your browser and the PDF stays on this device.' },
      { question: 'Why do multiple JPG pages download as a ZIP?', answer: 'The ZIP keeps all numbered page images together for one reliable browser download.' },
      { question: 'Will text remain selectable in the JPG?', answer: 'No. A JPG is a visual image of the page. Keep the source PDF when selectable text, links, or document structure matter.' },
    ],
  },
  'pdf-to-word': {
    title: 'PDF to Word Locally — Free, Local OCR | Sora Files',
    description: 'Extract embedded PDF text and recognize scanned pages locally with OCR in your browser. Free, private PDF-to-Word conversion with no file upload.',
    keywords: 'PDF to Word no upload, PDF to Word OCR locally, private PDF to Word converter, convert PDF to Word free',
    h1: 'Convert PDF text and scanned pages to Word locally.',
    intro: 'Extract embedded text first, and automatically recognize scanned pages using local OCR without sending your PDF to Sora Files.',
    sectionTitle: 'Private text extraction and local OCR—not a full layout clone',
    paragraphs: ['This tool reads embedded text and performs local optical character recognition (OCR) on scanned pages inside your browser. It creates a simple Word document on your device without placing the source document in a server upload queue.', 'Complex columns, tables, forms, graphics, and exact page layouts are simplified. Scanned page OCR accuracy depends on scan clarity, selected language, handwriting, and page structure. Review and reformat the DOCX before relying on it for layout-critical needs.'],
    steps: ['Choose a PDF document.', 'Select the document language if pages contain scans.', 'Convert locally with embedded text and local OCR, then download the Word file.'],
    note: 'Scanned pages are recognized locally with OCR. Scan clarity, language, handwriting, tables, and columns affect accuracy, and exact page layout is not reconstructed.',
    faqs: [
      { question: 'How does local OCR handle scanned PDF pages?', answer: 'Pages below a text threshold are rendered and processed with an on-demand local OCR model in your browser. Your document is never uploaded.' },
      { question: 'Will the Word file keep the original layout?', answer: 'No. This is a basic text-focused conversion. Columns, tables, graphics, forms, fonts, and exact page layout may be simplified.' },
      { question: 'Is PDF to Word processed locally?', answer: 'Yes. Text extraction, local OCR, and DOCX creation happen entirely in your browser without sending the source PDF to Sora Files.' },
    ],
  },
  'word-to-pdf': {
    title: 'Word to PDF Locally — Free, No Upload | Sora Files',
    description: 'Convert basic DOCX text to a PDF locally in your browser. Free private Word-to-PDF converter with no upload, account, or watermark.',
    keywords: 'Word to PDF no upload, Word to PDF locally, private Word to PDF converter, convert DOCX to PDF free',
    h1: 'Convert Word text to PDF locally.',
    intro: 'Create a clean PDF from basic DOCX text in this browser. No file upload, account, or watermark is required.',
    sectionTitle: 'A private basic Word-to-PDF workflow',
    paragraphs: ['Sora Files reads supported DOCX text and creates a PDF on your device. This is useful for simple letters, notes, and text-first documents when privacy matters more than reproducing every Microsoft Word layout feature.', 'The conversion is intentionally basic. Complex tables, headers, footers, page breaks, fonts, drawings, and precise styling may change or be omitted. Keep the Word original and inspect the PDF before submitting or printing it.'],
    steps: ['Choose a text-based DOCX file.', 'Create the PDF locally in this browser.', 'Download and check the new document.'],
    note: 'Use Microsoft Word or another full document editor when exact layout fidelity is required.',
    faqs: [
      { question: 'Can I convert Word to PDF without uploading?', answer: 'Yes. The DOCX is read and a new PDF is created locally in this browser.' },
      { question: 'Will complex Word formatting be preserved?', answer: 'Not exactly. This basic text-focused converter can simplify tables, headers, footers, fonts, drawings, and precise page layout.' },
      { question: 'Does the tool overwrite my Word file?', answer: 'No. Your DOCX remains unchanged and the result downloads as a separate PDF.' },
    ],
  },
};
const metadata = pages[tool.slug];
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: `${tool.title} - Sora Files`,
      url: `https://sorafiles.com/${tool.slug}`,
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Any operating system with a modern web browser',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      description: metadata.description,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://sorafiles.com/' },
        { '@type': 'ListItem', position: 2, name: tool.category === 'image' ? 'Image tools' : 'PDF tools', item: `https://sorafiles.com/#${tool.category === 'image' ? 'image-tools' : 'pdf-tools'}` },
        { '@type': 'ListItem', position: 3, name: tool.title, item: `https://sorafiles.com/${tool.slug}` },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: metadata.faqs.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    },
  ],
};
---
<Layout title={metadata.title} description={metadata.description} keywords={metadata.keywords} canonicalPath={`/${tool.slug}`} {schema}>
  <Header />
  <main id="main">
    <ToolPageHero tool={tool} h1={metadata.h1} intro={metadata.intro} limitations={[metadata.note]} />
    <div class="bg-canvas pb-20 pt-8 sm:pb-28 sm:pt-10"><DocumentActionWorkbench tool={tool}/></div>
    <section class="border-t border-line px-5 py-20 sm:px-6">
      <div class="mx-auto grid max-w-5xl gap-12 lg:grid-cols-[1.1fr_0.9fr]">
        <article><h2 class="text-balance text-3xl font-semibold tracking-[-0.035em]">{metadata.sectionTitle}</h2>{metadata.paragraphs.map((paragraph) => <p class="mt-5 text-sm leading-7 text-muted">{paragraph}</p>)}</article>
        <div><h2 class="text-xl font-semibold">How it works</h2><ol class="mt-5 space-y-4">{metadata.steps.map((step, index) => <li class="flex gap-4 text-sm leading-6 text-muted"><span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-blue text-xs font-semibold text-white">{index + 1}</span><span>{step}</span></li>)}</ol><p data-pdf-to-word-ocr-disclosure={tool.slug === 'pdf-to-word' ? '' : undefined} class="mt-8 rounded-card border border-line bg-canvas p-5 text-sm leading-6 text-muted"><span class="font-medium text-ink">Good to know:</span> {metadata.note}</p></div>
      </div>
    </section>
    <ToolFaq items={metadata.faqs} title={`${tool.title} questions`} />
    <RelatedTools slugs={tool.related} />
  </main>
  <Footer />
</Layout>
