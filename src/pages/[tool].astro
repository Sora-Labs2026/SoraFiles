---
import LiveToolRoute from '../components/LiveToolRoute.astro';
import { liveTools, type LiveTool } from '../data/liveTools';

export function getStaticPaths() {
  const explicitRoutes = new Set(['pdf', 'image-converter', 'compress-image', 'heic-to-jpg']);
  return liveTools.filter((tool) => !explicitRoutes.has(tool.slug)).map((tool) => ({ params: { tool: tool.slug }, props: { tool } }));
}
interface Props { tool: LiveTool; }
const { tool } = Astro.props;
---

<LiveToolRoute {tool} />
