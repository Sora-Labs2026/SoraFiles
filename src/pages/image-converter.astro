---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ImageConverterWorkbench from '../components/ImageConverterWorkbench.astro';
import ToolPageHero from '../components/ToolPageHero.astro';
import ToolFaq from '../components/ToolFaq.astro';
import RelatedTools from '../components/RelatedTools.astro';
import { toolBySlug } from '../data/tools';

const description = 'Convert JPG, PNG, WebP, GIF, BMP, AVIF, SVG, HEIC, HEIF, TIFF, and PSD images locally. Free private image converter with no upload or watermark.';
const keywords = 'free image converter, image converter no upload, convert image format locally, JPG to PNG, PNG to JPG, TIFF to JPG, PSD to PNG, HEIC to JPG';
const tool = toolBySlug.get('image-converter')!;
const faqItems = [
  { question: 'Is the Sora Files image converter free?', answer: 'Yes. The image converter is free to use, requires no account, and adds no watermark. It creates a separate download without overwriting the original image.' },
  { question: 'Are images uploaded while converting?', answer: 'No. Supported images are decoded and converted locally in your browser. Sora Files does not receive the selected image or the converted download.' },
  { question: 'Which image formats can I convert?', answer: 'The converter accepts JPG, JPEG, JFIF, PNG, APNG, WebP, GIF, BMP, AVIF, SVG, ICO, HEIC, HEIF, TIFF, TIF, PSD, and browser-supported JPEG 2000 files. Output is available as JPG, PNG, or WebP.' },
  { question: 'Can I convert HEIC, TIFF, or PSD without uploading?', answer: 'Yes. HEIC and HEIF use the primary still image, multipage TIFF uses the first page, and PSD uses its flattened composite. All supported decoding happens on your device.' },
  { question: 'Why are RAW and INDD files not converted?', answer: 'Camera RAW files require camera-specific development before they become a standard image. INDD is an Adobe InDesign layout document rather than an image. Export either format as JPG, PNG, or TIFF first.' },
  { question: 'Should I choose JPG, PNG, or WebP?', answer: 'Choose JPG for widely compatible photographs, PNG for lossless images or transparency, and WebP for efficient web images. The converter preserves pixel dimensions but does not copy metadata, layers, or animation.' },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['WebApplication', 'SoftwareApplication'],
      '@id': 'https://sorafiles.com/image-converter#app',
      name: 'Sora Files All-in-One Image Converter',
      url: 'https://sorafiles.com/image-converter',
      applicationCategory: 'MultimediaApplication',
      operatingSystem: 'Any operating system with a modern web browser',
      browserRequirements: 'Requires JavaScript and a modern browser with Canvas support',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      featureList: ['Local browser processing', 'JPG, PNG, and WebP output', 'HEIC and HEIF decoding', 'TIFF decoding', 'Flattened PSD conversion', 'No upload, account, or watermark'],
      description,
    },
    {
      '@type': 'BreadcrumbList',
      '@id': 'https://sorafiles.com/image-converter#breadcrumb',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Sora Files', item: 'https://sorafiles.com/' },
        { '@type': 'ListItem', position: 2, name: 'Image Converter', item: 'https://sorafiles.com/image-converter' },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': 'https://sorafiles.com/image-converter#faq',
      mainEntity: faqItems.map(({ question, answer }) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } })),
    },
  ],
};

const supported = ['JPG', 'JPEG', 'JFIF', 'PNG', 'APNG', 'WebP', 'GIF', 'BMP', 'AVIF', 'SVG', 'ICO', 'HEIC', 'HEIF', 'TIFF', 'TIF', 'PSD', 'JPEG 2000*'];
---
<Layout title="Free Image Converter Without Uploading | Sora Files" {description} {keywords} canonicalPath="/image-converter" {schema}>
  <Header />
  <main id="main">
    <ToolPageHero tool={tool} h1="Convert images without uploading them." intro="Turn common, modern, iPhone, print, and layered image files into JPG, PNG, or WebP. Everything runs locally in your browser." limitations={['Animated and multipage inputs use the first frame or page. PSD output uses the flattened composite.', 'AVIF, ICO, and JPEG 2000 decoding depends on browser support.']} />

    <div class="bg-canvas pb-20 pt-8 sm:pb-28 sm:pt-10"><ImageConverterWorkbench /></div>

    <section class="border-t border-line px-5 py-20 sm:px-6">
      <div class="mx-auto max-w-5xl">
        <div class="grid gap-12 lg:grid-cols-[1.1fr_0.9fr]">
          <article>
            <h2 class="text-balance text-3xl font-semibold tracking-[-0.035em]">One image converter for everyday formats</h2>
            <p class="mt-5 text-sm leading-7 text-muted">Sora Files reads the selected image on your device and creates a new JPG, PNG, or WebP download. There is no upload queue, account, watermark, or server copy. The original file is never overwritten.</p>
            <p class="mt-4 text-sm leading-7 text-muted">Use JPG for broad compatibility and smaller photographs, PNG for lossless pixels and transparency, or WebP for an efficient web-ready file. Pixel dimensions stay unchanged while metadata is removed from the new file.</p>
          </article>
          <div>
            <h2 class="text-xl font-semibold">Supported input extensions</h2>
            <ul class="mt-5 flex flex-wrap gap-2" aria-label="Supported image extensions">
              {supported.map((item) => <li class="rounded-full border border-line bg-canvas px-3 py-1.5 text-xs font-medium text-muted">{item}</li>)}
            </ul>
            <p class="mt-5 text-sm leading-6 text-muted">Animated GIF and APNG files use their first frame. Multipage TIFF files use their first page. PSD files use the flattened composite, not editable layers. AVIF, ICO, and JPEG 2000 decoding depends on support in your browser.</p>
          </div>
        </div>

        <div class="mt-14 grid border-l border-t border-line md:grid-cols-3">
          <article class="-ml-px -mt-px border border-line p-5"><h2 class="font-semibold">Camera RAW</h2><p class="mt-3 text-sm leading-6 text-muted">RAW is a family that includes DNG, CR2, CR3, NEF, ARW, RAF, ORF, RW2, and more. These files require camera-specific development, so the converter asks you to export a standard image first.</p></article>
          <article class="-ml-px -mt-px border border-line p-5"><h2 class="font-semibold">JPEG 2000</h2><p class="mt-3 text-sm leading-6 text-muted">JP2, J2K, JPF, and JPX decoding is not consistently available in current browsers. The converter uses it when your browser provides a decoder and otherwise explains how to prepare the file.</p></article>
          <article class="-ml-px -mt-px border border-line p-5"><h2 class="font-semibold">Adobe INDD</h2><p class="mt-3 text-sm leading-6 text-muted">INDD is an InDesign page-layout document rather than an image. Export the required page from InDesign as JPG or PNG, then use Sora Files to convert or compress it.</p></article>
        </div>
      </div>
    </section>
    <ToolFaq items={faqItems} title="All-in-One Image Converter FAQ" />
    <RelatedTools slugs={tool.related} />
  </main>
  <Footer />
</Layout>
