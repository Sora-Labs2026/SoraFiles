---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const description = 'The page you requested could not be found. Return to Sora Files to use free private PDF and image tools.';
---

<Layout title="Page Not Found | Sora Files" {description} canonicalPath="/404" noIndex>
  <Header />
  <main id="main" class="grid-surface flex min-h-[65vh] items-center border-b border-line px-5 py-20 sm:px-6">
    <div class="mx-auto w-full max-w-3xl text-center">
      <p class="eyebrow text-xs font-semibold text-blue">Error 404</p>
      <h1 class="mt-4 text-balance text-[clamp(2.25rem,5.5vw,3.5rem)] font-semibold leading-[1.05] tracking-[-0.05em]">This page could not be found.</h1>
      <p class="mx-auto mt-6 max-w-xl text-pretty text-lg leading-8 text-muted">The address may be incorrect or the page may have moved. Your files have not been selected or processed.</p>
      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <a href="/" class="inline-flex min-h-11 items-center justify-center rounded-control bg-action px-5 text-sm font-medium text-action-contrast hover:bg-action-hover">Browse File Tools</a>
        <a href="/contact" class="inline-flex min-h-11 items-center justify-center rounded-control border border-line bg-surface px-5 text-sm font-medium text-ink hover:bg-canvas">Contact support</a>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
