---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<Layout title="Page not found | SoraFiles" description="The page you requested could not be found." canonicalPath="/404" noIndex>
  <Header />
  <main id="main" data-testid="not-found" class="mx-auto flex max-w-xl flex-col items-center px-4 py-28 text-center">
    <span class="text-gradient text-6xl font-extrabold">404</span>
    <p class="mt-4 text-sm font-bold text-slate-500 dark:text-slate-400">Page not found</p>
    <a href="/" class="mt-6 rounded-full bg-slate-900 px-6 py-2.5 text-sm font-bold text-white dark:bg-white dark:text-slate-900">Back to home</a>
  </main>
  <Footer />
</Layout>
