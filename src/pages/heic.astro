---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<Layout title="HEIC to JPG | SoraFiles" description="The HEIC converter moved to its canonical address." canonicalPath="/heic-to-jpg" noIndex>
  <Header />
  <main id="main" class="mx-auto flex min-h-[55vh] max-w-xl flex-col items-center justify-center px-4 py-20 text-center"><span class="text-xs font-extrabold uppercase tracking-[.25em] text-violet-500">Moved</span><h1 class="mt-3 text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white">HEIC to JPG</h1><p class="mt-3 text-sm font-medium text-slate-500 dark:text-slate-400">Use the current private, on-device converter.</p><a href="/heic-to-jpg" class="mt-6 rounded-full bg-slate-900 px-6 py-2.5 text-sm font-bold text-white dark:bg-white dark:text-slate-900">Open HEIC to JPG</a></main>
  <Footer />
</Layout>
