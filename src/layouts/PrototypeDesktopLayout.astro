---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/v10-site-exact.css';
import {localizedPath,type LocalePath} from '../i18n/config';
import {prototypeText} from '../i18n/prototype';
import {desktopDownloadText} from '../i18n/desktopDownload';
interface Props {title:string;description:string;path:string;sensitive?:boolean;locale?:LocalePath}
const {title,description,path,sensitive=false,locale=(Astro.params.locale||'en') as LocalePath}=Astro.props;
const t=(text:string)=>text==='Downloads'?desktopDownloadText(locale).downloads:prototypeText(locale,text);
const links=[['Overview','/desktop'],['Plans','/desktop/pricing'],['Downloads','/desktop/download'],['Releases','/desktop/releases'],['Help','/desktop/help']];
---
<Layout {title} {description} {locale} canonicalPath={localizedPath(locale,path)} alternatePath={path} noIndex={sensitive} analytics={!sensitive} {sensitive}>
 <slot name="early-head" slot="early-head"/><Header {locale}/>
 <main id="main" data-prototype-info><nav class="subnav" aria-label="SoraFiles Desktop" data-testid="desktop-subnav"><div class="container subnav__inner"><span class="eyebrow subnav__title">SoraFiles Desktop</span><ul class="subnav__list">{links.map(([label,href])=><li><a class="subnav__link" href={localizedPath(locale,href)} aria-current={path===href?'page':undefined}>{t(label)}</a></li>)}</ul></div></nav><slot/></main>
 <Footer {locale}/>
</Layout>
