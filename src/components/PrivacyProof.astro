---
import PrivacyProofGrid from './PrivacyProofGrid.astro';
import ProcessFlow from './ProcessFlow.astro';
import { getLocaleContent } from '../i18n';
import type { LocalePath } from '../i18n/config';

interface Props {
  locale?: LocalePath;
}

const { locale = 'en' } = Astro.props;
const content = getLocaleContent(locale);
---

<PrivacyProofGrid proof={content.home.privacyProof} />
<ProcessFlow title={content.home.privacyTitle} steps={content.home.privacySteps} />
