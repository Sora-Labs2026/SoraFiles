---
import type { LiveTool } from '../data/liveTools';
import type { LocalizedToolCopy } from '../i18n/types';
import type { LocalePath } from '../i18n/config';
import { getWorkbenchMessages } from '../i18n/workbench';
import { getOcrMessages } from '../i18n/ocr';
import { getConversionFidelityMessages, getWatermarkPdfMessages } from '../i18n/documentTools';
import ToolIcon from './ToolIcon.astro';
import VisualPdfWorkspace from './VisualPdfWorkspace.astro';
import AdaptiveWorkspace from './AdaptiveWorkspace.astro';
import { liveText } from '../data/liveI18n';

interface Props {
  tool: LiveTool;
  locale?: LocalePath;
  copy?: LocalizedToolCopy;
}

const {
  tool,
  locale = 'en',
  copy = {
    title: tool.name,
    short: tool.tagline,
    description: tool.description,
    note: tool.description,
  } as LocalizedToolCopy,
} = Astro.props;

const m = getWorkbenchMessages(locale);
const t = (path: string) => liveText(locale, path);
const ocrMsg = getOcrMessages(locale);
const watermarkMsg = getWatermarkPdfMessages(locale);
const fidelityMsg = getConversionFidelityMessages(locale);

const tones = {
  indigo: 'bg-blue-soft text-blue',
  cyan: 'bg-cyan-soft text-cyan',
  violet: 'bg-violet-soft text-violet',
  coral: 'bg-coral-soft text-coral',
  pink: 'bg-pink-soft text-pink',
  green: 'bg-green-soft text-green',
};
const actionTones: Record<string, keyof typeof tones> = {
  'merge-pdf': 'violet', 'split-pdf': 'cyan', 'rotate-pdf': 'green', 'remove-pages': 'coral',
  'watermark-pdf': 'violet', 'page-numbers': 'cyan', 'sign-pdf': 'pink', 'jpg-to-pdf': 'pink',
  'pdf-to-jpg': 'coral', 'pdf-to-word': 'indigo', 'word-to-pdf': 'cyan',
};
const actionTone = actionTones[tool.id] ?? 'indigo';
const visualPdfTools = new Set(['merge-pdf', 'split-pdf', 'rotate-pdf', 'remove-pages', 'watermark-pdf', 'page-numbers', 'sign-pdf']);
const workspaceMode = visualPdfTools.has(tool.slug) || tool.slug === 'jpg-to-pdf' ? 'canvas' : 'preview';
const uploadCopy = { drop: liveText(locale, tool.multiple ? 'wb.dropMany' : 'wb.dropOne'), click: liveText(locale, 'wb.orClick') };
const englishActions: Record<string, string> = {
  'merge-pdf': 'Merge PDFs', 'split-pdf': 'Split PDF', 'rotate-pdf': 'Rotate pages',
  'remove-pages': 'Remove selected pages', 'watermark-pdf': 'Add watermark',
  'page-numbers': 'Add page numbers', 'sign-pdf': 'Add signature',
  'jpg-to-pdf': 'Create PDF', 'pdf-to-jpg': 'Convert pages',
  'pdf-to-word': 'Convert to Word', 'word-to-pdf': 'Convert to PDF',
};
const primaryAction = locale === 'en' ? (englishActions[tool.slug] ?? m.process) : m.process;
---
<section data-workbench id="document-tool" aria-labelledby="document-tool-heading" class="mx-auto max-w-5xl px-5 sm:px-6" data-tool={tool.slug} data-accept={tool.accept} data-multiple={String(tool.multiple)} data-localized={locale !== 'en' ? 'true' : 'false'} data-copy-note={copy.note} data-merge-minimum={t('wb.err.tooFew')} data-split-compact-warning={t('lim.compress')} data-locale={locale}>
  <div class="overflow-hidden rounded-card bg-surface shadow-card">
    <div class="border-b border-line px-5 py-4 sm:px-7"><div class="flex flex-wrap items-center justify-between gap-3"><div class="flex items-center gap-3"><span class:list={['flex h-10 w-10 items-center justify-center rounded-xl', tones[actionTone]]}><ToolIcon icon={tool.icon}/></span><div><p class="eyebrow text-xs font-semibold text-blue">{m.localFileTool}</p><h2 id="document-tool-heading" class="mt-1 text-lg font-semibold tracking-tight">{copy.title}</h2></div></div><div class="inline-flex items-center gap-2 rounded-full bg-green-soft px-3 py-1.5 text-xs font-medium text-green"><span class="h-2 w-2 rounded-full bg-green" aria-hidden="true"></span>{m.noUpload}</div></div></div>
    <div id="action-empty" class="p-4 sm:p-7">
      <div id="action-drop" class="sf-upload-dropzone group flex min-h-72 flex-col items-center justify-center px-5 py-12 text-center">
        <span class:list={['sf-upload-dropzone__icon flex h-14 w-14 items-center justify-center rounded-xl shadow-small', tones[actionTone]]}><ToolIcon icon={tool.icon}/></span>
        <h3 class="mt-5 text-xl font-semibold tracking-tight">{uploadCopy.drop}</h3>
        <p class="mt-2 max-w-md text-sm leading-6 text-muted">{copy.short} · {m.processedHere}</p>
        <button id="action-choose" type="button" class="mt-6 inline-flex min-h-12 items-center justify-center rounded-control bg-action px-6 text-sm font-medium text-action-contrast shadow-small transition-colors hover:bg-action-hover">{tool.multiple ? m.chooseFiles : m.chooseFile}</button>
        <p class="mt-3 text-xs text-muted">{uploadCopy.click}</p>
        <input id="action-input" name="sourceFiles" class="sr-only" tabindex="-1" type="file" accept={tool.accept} multiple={tool.multiple} aria-label={tool.multiple ? m.chooseFiles : m.chooseFile} aria-describedby="action-help action-error" />
        <p id="action-help" class="sr-only">{copy.description}</p>
        <p id="action-error" hidden role="alert" tabindex="-1" class="mt-4 max-w-lg break-words rounded-control bg-amber-soft px-4 py-3 text-sm leading-6 text-amber"></p>
      </div>
    </div>
    <AdaptiveWorkspace id="action-work" mode={workspaceMode} title={copy.title} resetTarget="#action-remove" class={`action-workspace${visualPdfTools.has(tool.slug) ? ' has-visual-pdf' : ''}${tool.slug === 'word-to-pdf' ? ' no-conversion-options' : ''}`}>
      <div data-workspace-source class="min-w-0 border-b border-line p-5 sm:p-7 lg:border-b-0 lg:border-r">
        <div data-workspace-filebar class="flex flex-wrap items-center justify-between gap-3"><div><p class="text-sm font-semibold">{tool.multiple ? m.selectedFiles : m.selectedFile}</p><p id="action-total" class="mt-1 text-xs text-muted"></p></div><div class="flex flex-wrap items-center gap-2">{tool.multiple && <button id="action-add" type="button" class="min-h-10 rounded-control border border-line bg-surface px-3 text-sm font-medium text-ink hover:border-line-strong">+ {m.chooseFiles}</button>}<button id="action-remove" type="button" class="min-h-10 rounded-control px-3 text-sm text-muted hover:bg-canvas hover:text-ink">{m.removeAll}</button></div></div>
        <ol id="action-file-list" class="mt-5 max-h-80 divide-y divide-line overflow-y-auto rounded-xl border border-line"></ol>
        {visualPdfTools.has(tool.slug) && <VisualPdfWorkspace tool={tool.slug}/>}
        {tool.slug === 'merge-pdf' && <p id="merge-minimum" class="mt-3 text-sm font-medium text-amber" aria-live="polite">{t('wb.err.tooFew')}</p>}
      </div>
      <form data-workspace-inspector data-workbench-controls id="action-form" class="min-w-0 overflow-y-auto p-5 sm:p-7">
        {tool.slug === 'rotate-pdf' && <div class="rounded-control bg-green-soft px-4 py-3 text-sm leading-6 text-green"><strong class="block">Rotate without changing page quality</strong><span class="mt-1 block text-xs">Select pages in the workspace, then rotate them left or right. Text, images, links, and page size stay intact.</span></div>}
        {tool.slug === 'split-pdf' && <div class="space-y-4"><div class="rounded-control bg-green-soft px-4 py-3 text-sm leading-6 text-green"><strong class="block">Choose exactly which pages you need</strong><span class="mt-1 block text-xs">Text, images, links, forms, and page sizes stay intact in the new PDFs.</span></div><label class="block text-sm font-semibold">Split mode<select id="split-mode" class="mt-2 min-h-12 w-full rounded-control border border-line bg-surface px-3 text-sm text-ink"><option value="separate" selected>Every selected page · separate PDFs</option><option value="selected">Selected pages · one PDF</option><option value="groups">Custom groups · separate PDFs</option><option value="every">Every N pages</option><option value="odd-even">Odd and even pages</option></select></label><label data-split-option="groups" hidden class="block text-sm font-semibold">Custom groups<input id="split-groups" type="text" inputmode="text" autocomplete="off" placeholder="1-3; 4-6,9; 10-12" class="mt-2 min-h-12 w-full rounded-control border border-line bg-surface px-3 text-sm text-ink"/><span class="mt-1.5 block text-xs font-normal leading-5 text-muted">Separate groups with semicolons. Each group becomes one PDF.</span></label><label data-split-option="every" hidden class="block text-sm font-semibold">Pages per file<input id="split-every" type="number" min="1" max="100" value="5" inputmode="numeric" class="mt-2 min-h-12 w-full rounded-control border border-line bg-surface px-3 text-sm text-ink"/></label></div>}
        {tool.slug === 'remove-pages' && <div><label for="remove-page-spec" class="text-sm font-semibold">{t('opt.pages')}</label><input id="remove-page-spec" name="removePageSpec" type="text" inputmode="text" autocomplete="off" placeholder={t('opt.pagesHint')} class="mt-2 min-h-12 w-full rounded-control border border-line bg-surface px-3 text-sm text-ink"/><p class="mt-2 text-xs leading-5 text-muted">{t('opt.pagesHint')}</p></div>}
        {tool.slug === 'watermark-pdf' && <div class="space-y-5">
          <fieldset><legend class="text-sm font-semibold">{watermarkMsg.watermarkType}</legend><div class="mt-3 grid grid-cols-2 rounded-control bg-canvas p-1 text-sm"><button type="button" data-watermark-mode="text" aria-pressed="true" class="min-h-11 rounded-md bg-surface px-3 font-medium text-ink shadow-small hover:text-blue-strong focus-visible:ring-2 focus-visible:ring-blue">{watermarkMsg.text}</button><button type="button" data-watermark-mode="image" aria-pressed="false" class="min-h-11 rounded-md px-3 font-medium text-muted hover:text-ink focus-visible:ring-2 focus-visible:ring-blue">{watermarkMsg.image}</button></div></fieldset>
          <div data-watermark-panel="text"><label for="watermark-text" class="text-sm font-semibold">{t('opt.text')}</label><input id="watermark-text" name="watermarkText" type="text" autocomplete="off" maxlength="60" placeholder={t('opt.text')} class="mt-2 min-h-12 w-full rounded-control border border-line bg-surface px-3 text-sm text-ink"/><div class="mt-4 grid grid-cols-2 gap-3"><label class="text-xs font-medium text-muted">Font size<input id="watermark-font-size" type="number" min="8" max="160" value="42" class="mt-1 min-h-11 w-full rounded-control border border-line bg-surface px-3 text-sm text-ink"/></label><label class="text-xs font-medium text-muted">Color<input id="watermark-color" type="color" value="#404a6b" class="mt-1 min-h-11 w-full rounded-control border border-line bg-surface p-1"/></label></div></div>
          <div data-watermark-panel="image" hidden>
            <label for="watermark-image" class="text-sm font-semibold">{watermarkMsg.uploadImage}</label>
            <input id="watermark-image" name="watermarkImage" type="file" accept="image/png,image/jpeg,image/webp,.png,.jpg,.jpeg,.webp" class="mt-2 block min-h-12 w-full rounded-control border border-line bg-surface p-2 text-sm file:mr-3 file:rounded-md file:border-0 file:bg-violet-soft file:px-3 file:py-2 file:font-medium file:text-violet hover:border-line-strong focus-visible:ring-2 focus-visible:ring-blue"/>
            <p class="mt-2 text-xs leading-5 text-muted">{watermarkMsg.imageHelp}</p>
            <fieldset id="watermark-image-options" hidden class="mt-4"><legend class="text-sm font-semibold">{watermarkMsg.imageTreatment}</legend><div class="mt-3 grid gap-2 sm:grid-cols-2">
              <label class="flex cursor-pointer items-start gap-3 rounded-control border border-line bg-surface p-3 hover:border-line-strong has-[:checked]:border-violet has-[:checked]:bg-violet-soft"><input type="radio" name="watermarkImageTreatment" value="as-is" checked class="mt-1 accent-violet"/><span><span class="block text-sm font-medium">{watermarkMsg.useAsIs}</span><span class="mt-1 block text-xs leading-5 text-muted">{watermarkMsg.useAsIsHelp}</span></span></label>
              <label class="flex cursor-pointer items-start gap-3 rounded-control border border-line bg-surface p-3 hover:border-line-strong has-[:checked]:border-violet has-[:checked]:bg-violet-soft"><input type="radio" name="watermarkImageTreatment" value="remove" class="mt-1 accent-violet"/><span><span class="block text-sm font-medium">{watermarkMsg.removeBackground}</span><span class="mt-1 block text-xs leading-5 text-muted">{watermarkMsg.removeBackgroundHelp}</span></span></label>
            </div></fieldset>
            <div id="watermark-cleanup-controls" hidden class="mt-4"><div class="flex items-center justify-between gap-3"><label for="watermark-cleanup" class="text-xs font-medium text-muted">{watermarkMsg.cleanupStrength}</label><output id="watermark-cleanup-output" for="watermark-cleanup" class="font-mono text-xs font-medium text-muted">32%</output></div><input id="watermark-cleanup" name="watermarkCleanup" type="range" min="8" max="72" value="32" aria-valuetext="32%" class="mt-2 w-full accent-violet"/></div>
            <div id="watermark-image-preview" hidden class="mt-4 grid grid-cols-2 gap-2"><figure class="min-w-0 overflow-hidden rounded-control border border-line bg-surface"><div class="grid h-28 place-items-center bg-[linear-gradient(45deg,var(--color-canvas)_25%,transparent_25%),linear-gradient(-45deg,var(--color-canvas)_25%,transparent_25%),linear-gradient(45deg,transparent_75%,var(--color-canvas)_75%),linear-gradient(-45deg,transparent_75%,var(--color-canvas)_75%)] bg-[length:16px_16px] bg-[position:0_0,0_8px,8px_-8px,-8px_0]"><img id="watermark-image-before" alt={watermarkMsg.beforeAlt} width="320" height="112" class="h-28 w-full object-contain"/></div><figcaption class="border-t border-line px-2 py-1.5 text-xs text-muted">{watermarkMsg.before}</figcaption></figure><figure class="min-w-0 overflow-hidden rounded-control border border-line bg-surface"><div class="grid h-28 place-items-center bg-[linear-gradient(45deg,var(--color-canvas)_25%,transparent_25%),linear-gradient(-45deg,var(--color-canvas)_25%,transparent_25%),linear-gradient(45deg,transparent_75%,var(--color-canvas)_75%),linear-gradient(-45deg,transparent_75%,var(--color-canvas)_75%)] bg-[length:16px_16px] bg-[position:0_0,0_8px,8px_-8px,-8px_0]"><img id="watermark-image-after" alt={watermarkMsg.afterAlt} width="320" height="112" class="h-28 w-full object-contain"/></div><figcaption class="border-t border-line px-2 py-1.5 text-xs text-muted">{watermarkMsg.after}</figcaption></figure></div>
            <label class="mt-4 block text-xs font-medium text-muted">Logo size<output id="watermark-scale-output" for="watermark-scale" class="float-right font-mono">40%</output><input id="watermark-scale" type="range" min="10" max="90" value="40" class="mt-2 w-full accent-violet"/></label>
          </div>
          <div class="grid gap-4 sm:grid-cols-2"><label class="text-xs font-medium text-muted">Position<select id="watermark-position" class="mt-1 min-h-11 w-full rounded-control border border-line bg-surface px-3 text-sm text-ink"><option value="center">Center</option><option value="top-left">Top left</option><option value="top-center">Top center</option><option value="top-right">Top right</option><option value="bottom-left">Bottom left</option><option value="bottom-center">Bottom center</option><option value="bottom-right">Bottom right</option></select></label><label class="text-xs font-medium text-muted">Rotation<input id="watermark-rotation" type="number" min="-180" max="180" value="35" class="mt-1 min-h-11 w-full rounded-control border border-line bg-surface px-3 text-sm text-ink"/></label></div>
          <div><div class="flex items-center justify-between gap-4"><label for="watermark-opacity" class="text-sm font-semibold">{t('opt.opacity')}</label><output id="watermark-opacity-output" for="watermark-opacity" class="font-mono text-sm">20%</output></div><input id="watermark-opacity" name="watermarkOpacity" type="range" min="5" max="80" step="5" value="20" aria-valuetext="20%" class="mt-3 w-full accent-ink"/></div>
          <label class="flex min-h-11 cursor-pointer items-center gap-3 rounded-control border border-line bg-surface px-3 text-sm font-medium"><input id="watermark-tiled" type="checkbox" class="h-4 w-4 accent-violet"/> Repeat across each selected page</label>
        </div>}
        {tool.slug === 'page-numbers' && <div class="grid gap-5 sm:grid-cols-2"><div><label for="page-number-format" class="text-sm font-semibold">Format</label><select id="page-number-format" class="mt-2 min-h-12 w-full rounded-control border border-line bg-surface px-3 text-sm text-ink"><option value="number">1</option><option value="page">Page 1</option><option value="total">Page 1 of N</option><option value="roman">Roman numerals</option></select></div><div><label for="page-number-start" class="text-sm font-semibold">Start number</label><input id="page-number-start" name="pageNumberStart" type="number" inputmode="numeric" min="1" max="999999" value="1" class="mt-2 min-h-12 w-full rounded-control border border-line bg-surface px-3 text-sm text-ink"/></div><div><label for="page-number-skip" class="text-sm font-semibold">Skip first pages</label><input id="page-number-skip" type="number" inputmode="numeric" min="0" max="9999" value="0" class="mt-2 min-h-12 w-full rounded-control border border-line bg-surface px-3 text-sm text-ink"/></div><div><label for="page-number-position" class="text-sm font-semibold">{t('opt.position')}</label><select id="page-number-position" name="pageNumberPosition" class="mt-2 min-h-12 w-full rounded-control border border-line bg-surface px-3 text-sm text-ink"><option value="bottom-left">{t('optval.bottom-left')}</option><option value="bottom-center" selected>{t('optval.bottom-center')}</option><option value="bottom-right">{t('optval.bottom-right')}</option><option value="top-left">{t('optval.top-left')}</option><option value="top-center">{t('optval.top-center')}</option><option value="top-right">{t('optval.top-right')}</option></select></div><div><label for="page-number-size" class="text-sm font-semibold">Font size</label><input id="page-number-size" type="number" min="6" max="72" value="10" class="mt-2 min-h-12 w-full rounded-control border border-line bg-surface px-3 text-sm text-ink"/></div><div><label for="page-number-margin" class="text-sm font-semibold">Margin</label><div class="mt-2 flex items-center rounded-control border border-line bg-surface"><input id="page-number-margin" type="number" min="4" max="144" value="24" class="min-h-12 min-w-0 flex-1 rounded-control bg-transparent px-3 text-sm text-ink"/><span class="pr-3 text-xs text-muted">pt</span></div></div><label class="sm:col-span-2"><span class="text-sm font-semibold">Color</span><input id="page-number-color" type="color" value="#333b52" class="mt-2 min-h-11 w-full rounded-control border border-line bg-surface p-1"/></label></div>}
        {tool.slug === 'sign-pdf' && <div>
          <fieldset><legend class="text-sm font-semibold">{t('opt.signature')}</legend><div class="mt-3 grid grid-cols-3 rounded-control bg-canvas p-1 text-sm"><button type="button" data-sign-mode="type" aria-pressed="true" class="min-h-10 rounded-md bg-surface px-2 font-medium text-ink shadow-small">Type</button><button type="button" data-sign-mode="draw" aria-pressed="false" class="min-h-10 rounded-md px-2 font-medium text-muted">Draw</button><button type="button" data-sign-mode="upload" aria-pressed="false" class="min-h-10 rounded-md px-2 font-medium text-muted">Upload</button></div></fieldset>
          <div data-sign-panel="type" class="mt-4"><div class="grid gap-3 sm:grid-cols-[.8fr_1.2fr]"><label class="text-sm font-semibold">Field type<select id="signature-kind" class="mt-2 min-h-12 w-full rounded-control border border-line bg-surface px-3 text-sm text-ink"><option value="signature">Signature</option><option value="initials">Initials</option><option value="date">Date</option><option value="text">Text</option><option value="check">Checkmark</option></select></label><label for="signature-text" class="text-sm font-semibold">Text<input id="signature-text" name="signatureText" type="text" autocomplete="off" maxlength="80" class="mt-2 min-h-12 w-full rounded-control border border-line bg-surface px-3 text-sm text-ink"/></label></div></div>
          <div data-sign-panel="draw" hidden class="mt-4"><p class="text-sm font-semibold">Draw your signature</p><canvas id="signature-draw-canvas" width="720" height="240" class="mt-2 h-32 w-full touch-none select-none rounded-control border border-line bg-white [-webkit-user-select:none]" aria-label="Draw your signature"></canvas></div>
          <div data-sign-panel="upload" hidden class="mt-4"><label for="signature-upload" class="text-sm font-semibold">Upload a signature image</label><input id="signature-upload" type="file" accept="image/png,image/jpeg,image/webp,.png,.jpg,.jpeg,.webp" class="mt-2 block min-h-12 w-full rounded-control border border-line bg-surface p-2 text-sm"/><div id="signature-upload-controls" hidden class="mt-3"><div class="flex items-center justify-between gap-3"><label for="signature-cleanup" class="text-xs font-medium text-muted">Background cleanup</label><output id="signature-cleanup-output" for="signature-cleanup" class="text-xs font-medium text-muted">32%</output></div><input id="signature-cleanup" type="range" min="8" max="72" value="32" class="mt-2 w-full accent-blue"/><div class="mt-3 grid grid-cols-2 gap-2"><figure class="overflow-hidden rounded-lg border border-line bg-white"><img id="signature-upload-before" alt="Uploaded signature before background cleanup" class="h-24 w-full object-contain"/><figcaption class="border-t border-line px-2 py-1 text-[10px] text-muted">Before</figcaption></figure><figure class="overflow-hidden rounded-lg border border-line bg-white"><img id="signature-upload-after" alt="Signature after background cleanup" class="h-24 w-full object-contain"/><figcaption class="border-t border-line px-2 py-1 text-[10px] text-muted">After</figcaption></figure></div></div></div>
          <canvas id="signature-canvas" width="720" height="240" hidden aria-hidden="true"></canvas>
          <div class="mt-3 flex flex-wrap items-center justify-end gap-2"><button id="signature-save" type="button" class="min-h-10 shrink-0 rounded-control border border-line px-3 text-sm font-medium text-ink hover:border-blue">Save on this device</button><button id="signature-clear-saved" type="button" class="min-h-10 shrink-0 rounded-control border border-line px-3 text-sm text-muted hover:bg-canvas hover:text-ink">Clear saved signature</button><button id="signature-clear" type="button" class="min-h-10 shrink-0 rounded-control border border-line px-3 text-sm text-muted hover:bg-canvas hover:text-ink">{t('opt.clear')}</button></div>
          <div id="signature-object-controls" hidden class="mt-5"><div class="flex items-center justify-between gap-3"><label for="signature-size" class="text-xs font-medium text-muted">Selected signature size</label><output id="signature-size-output" for="signature-size" class="font-mono text-xs text-muted">30%</output></div><input id="signature-size" type="range" min="15" max="55" value="30" class="mt-2 w-full accent-blue"/><div class="mt-3 grid grid-cols-2 gap-2"><button id="signature-duplicate" type="button" class="min-h-11 rounded-control bg-canvas px-3 text-sm font-medium text-ink hover:bg-blue-soft">Duplicate</button><button id="signature-delete" type="button" class="min-h-11 rounded-control bg-coral-soft px-3 text-sm font-medium text-coral hover:opacity-80">Delete</button></div></div>
          <p id="signature-help" class="mt-4 rounded-control bg-blue-soft px-4 py-3 text-xs leading-5 text-blue-strong">This adds a visible signature mark. It does not add a verified digital certificate.</p>
        </div>}
        {tool.slug === 'jpg-to-pdf' && <div class="grid gap-5 sm:grid-cols-2"><div><label for="image-page-size" class="text-sm font-semibold">{m.pageSize}</label><select id="image-page-size" name="imagePageSize" class="mt-2 min-h-12 w-full rounded-control border border-line bg-surface px-3 text-sm text-ink"><option value="image">Auto · image size</option><option value="a4" selected>A4</option><option value="letter">Letter</option></select></div><div><label for="image-orientation" class="text-sm font-semibold">Orientation</label><select id="image-orientation" class="mt-2 min-h-12 w-full rounded-control border border-line bg-surface px-3 text-sm text-ink"><option value="auto">Auto</option><option value="portrait">Portrait</option><option value="landscape">Landscape</option></select></div><div><label for="image-margin" class="text-sm font-semibold">Margins</label><select id="image-margin" class="mt-2 min-h-12 w-full rounded-control border border-line bg-surface px-3 text-sm text-ink"><option value="0">None</option><option value="18">Small</option><option value="36" selected>Medium</option><option value="72">Large</option></select></div><div><label for="image-fit" class="text-sm font-semibold">Image fit</label><select id="image-fit" class="mt-2 min-h-12 w-full rounded-control border border-line bg-surface px-3 text-sm text-ink"><option value="fit" selected>Fit</option><option value="fill">Fill · crop edges</option><option value="actual">Actual / Auto</option></select></div></div>}
        {tool.slug === 'pdf-to-jpg' && <div class="grid gap-5 sm:grid-cols-2"><div><label for="jpg-resolution" class="text-sm font-semibold">Resolution</label><select id="jpg-resolution" name="jpgResolution" class="mt-2 min-h-12 w-full rounded-control border border-line bg-surface px-3 text-sm text-ink"><option value="1.5">108 DPI</option><option value="2" selected>144 DPI</option><option value="2.5">180 DPI</option><option value="3">216 DPI</option></select></div><div><label for="pdf-image-format" class="text-sm font-semibold">{m.outputFormat}</label><select id="pdf-image-format" class="mt-2 min-h-12 w-full rounded-control border border-line bg-surface px-3 text-sm text-ink"><option value="jpg" selected>JPG</option><option value="png">PNG</option><option value="webp">WebP</option></select></div><div class="sm:col-span-2"><label for="pdf-image-pages" class="text-sm font-semibold">Pages</label><input id="pdf-image-pages" type="text" inputmode="text" autocomplete="off" placeholder="All pages, or 1-3,7" class="mt-2 min-h-12 w-full rounded-control border border-line bg-surface px-3 text-sm text-ink"/></div><div id="pdf-image-quality-wrap" class="sm:col-span-2"><div class="flex items-center justify-between"><label for="pdf-image-quality" class="text-sm font-semibold">JPG / WebP quality</label><output id="pdf-image-quality-output" for="pdf-image-quality" class="font-mono text-sm">88%</output></div><input id="pdf-image-quality" type="range" min="40" max="100" value="88" class="mt-3 w-full accent-coral"/></div></div>}
        {tool.slug === 'pdf-to-word' && <fieldset><legend class="text-sm font-semibold">Word result</legend><div class="mt-3 grid gap-3 sm:grid-cols-2">
          <label class="flex cursor-pointer items-start gap-3 rounded-control border border-line bg-surface p-4 has-[:checked]:border-blue has-[:checked]:bg-blue-soft"><input type="radio" name="pdfWordMode" value="editable" checked class="mt-1 accent-blue"/><span><strong class="block text-sm">Editable Word document</strong><span class="mt-1 block text-xs leading-5 text-muted">Turns selectable PDF text into editable paragraphs, headings, lists, simple tables, and page breaks. {ocrMsg.automaticFallback} Complex columns and spacing may need cleanup.</span></span></label>
          <label class="flex cursor-pointer items-start gap-3 rounded-control border border-line bg-surface p-4 has-[:checked]:border-violet has-[:checked]:bg-violet-soft"><input type="radio" name="pdfWordMode" value="visual" class="mt-1 accent-violet"/><span><strong class="block text-sm">Keep the page appearance</strong><span class="mt-1 block text-xs leading-5 text-muted">Keeps each page looking the same, but the text will not be editable in Word.</span></span></label>
        </div></fieldset>}
        {tool.slug !== 'sign-pdf' && tool.slug !== 'pdf-to-word' && tool.slug !== 'word-to-pdf' && <div id="action-tool-note" class="mt-5 rounded-control bg-blue-soft px-4 py-3 text-sm leading-6 text-blue-strong">{copy.note}</div>}
        <button id="action-process" type="submit" class="mt-6 inline-flex min-h-12 w-full items-center justify-center rounded-control bg-action px-5 text-sm font-medium text-action-contrast transition-colors hover:bg-action-hover disabled:cursor-wait disabled:opacity-50">{primaryAction}</button>
        {(tool.slug === 'pdf-to-word' || tool.slug === 'word-to-pdf') && <button id="ocr-cancel" type="button" hidden class="mt-3 inline-flex min-h-10 w-full items-center justify-center rounded-control border border-line bg-canvas text-sm font-medium text-ink hover:bg-surface">{ocrMsg.cancel}</button>}
        <p data-workbench-status id="action-status" class="mt-3 min-h-5 text-center text-xs text-muted" aria-live="polite"></p>
      </form>
    </AdaptiveWorkspace>
    <div data-workbench-result id="action-result" hidden class="border-t border-line bg-canvas p-5 sm:p-7"><div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-center"><div><p class="text-sm font-semibold text-green">{m.ready}</p><p id="action-result-stats" class="mt-2 text-sm text-muted"></p></div><a id="action-download" class="inline-flex min-h-12 items-center justify-center rounded-control bg-blue px-6 text-sm font-medium text-white hover:bg-blue-strong">{m.download}</a></div><p id="action-result-warning" hidden role="status" class="mt-4 rounded-control bg-amber-soft px-4 py-3 text-sm leading-6 text-amber"></p></div>
  </div>
</section>

