    overlay.addEventListener('pointerdown', event => { if (!signatureHasInk) return; event.preventDefault(); moving = true; overlay.setPointerCapture(event.pointerId); const rect = overlay.getBoundingClientRect(); offsetX = event.clientX - rect.left; offsetY = event.clientY - rect.top; });
    overlay.addEventListener('pointermove', event => { if (!moving) return; event.preventDefault(); const stage = actionEl('#signature-page-stage'); const stageRect = stage.getBoundingClientRect(); const overlayRect = overlay.getBoundingClientRect(); const left = Math.max(0, Math.min(stageRect.width - overlayRect.width, event.clientX - stageRect.left - offsetX)); const top = Math.max(0, Math.min(stageRect.height - overlayRect.height, event.clientY - stageRect.top - offsetY)); overlay.style.left = `${(left / stageRect.width) * 100}%`; overlay.style.top = `${(top / stageRect.height) * 100}%`; });
    const stopMove = (event: PointerEvent) => { if (!moving) return; event.preventDefault(); moving = false; };
    overlay.addEventListener('pointerup', stopMove); overlay.addEventListener('pointercancel', stopMove);
  }
  let appendSelection = false;
  actionEl<HTMLButtonElement>('#action-choose').addEventListener('click', () => { appendSelection = false; actionInput.click(); });
  actionRoot.querySelector<HTMLButtonElement>('#action-add')?.addEventListener('click', () => { appendSelection = true; actionInput.click(); });
  actionInput.addEventListener('change', () => void loadActionFiles(Array.from(actionInput.files ?? []), appendSelection)); actionEl<HTMLButtonElement>('#action-remove').addEventListener('click', resetAction); actionForm.addEventListener('submit', event => { event.preventDefault(); void processAction(); });
  const actionDrop = actionEl('#action-drop'); for (const eventName of ['dragenter','dragover']) actionDrop.addEventListener(eventName, event => { event.preventDefault(); actionDrop.classList.add('border-blue','bg-blue-soft','select-none'); }); for (const eventName of ['dragleave','drop']) actionDrop.addEventListener(eventName, event => { event.preventDefault(); actionDrop.classList.remove('border-blue','bg-blue-soft','select-none'); }); actionDrop.addEventListener('drop', event => { const files = Array.from(event.dataTransfer?.files ?? []); if (files.length) void loadActionFiles(files, actionFiles.length > 0); }); window.addEventListener('beforeunload', clearActionUrl);
</script>
