---
import type { LiveTool } from '../data/liveTools';
import type { LocalizedToolCopy } from '../i18n/types';
import type { LocalePath } from '../i18n/config';
import { getWorkbenchMessages } from '../i18n/workbench';
import { OCR_LANGUAGE_OPTIONS, OCR_LANGUAGE_BY_LOCALE } from '../lib/ocr/languages';
import { getOcrMessages } from '../i18n/ocr';
import ToolIcon from './ToolIcon.astro';
import { liveText } from '../data/liveI18n';

interface Props {
  tool: LiveTool;
  locale?: LocalePath;
  copy?: LocalizedToolCopy;
}

const {
  tool,
  locale = 'en',
  copy = {
    title: tool.name,
    short: tool.tagline,
    description: tool.description,
    note: tool.description,
  } as LocalizedToolCopy,
} = Astro.props;

const m = getWorkbenchMessages(locale);
const t = (path: string) => liveText(locale, path);
const ocrMsg = getOcrMessages(locale);
const defaultOcrCode = OCR_LANGUAGE_BY_LOCALE[locale] ?? 'eng';

const tones = {
  indigo: 'bg-blue-soft text-blue',
  cyan: 'bg-cyan-soft text-cyan',
  violet: 'bg-violet-soft text-violet',
  coral: 'bg-coral-soft text-coral',
  pink: 'bg-pink-soft text-pink',
  green: 'bg-green-soft text-green',
};
const actionTones: Record<string, keyof typeof tones> = {
  'merge-pdf': 'violet', 'split-pdf': 'cyan', 'rotate-pdf': 'green', 'remove-pages': 'coral',
  'watermark-pdf': 'violet', 'page-numbers': 'cyan', 'sign-pdf': 'pink', 'jpg-to-pdf': 'pink',
  'pdf-to-jpg': 'coral', 'pdf-to-word': 'indigo', 'word-to-pdf': 'cyan',
};
const actionTone = actionTones[tool.id] ?? 'indigo';
---
<section data-workbench id="document-tool" aria-labelledby="document-tool-heading" class="mx-auto max-w-5xl px-5 sm:px-6" data-tool={tool.slug} data-accept={tool.accept} data-multiple={String(tool.multiple)} data-localized={locale !== 'en' ? 'true' : 'false'} data-copy-note={copy.note} data-locale={locale}>
  <div class="overflow-hidden rounded-card bg-surface shadow-card">
    <div class="border-b border-line px-5 py-4 sm:px-7"><div class="flex flex-wrap items-center justify-between gap-3"><div class="flex items-center gap-3"><span class:list={['flex h-10 w-10 items-center justify-center rounded-xl', tones[actionTone]]}><ToolIcon icon={tool.icon}/></span><div><p class="eyebrow text-xs font-semibold text-blue">{m.localFileTool}</p><h2 id="document-tool-heading" class="mt-1 text-lg font-semibold tracking-tight">{copy.title}</h2></div></div><div class="inline-flex items-center gap-2 rounded-full bg-green-soft px-3 py-1.5 text-xs font-medium text-green"><span class="h-2 w-2 rounded-full bg-green" aria-hidden="true"></span>{m.noUpload}</div></div></div>
    <div id="action-empty" class="p-4 sm:p-7">
      <div id="action-drop" class="group flex min-h-72 flex-col items-center justify-center rounded-xl border border-dashed border-line-strong bg-canvas px-5 py-12 text-center transition-colors hover:border-blue/60 hover:bg-surface">
        <span class:list={['flex h-14 w-14 items-center justify-center rounded-xl shadow-small', tones[actionTone]]}><ToolIcon icon={tool.icon}/></span>
        <h3 class="mt-5 text-xl font-semibold tracking-tight">{tool.multiple ? m.chooseFiles : m.chooseFile}</h3>
        <p class="mt-2 max-w-md text-sm leading-6 text-muted">{copy.short} · {m.processedHere}</p>
        <button id="action-choose" type="button" class="mt-6 inline-flex min-h-12 items-center justify-center rounded-control bg-action px-6 text-sm font-medium text-action-contrast shadow-small transition-colors hover:bg-action-hover">{tool.multiple ? m.chooseFiles : m.chooseFile}</button>
        <input id="action-input" name="sourceFiles" class="sr-only" tabindex="-1" type="file" accept={tool.accept} multiple={tool.multiple} aria-label={tool.multiple ? m.chooseFiles : m.chooseFile} aria-describedby="action-help action-error" />
        <p id="action-help" class="sr-only">{copy.description}</p>
        <p id="action-error" hidden role="alert" tabindex="-1" class="mt-4 max-w-lg break-words rounded-control bg-amber-soft px-4 py-3 text-sm leading-6 text-amber"></p>
      </div>
    </div>
    <div id="action-work" hidden class="grid min-w-0 lg:grid-cols-[1fr_0.85fr]">
      <div class="min-w-0 border-b border-line p-5 sm:p-7 lg:border-b-0 lg:border-r">
        <div class="flex items-center justify-between gap-4"><div><p class="text-sm font-semibold">{tool.multiple ? m.selectedFiles : m.selectedFile}</p><p id="action-total" class="mt-1 text-xs text-muted"></p></div><button id="action-remove" type="button" class="min-h-10 rounded-control px-3 text-sm text-muted hover:bg-canvas hover:text-ink">{m.removeAll}</button></div>
        <ol id="action-file-list" class="mt-5 max-h-80 divide-y divide-line overflow-y-auto rounded-xl border border-line"></ol>
      </div>
      <form data-workbench-controls id="action-form" class="min-w-0 p-5 sm:p-7">
        {tool.slug === 'pdf-to-word' && (
          <div id="ocr-options" class="mb-5 rounded-control border border-line p-4">
            <label for="ocr-language" class="text-sm font-semibold">{ocrMsg.languageLabel}</label>
            <select id="ocr-language" name="ocrLanguage" class="mt-2 min-h-12 w-full rounded-control border border-line bg-surface px-3 text-sm text-ink">
              {OCR_LANGUAGE_OPTIONS.map((opt) => (
                <option value={opt.code} selected={opt.code === defaultOcrCode}>
                  {opt.nativeName} ({opt.code})
                </option>
              ))}
            </select>
            <p class="mt-2 text-xs text-muted">{ocrMsg.languageHelp}</p>
          </div>
        )}
        {tool.slug === 'rotate-pdf' && <div><label for="rotate-angle" class="text-sm font-semibold">{m.rotation}</label><select id="rotate-angle" name="rotateAngle" class="mt-2 min-h-12 w-full rounded-control border border-line bg-surface px-3 text-sm text-ink"><option value="90">90°</option><option value="180">180°</option><option value="270">270°</option></select></div>}
        {tool.slug === 'remove-pages' && <div><label for="remove-page-spec" class="text-sm font-semibold">{t('opt.pages')}</label><input id="remove-page-spec" name="removePageSpec" type="text" inputmode="numeric" autocomplete="off" placeholder={t('opt.pagesHint')} class="mt-2 min-h-12 w-full rounded-control border border-line bg-surface px-3 text-sm text-ink"/><p class="mt-2 text-xs leading-5 text-muted">{t('opt.pagesHint')}</p></div>}
        {tool.slug === 'watermark-pdf' && <div class="space-y-5"><div><label for="watermark-text" class="text-sm font-semibold">{t('opt.text')}</label><input id="watermark-text" name="watermarkText" type="text" autocomplete="off" maxlength="60" placeholder={t('opt.text')} class="mt-2 min-h-12 w-full rounded-control border border-line bg-surface px-3 text-sm text-ink"/></div><div><div class="flex items-center justify-between gap-4"><label for="watermark-opacity" class="text-sm font-semibold">{t('opt.opacity')}</label><output id="watermark-opacity-output" for="watermark-opacity" class="font-mono text-sm">20%</output></div><input id="watermark-opacity" name="watermarkOpacity" type="range" min="5" max="50" step="5" value="20" aria-valuetext="20%" class="mt-3 w-full accent-ink"/></div></div>}
        {tool.slug === 'page-numbers' && <div class="grid gap-5 sm:grid-cols-2"><div><label for="page-number-position" class="text-sm font-semibold">{t('opt.position')}</label><select id="page-number-position" name="pageNumberPosition" class="mt-2 min-h-12 w-full rounded-control border border-line bg-surface px-3 text-sm text-ink"><option value="bottom-center">{t('optval.bottom-center')}</option><option value="bottom-right">{t('optval.bottom-right')}</option><option value="top-center">{t('optval.top-center')}</option><option value="top-right">{t('optval.top-right')}</option></select></div><div><label for="page-number-start" class="text-sm font-semibold">{t('opt.page')}</label><input id="page-number-start" name="pageNumberStart" type="number" inputmode="numeric" min="1" max="999999" value="1" class="mt-2 min-h-12 w-full rounded-control border border-line bg-surface px-3 text-sm text-ink"/></div></div>}
        {tool.slug === 'sign-pdf' && <div><label for="signature-text" class="text-sm font-semibold">{t('opt.signature')} — {t('opt.text')}</label><input id="signature-text" name="signatureText" type="text" autocomplete="off" maxlength="80" aria-describedby="signature-help" class="mt-2 min-h-12 w-full rounded-control border border-line bg-surface px-3 text-sm text-ink"/><p id="signature-help" class="mt-2 text-xs leading-5 text-muted">{t('lim.sign')}</p><canvas id="signature-canvas" width="720" height="240" role="img" class="mt-3 h-32 w-full touch-none rounded-control border border-line bg-white" aria-label={t('opt.signature')}>{t('lim.sign')}</canvas><div class="mt-2 flex items-center justify-end"><button id="signature-clear" type="button" class="min-h-10 shrink-0 rounded-control border border-line px-3 text-sm text-muted hover:bg-canvas hover:text-ink">{t('opt.clear')}</button></div><label for="signature-scope" class="mt-5 block text-sm font-semibold">{t('opt.page')}</label><select id="signature-scope" name="signatureScope" class="mt-2 min-h-12 w-full rounded-control border border-line bg-surface px-3 text-sm text-ink"><option value="last">{t('optval.last')}</option><option value="first">{t('optval.first')}</option><option value="all">{t('optval.all')}</option></select></div>}
        {tool.slug === 'jpg-to-pdf' && <div><label for="image-page-size" class="text-sm font-semibold">{m.pageSize}</label><select id="image-page-size" name="imagePageSize" class="mt-2 min-h-12 w-full rounded-control border border-line bg-surface px-3 text-sm text-ink"><option value="a4">A4</option><option value="image">{m.original}</option></select></div>}
        {tool.slug === 'pdf-to-jpg' && <div><label for="jpg-resolution" class="text-sm font-semibold">{m.imageQuality}</label><select id="jpg-resolution" name="jpgResolution" class="mt-2 min-h-12 w-full rounded-control border border-line bg-surface px-3 text-sm text-ink"><option value="1.5">108 DPI</option><option value="2" selected>144 DPI</option><option value="2.5">180 DPI</option></select></div>}
        <div class="rounded-control bg-blue-soft px-4 py-3 text-sm leading-6 text-blue-strong" class:list={[tool.slug !== 'merge-pdf' && tool.slug !== 'split-pdf' && tool.slug !== 'pdf-to-word' && tool.slug !== 'word-to-pdf' ? 'mt-5' : '']}>
          {tool.slug === 'pdf-to-word' ? ocrMsg.layoutWarning : copy.note}
        </div>
        {(tool.slug === 'pdf-to-word' || tool.slug === 'word-to-pdf') && <label class="mt-5 flex cursor-pointer items-start gap-3 text-sm leading-6"><input id="fidelity-confirm" name="fidelityConfirm" type="checkbox" class="mt-1.5 accent-blue"/><span>{m.confirmLimitation}</span></label>}
        <button id="action-process" type="submit" class="mt-6 inline-flex min-h-12 w-full items-center justify-center rounded-control bg-action px-5 text-sm font-medium text-action-contrast transition-colors hover:bg-action-hover disabled:cursor-wait disabled:opacity-50">{m.process}</button>
        {tool.slug === 'pdf-to-word' && <button id="ocr-cancel" type="button" hidden class="mt-3 inline-flex min-h-10 w-full items-center justify-center rounded-control border border-line bg-canvas text-sm font-medium text-ink hover:bg-surface">{ocrMsg.cancel}</button>}
        <p data-workbench-status id="action-status" class="mt-3 min-h-5 text-center text-xs text-muted" aria-live="polite"></p>
      </form>
    </div>
    <div data-workbench-result id="action-result" hidden class="border-t border-line bg-canvas p-5 sm:p-7"><div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-center"><div><p class="text-sm font-semibold text-green">{m.ready}</p><p id="action-result-stats" class="mt-2 text-sm text-muted"></p></div><a id="action-download" class="inline-flex min-h-12 items-center justify-center rounded-control bg-blue px-6 text-sm font-medium text-white hover:bg-blue-strong">{m.download}</a></div><p id="action-result-warning" hidden role="status" class="mt-4 rounded-control bg-amber-soft px-4 py-3 text-sm leading-6 text-amber"></p></div>
  </div>
</section>

<script type="application/json" id="action-workbench-messages" is:inline set:html={JSON.stringify(m).replace(/</g, '\\u003c')}></script>

<script>
  import pdfWorkerUrl from 'pdfjs-dist/build/pdf.worker.min.mjs?url';
  import { safeOutputStem, setDisplayedFilename } from '../utils/filename';
  import type { WorkbenchMessages } from '../i18n/workbench';
  import type { LocalePath } from '../i18n/config';
  import { getOcrMessages, formatOcrMessage } from '../i18n/ocr';
  import type { OcrLanguageCode } from '../lib/ocr/languages';

  const actionMessages = JSON.parse(document.querySelector('#action-workbench-messages')?.textContent || '{}') as WorkbenchMessages;
  type ActionTool = 'merge-pdf' | 'split-pdf' | 'rotate-pdf' | 'remove-pages' | 'watermark-pdf' | 'page-numbers' | 'sign-pdf' | 'jpg-to-pdf' | 'pdf-to-jpg' | 'pdf-to-word' | 'word-to-pdf';
  const actionRoot = document.querySelector<HTMLElement>('#document-tool'); if (!actionRoot) throw new Error('Missing document tool.');
  const localizedAction = actionRoot.dataset.localized === 'true';
  const actionTool = actionRoot.dataset.tool as ActionTool;
  const currentLocale = (actionRoot.dataset.locale || 'en') as LocalePath;
  const ocrMessages = getOcrMessages(currentLocale);

  const actionEl = <T extends HTMLElement>(selector: string) => { const node = actionRoot.querySelector<T>(selector); if (!node) throw new Error(`Missing element: ${selector}`); return node; };
  const actionInput = actionEl<HTMLInputElement>('#action-input'); const actionEmpty = actionEl('#action-empty'); const actionWork = actionEl('#action-work'); const actionResult = actionEl('#action-result'); const actionError = actionEl('#action-error'); const actionStatus = actionEl('#action-status'); const actionForm = actionEl<HTMLFormElement>('#action-form'); const actionButton = actionEl<HTMLButtonElement>('#action-process');
  const ocrCancelButton = actionRoot.querySelector<HTMLButtonElement>('#ocr-cancel');

  let activeAbortController: AbortController | null = null;

  if (ocrCancelButton) {
    ocrCancelButton.addEventListener('click', () => {
      if (activeAbortController) {
        activeAbortController.abort();
        actionStatus.textContent = ocrMessages.cancelled;
        ocrCancelButton.hidden = true;
      }
    });
  }

  const localizeActionMutations = () => {
    if (!localizedAction) return;
    const value = actionStatus.textContent?.trim() || '';
    const localizedValues = [actionMessages.processing, actionMessages.finished, actionMessages.failed, actionMessages.invalidFile, actionMessages.tooLarge, actionMessages.noText, actionMessages.password, actionMessages.confirmLimitation, ocrMessages.cancelled];
    if (value && !localizedValues.includes(value) && !value.includes('…') && !value.includes('OCR')) {
      actionStatus.textContent = /no selectable text|no readable text/i.test(value) ? actionMessages.noText
        : /password/i.test(value) ? actionMessages.password
        : /confirm|formatting limitation/i.test(value) ? actionMessages.confirmLimitation
        : /adding|preparing|rendering|extracting|reading|processing/i.test(value) ? actionMessages.processing
        : actionMessages.failed;
    }
    if (actionButton.disabled && actionButton.textContent?.trim() !== actionMessages.processing) actionButton.textContent = actionMessages.processing;
  };
  new MutationObserver(localizeActionMutations).observe(actionRoot, { childList: true, subtree: true, characterData: true });

  let actionFiles: File[] = []; let actionUrl: string | null = null; let signatureHasInk = false;
  const readableSize = (bytes: number) => bytes < 1000 ? `${bytes} B` : bytes < 1_000_000 ? `${(bytes / 1000).toFixed(0)} KB` : `${(bytes / 1_000_000).toFixed(2)} MB`;
  const baseName = (name: string) => safeOutputStem(name);
  const isPdf = async (file: File) => new TextDecoder('ascii').decode(await file.slice(0, 5).arrayBuffer()) === '%PDF-';
  const imageKind = async (file: File) => { const bytes = new Uint8Array(await file.slice(0, 12).arrayBuffer()); if (bytes[0] === 0xff && bytes[1] === 0xd8 && bytes[2] === 0xff) return 'jpg'; if (bytes[0] === 0x89 && bytes[1] === 0x50 && bytes[2] === 0x4e && bytes[3] === 0x47) return 'png'; return null; };
  const isDocx = async (file: Blob) => { if (new TextDecoder('ascii').decode(await file.slice(0, 2).arrayBuffer()) !== 'PK') return false; const { unzipSync } = await import('fflate'); try { const archive = unzipSync(new Uint8Array(await file.arrayBuffer()), { filter: fileInfo => fileInfo.name === 'word/document.xml' && fileInfo.originalSize <= 20_000_000 }); return Boolean(archive['word/document.xml']); } catch { return false; } };
  const clearActionUrl = () => { if (actionUrl) URL.revokeObjectURL(actionUrl); actionUrl = null; actionResult.hidden = true; };
  const resetAction = () => { clearActionUrl(); actionFiles = []; actionInput.value = ''; actionInput.removeAttribute('aria-invalid'); actionEmpty.hidden = false; actionWork.hidden = true; actionError.hidden = true; actionStatus.textContent = ''; if (ocrCancelButton) ocrCancelButton.hidden = true; };
  const failSelection = (message: string) => { resetAction(); actionError.textContent = message; actionError.hidden = false; actionInput.setAttribute('aria-invalid', 'true'); actionError.focus(); };

  const loadActionFiles = async (files: File[]) => {
    resetAction();
    try {
      if (!files.length) return;
      if (!actionRoot.dataset.multiple || actionRoot.dataset.multiple === 'false') files = files.slice(0, 1);
      if (files.length > 20) throw new Error('Choose no more than 20 files at once.');
      const total = files.reduce((sum, file) => sum + file.size, 0); if (total > 100_000_000) throw new Error('The selected files exceed the 100 MB local-processing safety limit.');
      if (actionTool === 'word-to-pdf' && files[0].size > 25_000_000) throw new Error('Choose a DOCX smaller than 25 MB to protect browser memory.');
      if (['merge-pdf','split-pdf','rotate-pdf','remove-pages','watermark-pdf','page-numbers','sign-pdf','pdf-to-jpg','pdf-to-word'].includes(actionTool)) { for (const file of files) if (!(await isPdf(file))) throw new Error(`${file.name} is not a valid PDF. Choose files with a real PDF signature.`); }
      if (actionTool === 'jpg-to-pdf') { for (const file of files) if (!(await imageKind(file))) throw new Error(`${file.name} is not a valid JPG or PNG image.`); }
      if (actionTool === 'word-to-pdf' && !(await isDocx(files[0]))) throw new Error('Choose a valid DOCX file created by Word, Google Docs, or LibreOffice.');
      actionFiles = files; const list = actionEl<HTMLOListElement>('#action-file-list'); list.textContent = '';
      files.forEach((file, index) => { const item = document.createElement('li'); item.className = 'flex min-w-0 items-center gap-3 px-4 py-3'; const count = document.createElement('span'); count.className = 'shrink-0 font-mono text-xs text-muted'; count.textContent = String(index + 1).padStart(2, '0'); const text = document.createElement('span'); text.className = 'min-w-0 flex-1 truncate text-sm font-medium'; setDisplayedFilename(text, file.name); const size = document.createElement('span'); size.className = 'shrink-0 text-xs text-muted'; size.textContent = readableSize(file.size); item.append(count, text, size); list.append(item); });
      actionEl('#action-total').textContent = localizedAction ? `${files.length} · ${readableSize(total)}` : `${files.length} ${files.length === 1 ? 'file' : 'files'} · ${readableSize(total)}`; actionEmpty.hidden = true; actionWork.hidden = false;
    } catch (error) { const detail = error instanceof Error ? error.message : ''; failSelection(localizedAction ? (/MB|limit|more than|smaller/i.test(detail) ? actionMessages.tooLarge : actionMessages.invalidFile) : (detail || actionMessages.invalidFile)); }
  };

  const downloadBlob = (blob: Blob, name: string, stats: string, warning = '', ocrPages = 0, lowConfidencePages: number[] = []) => {
    clearActionUrl();
    actionUrl = URL.createObjectURL(blob);
    const link = actionEl<HTMLAnchorElement>('#action-download');
    link.href = actionUrl;
    link.download = name;
    actionEl('#action-result-stats').textContent = localizedAction ? readableSize(blob.size) : stats;
    const warningEl = actionEl('#action-result-warning');
    warningEl.textContent = localizedAction && warning ? actionMessages.review : warning;
    warningEl.hidden = !warningEl.textContent;
    if (ocrPages > 0) {
      actionResult.setAttribute('data-ocr-pages', String(ocrPages));
    } else {
      actionResult.removeAttribute('data-ocr-pages');
    }
    if (lowConfidencePages.length > 0) {
      actionResult.setAttribute('data-ocr-low-confidence', lowConfidencePages.join(','));
    } else {
      actionResult.removeAttribute('data-ocr-low-confidence');
    }
    actionResult.hidden = false;
    actionStatus.textContent = actionMessages.finished;
    actionResult.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'nearest' });
  };

  const loadPdfLib = async (file: File) => { const { PDFDocument } = await import('pdf-lib'); return { PDFDocument, source: await PDFDocument.load(await file.arrayBuffer(), { ignoreEncryption: false }) }; };
  const loadPdfJs = async (file: File) => { const pdfjs = await import('pdfjs-dist'); pdfjs.GlobalWorkerOptions.workerSrc = pdfWorkerUrl; return pdfjs.getDocument({ data: new Uint8Array(await file.arrayBuffer()), cMapUrl: '/pdfjs/cmaps/', cMapPacked: true, wasmUrl: '/pdfjs/wasm/' }).promise; };

  const validatePdfBytes = async (bytes: Uint8Array, expectedPages: number) => {
    if (new TextDecoder('ascii').decode(bytes.slice(0, 5)) !== '%PDF-') throw new Error('The tool produced an invalid PDF. No download was created.');
    const { PDFDocument } = await import('pdf-lib');
    const verified = await PDFDocument.load(bytes, { ignoreEncryption: false, updateMetadata: false });
    if (verified.getPageCount() !== expectedPages) throw new Error('The output PDF did not preserve the expected number of pages. No download was created.');
  };

  const downloadPdfBytes = async (bytes: Uint8Array, expectedPages: number, name: string, stats: string, warning = '') => {
    await validatePdfBytes(bytes, expectedPages);
    downloadBlob(new Blob([bytes as BlobPart], { type: 'application/pdf' }), name, stats, warning);
  };

  const parsePageSpec = (value: string, pageCount: number) => {
    const clean = value.trim();
    if (!clean) throw new Error('Enter at least one page number to remove.');
    const pages = new Set<number>();
    for (const part of clean.split(',')) {
      const token = part.trim();
      const match = /^(\d+)(?:\s*-\s*(\d+))?$/.exec(token);
      if (!match) throw new Error(`“${token || part}” is not a valid page number or range.`);
      const start = Number(match[1]);
      const end = Number(match[2] ?? match[1]);
      if (start < 1 || end < start || end > pageCount) throw new Error(`Use page numbers from 1 to ${pageCount}, with ranges in ascending order.`);
      for (let page = start; page <= end; page += 1) pages.add(page - 1);
    }
    return [...pages].sort((a, b) => a - b);
  };

  const mergePdfs = async () => { const { PDFDocument } = await import('pdf-lib'); const output = await PDFDocument.create(); let pages = 0; for (let i = 0; i < actionFiles.length; i += 1) { actionStatus.textContent = `Adding file ${i + 1} of ${actionFiles.length}…`; const source = await PDFDocument.load(await actionFiles[i].arrayBuffer(), { ignoreEncryption: false }); const copied = await output.copyPages(source, source.getPageIndices()); copied.forEach(page => output.addPage(page)); pages += copied.length; } const bytes = await output.save({ useObjectStreams: true }); await downloadPdfBytes(bytes, pages, 'merged-sorafiles.pdf', `${actionFiles.length} files · ${pages} pages · ${readableSize(bytes.length)}`); };
  const splitPdf = async () => { const { PDFDocument } = await import('pdf-lib'); const { source } = await loadPdfLib(actionFiles[0]); if (source.getPageCount() > 100) throw new Error('Split currently supports up to 100 pages.'); const entries: Record<string, Uint8Array> = {}; for (let i = 0; i < source.getPageCount(); i += 1) { actionStatus.textContent = `Preparing page ${i + 1} of ${source.getPageCount()}…`; const output = await PDFDocument.create(); const [page] = await output.copyPages(source, [i]); output.addPage(page); const bytes = await output.save({ useObjectStreams: true }); await validatePdfBytes(bytes, 1); entries[`page-${String(i + 1).padStart(3, '0')}.pdf`] = bytes; } const { zipSync } = await import('fflate'); const zipped = zipSync(entries, { level: 6 }); const count = source.getPageCount(); downloadBlob(new Blob([zipped as BlobPart], { type: 'application/zip' }), `${baseName(actionFiles[0].name)}-pages.zip`, `${count} ${count === 1 ? 'PDF' : 'PDFs'} · ${readableSize(zipped.length)}`); };
  const rotatePdf = async () => { const { degrees } = await import('pdf-lib'); const { source } = await loadPdfLib(actionFiles[0]); const angle = Number(actionEl<HTMLSelectElement>('#rotate-angle').value); source.getPages().forEach(page => page.setRotation(degrees((page.getRotation().angle + angle) % 360))); const bytes = await source.save({ useObjectStreams: true }); const count = source.getPageCount(); await downloadPdfBytes(bytes, count, `${baseName(actionFiles[0].name)}-rotated.pdf`, `${count} ${count === 1 ? 'page' : 'pages'} · ${angle}° · ${readableSize(bytes.length)}`); };
  const removePagesPdf = async () => {
    const { source } = await loadPdfLib(actionFiles[0]);
    const pageCount = source.getPageCount();
    const indices = parsePageSpec(actionEl<HTMLInputElement>('#remove-page-spec').value, pageCount);
    if (indices.length >= pageCount) throw new Error('At least one page must remain in the PDF.');
    [...indices].reverse().forEach(index => source.removePage(index));
    const bytes = await source.save({ useObjectStreams: true });
    const remaining = pageCount - indices.length;
    await downloadPdfBytes(bytes, remaining, `${baseName(actionFiles[0].name)}-pages-removed.pdf`, `${indices.length} removed · ${remaining} remaining · ${readableSize(bytes.length)}`);
  };

  const watermarkPdf = async () => {
    const { source } = await loadPdfLib(actionFiles[0]);
    const text = actionEl<HTMLInputElement>('#watermark-text').value.trim().replace(/\s+/g, ' ');
    if (!text) throw new Error('Enter watermark text.');
    if (text.length > 60) throw new Error('Keep the watermark to 60 characters or fewer.');
    const opacity = Number(actionEl<HTMLInputElement>('#watermark-opacity').value) / 100;
    if (!Number.isFinite(opacity) || opacity < 0.05 || opacity > 0.5) throw new Error('Choose a watermark opacity from 5% to 50%.');
    const { StandardFonts, degrees, rgb } = await import('pdf-lib');
    const font = await source.embedFont(StandardFonts.HelveticaBold);
    for (const page of source.getPages()) {
      const { width, height } = page.getSize();
      const fontSize = Math.max(20, Math.min(64, Math.min(width, height) / 9));
      const textWidth = font.widthOfTextAtSize(text, fontSize);
      page.drawText(text, { x: (width - textWidth * 0.72) / 2, y: height / 2, size: fontSize, font, color: rgb(0.25, 0.29, 0.42), opacity, rotate: degrees(35) });
    }
    const bytes = await source.save({ useObjectStreams: true });
    await downloadPdfBytes(bytes, source.getPageCount(), `${baseName(actionFiles[0].name)}-watermarked.pdf`, `${source.getPageCount()} pages · ${readableSize(bytes.length)}`);
  };

  const addPageNumbersPdf = async () => {
    const { source } = await loadPdfLib(actionFiles[0]);
    const position = actionEl<HTMLSelectElement>('#page-number-position').value;
    const start = Number(actionEl<HTMLInputElement>('#page-number-start').value);
    if (!Number.isSafeInteger(start) || start < 1 || start > 999_999) throw new Error('Choose a starting number from 1 to 999999.');
    const { StandardFonts, rgb } = await import('pdf-lib');
    const font = await source.embedFont(StandardFonts.Helvetica);
    const pages = source.getPages();
    pages.forEach((page, index) => {
      const { width, height } = page.getSize();
      const label = `${start + index} / ${start + pages.length - 1}`;
      const size = 10;
      const labelWidth = font.widthOfTextAtSize(label, size);
      const x = position.endsWith('right') ? Math.max(24, width - labelWidth - 28) : Math.max(24, (width - labelWidth) / 2);
      const y = position.startsWith('top') ? height - 32 : 24;
      page.drawText(label, { x, y, size, font, color: rgb(0.2, 0.23, 0.32) });
    });
    const bytes = await source.save({ useObjectStreams: true });
    await downloadPdfBytes(bytes, pages.length, `${baseName(actionFiles[0].name)}-numbered.pdf`, `${pages.length} numbered pages · ${readableSize(bytes.length)}`);
  };

  const signPdf = async () => {
    if (!signatureHasInk) throw new Error('Draw a signature before processing the PDF.');
    const canvas = actionEl<HTMLCanvasElement>('#signature-canvas');
    const signatureBlob = await new Promise<Blob>((resolve, reject) => canvas.toBlob(blob => blob ? resolve(blob) : reject(new Error('The signature image could not be created.')), 'image/png'));
    const { source } = await loadPdfLib(actionFiles[0]);
    const signature = await source.embedPng(await signatureBlob.arrayBuffer());
    const scope = actionEl<HTMLSelectElement>('#signature-scope').value;
    const pages = source.getPages();
    const indices = scope === 'all' ? pages.map((_, index) => index) : scope === 'first' ? [0] : [pages.length - 1];
    for (const index of indices) {
      const page = pages[index];
      const { width, height } = page.getSize();
      const drawWidth = Math.min(170, width * 0.35);
      const drawHeight = drawWidth * (signature.height / signature.width);
      page.drawImage(signature, { x: Math.max(24, width - drawWidth - 36), y: Math.max(24, Math.min(48, height - drawHeight - 24)), width: drawWidth, height: drawHeight });
    }
    const bytes = await source.save({ useObjectStreams: true });
    await downloadPdfBytes(bytes, pages.length, `${baseName(actionFiles[0].name)}-signed.pdf`, `${indices.length} signed ${indices.length === 1 ? 'page' : 'pages'} · ${readableSize(bytes.length)}`, 'This adds a visible signature appearance only. It is not a certificate-backed digital signature and does not verify identity.');
  };
  const imagesToPdf = async () => { const { PDFDocument } = await import('pdf-lib'); const output = await PDFDocument.create(); const mode = actionEl<HTMLSelectElement>('#image-page-size').value; for (let i = 0; i < actionFiles.length; i += 1) { actionStatus.textContent = `Adding image ${i + 1} of ${actionFiles.length}…`; const file = actionFiles[i]; const kind = await imageKind(file); const image = kind === 'png' ? await output.embedPng(await file.arrayBuffer()) : await output.embedJpg(await file.arrayBuffer()); let pageWidth: number; let pageHeight: number; if (mode === 'a4') { const landscape = image.width > image.height; pageWidth = landscape ? 841.89 : 595.28; pageHeight = landscape ? 595.28 : 841.89; } else { const scale = Math.min(1, 1600 / Math.max(image.width, image.height)); pageWidth = image.width * scale * 0.75; pageHeight = image.height * scale * 0.75; } const page = output.addPage([pageWidth, pageHeight]); const margin = mode === 'a4' ? 28 : 0; const fit = Math.min((pageWidth - margin * 2) / image.width, (pageHeight - margin * 2) / image.height); const width = image.width * fit; const height = image.height * fit; page.drawImage(image, { x: (pageWidth - width) / 2, y: (pageHeight - height) / 2, width, height }); } const bytes = await output.save({ useObjectStreams: true }); await downloadPdfBytes(bytes, actionFiles.length, 'images-sorafiles.pdf', `${actionFiles.length} ${actionFiles.length === 1 ? 'page' : 'pages'} · ${readableSize(bytes.length)}`); };
  const pdfToJpg = async () => { const source = await loadPdfJs(actionFiles[0]); if (source.numPages > 40) throw new Error('PDF to JPG currently supports up to 40 pages.'); const scaleSetting = Number(actionEl<HTMLSelectElement>('#jpg-resolution').value); const entries: Record<string, Uint8Array> = {}; for (let i = 1; i <= source.numPages; i += 1) { actionStatus.textContent = `Rendering page ${i} of ${source.numPages}…`; const page = await source.getPage(i); const base = page.getViewport({ scale: 1 }); let scale = scaleSetting; if (base.width * scale * base.height * scale > 16_000_000) scale *= Math.sqrt(16_000_000 / (base.width * scale * base.height * scale)); const viewport = page.getViewport({ scale }); const canvas = document.createElement('canvas'); canvas.width = Math.ceil(viewport.width); canvas.height = Math.ceil(viewport.height); const context = canvas.getContext('2d', { alpha: false }); if (!context) throw new Error('Canvas rendering is unavailable.'); context.fillStyle = '#fff'; context.fillRect(0, 0, canvas.width, canvas.height); await page.render({ canvas, canvasContext: context, viewport, background: '#fff' }).promise; const blob = await new Promise<Blob>((resolve, reject) => canvas.toBlob(value => value ? resolve(value) : reject(new Error('JPG encoding failed.')), 'image/jpeg', 0.86)); const bytes = new Uint8Array(await blob.arrayBuffer()); if (!(bytes[0] === 0xff && bytes[1] === 0xd8 && bytes[2] === 0xff)) throw new Error(`Page ${i} did not produce a valid JPG. No download was created.`); entries[`page-${String(i).padStart(3, '0')}.jpg`] = bytes; page.cleanup(); canvas.width = 1; canvas.height = 1; } const count = source.numPages; await source.cleanup(); const { zipSync } = await import('fflate'); const zipped = zipSync(entries, { level: 0 }); downloadBlob(new Blob([zipped as BlobPart], { type: 'application/zip' }), `${baseName(actionFiles[0].name)}-jpg.zip`, `${count} JPG ${count === 1 ? 'file' : 'files'} · ${readableSize(zipped.length)}`); };

  const pdfToWord = async () => {
    const pdfDoc = await loadPdfJs(actionFiles[0]);
    const selectedLangCode = (actionRoot.querySelector<HTMLSelectElement>('#ocr-language')?.value || 'eng') as OcrLanguageCode;

    const { extractPdfForWord } = await import('../lib/pdf-to-word/convert');
    const { createDocxFromPages } = await import('../lib/pdf-to-word/docx');

    activeAbortController = new AbortController();
    if (ocrCancelButton) ocrCancelButton.hidden = false;

    const docAdapter = {
      pageCount: pdfDoc.numPages,
      async openPage(pageNum: number) {
        const page = await pdfDoc.getPage(pageNum);
        return {
          number: pageNum,
          async textItems() {
            const content = await page.getTextContent();
            return content.items as any[];
          },
          async renderForOcr(maxPixels: number) {
            const base = page.getViewport({ scale: 1 });
            const scale = Math.min(2, Math.sqrt(maxPixels / Math.max(1, base.width * base.height)));
            const viewport = page.getViewport({ scale });
            const canvas = document.createElement('canvas');
            canvas.width = Math.ceil(viewport.width);
            canvas.height = Math.ceil(viewport.height);
            const ctx = canvas.getContext('2d', { alpha: false });
            if (!ctx) throw new Error('Canvas context unavailable');
            ctx.fillStyle = '#fff';
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            await page.render({ canvas, canvasContext: ctx, viewport, background: '#fff' }).promise;
            return canvas;
          },
          cleanup() {
            page.cleanup();
          },
        };
      },
      async destroy() {
        await pdfDoc.cleanup();
      },
    };

    let ocrPagesCount = 0;
    let lowConfidencePages: number[] = [];

    try {
      const extractedPages = await extractPdfForWord({
        document: docAdapter,
        createOcrEngine: async (onProgress) => {
          const { createLocalOcrEngine } = await import('../lib/ocr/local-engine');
          return await createLocalOcrEngine(selectedLangCode, onProgress);
        },
        signal: activeAbortController.signal,
        onProgress: (p) => {
          if (p.stage === 'inspecting') {
            actionStatus.textContent = formatOcrMessage(ocrMessages.inspecting, { current: p.page, total: p.total });
          } else if (p.stage === 'scan-count') {
            ocrPagesCount = p.scannedPages;
            if (p.warning) {
              actionStatus.textContent = ocrMessages.tooManyScans;
            }
          } else if (p.stage === 'loading-model') {
            actionStatus.textContent = formatOcrMessage(ocrMessages.loadingModel, { code: selectedLangCode });
          } else if (p.stage === 'recognizing') {
            actionStatus.textContent = formatOcrMessage(ocrMessages.recognizingPage, { current: p.page, total: p.total });
          } else if (p.stage === 'complete') {
            lowConfidencePages = p.lowConfidencePages;
          }
        },
      });

      const blob = await createDocxFromPages(extractedPages, currentLocale === 'ar' ? 'rtl' : 'ltr');
      if (!(await isDocx(blob))) throw new Error('The generated Word file did not pass local ZIP and document-structure validation. No download was created.');
      let summaryText = ocrMessages.layoutWarning;
      if (ocrPagesCount > 0) {
        summaryText = formatOcrMessage(ocrMessages.ocrSummary, { pages: ocrPagesCount }) + ' ' + summaryText;
      }

      downloadBlob(
        blob,
        `${baseName(actionFiles[0].name)}.docx`,
        `${pdfDoc.numPages} ${pdfDoc.numPages === 1 ? 'page' : 'pages'} · ${readableSize(blob.size)}`,
        summaryText,
        ocrPagesCount,
        lowConfidencePages,
      );
    } finally {
      if (ocrCancelButton) ocrCancelButton.hidden = true;
      activeAbortController = null;
      await pdfDoc.cleanup().catch(() => {});
    }
  };

  const wordToPdf = async () => { actionStatus.textContent = 'Reading document text locally…'; const mammoth = await import('mammoth'); const result = await mammoth.extractRawText({ arrayBuffer: await actionFiles[0].arrayBuffer() }); const text = result.value.trim(); if (!text) throw new Error('No readable text was found in this DOCX file.'); const { jsPDF } = await import('jspdf'); const pdf = new jsPDF({ unit: 'pt', format: 'a4', compress: true }); const margin = 54; const width = pdf.internal.pageSize.getWidth() - margin * 2; const lines = pdf.splitTextToSize(text, width) as string[]; const lineHeight = 16; let y = margin; pdf.setFont('helvetica', 'normal'); pdf.setFontSize(11); for (let i = 0; i < lines.length; i += 1) { if (y > pdf.internal.pageSize.getHeight() - margin) { pdf.addPage(); y = margin; } pdf.text(lines[i], margin, y); y += lineHeight; } const blob = pdf.output('blob'); const bytes = new Uint8Array(await blob.arrayBuffer()); const pageCount = pdf.getNumberOfPages(); await downloadPdfBytes(bytes, pageCount, `${baseName(actionFiles[0].name)}.pdf`, `${pageCount} ${pageCount === 1 ? 'page' : 'pages'} · ${readableSize(blob.size)}`, 'This text-first PDF does not reproduce advanced Word formatting, images, headers, columns, or exact pagination.'); };

  const processAction = async () => { if (!actionFiles.length) return; if ((actionTool === 'pdf-to-word' || actionTool === 'word-to-pdf') && !actionEl<HTMLInputElement>('#fidelity-confirm').checked) { actionStatus.textContent = 'Confirm the formatting limitation before continuing.'; actionEl<HTMLInputElement>('#fidelity-confirm').focus(); return; } actionButton.disabled = true; actionRoot.setAttribute('aria-busy', 'true'); const original = actionButton.textContent ?? 'Process locally'; actionButton.textContent = 'Processing…'; actionResult.hidden = true; try { if (actionTool === 'merge-pdf') await mergePdfs(); else if (actionTool === 'split-pdf') await splitPdf(); else if (actionTool === 'rotate-pdf') await rotatePdf(); else if (actionTool === 'remove-pages') await removePagesPdf(); else if (actionTool === 'watermark-pdf') await watermarkPdf(); else if (actionTool === 'page-numbers') await addPageNumbersPdf(); else if (actionTool === 'sign-pdf') await signPdf(); else if (actionTool === 'jpg-to-pdf') await imagesToPdf(); else if (actionTool === 'pdf-to-jpg') await pdfToJpg(); else if (actionTool === 'pdf-to-word') await pdfToWord(); else await wordToPdf(); } catch (error: any) { if (error?.code === 'cancelled' || error?.message?.includes('cancelled')) { actionStatus.textContent = ocrMessages.cancelled; } else { actionStatus.textContent = error instanceof Error ? error.message : 'Local processing failed.'; } } finally { actionRoot.removeAttribute('aria-busy'); actionButton.disabled = false; actionButton.textContent = original; } };

  const watermarkOpacity = actionRoot.querySelector<HTMLInputElement>('#watermark-opacity');
  const watermarkOpacityOutput = actionRoot.querySelector<HTMLOutputElement>('#watermark-opacity-output');
  watermarkOpacity?.addEventListener('input', () => { const value = `${watermarkOpacity.value}%`; watermarkOpacity.setAttribute('aria-valuetext', value); if (watermarkOpacityOutput) watermarkOpacityOutput.value = value; });

  const signatureCanvas = actionRoot.querySelector<HTMLCanvasElement>('#signature-canvas');
  if (signatureCanvas) {
    const context = signatureCanvas.getContext('2d');
    if (!context) throw new Error('Signature drawing is unavailable in this browser.');
    context.strokeStyle = '#111827';
    context.fillStyle = '#111827';
    context.lineWidth = 5;
    context.lineCap = 'round';
    context.lineJoin = 'round';
    const signatureText = actionRoot.querySelector<HTMLInputElement>('#signature-text');
    const renderTypedSignature = () => {
      if (!signatureText) return;
      context.clearRect(0, 0, signatureCanvas.width, signatureCanvas.height);
      const value = signatureText.value.trim();
      signatureHasInk = Boolean(value);
      if (!value) return;
      context.save();
      context.fillStyle = '#111827';
      context.font = 'italic 72px Georgia, serif';
      context.textAlign = 'center';
      context.textBaseline = 'middle';
      context.fillText(value, signatureCanvas.width / 2, signatureCanvas.height / 2, signatureCanvas.width - 64);
      context.restore();
    };
    signatureText?.addEventListener('input', renderTypedSignature);
    let drawing = false;
    const point = (event: PointerEvent) => {
      const rect = signatureCanvas.getBoundingClientRect();
      return { x: (event.clientX - rect.left) * (signatureCanvas.width / rect.width), y: (event.clientY - rect.top) * (signatureCanvas.height / rect.height) };
    };
    signatureCanvas.addEventListener('pointerdown', event => {
      if (signatureText?.value) { signatureText.value = ''; context.clearRect(0, 0, signatureCanvas.width, signatureCanvas.height); }
      drawing = true;
      signatureHasInk = true;
      signatureCanvas.setPointerCapture(event.pointerId);
      const current = point(event);
      context.beginPath();
      context.arc(current.x, current.y, 2.5, 0, Math.PI * 2);
      context.fill();
      context.beginPath();
      context.moveTo(current.x, current.y);
    });
    signatureCanvas.addEventListener('pointermove', event => { if (!drawing) return; const current = point(event); context.lineTo(current.x, current.y); context.stroke(); });
    const stopDrawing = () => { drawing = false; context.closePath(); };
    signatureCanvas.addEventListener('pointerup', stopDrawing);
    signatureCanvas.addEventListener('pointercancel', stopDrawing);
    actionEl<HTMLButtonElement>('#signature-clear').addEventListener('click', () => { context.clearRect(0, 0, signatureCanvas.width, signatureCanvas.height); if (signatureText) signatureText.value = ''; signatureHasInk = false; signatureText?.focus(); });
  }
  actionEl<HTMLButtonElement>('#action-choose').addEventListener('click', () => actionInput.click()); actionInput.addEventListener('change', () => void loadActionFiles(Array.from(actionInput.files ?? []))); actionEl<HTMLButtonElement>('#action-remove').addEventListener('click', resetAction); actionForm.addEventListener('submit', event => { event.preventDefault(); void processAction(); });
  const actionDrop = actionEl('#action-drop'); for (const eventName of ['dragenter','dragover']) actionDrop.addEventListener(eventName, event => { event.preventDefault(); actionDrop.classList.add('border-blue','bg-blue-soft','select-none'); }); for (const eventName of ['dragleave','drop']) actionDrop.addEventListener(eventName, event => { event.preventDefault(); actionDrop.classList.remove('border-blue','bg-blue-soft','select-none'); }); actionDrop.addEventListener('drop', event => { const files = Array.from(event.dataTransfer?.files ?? []); if (files.length) void loadActionFiles(files); }); window.addEventListener('beforeunload', clearActionUrl);
</script>
