---
import type { LiveTool } from '../data/liveTools';
import type { LocalizedToolCopy } from '../i18n/types';
import type { LocalePath } from '../i18n/config';
import { getWorkbenchMessages } from '../i18n/workbench';
import { OCR_LANGUAGE_OPTIONS, OCR_LANGUAGE_BY_LOCALE } from '../lib/ocr/languages';
import { getOcrMessages } from '../i18n/ocr';
import { getWatermarkPdfMessages } from '../i18n/documentTools';
import ToolIcon from './ToolIcon.astro';
import { liveText } from '../data/liveI18n';

interface Props {
  tool: LiveTool;
  locale?: LocalePath;
  copy?: LocalizedToolCopy;
}

const {
  tool,
  locale = 'en',
  copy = {
    title: tool.name,
    short: tool.tagline,
    description: tool.description,
    note: tool.description,
  } as LocalizedToolCopy,
} = Astro.props;

const m = getWorkbenchMessages(locale);
const t = (path: string) => liveText(locale, path);
const ocrMsg = getOcrMessages(locale);
const watermarkMsg = getWatermarkPdfMessages(locale);
const defaultOcrCode = OCR_LANGUAGE_BY_LOCALE[locale] ?? 'eng';

const tones = {
  indigo: 'bg-blue-soft text-blue',
  cyan: 'bg-cyan-soft text-cyan',
  violet: 'bg-violet-soft text-violet',
  coral: 'bg-coral-soft text-coral',
  pink: 'bg-pink-soft text-pink',
  green: 'bg-green-soft text-green',
};
const actionTones: Record<string, keyof typeof tones> = {
  'merge-pdf': 'violet', 'split-pdf': 'cyan', 'rotate-pdf': 'green', 'remove-pages': 'coral',
  'watermark-pdf': 'violet', 'page-numbers': 'cyan', 'sign-pdf': 'pink', 'jpg-to-pdf': 'pink',
  'pdf-to-jpg': 'coral', 'pdf-to-word': 'indigo', 'word-to-pdf': 'cyan',
};
const actionTone = actionTones[tool.id] ?? 'indigo';
---
<section data-workbench id="document-tool" aria-labelledby="document-tool-heading" class="mx-auto max-w-5xl px-5 sm:px-6" data-tool={tool.slug} data-accept={tool.accept} data-multiple={String(tool.multiple)} data-localized={locale !== 'en' ? 'true' : 'false'} data-copy-note={copy.note} data-merge-minimum={t('wb.err.tooFew')} data-split-compact-warning={t('lim.compress')} data-locale={locale}>
  <div class="overflow-hidden rounded-card bg-surface shadow-card">
    <div class="border-b border-line px-5 py-4 sm:px-7"><div class="flex flex-wrap items-center justify-between gap-3"><div class="flex items-center gap-3"><span class:list={['flex h-10 w-10 items-center justify-center rounded-xl', tones[actionTone]]}><ToolIcon icon={tool.icon}/></span><div><p class="eyebrow text-xs font-semibold text-blue">{m.localFileTool}</p><h2 id="document-tool-heading" class="mt-1 text-lg font-semibold tracking-tight">{copy.title}</h2></div></div><div class="inline-flex items-center gap-2 rounded-full bg-green-soft px-3 py-1.5 text-xs font-medium text-green"><span class="h-2 w-2 rounded-full bg-green" aria-hidden="true"></span>{m.noUpload}</div></div></div>
    <div id="action-empty" class="p-4 sm:p-7">
      <div id="action-drop" class="group flex min-h-72 flex-col items-center justify-center rounded-xl border border-dashed border-line-strong bg-canvas px-5 py-12 text-center transition-colors hover:border-blue/60 hover:bg-surface">
        <span class:list={['flex h-14 w-14 items-center justify-center rounded-xl shadow-small', tones[actionTone]]}><ToolIcon icon={tool.icon}/></span>
        <h3 class="mt-5 text-xl font-semibold tracking-tight">{tool.multiple ? m.chooseFiles : m.chooseFile}</h3>
        <p class="mt-2 max-w-md text-sm leading-6 text-muted">{copy.short} · {m.processedHere}</p>
        <button id="action-choose" type="button" class="mt-6 inline-flex min-h-12 items-center justify-center rounded-control bg-action px-6 text-sm font-medium text-action-contrast shadow-small transition-colors hover:bg-action-hover">{tool.multiple ? m.chooseFiles : m.chooseFile}</button>
        <input id="action-input" name="sourceFiles" class="sr-only" tabindex="-1" type="file" accept={tool.accept} multiple={tool.multiple} aria-label={tool.multiple ? m.chooseFiles : m.chooseFile} aria-describedby="action-help action-error" />
        <p id="action-help" class="sr-only">{copy.description}</p>
        <p id="action-error" hidden role="alert" tabindex="-1" class="mt-4 max-w-lg break-words rounded-control bg-amber-soft px-4 py-3 text-sm leading-6 text-amber"></p>
      </div>
    </div>
    <div id="action-work" hidden class="grid min-w-0 lg:grid-cols-[1fr_0.85fr]">
      <div class="min-w-0 border-b border-line p-5 sm:p-7 lg:border-b-0 lg:border-r">
        <div class="flex flex-wrap items-center justify-between gap-3"><div><p class="text-sm font-semibold">{tool.multiple ? m.selectedFiles : m.selectedFile}</p><p id="action-total" class="mt-1 text-xs text-muted"></p></div><div class="flex flex-wrap items-center gap-2">{tool.multiple && <button id="action-add" type="button" class="min-h-10 rounded-control border border-line bg-surface px-3 text-sm font-medium text-ink hover:border-line-strong">+ {m.chooseFiles}</button>}<button id="action-remove" type="button" class="min-h-10 rounded-control px-3 text-sm text-muted hover:bg-canvas hover:text-ink">{m.removeAll}</button></div></div>
        <ol id="action-file-list" class="mt-5 max-h-80 divide-y divide-line overflow-y-auto rounded-xl border border-line"></ol>
        {tool.slug === 'merge-pdf' && <p id="merge-minimum" class="mt-3 text-sm font-medium text-amber" aria-live="polite">{t('wb.err.tooFew')}</p>}
      </div>
      <form data-workbench-controls id="action-form" class="min-w-0 p-5 sm:p-7">
        {tool.slug === 'pdf-to-word' && (
          <div id="ocr-options" class="mb-5 rounded-control border border-line p-4">
            <label for="ocr-language" class="text-sm font-semibold">{ocrMsg.languageLabel}</label>
            <select id="ocr-language" name="ocrLanguage" class="mt-2 min-h-12 w-full rounded-control border border-line bg-surface px-3 text-sm text-ink">
              {OCR_LANGUAGE_OPTIONS.map((opt) => (
                <option value={opt.code} selected={opt.code === defaultOcrCode}>
                  {opt.nativeName} ({opt.code})
                </option>
              ))}
            </select>
            <p class="mt-2 text-xs text-muted">{ocrMsg.languageHelp}</p>
          </div>
        )}
        {tool.slug === 'rotate-pdf' && <div><label for="rotate-angle" class="text-sm font-semibold">{m.rotation}</label><select id="rotate-angle" name="rotateAngle" class="mt-2 min-h-12 w-full rounded-control border border-line bg-surface px-3 text-sm text-ink"><option value="90">90°</option><option value="180">180°</option><option value="270">270°</option></select></div>}
        {tool.slug === 'split-pdf' && <fieldset><legend class="text-sm font-semibold">{m.whatPreserved}</legend><div class="mt-3 grid gap-2 sm:grid-cols-2"><label class="flex cursor-pointer items-start gap-3 rounded-control border border-line bg-surface p-3 hover:border-line-strong has-[:checked]:border-cyan has-[:checked]:bg-cyan-soft"><input type="radio" name="splitMode" value="smart" checked class="mt-1 accent-cyan"/><span><span class="block text-sm font-medium">{m.smallerFile}</span><span class="mt-1 block text-xs leading-5 text-muted">{t('lim.compress')}</span></span></label><label class="flex cursor-pointer items-start gap-3 rounded-control border border-line bg-surface p-3 hover:border-line-strong has-[:checked]:border-cyan has-[:checked]:bg-cyan-soft"><input type="radio" name="splitMode" value="preserve" class="mt-1 accent-cyan"/><span><span class="block text-sm font-medium">{m.betterQuality}</span><span class="mt-1 block text-xs leading-5 text-muted">{copy.note}</span></span></label></div></fieldset>}
        {tool.slug === 'remove-pages' && <div><label for="remove-page-spec" class="text-sm font-semibold">{t('opt.pages')}</label><input id="remove-page-spec" name="removePageSpec" type="text" inputmode="text" autocomplete="off" placeholder={t('opt.pagesHint')} class="mt-2 min-h-12 w-full rounded-control border border-line bg-surface px-3 text-sm text-ink"/><p class="mt-2 text-xs leading-5 text-muted">{t('opt.pagesHint')}</p></div>}
        {tool.slug === 'watermark-pdf' && <div class="space-y-5">
          <fieldset><legend class="text-sm font-semibold">{watermarkMsg.watermarkType}</legend><div class="mt-3 grid grid-cols-2 rounded-control bg-canvas p-1 text-sm"><button type="button" data-watermark-mode="text" aria-pressed="true" class="min-h-11 rounded-md bg-surface px-3 font-medium text-ink shadow-small hover:text-blue-strong focus-visible:ring-2 focus-visible:ring-blue">{watermarkMsg.text}</button><button type="button" data-watermark-mode="image" aria-pressed="false" class="min-h-11 rounded-md px-3 font-medium text-muted hover:text-ink focus-visible:ring-2 focus-visible:ring-blue">{watermarkMsg.image}</button></div></fieldset>
          <div data-watermark-panel="text"><label for="watermark-text" class="text-sm font-semibold">{t('opt.text')}</label><input id="watermark-text" name="watermarkText" type="text" autocomplete="off" maxlength="60" placeholder={t('opt.text')} class="mt-2 min-h-12 w-full rounded-control border border-line bg-surface px-3 text-sm text-ink"/></div>
          <div data-watermark-panel="image" hidden>
            <label for="watermark-image" class="text-sm font-semibold">{watermarkMsg.uploadImage}</label>
            <input id="watermark-image" name="watermarkImage" type="file" accept="image/png,image/jpeg,image/webp,.png,.jpg,.jpeg,.webp" class="mt-2 block min-h-12 w-full rounded-control border border-line bg-surface p-2 text-sm file:mr-3 file:rounded-md file:border-0 file:bg-violet-soft file:px-3 file:py-2 file:font-medium file:text-violet hover:border-line-strong focus-visible:ring-2 focus-visible:ring-blue"/>
            <p class="mt-2 text-xs leading-5 text-muted">{watermarkMsg.imageHelp}</p>
            <fieldset id="watermark-image-options" hidden class="mt-4"><legend class="text-sm font-semibold">{watermarkMsg.imageTreatment}</legend><div class="mt-3 grid gap-2 sm:grid-cols-2">
              <label class="flex cursor-pointer items-start gap-3 rounded-control border border-line bg-surface p-3 hover:border-line-strong has-[:checked]:border-violet has-[:checked]:bg-violet-soft"><input type="radio" name="watermarkImageTreatment" value="as-is" checked class="mt-1 accent-violet"/><span><span class="block text-sm font-medium">{watermarkMsg.useAsIs}</span><span class="mt-1 block text-xs leading-5 text-muted">{watermarkMsg.useAsIsHelp}</span></span></label>
              <label class="flex cursor-pointer items-start gap-3 rounded-control border border-line bg-surface p-3 hover:border-line-strong has-[:checked]:border-violet has-[:checked]:bg-violet-soft"><input type="radio" name="watermarkImageTreatment" value="remove" class="mt-1 accent-violet"/><span><span class="block text-sm font-medium">{watermarkMsg.removeBackground}</span><span class="mt-1 block text-xs leading-5 text-muted">{watermarkMsg.removeBackgroundHelp}</span></span></label>
            </div></fieldset>
            <div id="watermark-cleanup-controls" hidden class="mt-4"><div class="flex items-center justify-between gap-3"><label for="watermark-cleanup" class="text-xs font-medium text-muted">{watermarkMsg.cleanupStrength}</label><output id="watermark-cleanup-output" for="watermark-cleanup" class="font-mono text-xs font-medium text-muted">32%</output></div><input id="watermark-cleanup" name="watermarkCleanup" type="range" min="8" max="72" value="32" aria-valuetext="32%" class="mt-2 w-full accent-violet"/></div>
            <div id="watermark-image-preview" hidden class="mt-4 grid grid-cols-2 gap-2"><figure class="min-w-0 overflow-hidden rounded-control border border-line bg-surface"><div class="grid h-28 place-items-center bg-[linear-gradient(45deg,var(--color-canvas)_25%,transparent_25%),linear-gradient(-45deg,var(--color-canvas)_25%,transparent_25%),linear-gradient(45deg,transparent_75%,var(--color-canvas)_75%),linear-gradient(-45deg,transparent_75%,var(--color-canvas)_75%)] bg-[length:16px_16px] bg-[position:0_0,0_8px,8px_-8px,-8px_0]"><img id="watermark-image-before" alt={watermarkMsg.beforeAlt} width="320" height="112" class="h-28 w-full object-contain"/></div><figcaption class="border-t border-line px-2 py-1.5 text-xs text-muted">{watermarkMsg.before}</figcaption></figure><figure class="min-w-0 overflow-hidden rounded-control border border-line bg-surface"><div class="grid h-28 place-items-center bg-[linear-gradient(45deg,var(--color-canvas)_25%,transparent_25%),linear-gradient(-45deg,var(--color-canvas)_25%,transparent_25%),linear-gradient(45deg,transparent_75%,var(--color-canvas)_75%),linear-gradient(-45deg,transparent_75%,var(--color-canvas)_75%)] bg-[length:16px_16px] bg-[position:0_0,0_8px,8px_-8px,-8px_0]"><img id="watermark-image-after" alt={watermarkMsg.afterAlt} width="320" height="112" class="h-28 w-full object-contain"/></div><figcaption class="border-t border-line px-2 py-1.5 text-xs text-muted">{watermarkMsg.after}</figcaption></figure></div>
          </div>
          <div><div class="flex items-center justify-between gap-4"><label for="watermark-opacity" class="text-sm font-semibold">{t('opt.opacity')}</label><output id="watermark-opacity-output" for="watermark-opacity" class="font-mono text-sm">20%</output></div><input id="watermark-opacity" name="watermarkOpacity" type="range" min="5" max="50" step="5" value="20" aria-valuetext="20%" class="mt-3 w-full accent-ink"/></div>
        </div>}
        {tool.slug === 'page-numbers' && <div class="grid gap-5 sm:grid-cols-2"><div><label for="page-number-position" class="text-sm font-semibold">{t('opt.position')}</label><select id="page-number-position" name="pageNumberPosition" class="mt-2 min-h-12 w-full rounded-control border border-line bg-surface px-3 text-sm text-ink"><option value="bottom-center">{t('optval.bottom-center')}</option><option value="bottom-right">{t('optval.bottom-right')}</option><option value="top-center">{t('optval.top-center')}</option><option value="top-right">{t('optval.top-right')}</option></select></div><div><label for="page-number-start" class="text-sm font-semibold">{t('opt.page')}</label><input id="page-number-start" name="pageNumberStart" type="number" inputmode="numeric" min="1" max="999999" value="1" class="mt-2 min-h-12 w-full rounded-control border border-line bg-surface px-3 text-sm text-ink"/></div></div>}
        {tool.slug === 'sign-pdf' && <div>
          <fieldset><legend class="text-sm font-semibold">{t('opt.signature')}</legend><div class="mt-3 grid grid-cols-3 rounded-control bg-canvas p-1 text-sm"><button type="button" data-sign-mode="type" aria-pressed="true" class="min-h-10 rounded-md bg-surface px-2 font-medium text-ink shadow-small">Type</button><button type="button" data-sign-mode="draw" aria-pressed="false" class="min-h-10 rounded-md px-2 font-medium text-muted">Draw</button><button type="button" data-sign-mode="upload" aria-pressed="false" class="min-h-10 rounded-md px-2 font-medium text-muted">Upload</button></div></fieldset>
          <div data-sign-panel="type" class="mt-4"><label for="signature-text" class="text-sm font-semibold">Your signature</label><input id="signature-text" name="signatureText" type="text" autocomplete="off" maxlength="80" class="mt-2 min-h-12 w-full rounded-control border border-line bg-surface px-3 text-sm text-ink"/></div>
          <div data-sign-panel="draw" hidden class="mt-4"><p class="text-sm font-semibold">Draw your signature</p><canvas id="signature-draw-canvas" width="720" height="240" class="mt-2 h-32 w-full touch-none select-none rounded-control border border-line bg-white [-webkit-user-select:none]" aria-label="Draw your signature"></canvas></div>
          <div data-sign-panel="upload" hidden class="mt-4"><label for="signature-upload" class="text-sm font-semibold">Upload a signature image</label><input id="signature-upload" type="file" accept="image/png,image/jpeg,image/webp,.png,.jpg,.jpeg,.webp" class="mt-2 block min-h-12 w-full rounded-control border border-line bg-surface p-2 text-sm"/><div id="signature-upload-controls" hidden class="mt-3"><div class="flex items-center justify-between gap-3"><label for="signature-cleanup" class="text-xs font-medium text-muted">Background cleanup</label><output id="signature-cleanup-output" for="signature-cleanup" class="text-xs font-medium text-muted">32%</output></div><input id="signature-cleanup" type="range" min="8" max="72" value="32" class="mt-2 w-full accent-blue"/><div class="mt-3 grid grid-cols-2 gap-2"><figure class="overflow-hidden rounded-lg border border-line bg-white"><img id="signature-upload-before" alt="Uploaded signature before background cleanup" class="h-24 w-full object-contain"/><figcaption class="border-t border-line px-2 py-1 text-[10px] text-muted">Before</figcaption></figure><figure class="overflow-hidden rounded-lg border border-line bg-white"><img id="signature-upload-after" alt="Signature after background cleanup" class="h-24 w-full object-contain"/><figcaption class="border-t border-line px-2 py-1 text-[10px] text-muted">After</figcaption></figure></div></div></div>
          <canvas id="signature-canvas" width="720" height="240" hidden aria-hidden="true"></canvas>
          <div class="mt-3 flex items-center justify-end"><button id="signature-clear" type="button" class="min-h-10 shrink-0 rounded-control border border-line px-3 text-sm text-muted hover:bg-canvas hover:text-ink">{t('opt.clear')}</button></div>
          <div id="signature-placement" hidden class="mt-5 rounded-xl border border-line bg-canvas p-3"><div class="flex items-center justify-between gap-3"><label for="signature-page" class="text-sm font-semibold">{t('opt.page')}</label><input id="signature-page" type="number" inputmode="numeric" min="1" value="1" class="min-h-10 w-24 rounded-control border border-line bg-surface px-3 text-sm"/></div><div id="signature-page-stage" class="relative mx-auto mt-3 w-fit max-w-full overflow-hidden rounded-lg bg-white shadow-small"><canvas id="signature-page-preview" class="block h-auto max-h-[22rem] w-auto max-w-full"></canvas><img id="signature-overlay" alt="Signature placement — drag to reposition" draggable="false" class="absolute left-[62%] top-[76%] w-[30%] touch-none select-none object-contain [-webkit-user-drag:none] [-webkit-user-select:none]"/></div><div class="mt-3 flex items-center justify-between gap-3"><label for="signature-size" class="text-xs font-medium text-muted">Signature size</label><input id="signature-size" type="range" min="15" max="55" value="30" class="w-2/3 accent-blue"/></div><p class="mt-2 text-xs leading-5 text-muted">Drag the signature to the exact position. The page preview and downloaded PDF use the same normalized coordinates.</p></div>
          <p id="signature-help" class="mt-4 rounded-control bg-blue-soft px-4 py-3 text-xs leading-5 text-blue-strong">A drawn signature is an image stamp, not a cryptographic digital signature.</p>
        </div>}
        {tool.slug === 'jpg-to-pdf' && <div><label for="image-page-size" class="text-sm font-semibold">{m.pageSize}</label><select id="image-page-size" name="imagePageSize" class="mt-2 min-h-12 w-full rounded-control border border-line bg-surface px-3 text-sm text-ink"><option value="a4">A4</option><option value="image">{m.original}</option></select></div>}
        {tool.slug === 'pdf-to-jpg' && <div><label for="jpg-resolution" class="text-sm font-semibold">{m.imageQuality}</label><select id="jpg-resolution" name="jpgResolution" class="mt-2 min-h-12 w-full rounded-control border border-line bg-surface px-3 text-sm text-ink"><option value="1.5">108 DPI</option><option value="2" selected>144 DPI</option><option value="2.5">180 DPI</option></select></div>}
        <div id="action-tool-note" hidden={tool.slug === 'sign-pdf'} class="rounded-control bg-blue-soft px-4 py-3 text-sm leading-6 text-blue-strong" class:list={[tool.slug !== 'merge-pdf' && tool.slug !== 'split-pdf' && tool.slug !== 'pdf-to-word' && tool.slug !== 'word-to-pdf' ? 'mt-5' : '']}>
          {tool.slug === 'pdf-to-word' ? ocrMsg.layoutWarning : copy.note}
        </div>
        {(tool.slug === 'pdf-to-word' || tool.slug === 'word-to-pdf') && <label class="mt-5 flex cursor-pointer items-start gap-3 text-sm leading-6"><input id="fidelity-confirm" name="fidelityConfirm" type="checkbox" class="mt-1.5 accent-blue"/><span>{m.confirmLimitation}</span></label>}
        <button id="action-process" type="submit" class="mt-6 inline-flex min-h-12 w-full items-center justify-center rounded-control bg-action px-5 text-sm font-medium text-action-contrast transition-colors hover:bg-action-hover disabled:cursor-wait disabled:opacity-50">{m.process}</button>
        {tool.slug === 'pdf-to-word' && <button id="ocr-cancel" type="button" hidden class="mt-3 inline-flex min-h-10 w-full items-center justify-center rounded-control border border-line bg-canvas text-sm font-medium text-ink hover:bg-surface">{ocrMsg.cancel}</button>}
        <p data-workbench-status id="action-status" class="mt-3 min-h-5 text-center text-xs text-muted" aria-live="polite"></p>
      </form>
    </div>
    <div data-workbench-result id="action-result" hidden class="border-t border-line bg-canvas p-5 sm:p-7"><div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-center"><div><p class="text-sm font-semibold text-green">{m.ready}</p><p id="action-result-stats" class="mt-2 text-sm text-muted"></p></div><a id="action-download" class="inline-flex min-h-12 items-center justify-center rounded-control bg-blue px-6 text-sm font-medium text-white hover:bg-blue-strong">{m.download}</a></div><p id="action-result-warning" hidden role="status" class="mt-4 rounded-control bg-amber-soft px-4 py-3 text-sm leading-6 text-amber"></p></div>
  </div>
</section>

<script type="application/json" id="action-workbench-messages" is:inline set:html={JSON.stringify(m).replace(/</g, '\\u003c')}></script>
<script type="application/json" id="watermark-pdf-messages" is:inline set:html={JSON.stringify(watermarkMsg).replace(/</g, '\\u003c')}></script>

<script>
  import pdfWorkerUrl from 'pdfjs-dist/build/pdf.worker.min.mjs?url';
  import { safeOutputStem, setDisplayedFilename } from '../utils/filename';
  import type { WorkbenchMessages } from '../i18n/workbench';
  import type { LocalePath } from '../i18n/config';
  import { getOcrMessages, formatOcrMessage } from '../i18n/ocr';
  import type { OcrLanguageCode } from '../lib/ocr/languages';
  import type { WatermarkPdfMessages } from '../i18n/documentTools';

  const actionMessages = JSON.parse(document.querySelector('#action-workbench-messages')?.textContent || '{}') as WorkbenchMessages;
  const watermarkMessages = JSON.parse(document.querySelector('#watermark-pdf-messages')?.textContent || '{}') as WatermarkPdfMessages;
  type ActionTool = 'merge-pdf' | 'split-pdf' | 'rotate-pdf' | 'remove-pages' | 'watermark-pdf' | 'page-numbers' | 'sign-pdf' | 'jpg-to-pdf' | 'pdf-to-jpg' | 'pdf-to-word' | 'word-to-pdf';
  const actionRoot = document.querySelector<HTMLElement>('#document-tool'); if (!actionRoot) throw new Error('Missing document tool.');
  const localizedAction = actionRoot.dataset.localized === 'true';
  const actionTool = actionRoot.dataset.tool as ActionTool;
  const currentLocale = (actionRoot.dataset.locale || 'en') as LocalePath;
  const ocrMessages = getOcrMessages(currentLocale);

  const actionEl = <T extends HTMLElement>(selector: string) => { const node = actionRoot.querySelector<T>(selector); if (!node) throw new Error(`Missing element: ${selector}`); return node; };
  const actionInput = actionEl<HTMLInputElement>('#action-input'); const actionEmpty = actionEl('#action-empty'); const actionWork = actionEl('#action-work'); const actionResult = actionEl('#action-result'); const actionError = actionEl('#action-error'); const actionStatus = actionEl('#action-status'); const actionForm = actionEl<HTMLFormElement>('#action-form'); const actionButton = actionEl<HTMLButtonElement>('#action-process');
  const ocrCancelButton = actionRoot.querySelector<HTMLButtonElement>('#ocr-cancel');

  let activeAbortController: AbortController | null = null;

  if (ocrCancelButton) {
    ocrCancelButton.addEventListener('click', () => {
      if (activeAbortController) {
        activeAbortController.abort();
        actionStatus.textContent = ocrMessages.cancelled;
        ocrCancelButton.hidden = true;
      }
    });
  }

  const localizeActionMutations = () => {
    if (!localizedAction) return;
    const value = actionStatus.textContent?.trim() || '';
