---
import type { ToolDefinition, ToolSlug } from '../data/tools';
import type { LocalizedToolCopy } from '../i18n/types';
import type { LocalePath } from '../i18n/config';
import { getWorkbenchMessages } from '../i18n/workbench';
import { OCR_LANGUAGE_OPTIONS, OCR_LANGUAGE_BY_LOCALE } from '../lib/ocr/languages';
import { getOcrMessages } from '../i18n/ocr';
import ToolIcon from './ToolIcon.astro';

interface Props {
  tool: ToolDefinition & { slug: ToolSlug };
  locale?: LocalePath;
  copy?: LocalizedToolCopy;
}

const {
  tool,
  locale = 'en',
  copy = {
    title: tool.title,
    short: tool.short,
    description: tool.description,
    note: tool.caution ?? tool.description,
  } as LocalizedToolCopy,
} = Astro.props;

const m = getWorkbenchMessages(locale);
const ocrMsg = getOcrMessages(locale);
const defaultOcrCode = OCR_LANGUAGE_BY_LOCALE[locale] ?? 'eng';

const tones = {
  indigo: 'bg-blue-soft text-blue',
  cyan: 'bg-cyan-soft text-cyan',
  violet: 'bg-violet-soft text-violet',
  coral: 'bg-coral-soft text-coral',
  pink: 'bg-pink-soft text-pink',
  green: 'bg-green-soft text-green',
};
---
<section data-workbench id="document-tool" aria-labelledby="document-tool-heading" class="mx-auto max-w-5xl px-5 sm:px-6" data-tool={tool.slug} data-accept={tool.accept} data-multiple={String(tool.multiple)} data-localized={locale !== 'en' ? 'true' : 'false'} data-copy-note={copy.note} data-locale={locale}>
  <div class="overflow-hidden rounded-card bg-surface shadow-card">
    <div class="border-b border-line px-5 py-4 sm:px-7"><div class="flex flex-wrap items-center justify-between gap-3"><div class="flex items-center gap-3"><span class:list={['flex h-10 w-10 items-center justify-center rounded-xl', tones[tool.tone]]}><ToolIcon icon={tool.icon}/></span><div><p class="eyebrow text-xs font-semibold text-blue">{m.localFileTool}</p><h2 id="document-tool-heading" class="mt-1 text-lg font-semibold tracking-tight">{copy.title}</h2></div></div><div class="inline-flex items-center gap-2 rounded-full bg-green-soft px-3 py-1.5 text-xs font-medium text-green"><span class="h-2 w-2 rounded-full bg-green" aria-hidden="true"></span>{m.noUpload}</div></div></div>
    <div id="action-empty" class="p-4 sm:p-7">
      <div id="action-drop" class="group flex min-h-72 flex-col items-center justify-center rounded-xl border border-dashed border-line-strong bg-canvas px-5 py-12 text-center transition-colors hover:border-blue/60 hover:bg-surface">
        <span class:list={['flex h-14 w-14 items-center justify-center rounded-xl shadow-small', tones[tool.tone]]}><ToolIcon icon={tool.icon}/></span>
        <h3 class="mt-5 text-xl font-semibold tracking-tight">{tool.multiple ? m.chooseFiles : m.chooseFile}</h3>
        <p class="mt-2 max-w-md text-sm leading-6 text-muted">{copy.short} · {m.processedHere}</p>
        <button id="action-choose" type="button" class="mt-6 inline-flex min-h-12 items-center justify-center rounded-control bg-action px-6 text-sm font-medium text-action-contrast shadow-small transition-colors hover:bg-action-hover">{tool.multiple ? m.chooseFiles : m.chooseFile}</button>
        <input id="action-input" name="sourceFiles" class="sr-only" type="file" accept={tool.accept} multiple={tool.multiple} aria-label={tool.multiple ? m.chooseFiles : m.chooseFile} aria-describedby="action-help" />
        <p id="action-help" class="sr-only">{copy.description}</p>
        <p id="action-error" hidden role="alert" tabindex="-1" class="mt-4 max-w-lg break-words rounded-control bg-amber-soft px-4 py-3 text-sm leading-6 text-amber"></p>
      </div>
    </div>
    <div id="action-work" hidden class="grid lg:grid-cols-[1fr_0.85fr]">
      <div class="border-b border-line p-5 sm:p-7 lg:border-b-0 lg:border-r">
        <div class="flex items-center justify-between gap-4"><div><p class="text-sm font-semibold">{tool.multiple ? m.selectedFiles : m.selectedFile}</p><p id="action-total" class="mt-1 text-xs text-muted"></p></div><button id="action-remove" type="button" class="min-h-10 rounded-control px-3 text-sm text-muted hover:bg-canvas hover:text-ink">{m.removeAll}</button></div>
        <ol id="action-file-list" class="mt-5 max-h-80 divide-y divide-line overflow-y-auto rounded-xl border border-line"></ol>
      </div>
      <form data-workbench-controls id="action-form" class="p-5 sm:p-7">
        {tool.slug === 'pdf-to-word' && (
          <div id="ocr-options" class="mb-5 rounded-control border border-line p-4">
            <label for="ocr-language" class="text-sm font-semibold">{ocrMsg.languageLabel}</label>
            <select id="ocr-language" name="ocrLanguage" class="mt-2 min-h-12 w-full rounded-control border border-line bg-surface px-3 text-sm text-ink">
              {OCR_LANGUAGE_OPTIONS.map((opt) => (
                <option value={opt.code} selected={opt.code === defaultOcrCode}>
                  {opt.nativeName} ({opt.code})
                </option>
              ))}
            </select>
            <p class="mt-2 text-xs text-muted">{ocrMsg.languageHelp}</p>
          </div>
        )}
        {tool.slug === 'rotate-pdf' && <div><label for="rotate-angle" class="text-sm font-semibold">{m.rotation}</label><select id="rotate-angle" name="rotateAngle" class="mt-2 min-h-12 w-full rounded-control border border-line bg-surface px-3 text-sm text-ink"><option value="90">90°</option><option value="180">180°</option><option value="270">270°</option></select></div>}
        {tool.slug === 'jpg-to-pdf' && <div><label for="image-page-size" class="text-sm font-semibold">{m.pageSize}</label><select id="image-page-size" name="imagePageSize" class="mt-2 min-h-12 w-full rounded-control border border-line bg-surface px-3 text-sm text-ink"><option value="a4">A4</option><option value="image">{m.original}</option></select></div>}
        {tool.slug === 'pdf-to-jpg' && <div><label for="jpg-resolution" class="text-sm font-semibold">{m.imageQuality}</label><select id="jpg-resolution" name="jpgResolution" class="mt-2 min-h-12 w-full rounded-control border border-line bg-surface px-3 text-sm text-ink"><option value="1.5">108 DPI</option><option value="2" selected>144 DPI</option><option value="2.5">180 DPI</option></select></div>}
        <div class="rounded-control bg-blue-soft px-4 py-3 text-sm leading-6 text-blue-strong" class:list={[tool.slug === 'rotate-pdf' || tool.slug === 'jpg-to-pdf' || tool.slug === 'pdf-to-jpg' ? 'mt-5' : '']}>
          {tool.slug === 'pdf-to-word' ? ocrMsg.layoutWarning : copy.note}
        </div>
        {(tool.slug === 'pdf-to-word' || tool.slug === 'word-to-pdf') && <label class="mt-5 flex cursor-pointer items-start gap-3 text-sm leading-6"><input id="fidelity-confirm" name="fidelityConfirm" type="checkbox" class="mt-1.5 accent-blue"/><span>{m.confirmLimitation}</span></label>}
        <button id="action-process" type="submit" class="mt-6 inline-flex min-h-12 w-full items-center justify-center rounded-control bg-action px-5 text-sm font-medium text-action-contrast transition-colors hover:bg-action-hover disabled:cursor-wait disabled:opacity-50">{m.process}</button>
        {tool.slug === 'pdf-to-word' && <button id="ocr-cancel" type="button" hidden class="mt-3 inline-flex min-h-10 w-full items-center justify-center rounded-control border border-line bg-canvas text-sm font-medium text-ink hover:bg-surface">{ocrMsg.cancel}</button>}
        <p data-workbench-status id="action-status" class="mt-3 min-h-5 text-center text-xs text-muted" aria-live="polite"></p>
      </form>
    </div>
    <div data-workbench-result id="action-result" hidden class="border-t border-line bg-canvas p-5 sm:p-7"><div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-center"><div><p class="text-sm font-semibold text-green">{m.ready}</p><p id="action-result-stats" class="mt-2 text-sm text-muted"></p></div><a id="action-download" class="inline-flex min-h-12 items-center justify-center rounded-control bg-blue px-6 text-sm font-medium text-white hover:bg-blue-strong">{m.download}</a></div><p id="action-result-warning" hidden class="mt-4 rounded-control bg-amber-soft px-4 py-3 text-sm leading-6 text-amber"></p></div>
  </div>
</section>

<script type="application/json" id="action-workbench-messages" is:inline set:html={JSON.stringify(m).replace(/</g, '\\u003c')}></script>

<script>
  import pdfWorkerUrl from 'pdfjs-dist/build/pdf.worker.min.mjs?url';
  import { setDisplayedFilename } from '../utils/filename';
  import type { WorkbenchMessages } from '../i18n/workbench';
  import type { LocalePath } from '../i18n/config';
  import { getOcrMessages, formatOcrMessage } from '../i18n/ocr';
  import type { OcrLanguageCode } from '../lib/ocr/languages';
  import { localizedNoTextStatus } from '../lib/action-messages';

  const actionMessages = JSON.parse(document.querySelector('#action-workbench-messages')?.textContent || '{}') as WorkbenchMessages;
  type ActionTool = 'merge-pdf' | 'split-pdf' | 'rotate-pdf' | 'jpg-to-pdf' | 'pdf-to-jpg' | 'pdf-to-word' | 'word-to-pdf';
  const actionRoot = document.querySelector<HTMLElement>('#document-tool'); if (!actionRoot) throw new Error('Missing document tool.');
  const localizedAction = actionRoot.dataset.localized === 'true';
  const actionTool = actionRoot.dataset.tool as ActionTool;
  const currentLocale = (actionRoot.dataset.locale || 'en') as LocalePath;
  const ocrMessages = getOcrMessages(currentLocale);

  const actionEl = <T extends HTMLElement>(selector: string) => { const node = actionRoot.querySelector<T>(selector); if (!node) throw new Error(`Missing element: ${selector}`); return node; };
  const actionInput = actionEl<HTMLInputElement>('#action-input'); const actionEmpty = actionEl('#action-empty'); const actionWork = actionEl('#action-work'); const actionResult = actionEl('#action-result'); const actionError = actionEl('#action-error'); const actionStatus = actionEl('#action-status'); const actionForm = actionEl<HTMLFormElement>('#action-form'); const actionButton = actionEl<HTMLButtonElement>('#action-process');
  const ocrCancelButton = actionRoot.querySelector<HTMLButtonElement>('#ocr-cancel');

  let activeAbortController: AbortController | null = null;

  if (ocrCancelButton) {
    ocrCancelButton.addEventListener('click', () => {
      if (activeAbortController) {
        activeAbortController.abort();
        actionStatus.textContent = ocrMessages.cancelled;
        ocrCancelButton.hidden = true;
      }
    });
  }

  const localizeActionMutations = () => {
    const value = actionStatus.textContent?.trim() || '';
    const noTextStatus = localizedNoTextStatus(actionTool, value, actionMessages);
    if (noTextStatus) {
      if (value !== noTextStatus) actionStatus.textContent = noTextStatus;
      return;
    }
    if (!localizedAction) return;
    const localizedValues = [actionMessages.processing, actionMessages.finished, actionMessages.failed, actionMessages.invalidFile, actionMessages.tooLarge, actionMessages.noReadableText, actionMessages.noTextAfterOcr, actionMessages.password, actionMessages.confirmLimitation, ocrMessages.cancelled];
    if (value && !localizedValues.includes(value) && !value.includes('…') && !value.includes('OCR')) {
      actionStatus.textContent = /password/i.test(value) ? actionMessages.password
        : /confirm|formatting limitation/i.test(value) ? actionMessages.confirmLimitation
        : /adding|preparing|rendering|extracting|reading|processing/i.test(value) ? actionMessages.processing
        : actionMessages.failed;
    }
    if (actionButton.disabled && actionButton.textContent?.trim() !== actionMessages.processing) actionButton.textContent = actionMessages.processing;
  };
  new MutationObserver(localizeActionMutations).observe(actionRoot, { childList: true, subtree: true, characterData: true });

  let actionFiles: File[] = []; let actionUrl: string | null = null;
  const readableSize = (bytes: number) => bytes < 1000 ? `${bytes} B` : bytes < 1_000_000 ? `${(bytes / 1000).toFixed(0)} KB` : `${(bytes / 1_000_000).toFixed(2)} MB`;
  const baseName = (name: string) => name.replace(/\.[^.]+$/, '').replace(/[^a-zA-Z0-9._-]+/g, '-') || 'sora-file';
  const isPdf = async (file: File) => new TextDecoder('ascii').decode(await file.slice(0, 5).arrayBuffer()) === '%PDF-';
  const imageKind = async (file: File) => { const bytes = new Uint8Array(await file.slice(0, 12).arrayBuffer()); if (bytes[0] === 0xff && bytes[1] === 0xd8 && bytes[2] === 0xff) return 'jpg'; if (bytes[0] === 0x89 && bytes[1] === 0x50 && bytes[2] === 0x4e && bytes[3] === 0x47) return 'png'; return null; };
  const isDocx = async (file: File) => { if (new TextDecoder('ascii').decode(await file.slice(0, 2).arrayBuffer()) !== 'PK') return false; const { unzipSync } = await import('fflate'); try { const archive = unzipSync(new Uint8Array(await file.arrayBuffer()), { filter: fileInfo => fileInfo.name === 'word/document.xml' && fileInfo.originalSize <= 20_000_000 }); return Boolean(archive['word/document.xml']); } catch { return false; } };
  const clearActionUrl = () => { if (actionUrl) URL.revokeObjectURL(actionUrl); actionUrl = null; actionResult.hidden = true; };
  const resetAction = () => { clearActionUrl(); actionFiles = []; actionInput.value = ''; actionEmpty.hidden = false; actionWork.hidden = true; actionError.hidden = true; actionStatus.textContent = ''; if (ocrCancelButton) ocrCancelButton.hidden = true; };
  const failSelection = (message: string) => { resetAction(); actionError.textContent = message; actionError.hidden = false; actionError.focus(); };

  const loadActionFiles = async (files: File[]) => {
    resetAction();
    try {
      if (!files.length) return;
      if (!actionRoot.dataset.multiple || actionRoot.dataset.multiple === 'false') files = files.slice(0, 1);
      if (files.length > 20) throw new Error('Choose no more than 20 files at once.');
      const total = files.reduce((sum, file) => sum + file.size, 0); if (total > 100_000_000) throw new Error('The selected files exceed the 100 MB local-processing safety limit.');
      if (actionTool === 'word-to-pdf' && files[0].size > 25_000_000) throw new Error('Choose a DOCX smaller than 25 MB to protect browser memory.');
      if (['merge-pdf','split-pdf','rotate-pdf','pdf-to-jpg','pdf-to-word'].includes(actionTool)) { for (const file of files) if (!(await isPdf(file))) throw new Error(`${file.name} is not a valid PDF. Choose files with a real PDF signature.`); }
      if (actionTool === 'jpg-to-pdf') { for (const file of files) if (!(await imageKind(file))) throw new Error(`${file.name} is not a valid JPG or PNG image.`); }
      if (actionTool === 'word-to-pdf' && !(await isDocx(files[0]))) throw new Error('Choose a valid DOCX file created by Word, Google Docs, or LibreOffice.');
      actionFiles = files; const list = actionEl<HTMLOListElement>('#action-file-list'); list.textContent = '';
      files.forEach((file, index) => { const item = document.createElement('li'); item.className = 'flex min-w-0 items-center gap-3 px-4 py-3'; const count = document.createElement('span'); count.className = 'shrink-0 font-mono text-xs text-muted'; count.textContent = String(index + 1).padStart(2, '0'); const text = document.createElement('span'); text.className = 'min-w-0 flex-1 truncate text-sm font-medium'; setDisplayedFilename(text, file.name); const size = document.createElement('span'); size.className = 'shrink-0 text-xs text-muted'; size.textContent = readableSize(file.size); item.append(count, text, size); list.append(item); });
      actionEl('#action-total').textContent = localizedAction ? `${files.length} · ${readableSize(total)}` : `${files.length} ${files.length === 1 ? 'file' : 'files'} · ${readableSize(total)}`; actionEmpty.hidden = true; actionWork.hidden = false;
    } catch (error) { const detail = error instanceof Error ? error.message : ''; failSelection(localizedAction ? (/MB|limit|more than|smaller/i.test(detail) ? actionMessages.tooLarge : actionMessages.invalidFile) : (detail || actionMessages.invalidFile)); }
  };

  const downloadBlob = (blob: Blob, name: string, stats: string, warning = '', ocrPages = 0, lowConfidencePages: number[] = []) => {
    clearActionUrl();
    actionUrl = URL.createObjectURL(blob);
    const link = actionEl<HTMLAnchorElement>('#action-download');
    link.href = actionUrl;
    link.download = name;
    actionEl('#action-result-stats').textContent = localizedAction ? readableSize(blob.size) : stats;
    const warningEl = actionEl('#action-result-warning');
    warningEl.textContent = localizedAction && warning ? actionMessages.review : warning;
    warningEl.hidden = !warningEl.textContent;
    if (ocrPages > 0) {
      actionResult.setAttribute('data-ocr-pages', String(ocrPages));
    } else {
      actionResult.removeAttribute('data-ocr-pages');
    }
    if (lowConfidencePages.length > 0) {
      actionResult.setAttribute('data-ocr-low-confidence', lowConfidencePages.join(','));
    } else {
      actionResult.removeAttribute('data-ocr-low-confidence');
    }
    actionResult.hidden = false;
    actionStatus.textContent = actionMessages.finished;
    actionResult.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'nearest' });
  };

  const loadPdfLib = async (file: File) => { const { PDFDocument } = await import('pdf-lib'); return { PDFDocument, source: await PDFDocument.load(await file.arrayBuffer(), { ignoreEncryption: false }) }; };
  const loadPdfJs = async (file: File) => { const pdfjs = await import('pdfjs-dist'); pdfjs.GlobalWorkerOptions.workerSrc = pdfWorkerUrl; return pdfjs.getDocument({ data: new Uint8Array(await file.arrayBuffer()), cMapUrl: '/pdfjs/cmaps/', cMapPacked: true, wasmUrl: '/pdfjs/wasm/' }).promise; };

  const mergePdfs = async () => { const { PDFDocument } = await import('pdf-lib'); const output = await PDFDocument.create(); let pages = 0; for (let i = 0; i < actionFiles.length; i += 1) { actionStatus.textContent = `Adding file ${i + 1} of ${actionFiles.length}…`; const source = await PDFDocument.load(await actionFiles[i].arrayBuffer()); const copied = await output.copyPages(source, source.getPageIndices()); copied.forEach(page => output.addPage(page)); pages += copied.length; } const bytes = await output.save({ useObjectStreams: true }); downloadBlob(new Blob([bytes as BlobPart], { type: 'application/pdf' }), 'merged-sora-files.pdf', `${actionFiles.length} files · ${pages} pages · ${readableSize(bytes.length)}`); };
  const splitPdf = async () => { const { PDFDocument } = await import('pdf-lib'); const { source } = await loadPdfLib(actionFiles[0]); if (source.getPageCount() > 100) throw new Error('Split currently supports up to 100 pages.'); const entries: Record<string, Uint8Array> = {}; for (let i = 0; i < source.getPageCount(); i += 1) { actionStatus.textContent = `Preparing page ${i + 1} of ${source.getPageCount()}…`; const output = await PDFDocument.create(); const [page] = await output.copyPages(source, [i]); output.addPage(page); entries[`page-${String(i + 1).padStart(3, '0')}.pdf`] = await output.save({ useObjectStreams: true }); } const { zipSync } = await import('fflate'); const zipped = zipSync(entries, { level: 6 }); const count = source.getPageCount(); downloadBlob(new Blob([zipped as BlobPart], { type: 'application/zip' }), `${baseName(actionFiles[0].name)}-pages.zip`, `${count} ${count === 1 ? 'PDF' : 'PDFs'} · ${readableSize(zipped.length)}`); };
  const rotatePdf = async () => { const { degrees } = await import('pdf-lib'); const { source } = await loadPdfLib(actionFiles[0]); const angle = Number(actionEl<HTMLSelectElement>('#rotate-angle').value); source.getPages().forEach(page => page.setRotation(degrees((page.getRotation().angle + angle) % 360))); const bytes = await source.save({ useObjectStreams: true }); const count = source.getPageCount(); downloadBlob(new Blob([bytes as BlobPart], { type: 'application/pdf' }), `${baseName(actionFiles[0].name)}-rotated.pdf`, `${count} ${count === 1 ? 'page' : 'pages'} · ${angle}° · ${readableSize(bytes.length)}`); };
  const imagesToPdf = async () => { const { PDFDocument } = await import('pdf-lib'); const output = await PDFDocument.create(); const mode = actionEl<HTMLSelectElement>('#image-page-size').value; for (let i = 0; i < actionFiles.length; i += 1) { actionStatus.textContent = `Adding image ${i + 1} of ${actionFiles.length}…`; const file = actionFiles[i]; const kind = await imageKind(file); const image = kind === 'png' ? await output.embedPng(await file.arrayBuffer()) : await output.embedJpg(await file.arrayBuffer()); let pageWidth: number; let pageHeight: number; if (mode === 'a4') { const landscape = image.width > image.height; pageWidth = landscape ? 841.89 : 595.28; pageHeight = landscape ? 595.28 : 841.89; } else { const scale = Math.min(1, 1600 / Math.max(image.width, image.height)); pageWidth = image.width * scale * 0.75; pageHeight = image.height * scale * 0.75; } const page = output.addPage([pageWidth, pageHeight]); const margin = mode === 'a4' ? 28 : 0; const fit = Math.min((pageWidth - margin * 2) / image.width, (pageHeight - margin * 2) / image.height); const width = image.width * fit; const height = image.height * fit; page.drawImage(image, { x: (pageWidth - width) / 2, y: (pageHeight - height) / 2, width, height }); } const bytes = await output.save({ useObjectStreams: true }); downloadBlob(new Blob([bytes as BlobPart], { type: 'application/pdf' }), 'images-sora-files.pdf', `${actionFiles.length} ${actionFiles.length === 1 ? 'page' : 'pages'} · ${readableSize(bytes.length)}`); };
  const pdfToJpg = async () => { const source = await loadPdfJs(actionFiles[0]); if (source.numPages > 40) throw new Error('PDF to JPG currently supports up to 40 pages.'); const scaleSetting = Number(actionEl<HTMLSelectElement>('#jpg-resolution').value); const entries: Record<string, Uint8Array> = {}; for (let i = 1; i <= source.numPages; i += 1) { actionStatus.textContent = `Rendering page ${i} of ${source.numPages}…`; const page = await source.getPage(i); const base = page.getViewport({ scale: 1 }); let scale = scaleSetting; if (base.width * scale * base.height * scale > 16_000_000) scale *= Math.sqrt(16_000_000 / (base.width * scale * base.height * scale)); const viewport = page.getViewport({ scale }); const canvas = document.createElement('canvas'); canvas.width = Math.ceil(viewport.width); canvas.height = Math.ceil(viewport.height); const context = canvas.getContext('2d', { alpha: false }); if (!context) throw new Error('Canvas rendering is unavailable.'); context.fillStyle = '#fff'; context.fillRect(0, 0, canvas.width, canvas.height); await page.render({ canvas, canvasContext: context, viewport, background: '#fff' }).promise; const blob = await new Promise<Blob>((resolve, reject) => canvas.toBlob(value => value ? resolve(value) : reject(new Error('JPG encoding failed.')), 'image/jpeg', 0.86)); entries[`page-${String(i).padStart(3, '0')}.jpg`] = new Uint8Array(await blob.arrayBuffer()); page.cleanup(); canvas.width = 1; canvas.height = 1; } const count = source.numPages; await source.cleanup(); const { zipSync } = await import('fflate'); const zipped = zipSync(entries, { level: 0 }); downloadBlob(new Blob([zipped as BlobPart], { type: 'application/zip' }), `${baseName(actionFiles[0].name)}-jpg.zip`, `${count} JPG ${count === 1 ? 'file' : 'files'} · ${readableSize(zipped.length)}`); };

  const pdfToWord = async () => {
    const pdfDoc = await loadPdfJs(actionFiles[0]);
    const selectedLangCode = (actionRoot.querySelector<HTMLSelectElement>('#ocr-language')?.value || 'eng') as OcrLanguageCode;

    const { extractPdfForWord } = await import('../lib/pdf-to-word/convert');
    const { createDocxFromPages } = await import('../lib/pdf-to-word/docx');

    activeAbortController = new AbortController();
    if (ocrCancelButton) ocrCancelButton.hidden = false;

    const docAdapter = {
      pageCount: pdfDoc.numPages,
      async openPage(pageNum: number) {
        const page = await pdfDoc.getPage(pageNum);
        return {
          number: pageNum,
          async textItems() {
            const content = await page.getTextContent();
            return content.items as any[];
          },
          async renderForOcr(maxPixels: number) {
            const base = page.getViewport({ scale: 1 });
            const scale = Math.min(2, Math.sqrt(maxPixels / Math.max(1, base.width * base.height)));
            const viewport = page.getViewport({ scale });
            const canvas = document.createElement('canvas');
            canvas.width = Math.ceil(viewport.width);
            canvas.height = Math.ceil(viewport.height);
            const ctx = canvas.getContext('2d', { alpha: false });
            if (!ctx) throw new Error('Canvas context unavailable');
            ctx.fillStyle = '#fff';
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            await page.render({ canvas, canvasContext: ctx, viewport, background: '#fff' }).promise;
            return canvas;
          },
          cleanup() {
            page.cleanup();
          },
        };
      },
      async destroy() {
        await pdfDoc.cleanup();
      },
    };

    let ocrPagesCount = 0;
    let lowConfidencePages: number[] = [];

    try {
      const extractedPages = await extractPdfForWord({
        document: docAdapter,
        createOcrEngine: async (onProgress) => {
          const { createLocalOcrEngine } = await import('../lib/ocr/local-engine');
          return await createLocalOcrEngine(selectedLangCode, onProgress);
        },
        signal: activeAbortController.signal,
        onProgress: (p) => {
          if (p.stage === 'inspecting') {
            actionStatus.textContent = formatOcrMessage(ocrMessages.inspecting, { current: p.page, total: p.total });
          } else if (p.stage === 'scan-count') {
            ocrPagesCount = p.scannedPages;
            if (p.warning) {
              actionStatus.textContent = ocrMessages.tooManyScans;
            }
          } else if (p.stage === 'loading-model') {
            actionStatus.textContent = formatOcrMessage(ocrMessages.loadingModel, { code: selectedLangCode });
          } else if (p.stage === 'recognizing') {
            actionStatus.textContent = formatOcrMessage(ocrMessages.recognizingPage, { current: p.page, total: p.total });
          } else if (p.stage === 'complete') {
            lowConfidencePages = p.lowConfidencePages;
          }
        },
      });

      const blob = await createDocxFromPages(extractedPages, currentLocale === 'ar' ? 'rtl' : 'ltr');
      let summaryText = ocrMessages.layoutWarning;
      if (ocrPagesCount > 0) {
        summaryText = formatOcrMessage(ocrMessages.ocrSummary, { pages: ocrPagesCount }) + ' ' + summaryText;
      }

      downloadBlob(
        blob,
        `${baseName(actionFiles[0].name)}.docx`,
        `${pdfDoc.numPages} ${pdfDoc.numPages === 1 ? 'page' : 'pages'} · ${readableSize(blob.size)}`,
        summaryText,
        ocrPagesCount,
        lowConfidencePages,
      );
    } finally {
      if (ocrCancelButton) ocrCancelButton.hidden = true;
      activeAbortController = null;
      await pdfDoc.cleanup().catch(() => {});
    }
  };

  const wordToPdf = async () => { actionStatus.textContent = 'Reading document text locally…'; const mammoth = await import('mammoth'); const result = await mammoth.extractRawText({ arrayBuffer: await actionFiles[0].arrayBuffer() }); const text = result.value.trim(); if (!text) throw new Error('No readable text was found in this DOCX file.'); const { jsPDF } = await import('jspdf'); const pdf = new jsPDF({ unit: 'pt', format: 'a4', compress: true }); const margin = 54; const width = pdf.internal.pageSize.getWidth() - margin * 2; const lines = pdf.splitTextToSize(text, width) as string[]; const lineHeight = 16; let y = margin; pdf.setFont('helvetica', 'normal'); pdf.setFontSize(11); for (let i = 0; i < lines.length; i += 1) { if (y > pdf.internal.pageSize.getHeight() - margin) { pdf.addPage(); y = margin; } pdf.text(lines[i], margin, y); y += lineHeight; } const blob = pdf.output('blob'); downloadBlob(blob, `${baseName(actionFiles[0].name)}.pdf`, `${pdf.getNumberOfPages()} ${pdf.getNumberOfPages() === 1 ? 'page' : 'pages'} · ${readableSize(blob.size)}`, 'This text-first PDF does not reproduce advanced Word formatting, images, headers, columns, or exact pagination.'); };

  const processAction = async () => { if (!actionFiles.length) return; if ((actionTool === 'pdf-to-word' || actionTool === 'word-to-pdf') && !actionEl<HTMLInputElement>('#fidelity-confirm').checked) { actionStatus.textContent = 'Confirm the formatting limitation before continuing.'; actionEl<HTMLInputElement>('#fidelity-confirm').focus(); return; } actionButton.disabled = true; const original = actionButton.textContent ?? 'Process locally'; actionButton.textContent = 'Processing…'; actionResult.hidden = true; try { if (actionTool === 'merge-pdf') await mergePdfs(); else if (actionTool === 'split-pdf') await splitPdf(); else if (actionTool === 'rotate-pdf') await rotatePdf(); else if (actionTool === 'jpg-to-pdf') await imagesToPdf(); else if (actionTool === 'pdf-to-jpg') await pdfToJpg(); else if (actionTool === 'pdf-to-word') await pdfToWord(); else await wordToPdf(); } catch (error: any) { if (error?.code === 'cancelled' || error?.message?.includes('cancelled')) { actionStatus.textContent = ocrMessages.cancelled; } else { actionStatus.textContent = error instanceof Error ? error.message : 'Local processing failed.'; } } finally { actionButton.disabled = false; actionButton.textContent = original; } };
  actionEl<HTMLButtonElement>('#action-choose').addEventListener('click', () => actionInput.click()); actionInput.addEventListener('change', () => void loadActionFiles(Array.from(actionInput.files ?? []))); actionEl<HTMLButtonElement>('#action-remove').addEventListener('click', resetAction); actionForm.addEventListener('submit', event => { event.preventDefault(); void processAction(); });
  const actionDrop = actionEl('#action-drop'); for (const eventName of ['dragenter','dragover']) actionDrop.addEventListener(eventName, event => { event.preventDefault(); actionDrop.classList.add('border-blue','bg-blue-soft','select-none'); }); for (const eventName of ['dragleave','drop']) actionDrop.addEventListener(eventName, event => { event.preventDefault(); actionDrop.classList.remove('border-blue','bg-blue-soft','select-none'); }); actionDrop.addEventListener('drop', event => { const files = Array.from(event.dataTransfer?.files ?? []); if (files.length) void loadActionFiles(files); }); window.addEventListener('beforeunload', clearActionUrl);
</script>
