    .no-conversion-options [data-workspace-body] { grid-template-rows: auto auto; }
  }
  @media (max-width: 767px) {
    .action-workspace [data-image-file] { display: grid; grid-template-columns: auto 3rem minmax(0,1fr); }
    .action-workspace [data-image-file] [data-file-controls] { grid-column: 2 / -1; justify-content: flex-end; }
    .action-workspace [data-file-controls] button { min-width: 2.75rem; min-height: 2.75rem; }
    .action-workspace.no-conversion-options [data-workspace-body] { display: grid; grid-template-rows: minmax(0,1fr) auto; }
    .action-workspace.no-conversion-options[data-workspace-mode='preview'][data-mobile-view] [data-workspace-source], .action-workspace.no-conversion-options[data-workspace-mode='preview'][data-mobile-view] [data-workspace-inspector] { display: block !important; height: auto; }
    .action-workspace [data-workspace-body] { display: block; overflow: hidden; }
    .action-workspace[data-workspace-mode='canvas'][data-mobile-view='canvas'] [data-workspace-inspector] { display: none; }
    .action-workspace[data-workspace-mode='canvas'][data-mobile-view='pages'] [data-workspace-inspector] { display: none; }
    .action-workspace[data-workspace-mode='canvas'][data-mobile-view='inspector'] [data-workspace-body] { display: grid; grid-template-columns: minmax(0,1fr); grid-template-rows: minmax(11.5rem, 42%) minmax(0, 1fr); }
    .action-workspace[data-workspace-mode='canvas'][data-mobile-view='inspector'] [data-workspace-source], .action-workspace[data-workspace-mode='canvas'][data-mobile-view='inspector'] [data-workspace-inspector] { height: auto; min-height: 0; }
    .action-workspace[data-workspace-mode='canvas'][data-mobile-view='inspector'] [data-workspace-filebar] { display: none; }
    .action-workspace[data-workspace-mode='canvas'][data-mobile-view='inspector'] [data-workspace-source] { grid-template-rows: minmax(0,1fr); }
    .action-workspace [data-workspace-source], .action-workspace [data-workspace-inspector] { width: 100%; height: 100%; border: 0; padding: .9rem; }
    .action-workspace [data-workspace-inspector] { display: flex; flex-direction: column; padding-bottom: max(1rem, env(safe-area-inset-bottom)); }
    .action-workspace #action-process { position: sticky; bottom: 0; z-index: 4; margin-top: auto; box-shadow: 0 -10px 24px var(--color-surface); }
  }
</style>

<script type="application/json" id="action-workbench-messages" is:inline set:html={JSON.stringify(m).replace(/</g, '\\u003c')}></script>
<script type="application/json" id="watermark-pdf-messages" is:inline set:html={JSON.stringify(watermarkMsg).replace(/</g, '\\u003c')}></script>
<script type="application/json" id="conversion-fidelity-messages" is:inline set:html={JSON.stringify(fidelityMsg).replace(/</g, '\\u003c')}></script>

<script>
  import { loadPdfJs as loadPdfJsRuntime } from '../lib/pdfjsRuntime';
  import { safeOutputStem, setDisplayedFilename } from '../utils/filename';
  import type { WorkbenchMessages } from '../i18n/workbench';
  import type { LocalePath } from '../i18n/config';
  import { getOcrMessages } from '../i18n/ocr';
  import type { ConversionFidelityMessages, WatermarkPdfMessages } from '../i18n/documentTools';
  import { VisualPdfWorkspace } from '../lib/pdf/visual-workspace';

  const actionMessages = JSON.parse(document.querySelector('#action-workbench-messages')?.textContent || '{}') as WorkbenchMessages;
  const watermarkMessages = JSON.parse(document.querySelector('#watermark-pdf-messages')?.textContent || '{}') as WatermarkPdfMessages;
  const fidelityMessages = JSON.parse(document.querySelector('#conversion-fidelity-messages')?.textContent || '{}') as ConversionFidelityMessages;
  type ActionTool = 'merge-pdf' | 'split-pdf' | 'rotate-pdf' | 'remove-pages' | 'watermark-pdf' | 'page-numbers' | 'sign-pdf' | 'jpg-to-pdf' | 'pdf-to-jpg' | 'pdf-to-word' | 'word-to-pdf';
  const actionRoot = document.querySelector<HTMLElement>('#document-tool'); if (!actionRoot) throw new Error('Missing document tool.');
  const localizedAction = actionRoot.dataset.localized === 'true';
  const actionTool = actionRoot.dataset.tool as ActionTool;
  const currentLocale = (actionRoot.dataset.locale || 'en') as LocalePath;
  const ocrMessages = getOcrMessages(currentLocale);

  const splitMode = actionRoot.querySelector<HTMLSelectElement>('#split-mode');
  const syncSplitOptions = () => actionRoot.querySelectorAll<HTMLElement>('[data-split-option]').forEach(group => { group.hidden = group.dataset.splitOption !== splitMode?.value; });
  splitMode?.addEventListener('change', syncSplitOptions);
  syncSplitOptions();
  const actionEl = <T extends HTMLElement>(selector: string) => { const node = actionRoot.querySelector<T>(selector); if (!node) throw new Error(`Missing element: ${selector}`); return node; };
  const actionInput = actionEl<HTMLInputElement>('#action-input'); const actionEmpty = actionEl('#action-empty'); const actionWork = actionEl('#action-work'); const actionResult = actionEl('#action-result'); const actionError = actionEl('#action-error'); const actionStatus = actionEl('#action-status'); const actionForm = actionEl<HTMLFormElement>('#action-form'); const actionButton = actionEl<HTMLButtonElement>('#action-process');
  const ocrCancelButton = actionRoot.querySelector<HTMLButtonElement>('#ocr-cancel');
  const pdfWorkspaceRoot = actionRoot.querySelector<HTMLElement>('[data-pdf-workspace]');
  const pdfWorkspace = pdfWorkspaceRoot ? new VisualPdfWorkspace(pdfWorkspaceRoot) : null;

  let activeAbortController: AbortController | null = null;

  if (ocrCancelButton) {
    ocrCancelButton.addEventListener('click', () => {
      if (activeAbortController) {
        activeAbortController.abort();
        actionStatus.textContent = ocrMessages.cancelled;
        ocrCancelButton.hidden = true;
      }
    });
  }

  const localizeActionMutations = () => {
    if (!localizedAction) return;
    const value = actionStatus.textContent?.trim() || '';
    const localizedValues = [actionMessages.processing, actionMessages.finished, actionMessages.failed, actionMessages.invalidFile, actionMessages.tooLarge, actionMessages.noText, actionMessages.password, actionMessages.confirmLimitation, ocrMessages.cancelled];
    if (value && !localizedValues.includes(value) && !value.includes('…') && !value.includes('OCR')) {
      actionStatus.textContent = /no selectable text|no readable text/i.test(value) ? actionMessages.noText
        : /password/i.test(value) ? actionMessages.password
        : /confirm|formatting limitation/i.test(value) ? actionMessages.confirmLimitation
        : /adding|preparing|rendering|extracting|reading|processing/i.test(value) ? actionMessages.processing
        : actionMessages.failed;
    }
    if (actionButton.disabled && actionButton.textContent?.trim() !== actionMessages.processing) actionButton.textContent = actionMessages.processing;
  };
  new MutationObserver(localizeActionMutations).observe(actionRoot, { childList: true, subtree: true, characterData: true });

  let actionFiles: File[] = []; let actionUrl: string | null = null; let signatureHasInk = false;
  let watermarkMode: 'text' | 'image' = 'text';
  let watermarkSourceCanvas: HTMLCanvasElement | null = null;
  let watermarkProcessedCanvas: HTMLCanvasElement | null = null;
  let watermarkUploadUrl: string | null = null;
  let signatureUploadUrl: string | null = null;
  let signaturePdfPreview: any = null;
  let signaturePreviewTask: { cancel: () => void; promise: Promise<unknown> } | null = null;
  let imageRotations = new WeakMap<File, number>();
  let actionFilePreviewUrls: string[] = [];
  const readableSize = (bytes: number) => bytes < 1000 ? `${bytes} B` : bytes < 1_000_000 ? `${(bytes / 1000).toFixed(0)} KB` : `${(bytes / 1_000_000).toFixed(2)} MB`;
  const baseName = (name: string) => safeOutputStem(name);
  const isPdf = async (file: File) => new TextDecoder('ascii').decode(await file.slice(0, 5).arrayBuffer()) === '%PDF-';
  const imageKind = async (file: File) => { const bytes = new Uint8Array(await file.slice(0, 12).arrayBuffer()); if (bytes[0] === 0xff && bytes[1] === 0xd8 && bytes[2] === 0xff) return 'jpg'; if (bytes[0] === 0x89 && bytes[1] === 0x50 && bytes[2] === 0x4e && bytes[3] === 0x47) return 'png'; return null; };
  const isDocx = async (file: Blob) => { if (new TextDecoder('ascii').decode(await file.slice(0, 2).arrayBuffer()) !== 'PK') return false; const { unzipSync } = await import('fflate'); try { const archive = unzipSync(new Uint8Array(await file.arrayBuffer()), { filter: fileInfo => fileInfo.name === 'word/document.xml' && fileInfo.originalSize <= 20_000_000 }); return Boolean(archive['word/document.xml']); } catch { return false; } };
  const clearActionUrl = () => { if (actionUrl) URL.revokeObjectURL(actionUrl); actionUrl = null; actionResult.hidden = true; };
  const resetAction = () => { clearActionUrl(); actionWork.dispatchEvent(new CustomEvent('workspace-clean')); void pdfWorkspace?.clear(); actionFilePreviewUrls.forEach(URL.revokeObjectURL); actionFilePreviewUrls = []; imageRotations = new WeakMap(); if (signatureUploadUrl) URL.revokeObjectURL(signatureUploadUrl); signatureUploadUrl = null; if (watermarkUploadUrl) URL.revokeObjectURL(watermarkUploadUrl); watermarkUploadUrl = null; watermarkSourceCanvas = null; watermarkProcessedCanvas = null; signaturePreviewTask?.cancel(); signaturePreviewTask = null; void signaturePdfPreview?.cleanup(); signaturePdfPreview = null; signatureHasInk = false; actionFiles = []; actionInput.value = ''; actionInput.removeAttribute('aria-invalid'); actionEmpty.hidden = false; actionWork.hidden = true; actionError.hidden = true; actionStatus.textContent = ''; if (ocrCancelButton) ocrCancelButton.hidden = true; };
  const failSelection = (message: string) => { resetAction(); actionError.textContent = message; actionError.hidden = false; actionInput.setAttribute('aria-invalid', 'true'); actionError.focus(); };

  const renderActionFiles = () => {
    const list = actionEl<HTMLOListElement>('#action-file-list');
    list.textContent = '';
    actionFilePreviewUrls.forEach(URL.revokeObjectURL); actionFilePreviewUrls = [];
    actionFiles.forEach((file, index) => {
      const item = document.createElement('li');
      item.className = 'flex min-w-0 items-center gap-2 px-3 py-3';
      item.dataset.fileIndex = String(index);
      if (actionTool === 'jpg-to-pdf') item.dataset.imageFile = '';
      const count = document.createElement('span'); count.className = 'shrink-0 font-mono text-xs text-muted'; count.textContent = String(index + 1).padStart(2, '0');
      if (actionTool === 'jpg-to-pdf') { const url = URL.createObjectURL(file); actionFilePreviewUrls.push(url); const preview = document.createElement('img'); preview.src = url; preview.alt = ''; preview.className = 'h-12 w-12 shrink-0 rounded-lg border border-line bg-canvas object-cover'; preview.style.transform = `rotate(${imageRotations.get(file) ?? 0}deg)`; item.append(count, preview); }
      const text = document.createElement('span'); text.className = 'min-w-0 flex-1';
      const name = document.createElement('span'); name.className = 'block truncate text-sm font-medium'; name.dataset.workspaceSourceName = ''; setDisplayedFilename(name, file.name);
      const size = document.createElement('span'); size.className = 'mt-0.5 block text-xs text-muted'; size.textContent = readableSize(file.size);
      text.append(name, size);
      const controls = document.createElement('span'); controls.className = 'flex shrink-0 items-center gap-1';
      controls.dataset.fileControls = '';
      if (actionRoot.dataset.multiple === 'true' && actionRoot.dataset.tool !== 'metadata-remover') {
        for (const [label, delta, symbol] of [['Move up', -1, '↑'], ['Move down', 1, '↓']] as const) {
          const button = document.createElement('button'); button.type = 'button'; button.className = 'inline-flex h-10 w-10 items-center justify-center rounded-lg text-sm text-muted hover:bg-canvas hover:text-ink disabled:opacity-30'; button.textContent = symbol; button.setAttribute('aria-label', `${label}: ${file.name}`); button.disabled = delta < 0 ? index === 0 : index === actionFiles.length - 1;
          button.addEventListener('click', () => { const target = index + delta; [actionFiles[index], actionFiles[target]] = [actionFiles[target], actionFiles[index]]; renderActionFiles(); void pdfWorkspace?.load(actionFiles, loadPdfJs); actionStatus.textContent = `${file.name} is now ${target + 1} of ${actionFiles.length}.`; });
          controls.append(button);
        }
      }
      if (actionTool === 'jpg-to-pdf') for (const [label, delta, symbol] of [['Rotate left', -90, '↶'], ['Rotate right', 90, '↷']] as const) { const button = document.createElement('button'); button.type = 'button'; button.className = 'inline-flex h-10 w-10 items-center justify-center rounded-lg text-sm text-muted hover:bg-canvas hover:text-ink'; button.textContent = symbol; button.setAttribute('aria-label', `${label}: ${file.name}`); button.addEventListener('click', () => { imageRotations.set(file, ((imageRotations.get(file) ?? 0) + delta + 360) % 360); renderActionFiles(); actionStatus.textContent = `${file.name} rotated ${imageRotations.get(file)}°.`; }); controls.append(button); }
      const remove = document.createElement('button'); remove.type = 'button'; remove.className = 'inline-flex h-10 w-10 items-center justify-center rounded-lg text-lg text-muted hover:bg-rose-50 hover:text-rose-600'; remove.textContent = '×'; remove.setAttribute('aria-label', `${actionMessages.remove || 'Remove'}: ${file.name}`); remove.addEventListener('click', () => { actionFiles.splice(index, 1); clearActionUrl(); if (!actionFiles.length) { resetAction(); return; } renderActionFiles(); void pdfWorkspace?.load(actionFiles, loadPdfJs); });
      controls.append(remove); if (actionTool === 'jpg-to-pdf') item.append(text, controls); else item.append(count, text, controls); list.append(item);
    });
    const total = actionFiles.reduce((sum, file) => sum + file.size, 0);
    actionEl('#action-total').textContent = localizedAction ? `${actionFiles.length} · ${readableSize(total)}` : `${actionFiles.length} ${actionFiles.length === 1 ? 'file' : 'files'} · ${readableSize(total)}`;
    const mergeMinimum = actionRoot.querySelector<HTMLElement>('#merge-minimum');
    if (mergeMinimum) mergeMinimum.hidden = actionFiles.length >= 2;
    actionButton.disabled = actionTool === 'merge-pdf' && actionFiles.length < 2;
    actionEmpty.hidden = true; actionWork.hidden = false;
  };

  const loadActionFiles = async (files: File[], append = false) => {
    try {
      if (!files.length) return;
      if (!actionRoot.dataset.multiple || actionRoot.dataset.multiple === 'false') files = files.slice(0, 1);
      const combined = append ? [...actionFiles, ...files] : files;
      if (combined.length > 20) throw new Error('Choose no more than 20 files at once.');
      const total = combined.reduce((sum, file) => sum + file.size, 0); if (total > 100_000_000) throw new Error('The selected files exceed the 100 MB local-processing safety limit.');
      if (actionTool === 'word-to-pdf' && files[0].size > 25_000_000) throw new Error('Choose a DOCX smaller than 25 MB to protect browser memory.');
      if (['merge-pdf','split-pdf','rotate-pdf','remove-pages','watermark-pdf','page-numbers','sign-pdf','pdf-to-jpg','pdf-to-word'].includes(actionTool)) { for (const file of files) if (!(await isPdf(file))) throw new Error(`${file.name} is not a valid PDF. Choose files with a real PDF signature.`); }
      if (actionTool === 'jpg-to-pdf') { for (const file of files) if (!(await imageKind(file))) throw new Error(`${file.name} is not a valid JPG or PNG image.`); }
      if (actionTool === 'word-to-pdf' && !(await isDocx(files[0]))) throw new Error('Choose a valid DOCX file created by Word, Google Docs, or LibreOffice.');
      clearActionUrl(); actionError.hidden = true; actionInput.removeAttribute('aria-invalid'); actionFiles = combined; actionInput.value = ''; renderActionFiles(); if (pdfWorkspace) await pdfWorkspace.load(actionFiles, loadPdfJs); if (actionTool === 'sign-pdf') await setupSignPdfPreview(); actionWork.dispatchEvent(new CustomEvent('workspace-clean'));
    } catch (error) { const detail = error instanceof Error ? error.message : ''; const message = localizedAction ? (/MB|limit|more than|smaller/i.test(detail) ? actionMessages.tooLarge : actionMessages.invalidFile) : (detail || actionMessages.invalidFile); if (append && actionFiles.length) { actionStatus.textContent = message; actionInput.value = ''; } else failSelection(message); }
  };

  const downloadBlob = (blob: Blob, name: string, stats: string, warning = '', ocrPages = 0, lowConfidencePages: number[] = [], warningIsLocalized = false) => {
    clearActionUrl();
    actionUrl = URL.createObjectURL(blob);
    const link = actionEl<HTMLAnchorElement>('#action-download');
    link.href = actionUrl;
    link.download = name;
    actionEl('#action-result-stats').textContent = localizedAction ? readableSize(blob.size) : stats;
    const warningEl = actionEl('#action-result-warning');
    warningEl.textContent = localizedAction && warning && !warningIsLocalized ? actionMessages.review : warning;
    warningEl.hidden = !warningEl.textContent;
    if (ocrPages > 0) {
      actionResult.setAttribute('data-ocr-pages', String(ocrPages));
    } else {
      actionResult.removeAttribute('data-ocr-pages');
    }
    if (lowConfidencePages.length > 0) {
      actionResult.setAttribute('data-ocr-low-confidence', lowConfidencePages.join(','));
    } else {
      actionResult.removeAttribute('data-ocr-low-confidence');
    }
    actionResult.hidden = false;
    actionStatus.textContent = actionMessages.finished;
    actionWork.dispatchEvent(new CustomEvent('workspace-complete'));
    actionResult.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'nearest' });
  };

  const loadPdfLib = async (file: File) => { const { PDFDocument } = await import('pdf-lib'); return { PDFDocument, source: await PDFDocument.load(await file.arrayBuffer(), { ignoreEncryption: false }) }; };
  const loadPdfJs = async (file: File) => { const pdfjs = await loadPdfJsRuntime(); return pdfjs.getDocument({ data: new Uint8Array(await file.arrayBuffer()), cMapUrl: '/pdfjs/cmaps/', cMapPacked: true, wasmUrl: '/pdfjs/wasm/' }).promise; };

