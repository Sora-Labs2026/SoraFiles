---
import type { LocaleContent } from '../i18n/types';
import { localizedPath, type LocalePath } from '../i18n/config';
import prototypeTools from '../data/prototypeHomeTools.json';
import { liveTools } from '../data/liveTools';
import { liveText, liveToolCopy } from '../data/liveI18n';
import PrototypeHomeSections from './PrototypeHomeSections.astro';
import '../styles/v10-home-exact.css';
import HeroVisualization from './HeroVisualization.astro';
import {prototypeText} from '../i18n/prototype';
interface Props { locale: LocalePath; content: LocaleContent; }
const { locale, content } = Astro.props;
const t = (key: string) => liveText(locale, key);
const english = locale === 'en';
const pt=(text:string)=>prototypeText(locale,text);
const groups = ['all','pdf','convert','image','security'];
const labels:Record<string,string> = {all:pt('All'),pdf:'PDF',convert:pt('Convert'),image:pt('Image'),security:pt('Security')};
const primaryGroup=(id:string)=>prototypeTools.find(tool=>tool.id===id)!.category;
const groupsFor=(id:string)=>primaryGroup(id);
---
<main id="main" data-home-root data-count-template={pt('{count} tools')} data-filtered-count-template={pt('{count} of {total} tools')}>
 <section class="home-hero sf-container" data-testid="hero-section">
  <div class="home-hero__grid">
   <div>
    <h1 class="home-hero__title t-display"><span class="sf-line-reveal">{pt('Everyday PDF')}</span><span class="sf-line-reveal">{pt('and image tools.')}</span></h1>
    <p class="home-hero__lead t-lead" data-hero-lcp>{pt('Compress, convert, merge and sign files in your browser. Free, no account.')}</p>
    <form role="search" data-home-search-form class="home-hero__search tool-search">
     <svg class="tool-search__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10.5" cy="10.5" r="7"/><path d="m16 16 5 5"/></svg>
     <input class="tool-search__input" type="search" data-live-tool-search data-testid="hero-search-input" aria-label={content.home.searchLabel} placeholder={english?`Search ${liveTools.length} tools`:content.home.searchPlaceholder} aria-controls="tools-grid" autocomplete="off" />
     <button type="button" data-clear-search class="tool-search__clear" aria-label={content.home.clearSearch} hidden><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m18 6-12 12M6 6l12 12"/></svg></button>
     <kbd class="tool-search__kbd" aria-hidden="true">/</kbd>
    </form>
   </div>
   <div class="home-hero__visual"><HeroVisualization {locale}/></div>
  </div>
 </section>
 <section id="tools" class="tools sf-container" aria-label={t('nav.allTools')}>
  <div class="tools__bar">
   <div class="chips" role="group" aria-label={pt('Filter by category')}>
    {groups.map(group => <button class="chip" type="button" data-home-filter={group} aria-pressed={group === 'all'}>{labels[group]??group} <span class="chip__count tnum">{group === 'all' ? liveTools.length : liveTools.filter(tool => groupsFor(tool.id).split(' ').includes(group)).length}</span></button>)}
   </div>
   <p class="tools__count t-label" data-tool-results-status aria-live="polite">{pt('{count} tools').replace('{count}',String(liveTools.length))}</p>
  </div>
  <ul id="tools-grid" data-tools-grid class="tool-grid" data-collapsed="true">
   {prototypeTools.map((tool,i) => <li data-tool-search-item data-tool-id={tool.id} data-groups={tool.category} data-name={`${tool.name} ${english?'':liveToolCopy(locale,tool.id).n}`.toLowerCase()} data-search={`${tool.name} ${tool.outcome} ${tool.keywords.join(' ')} ${english?'':liveToolCopy(locale,tool.id).n+' '+liveToolCopy(locale,tool.id).t}`.toLowerCase()} style={`--i:${Math.min(i,12)}`}>
    <a class="tool-card" href={localizedPath(locale,tool.href)} data-testid={`tool-card-${tool.id}`}><span class="tool-card__icon" aria-hidden="true" set:html={tool.icon}/><span class="tool-card__body"><span class="tool-card__name">{english?tool.name:liveToolCopy(locale,tool.id).n}</span><span class="tool-card__desc">{english?tool.outcome:liveToolCopy(locale,tool.id).t}</span></span><svg class="tool-card__arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14m-7-7 7 7-7 7"/></svg><kbd class="tool-card__enter" aria-hidden="true"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 10 4 15l5 5M20 4v7a4 4 0 0 1-4 4H4"/></svg></kbd></a>
   </li>)}
  </ul>
  <button class="btn btn--md btn--secondary tools__more" type="button" data-show-all>{pt('Show all 26 tools')}</button>
  <div data-tools-empty hidden class="tools-empty"><p class="t-h3">{english?'No tools match “':content.home.noResults}<span data-empty-query></span>{english?'”':''}</p><p class="t-small tools-empty__hint">{english?'Try a file type like PDF or JPG, or a task like compress.':content.home.searchPlaceholder}</p><button type="button" data-reset-search class="btn btn--sm btn--secondary">{english?'Clear search':content.home.clearSearch}</button></div>
 </section>
 <PrototypeHomeSections {locale}/>
</main>
<style>.home-hero__title>span{display:block;overflow:hidden;padding-bottom:.1em;margin-bottom:-.1em}</style>
<script>
const home=document.querySelector<HTMLElement>('[data-home-root]');
if(home){
 const input=home.querySelector<HTMLInputElement>('[data-live-tool-search]')!;
 const cards=[...home.querySelectorAll<HTMLElement>('[data-tool-search-item]')];
 const buttons=[...home.querySelectorAll<HTMLButtonElement>('[data-home-filter]')];
 const grid=home.querySelector<HTMLElement>('[data-tools-grid]')!;
 let group='all',expanded=false;
 const rank=(card:HTMLElement,query:string)=>{
  if(!query)return 1;
  const terms=query.split(/\s+/),name=card.dataset.name!,words=name.split(' '),hay=card.dataset.search!.split(/[^\p{L}\p{N}]+/u);
  if(!terms.every(term=>hay.some(word=>/[^\x00-\x7f]/.test(term)?word.includes(term):word.startsWith(term))))return 0;
  return terms.every(term=>words.some(word=>word.startsWith(term)))?3:name.includes(query)?2:1;
 };
 const apply=()=>{
  const query=input.value.trim().toLowerCase();
  const ranked=cards.map((card,index)=>({card,index,score:rank(card,query)}));
  const visible=ranked.filter(({card,score})=>score&&(group==='all'||card.dataset.groups===group)).sort((a,b)=>b.score-a.score||a.index-b.index);
  cards.forEach(card=>{card.hidden=true;card.querySelector('a')!.removeAttribute('data-top')});
  visible.forEach(({card},i)=>{card.hidden=false;card.style.setProperty('--i',String(Math.min(i,12)));grid.append(card);if(query&&i===0)card.querySelector('a')!.setAttribute('data-top','true')});
  buttons.forEach(button=>{button.setAttribute('aria-pressed',String(button.dataset.homeFilter===group));button.querySelector('span')!.textContent=String(ranked.filter(({card,score})=>score&&(button.dataset.homeFilter==='all'||card.dataset.groups===button.dataset.homeFilter)).length)});
  const filtered=!!query||group!=='all';grid.dataset.collapsed=String(!filtered&&!expanded);grid.hidden=!visible.length;
  home.querySelector<HTMLElement>('[data-show-all]')!.hidden=filtered||expanded||!visible.length;
  home.querySelector<HTMLElement>('[data-tools-empty]')!.hidden=visible.length>0;
  home.querySelector<HTMLElement>('[data-empty-query]')!.textContent=input.value.trim();
  home.querySelector<HTMLElement>('[data-tool-results-status]')!.textContent=(filtered?home.dataset.filteredCountTemplate!:home.dataset.countTemplate!).replace('{count}',String(visible.length)).replace('{total}',String(cards.length));
  home.querySelector<HTMLElement>('[data-clear-search]')!.hidden=!query;
  home.querySelector<HTMLElement>('.tool-search__kbd')!.hidden=!!query;
 };
 input.addEventListener('input',apply);
 home.querySelector('[data-show-all]')!.addEventListener('click',()=>{expanded=true;apply()});
 buttons.forEach(button=>button.addEventListener('click',()=>{group=button.dataset.homeFilter!;apply()}));
 home.querySelectorAll('[data-clear-search],[data-reset-search]').forEach(button=>button.addEventListener('click',()=>{input.value='';group='all';apply();input.focus()}));
 home.querySelector('form')!.addEventListener('submit',event=>{event.preventDefault();const first=[...grid.querySelectorAll<HTMLElement>('li')].find(card=>!card.hidden)?.querySelector<HTMLAnchorElement>('a');if(first){first.dataset.picked='true';setTimeout(()=>location.assign(first.href),180)}});
 input.addEventListener('keydown',event=>{if(event.key==='Escape'){if(input.value){event.preventDefault();input.value='';apply()}else input.blur()}else if(event.key==='ArrowDown'){event.preventDefault();[...grid.querySelectorAll<HTMLElement>('li')].find(card=>!card.hidden)?.querySelector<HTMLAnchorElement>('a')?.focus()}});
 document.addEventListener('keydown',event=>{if((event.key==='/'||((event.ctrlKey||event.metaKey)&&event.key==='k'))&&!(event.target instanceof HTMLElement && (event.target.matches('input,textarea,select')||event.target.isContentEditable))){event.preventDefault();input.focus()}});
}
</script>
