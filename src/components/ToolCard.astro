---
import type { ToolDefinition } from '../data/tools';
import ToolIcon from './ToolIcon.astro';
import { localizedPath, type LocalePath } from '../i18n/config';
import type { LocalizedToolCopy } from '../i18n/types';
import { buildDiscoveryText } from '../lib/tool-discovery';

interface Props {
  tool: ToolDefinition;
  locale?: LocalePath;
  copy?: LocalizedToolCopy;
  labels?: { open: string; local: string; basic: string };
  searchAliases?: readonly string[];
  priority?: boolean;
}

const {
  tool,
  locale = 'en',
  copy,
  labels = { open: 'Open', local: 'Local processing', basic: 'Basic conversion' },
  searchAliases = [],
  priority = false,
} = Astro.props;

const title = copy?.title ?? tool.title;
const short = copy?.short ?? tool.short;
const description = copy?.description ?? tool.description;
const searchKeywords = buildDiscoveryText(
  [title, short, description, ...tool.formats, ...tool.keywords, ...searchAliases],
  locale,
);
const href = localizedPath(locale, tool.href);

const toneClasses = {
  indigo: 'bg-blue-soft text-blue',
  cyan: 'bg-cyan-soft text-cyan',
  violet: 'bg-violet-soft text-violet',
  coral: 'bg-coral-soft text-coral',
  pink: 'bg-pink-soft text-pink',
  green: 'bg-green-soft text-green',
};
---

<a
  href={href}
  data-tool-card
  data-tool-slug={tool.slug}
  data-tool-category={tool.category}
  data-tool-search={searchKeywords}
  class:list={[
    'group relative flex h-full min-w-0 flex-col border border-line bg-surface transition-[border-color,box-shadow,background-color] duration-200 hover:border-line-strong hover:shadow-small focus-visible:z-10 focus-visible:border-blue focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-2 focus-visible:ring-offset-canvas',
    priority ? 'p-5 sm:p-6' : 'p-5',
  ]}
>
  <div class="relative flex items-start justify-between gap-4">
    <span class:list={['flex h-11 w-11 shrink-0 items-center justify-center rounded-lg', toneClasses[tool.tone]]}>
      <ToolIcon icon={tool.icon} />
    </span>
    <div class="flex flex-wrap justify-end gap-1.5">
      {tool.badge && <span class="rounded-full border border-line bg-canvas px-2 py-1 text-[11px] font-medium text-muted">{tool.badge}</span>}
      {tool.status === 'basic' && <span class="rounded-full border border-amber/20 bg-amber-soft px-2 py-1 text-[11px] font-medium text-amber">{labels.basic}</span>}
    </div>
  </div>

  <h3 class:list={['mt-5 font-semibold tracking-[-0.025em] text-ink', priority ? 'text-lg' : 'text-base']}>{title}</h3>
  <p class="mt-1 text-xs font-medium text-muted">{short}</p>
  <p class="mt-3 text-sm leading-6 text-muted">{description}</p>

  {tool.caution && <p class="mt-3 text-xs leading-5 text-amber">{tool.caution}</p>}

  <div class="mt-auto flex items-end justify-between gap-4 pt-6">
    <ul class="flex min-w-0 flex-wrap gap-1.5" aria-label={`${title} formats`}>
      {tool.formats.slice(0, 4).map((format) => <li class="rounded border border-line bg-canvas px-1.5 py-1 font-mono text-[10px] font-medium text-muted">{format}</li>)}
      {tool.formats.length > 4 && <li class="px-1 py-1 text-[10px] font-medium text-muted">+{tool.formats.length - 4}</li>}
    </ul>
    <span class="inline-flex shrink-0 items-center gap-1 text-xs font-semibold text-blue">
      {labels.open}
      <svg aria-hidden="true" viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.6">
        <g data-tool-direction-arrow class="origin-center rtl:rotate-180" style="transform-box: fill-box">
          <path d="M3 8h9M9 4.5 12.5 8 9 11.5" stroke-linecap="round" stroke-linejoin="round" />
        </g>
      </svg>
    </span>
  </div>
</a>
