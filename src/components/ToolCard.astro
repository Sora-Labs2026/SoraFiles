---
import type { ToolDefinition } from '../data/tools';
import ToolIcon from './ToolIcon.astro';
import { localizedPath, type LocalePath } from '../i18n/config';
import type { LocalizedToolCopy } from '../i18n/types';

interface Props {
  tool: ToolDefinition;
  locale?: LocalePath;
  copy?: LocalizedToolCopy;
  labels?: { open: string; local: string; basic: string };
  priority?: boolean;
}

const {
  tool,
  locale = 'en',
  copy,
  labels = { open: 'Open', local: 'Local processing', basic: 'Basic conversion' },
} = Astro.props;
const title = copy?.title ?? tool.title;
const short = copy?.short ?? tool.short;
const description = copy?.description ?? tool.description;
const searchKeywords = [title, short, description, ...tool.formats, ...tool.keywords].join(' ').toLocaleLowerCase(locale);
const href = localizedPath(locale, tool.href);
const toneClasses = {
  indigo: 'bg-gradient-to-br from-blue-100 to-indigo-100 text-blue',
  cyan: 'bg-gradient-to-br from-cyan-100 to-sky-100 text-cyan',
  violet: 'bg-gradient-to-br from-violet-100 to-fuchsia-100 text-violet',
  coral: 'bg-gradient-to-br from-orange-100 to-rose-100 text-coral',
  pink: 'bg-gradient-to-br from-pink-100 to-fuchsia-100 text-pink',
  green: 'bg-gradient-to-br from-emerald-100 to-teal-100 text-green',
};
---

<article
  data-tool-card
  data-tool-category={tool.category}
  data-tool-search={searchKeywords}
  class="sf-glass group relative flex min-h-48 min-w-0 flex-col rounded-lg border border-white/75 p-4 shadow-card transition-[transform,box-shadow,border-color] duration-200 hover:-translate-y-1 hover:border-violet/25 hover:shadow-xl hover:shadow-violet-500/10"
>
  <a href={href} class="absolute inset-0 z-10 rounded-lg" aria-label={labels.open + ': ' + title}></a>
  <div class="flex items-start justify-between gap-3">
    <span class:list={['icon-pop flex h-12 w-12 shrink-0 items-center justify-center rounded-lg shadow-small', toneClasses[tool.tone]]}>
      <ToolIcon icon={tool.icon} />
    </span>
    {tool.status === 'basic' ? (
      <span class="rounded-full border border-amber/20 bg-amber-soft px-2 py-1 text-[9px] font-bold text-amber">{labels.basic}</span>
    ) : (
      <span class="rounded-full border border-green/15 bg-green-soft px-2 py-1 text-[9px] font-bold text-green">{labels.local}</span>
    )}
  </div>

  <h3 class="mt-5 text-[15px] font-extrabold tracking-tight text-ink">{title}</h3>
  <p class="mt-2 line-clamp-3 text-xs font-medium leading-5 text-muted">{short}</p>

  <div class="mt-auto flex items-center justify-between gap-3 pt-5">
    <span class="truncate text-[10px] font-bold uppercase text-muted">{tool.formats.slice(0, 3).join(' · ')}</span>
    <span class="inline-flex shrink-0 items-center gap-1 text-xs font-bold text-violet">
      {labels.open}
      <svg aria-hidden="true" viewBox="0 0 16 16" class="h-3.5 w-3.5 transition-transform group-hover:translate-x-1 rtl:rotate-180" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3 8h9M9 4.5 12.5 8 9 11.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </span>
  </div>
</article>