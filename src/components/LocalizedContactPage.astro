---
import type { LocaleContent } from '../i18n/types';
import type { LocalePath } from '../i18n/config';
interface Props { locale: LocalePath; page: LocaleContent['pages']['contact']; }
const { locale, page } = Astro.props;
---
<main id="main">
  <section class="grid-surface border-b border-line px-5 py-16 sm:px-6 sm:py-24"><div class="mx-auto max-w-5xl"><h1 class="max-w-4xl text-balance text-[clamp(2.4rem,6vw,4.5rem)] font-semibold leading-[1] tracking-[-0.05em]">{page.h1}</h1><p class="mt-6 max-w-2xl text-pretty text-lg leading-8 text-muted">{page.intro}</p></div></section>
<section class="px-5 py-16 sm:px-6 sm:py-24"><div class="mx-auto grid max-w-5xl gap-10 lg:grid-cols-[0.72fr_1.28fr] lg:items-start"><aside>{page.sections.map((section) => <section><h2 class="text-2xl font-semibold">{section.heading}</h2>{section.paragraphs.map((paragraph) => <p class="mt-4 text-sm leading-7 text-muted">{paragraph}</p>)}</section>)}</aside><div class="border border-line bg-surface"><div data-contact-success hidden role="status" class="border-b border-green/20 bg-green-soft px-6 py-4 text-sm text-green">{page.form.success}</div><form data-contact-form action="https://formsubmit.co/soralabs2026@gmail.com" method="POST" enctype="multipart/form-data" class="space-y-6 p-6 sm:p-8"><input type="hidden" name="_next" value={`https://sorafiles.com/${locale}/contact?sent=1`} /><input type="hidden" name="_subject" value={`SoraFiles ${locale}: Contact`} /><input type="hidden" name="_template" value="table" /><input type="text" name="_honey" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" aria-label="Do not fill this field" /><div class="grid gap-5 sm:grid-cols-2"><label class="text-sm font-medium">{page.form.name}<input name="Name" type="text" autocomplete="name" required maxlength="100" class="mt-2 min-h-12 w-full rounded-control border border-line bg-surface px-3.5 text-sm" /></label><label class="text-sm font-medium">{page.form.email}<input name="email" type="email" autocomplete="email" spellcheck="false" required maxlength="254" class="mt-2 min-h-12 w-full rounded-control border border-line bg-surface px-3.5 text-sm" /></label></div><label class="block text-sm font-medium">{page.form.subject}<select name="Category" autocomplete="off" required class="mt-2 min-h-12 w-full rounded-control border border-line bg-surface px-3.5 text-sm">{page.form.subjects.map((subject) => <option value={subject}>{subject}</option>)}</select></label><label class="block text-sm font-medium">{page.form.message}<textarea name="Message" autocomplete="off" required minlength="20" maxlength="5000" rows="8" class="mt-2 w-full resize-y rounded-control border border-line bg-surface px-3.5 py-3 text-sm leading-6"></textarea></label><label data-contact-attachment-disclosure class="block text-sm font-medium">{page.form.attachment} <span class="font-normal text-muted">({page.form.optional})</span><input name="attachment" type="file" accept=".pdf,.jpg,.jpeg,.png,.webp,.heic,.heif,.doc,.docx,.txt,.zip" class="mt-2 block w-full border border-dashed border-line p-4 text-sm text-muted" /><span class="mt-2 block text-xs leading-5 text-muted">{page.form.attachmentHelp}</span></label><label class="flex items-start gap-3 bg-canvas p-4 text-sm leading-6 text-muted"><input name="Consent" type="checkbox" value="Agreed" required class="mt-1.5 accent-blue"/><span>{page.form.consent}</span></label><button type="submit" class="inline-flex min-h-12 items-center justify-center rounded-control bg-action px-6 text-sm font-medium text-action-contrast hover:bg-action-hover">{page.form.send}</button><p class="text-xs text-muted">{page.form.caution}</p></form></div></div></section>
</main>
<script is:inline define:vars={{ sending: page.form.sending }}>
  const success = document.querySelector('[data-contact-success]');
  if (new URLSearchParams(location.search).get('sent') === '1' && success) success.removeAttribute('hidden');
  document.querySelector('form')?.addEventListener('submit', (event) => { const button = event.currentTarget.querySelector('button[type="submit"]'); if (button) { button.disabled = true; button.textContent = sending; } });
</script>
