---
import type { LiveTool } from '../data/liveTools';
import { localizedPath, type LocalePath } from '../i18n/config';
import { liveToolCopy } from '../data/liveI18n';
import ToolIcon from './ToolIcon.astro';
interface Props { tool: LiveTool; href?: string; modal?: boolean; locale?: LocalePath; }
const { tool, href, modal = false, locale = 'en' } = Astro.props;
const words = liveToolCopy(locale, tool.id);
const classes = `sf-tool-card group relative flex h-28 items-center gap-3 overflow-hidden rounded-2xl border p-4 text-left shadow-sm hover:shadow-lg ${tool.tint}`;
---

{modal ? (
  <a href={localizedPath(locale, `/${tool.slug}`)} data-live-tool-card={tool.id} data-tool-card data-testid={`tool-card-${tool.id}`} class={classes}>
    <span class:list={['flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br text-white shadow-md', tool.tile]}><ToolIcon icon={tool.icon}/></span>
    <span class="min-w-0 pr-5"><span class="line-clamp-2 text-[13px] font-extrabold leading-snug tracking-tight text-slate-800 dark:text-slate-100">{words.n}</span><span class="mt-0.5 line-clamp-3 text-[11px] font-medium leading-snug text-slate-600 dark:text-slate-400">{words.d}</span></span>
    <span class="absolute right-3.5 top-1/2 flex h-6 w-6 -translate-y-1/2 items-center justify-center rounded-full bg-white/90 text-slate-400 shadow-sm ring-1 ring-slate-900/5 transition-colors duration-200 group-hover:text-violet-600 dark:bg-white/10 dark:text-slate-500 dark:ring-white/10 dark:group-hover:text-violet-300"><svg aria-hidden="true" viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg></span>
  </a>
) : (
  <a href={href ?? `/${tool.slug}`} data-tool-card data-testid={`tool-card-${tool.id}`} class={classes}>
    <span class:list={['flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br text-white shadow-md', tool.tile]}><ToolIcon icon={tool.icon}/></span>
    <span class="min-w-0 pr-5"><span class="line-clamp-2 text-[13px] font-extrabold leading-snug tracking-tight text-slate-800 dark:text-slate-100">{words.n}</span><span class="mt-0.5 line-clamp-3 text-[11px] font-medium leading-snug text-slate-600 dark:text-slate-400">{words.d}</span></span>
    <span class="absolute right-3.5 top-1/2 flex h-6 w-6 -translate-y-1/2 items-center justify-center rounded-full bg-white/90 text-slate-400 shadow-sm ring-1 ring-slate-900/5 transition-colors duration-200 group-hover:text-violet-600 dark:bg-white/10 dark:text-slate-500 dark:ring-white/10 dark:group-hover:text-violet-300"><svg aria-hidden="true" viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg></span>
  </a>
)}
