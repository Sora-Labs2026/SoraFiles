---
interface Step {
  title: string;
  text: string;
}

interface Props {
  title: string;
  steps: Step[];
}

const { title, steps } = Astro.props;

const stepIcons = [
  { viewBox: '0 0 24 24', path: 'M5 3h10l4 4v14H5z M9 12h6' },
  { viewBox: '0 0 24 24', path: 'M12 3v6M8 5.5A7 7 0 1 0 16 5.5' },
  { viewBox: '0 0 24 24', path: 'M12 4v11M7 11l5 5 5-5 M5 20h14' },
];
---

<section class="border-b border-line bg-canvas px-5 py-16 sm:px-6 sm:py-20" aria-labelledby="process-flow-heading">
  <div class="mx-auto max-w-6xl">
    <h2 id="process-flow-heading" class="text-balance text-[clamp(1.75rem,4vw,2.5rem)] font-semibold tracking-[-0.04em] text-ink" data-reveal style="--reveal-delay: 0">
      {title}
    </h2>

    <div class="relative mt-10">
      <div
        aria-hidden="true"
        data-draw-line
        class="absolute left-0 top-[1.9375rem] hidden h-px w-full bg-line-strong sm:block"
      >
      </div>
      <ol class="grid border-l border-t border-line sm:grid-cols-3 sm:border-l-0 sm:border-t-0 sm:bg-transparent">
        {steps.map((step, index) => (
          <li
            class="relative -ml-px -mt-px border border-line bg-surface p-6 sm:p-7"
            data-reveal
            style={`--reveal-delay: ${index + 1}`}
          >
            <span class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-line bg-blue-soft text-blue" aria-hidden="true">
              <svg viewBox={stepIcons[index % stepIcons.length].viewBox} class="h-4.5 w-4.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d={stepIcons[index % stepIcons.length].path} />
              </svg>
            </span>
            <h3 class="mt-4 font-semibold tracking-tight text-ink">{step.title}</h3>
            <p class="mt-2 text-sm leading-6 text-muted">{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
