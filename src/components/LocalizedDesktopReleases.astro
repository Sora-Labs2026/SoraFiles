---
import DesktopLayout from '../layouts/PrototypeDesktopLayout.astro';
import releaseManifest from '../../desktop/releases/manifest.json';
import icons from '../data/prototypeIcons.json';
import {localizedPath,type LocalePath} from '../i18n/config';
import {desktopDownloadText} from '../i18n/desktopDownload';
interface Props {locale?:LocalePath}
const {locale='en'}=Astro.props;
const t=desktopDownloadText(locale);
const published=releaseManifest.releases.filter(release=>['active','maintenance'].includes(release.status)&&release.security==='clear');
const versions=[...new Set(published.map(release=>release.version))].sort((a,b)=>b.localeCompare(a,undefined,{numeric:true}));
---
<DesktopLayout title={`SoraFiles Desktop — ${t.releases}`} description={t.releases} path="/desktop/releases" {locale}>
 <header class="container page-intro"><h1 class="t-h1 page-intro__title"><span class="line-reveal"><span class="line-reveal__inner">{t.releases}</span></span></h1></header>
 <section class="container releases" aria-label={t.releases}>{versions.map(version=>{const rows=published.filter(release=>release.version===version);return <article class="panel release" aria-labelledby={`release-${version}`}><span class="tag tnum">{version}</span><h2 class="t-h2" id={`release-${version}`}>SoraFiles Desktop {version}</h2><p class="t-small">{t.published} {rows.map(release=>`${release.platform} ${release.arch}`).join(', ')}.</p><a class="btn btn--secondary btn--md" href={localizedPath(locale,'/desktop/download')}><Fragment set:html={icons.Download.replace('class="','class="btn__icon ')}/><span class="btn__label">{t.downloadRelease}</span></a></article>})}</section>
</DesktopLayout>
