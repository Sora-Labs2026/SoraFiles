---
import type { LocaleContent, LocalizedToolCopy } from '../i18n/types';
import type { LocalePath } from '../i18n/config';
import type { LiveTool } from '../data/liveTools';
import { dedicatedWorkbenchToolIds, documentActionToolIds } from '../data/liveTools';
import { liveText, liveToolCopy } from '../data/liveI18n';
import DocumentActionWorkbench from './DocumentActionWorkbench.astro';
import FileWorkbench from './FileWorkbench.astro';
import ImageConverterWorkbench from './ImageConverterWorkbench.astro';
import PdfWorkbench from './PdfWorkbench.astro';
import ExtraToolWorkbench from './ExtraToolWorkbench.astro';
import ResizeImageWorkbench from './ResizeImageWorkbench.astro';
import DocScannerWorkbench from './DocScannerWorkbench.astro';
import BackgroundRemovalWorkbench from './BackgroundRemovalWorkbench.astro';
import PrototypeToolSections from './PrototypeToolSections.astro';
import LocalizedPrototypeToolSections from './LocalizedPrototypeToolSections.astro';
import RatingWidget from './RatingWidget.astro';
interface Props { locale: LocalePath; content: LocaleContent; tool: LiveTool; copy?: LocalizedToolCopy; }
const { locale, tool, content } = Astro.props;
const t = (path: string) => liveText(locale, path);
const words = liveToolCopy(locale, tool.id);
const reviewedCopy = (content.tools as Record<string, LocalizedToolCopy>)[tool.id];
const fallbackCopy = { title: words.n, short: words.t, description: words.d, note: words.d, h1: words.n, intro: words.t, sectionTitle: words.n, paragraphs: [words.d], steps: [t('steps.s1t'), t('steps.s2t'), t('steps.s3t')], faqs: [] } as unknown as LocalizedToolCopy;
const exactCopy = reviewedCopy ?? fallbackCopy;
---
<main id="main" class="v10-tool-page" data-testid={`tool-page-${tool.slug}`} data-prototype-tool>
  {locale==='en'?<PrototypeToolSections id={tool.id} part="hero"/>:<LocalizedPrototypeToolSections {locale} {tool} copy={exactCopy} part="hero"/>}
  <section class="container tool-stage" aria-label={words.n}>
    <div id="workbench" class="live-workbench v10-workbench scroll-mt-24">
      {tool.id === 'compress-pdf' && <PdfWorkbench {locale} copy={exactCopy}/>}
      {tool.id === 'image-converter' && <ImageConverterWorkbench {locale} copy={exactCopy}/>}
      {(tool.id === 'compress-image' || tool.id === 'heic-to-jpg') && <FileWorkbench {locale} copy={exactCopy} forceJpg={tool.id === 'heic-to-jpg'}/>}
      {tool.id === 'resize-image' && <ResizeImageWorkbench {locale}/>}
      {tool.id === 'doc-scanner' && <DocScannerWorkbench {locale}/>}
      {tool.id === 'remove-background' && <BackgroundRemovalWorkbench {locale}/>}
      {documentActionToolIds.has(tool.id) && <DocumentActionWorkbench {tool} {locale} copy={exactCopy}/>}
      {!dedicatedWorkbenchToolIds.has(tool.id) && <ExtraToolWorkbench {tool} {locale}/>}
    </div>
  </section>
  <RatingWidget kind="tool" subject={tool.id} name={words.n} {locale}/>
  {locale==='en'?<PrototypeToolSections id={tool.id} part="after"/>:<LocalizedPrototypeToolSections {locale} {tool} copy={exactCopy} part="after"/>}
</main>
