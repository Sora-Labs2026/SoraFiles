---
import type { LocalePath } from '../i18n/config';
import { chapter3English, chapter3Text } from '../data/chapter3Ui';
import { imageAdjustmentText } from '../data/imageAdjustmentsUi';
import { liveText } from '../data/liveI18n';
import AdaptiveWorkspace from './AdaptiveWorkspace.astro';
interface Props { locale?: LocalePath; }
const { locale = 'en' } = Astro.props;
const c3 = (key: keyof typeof chapter3English) => chapter3Text(locale, key);
const uploadCopy = { drop: liveText(locale, 'wb.dropMany'), click: liveText(locale, 'wb.orClick') };
const clientMessages = JSON.stringify(Object.fromEntries(Object.keys(chapter3English).map((key) => [key, c3(key as keyof typeof chapter3English)]))).replace(/</g, '\\u003c');
const filters = [['original','original'],['enhanced','enhanced'],['color','color'],['grayscale','grayscale'],['bw','bw'],['contrast','highContrast'],['receipt','receipt']] as const;
const adjust = (key: Parameters<typeof imageAdjustmentText>[1]) => imageAdjustmentText(locale, key);
const lightAdjustments = [['exposure',adjust('exposure'),-100,100],['highlights',adjust('highlights'),-100,100],['shadows',adjust('shadows'),-100,100],['contrast',adjust('contrast'),-100,100],['brightness',adjust('brightness'),-100,100],['blackPoint',adjust('blackPoint'),0,100]] as const;
const detailAdjustments = [['definition',adjust('definition'),0,100],['sharpness',adjust('sharpness'),0,100],['noiseReduction',adjust('noiseReduction'),0,100]] as const;
---

<section data-workbench data-doc-scanner data-testid="workbench-doc-scanner" class="mx-auto max-w-5xl px-4 py-8 sm:px-6">
  <div class="glass overflow-hidden rounded-[1.75rem] p-4 shadow-2xl shadow-emerald-500/10 sm:p-6">
    <script type="application/json" data-scanner-messages is:inline set:html={clientMessages}></script>
    <button type="button" data-scanner-upload class="sf-upload-dropzone flex w-full cursor-pointer flex-col items-center justify-center gap-3 px-6 py-10 text-center"><span class="sf-upload-dropzone__icon grid h-14 w-14 place-items-center rounded-2xl bg-emerald-600 text-2xl font-semibold text-white shadow-lg shadow-emerald-500/20" aria-hidden="true">＋</span><span class="text-sm font-extrabold text-slate-800 dark:text-slate-100">{uploadCopy.drop}</span><span class="text-xs font-medium text-slate-500 dark:text-slate-400">{uploadCopy.click}</span><span class="text-[11px] font-bold text-emerald-600 dark:text-emerald-300">JPG · PNG · WebP — {c3('localOnly')}</span></button>
    <input data-scanner-input name="scanner-images" type="file" accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp" multiple class="sr-only" />
    <button type="button" data-scanner-close hidden>Close scanner</button>
    <p class="mt-2 text-center text-[11px] font-semibold text-slate-500 dark:text-slate-400" role="status">{c3('localOnly')}</p>

    <div data-scanner-error hidden role="alert" tabindex="-1" class="mt-4 rounded-2xl border border-rose-200 bg-rose-50 p-4 text-sm font-bold text-rose-700 dark:border-rose-400/20 dark:bg-rose-500/10 dark:text-rose-200"></div>
    <div data-scanner-progress hidden role="status" aria-live="polite" class="mt-4 rounded-2xl border border-violet-100 bg-violet-50/70 p-4 text-xs font-bold text-violet-700 dark:border-violet-400/20 dark:bg-violet-500/10 dark:text-violet-200"><span data-scanner-progress-text>{c3('preparing')}</span><button type="button" data-scanner-cancel class="ms-3 min-h-9 rounded-full border border-violet-200 bg-white px-3 text-[11px] font-extrabold dark:border-violet-400/20 dark:bg-white/10">{c3('cancel')}</button></div>

    <AdaptiveWorkspace id="doc-scanner-editor" mode="canvas" title={c3('pages')} resetTarget="[data-scanner-close]" class="scanner-canvas-workspace">
      <div data-scanner-workspace class="scanner-studio">
        <aside data-workspace-pages class="scanner-pages-panel">
          <div class="scanner-panel-heading">
            <div><p class="scanner-kicker">{c3('pages')}</p><p data-export-summary class="scanner-panel-note"></p></div>
            <button type="button" data-scanner-add class="scanner-mini-action">＋ {c3('addPage')}</button>
          </div>
          <ol data-page-list class="scanner-page-list"></ol>
          <button type="button" data-scanner-reset class="scanner-start-over">{c3('startOver')}</button>
        </aside>

        <section data-workspace-canvas class="scanner-preview-panel" aria-label={c3('preview')}>
          <header class="scanner-preview-header">
            <div class="min-w-0">
              <div class="flex min-w-0 items-center gap-2">
                <span class="scanner-live-dot" aria-hidden="true"></span>
                <h2 class="truncate text-sm font-extrabold text-white">{c3('preview')}</h2>
                <span data-scanner-crop-state class="scanner-crop-state">{c3('useFullImage')}</span>
              </div>
              <p data-scanner-selected-name data-workspace-source-name class="mt-1 truncate text-[11px] font-semibold text-slate-400"></p>
            </div>
            <div class="scanner-stage-actions">
              <button type="button" data-scanner-rotate-left class="scanner-stage-button" aria-label={`${c3('rotate')} −90°`} title={`${c3('rotate')} −90°`}>↶</button>
              <button type="button" data-scanner-rotate-right class="scanner-stage-button" aria-label={`${c3('rotate')} +90°`} title={`${c3('rotate')} +90°`}>↷</button>
              <button type="button" data-scanner-recrop class="scanner-stage-button scanner-stage-button-primary">{c3('adjustCorners')}</button>
            </div>
          </header>
          <p data-scanner-action-status class="scanner-action-status" role="status" aria-live="polite"></p>
          <div class="scanner-light-table">
            <div class="scanner-paper-shadow"><img data-scanner-preview alt="" width="1200" height="1600" class="scanner-preview-image" /></div>
          </div>
          <footer class="scanner-preview-footer"><span>{c3('localOnly')}</span><span>{c3('quality')}: 97%</span></footer>
        </section>

        <aside data-workspace-inspector data-workbench-controls class="scanner-inspector-panel">
          <section class="scanner-control-section">
            <div class="scanner-panel-heading"><div><p class="scanner-kicker">{c3('crop')}</p><p class="scanner-panel-note">{c3('useFullImage')}</p></div></div>
            <div class="grid grid-cols-2 gap-2">
              <button type="button" data-scanner-recrop class="scanner-control-button scanner-control-button-primary">{c3('adjustCorners')}</button>
              <button type="button" data-scanner-full class="scanner-control-button">{c3('useFullImage')}</button>
            </div>
            <button type="button" data-scanner-retake class="scanner-control-button mt-2 w-full">{c3('replace')}</button>
          </section>

          <fieldset class="scanner-control-section"><legend class="scanner-kicker">{c3('filter')}</legend><div class="mt-3 grid grid-cols-2 gap-2">{filters.map(([value,key]) => <label class="scanner-choice"><input type="radio" name="scan-filter" value={value} checked={value === 'color'} class="h-4 w-4 shrink-0 accent-emerald-500" /><span>{c3(key)}</span></label>)}</div></fieldset>

          <section data-scanner-adjustments class="scanner-control-section">
            <div class="scanner-panel-heading"><div><p class="scanner-kicker">{adjust('adjustments')}</p><p class="scanner-panel-note">{c3('preview')}</p></div><button type="button" data-scanner-adjustments-reset class="scanner-text-action">{c3('reset')}</button></div>
            <details open class="scanner-adjustment-group"><summary>{adjust('light')}</summary><div>{lightAdjustments.map(([key,label,min,max]) => <label class="scanner-slider"><span><span>{label}</span><output data-scanner-adjustment-output={key}>0</output></span><input data-scanner-adjustment={key} aria-label={label} type="range" min={min} max={max} value="0" /></label>)}</div></details>
            <details open class="scanner-adjustment-group"><summary>{adjust('detail')}</summary><div>{detailAdjustments.map(([key,label,min,max]) => <label class="scanner-slider"><span><span>{label}</span><output data-scanner-adjustment-output={key}>0</output></span><input data-scanner-adjustment={key} aria-label={label} type="range" min={min} max={max} value="0" /></label>)}</div></details>
          </section>

          <section data-scanner-export class="scanner-control-section scanner-export-section">
            <div class="scanner-panel-heading"><div><p class="scanner-kicker">{c3('export')}</p><p class="scanner-panel-note">{c3('format')}</p></div></div>
            <fieldset><legend class="sr-only">{c3('format')}</legend><div class="grid grid-cols-3 gap-2">{['pdf','jpg','png'].map((value) => <label class="scanner-format-choice"><input data-export-format type="radio" name="scanner-export-format" value={value} checked={value === 'pdf'} class="sr-only"/><span>{value.toUpperCase()}</span></label>)}</div></fieldset>
            <label data-searchable-wrap class="mt-3 flex min-h-11 items-start gap-2 rounded-xl bg-slate-100 p-3 text-xs font-bold text-slate-700 dark:bg-white/[.06] dark:text-slate-200"><input data-searchable-pdf name="scanner-searchable-pdf" type="checkbox" class="mt-0.5 h-4 w-4 shrink-0 accent-violet-600" /><span>{c3('ocr')}<small class="mt-1 block font-medium leading-4 text-slate-500 dark:text-slate-400">{c3('ocrNote')}</small></span></label>
            <button type="button" data-export-run class="mt-3 inline-flex min-h-12 w-full items-center justify-center rounded-xl bg-slate-950 px-5 text-sm font-extrabold text-white shadow-lg shadow-slate-950/15 hover:bg-violet-700 focus-visible:ring-2 focus-visible:ring-violet-500 disabled:cursor-wait disabled:opacity-70 dark:bg-white dark:text-slate-950">{c3('exportPdf')}</button>
            <div data-export-result hidden role="status" aria-live="polite" tabindex="-1" class="mt-3 rounded-xl border border-emerald-200 bg-emerald-50 p-3 dark:border-emerald-400/20 dark:bg-emerald-500/10"><span data-export-result-text class="block text-xs font-bold text-emerald-700 dark:text-emerald-200"></span><a data-export-download download class="mt-2 inline-flex min-h-10 w-full items-center justify-center rounded-lg bg-emerald-600 px-4 text-xs font-extrabold text-white">{c3('download')}</a></div>
          </section>
        </aside>
      </div>
    </AdaptiveWorkspace>
  </div>

  <div data-corner-dialog hidden class="fixed inset-0 z-[160] p-2 sm:p-5" role="dialog" aria-modal="true" aria-labelledby="scanner-corner-title" aria-describedby="scanner-corner-help">
    <button type="button" data-corner-close class="absolute inset-0 h-full w-full cursor-default bg-slate-950/80 backdrop-blur-sm" aria-label={c3('close')}></button>
    <div class="relative mx-auto flex h-full w-full max-w-6xl flex-col overflow-hidden rounded-[1.5rem] border border-white/15 bg-slate-950 shadow-2xl sm:rounded-[2rem]">
      <header class="flex shrink-0 items-center justify-between gap-3 border-b border-white/10 bg-slate-900 px-4 py-3 sm:px-6"><div class="min-w-0"><h2 id="scanner-corner-title" class="text-base font-extrabold text-white sm:text-lg">{c3('adjustCorners')}</h2><p id="scanner-corner-help" class="mt-0.5 text-xs font-semibold text-slate-300">{c3('dragCorners')}</p></div><button type="button" data-corner-close class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-white/10 text-xl font-bold text-white hover:bg-white/20 focus-visible:ring-2 focus-visible:ring-violet-400" aria-label={c3('close')}>×</button></header>
      <div class="min-h-0 flex-1 p-2 sm:p-4"><div data-corner-host tabindex="-1" class="relative h-full min-h-64 touch-none overflow-hidden rounded-xl border border-white/10 bg-slate-950 outline-none ring-violet-400 focus-visible:ring-2 sm:rounded-2xl"></div></div>
      <footer class="shrink-0 border-t border-white/10 bg-slate-900 p-3 sm:px-6 sm:py-4"><p data-corner-status class="mb-2 min-h-4 text-center text-xs font-bold text-violet-200" role="status" aria-live="polite"></p><div class="grid grid-cols-2 gap-2 sm:flex sm:justify-end"><button type="button" data-corners-full class="min-h-12 rounded-full border border-white/15 bg-white/10 px-4 text-xs font-extrabold text-white hover:bg-white/20 focus-visible:ring-2 focus-visible:ring-violet-400">{c3('useFullImage')}</button><button type="button" data-corner-close class="min-h-12 rounded-full border border-white/15 px-4 text-xs font-extrabold text-white hover:bg-white/10 focus-visible:ring-2 focus-visible:ring-violet-400">{c3('cancel')}</button><button type="button" data-corners-apply class="col-span-2 min-h-12 rounded-full bg-violet-500 px-6 text-sm font-extrabold text-white shadow-lg shadow-violet-500/30 hover:bg-violet-400 focus-visible:ring-2 focus-visible:ring-violet-300 disabled:cursor-wait disabled:opacity-70">{c3('applyCorners')}</button></div></footer>
    </div>
  </div>
</section>

<style is:global>
  .scanner-canvas-workspace [data-workspace-canvas-controls] { display: none; }
  .scanner-canvas-workspace [data-workspace-body] { overflow: hidden; background: #0b1020; }
  .scanner-studio { display: grid; grid-template-columns: minmax(12.5rem,15rem) minmax(0,1fr) minmax(17rem,20rem); width: 100%; height: 100%; min-height: 0; }
  .scanner-pages-panel, .scanner-inspector-panel { min-width: 0; min-height: 0; overflow-y: auto; overscroll-behavior: contain; background: var(--color-surface); }
  .scanner-pages-panel { display: flex; flex-direction: column; padding: 1rem; border-inline-end: 1px solid var(--color-line); }
  .scanner-inspector-panel { padding: 1rem; border-inline-start: 1px solid var(--color-line); }
  .scanner-panel-heading { display: flex; min-width: 0; align-items: center; justify-content: space-between; gap: .75rem; }
  .scanner-kicker { font-size: .68rem; line-height: 1rem; font-weight: 800; letter-spacing: .09em; text-transform: uppercase; color: var(--color-muted); }
  .scanner-panel-note { margin-top: .18rem; font-size: .68rem; line-height: 1rem; font-weight: 600; color: var(--color-muted); }
  .scanner-mini-action { min-height: 2.4rem; flex: none; border: 1px solid var(--color-line); border-radius: .7rem; padding-inline: .7rem; font-size: .7rem; font-weight: 800; color: var(--color-violet); background: var(--color-surface); }
  .scanner-mini-action:hover { border-color: color-mix(in srgb,var(--color-violet) 45%,var(--color-line)); background: var(--color-violet-soft); }
  .scanner-page-list { flex: 1; min-height: 6rem; margin-top: .85rem; overflow-y: auto; }
  .scanner-start-over { min-height: 2.7rem; margin-top: .75rem; border-radius: .7rem; font-size: .72rem; font-weight: 750; color: var(--color-muted); }
  .scanner-start-over:hover { color: var(--color-coral); background: var(--color-coral-soft); }
  .scanner-preview-panel { min-width: 0; min-height: 0; display: grid; grid-template-rows: auto auto minmax(0,1fr) auto; overflow: hidden; color: #fff; background: #0b1020; }
  .scanner-preview-header { display: flex; min-width: 0; align-items: center; justify-content: space-between; gap: 1rem; padding: .8rem 1rem; border-bottom: 1px solid rgb(255 255 255 / .08); background: rgb(15 23 42 / .82); }
  .scanner-live-dot { width: .45rem; height: .45rem; flex: none; border-radius: 999px; background: #34d399; box-shadow: 0 0 0 4px rgb(52 211 153 / .12); }
  .scanner-crop-state { flex: none; border: 1px solid rgb(255 255 255 / .1); border-radius: 999px; padding: .2rem .5rem; font-size: .62rem; line-height: .9rem; font-weight: 800; color: #cbd5e1; background: rgb(255 255 255 / .05); }
  .scanner-stage-actions { display: flex; flex: none; align-items: center; gap: .35rem; }
  .scanner-stage-button { min-width: 2.5rem; min-height: 2.5rem; display: inline-grid; place-items: center; border: 1px solid rgb(255 255 255 / .1); border-radius: .7rem; padding-inline: .7rem; font-size: .72rem; font-weight: 800; color: #e2e8f0; background: rgb(255 255 255 / .055); }
  .scanner-stage-button:hover { border-color: rgb(167 139 250 / .55); background: rgb(124 58 237 / .18); }
  .scanner-stage-button-primary { color: #fff; background: #6d28d9; border-color: #7c3aed; }
  .scanner-action-status { min-height: 1.65rem; padding: .35rem 1rem 0; font-size: .68rem; font-weight: 750; color: #6ee7b7; background: #0b1020; }
  .scanner-light-table { position: relative; display: grid; min-width: 0; min-height: 0; place-items: center; overflow: auto; padding: clamp(1rem,3vw,2.5rem); background-color: #0b1020; background-image: radial-gradient(circle at center, rgb(67 56 202 / .13), transparent 48%), linear-gradient(rgb(255 255 255 / .025) 1px, transparent 1px), linear-gradient(90deg,rgb(255 255 255 / .025) 1px,transparent 1px); background-size: auto, 24px 24px, 24px 24px; }
  .scanner-paper-shadow { display: grid; max-width: 100%; max-height: 100%; place-items: center; border-radius: .28rem; background: #fff; box-shadow: 0 32px 80px rgb(0 0 0 / .5), 0 0 0 1px rgb(255 255 255 / .14); }
  .scanner-preview-image { display: block; width: auto; height: auto; max-width: 100%; max-height: calc(92vh - 11.5rem); object-fit: contain; border-radius: .2rem; }
  .scanner-preview-footer { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .55rem 1rem; border-top: 1px solid rgb(255 255 255 / .08); font-size: .65rem; font-weight: 700; color: #94a3b8; background: rgb(15 23 42 / .8); }
  .scanner-control-section + .scanner-control-section { margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--color-line); }
  .scanner-control-button { min-height: 2.75rem; display: inline-flex; align-items: center; justify-content: center; border: 1px solid var(--color-line); border-radius: .75rem; padding-inline: .75rem; font-size: .7rem; font-weight: 800; color: var(--color-ink); background: var(--color-surface); }
  .scanner-control-button:hover { border-color: color-mix(in srgb,var(--color-violet) 45%,var(--color-line)); color: var(--color-violet); background: var(--color-violet-soft); }
  .scanner-control-button-primary { color: #fff; border-color: #7c3aed; background: #6d28d9; }
  .scanner-control-button-primary:hover { color: #fff; background: #7c3aed; }
  .scanner-choice, .scanner-format-choice { min-height: 2.65rem; display: flex; cursor: pointer; align-items: center; justify-content: flex-start; gap: .5rem; border: 1px solid var(--color-line); border-radius: .7rem; padding: .5rem .65rem; font-size: .68rem; font-weight: 750; color: var(--color-muted); background: var(--color-surface); }
  .scanner-choice:hover, .scanner-format-choice:hover { border-color: color-mix(in srgb,var(--color-green) 45%,var(--color-line)); }
  .scanner-choice:has(:checked) { border-color: var(--color-green); color: var(--color-green); background: var(--color-green-soft); box-shadow: 0 0 0 1px color-mix(in srgb,var(--color-green) 18%,transparent); }
  .scanner-format-choice { justify-content: center; }
  .scanner-format-choice:has(:checked) { border-color: var(--color-violet); color: var(--color-violet); background: var(--color-violet-soft); box-shadow: 0 0 0 1px color-mix(in srgb,var(--color-violet) 18%,transparent); }
  .scanner-text-action { min-height: 2.25rem; border-radius: .6rem; padding-inline: .6rem; font-size: .65rem; font-weight: 800; color: var(--color-violet); }
  .scanner-text-action:hover { background: var(--color-violet-soft); }
  .scanner-adjustment-group { margin-top: .7rem; border: 1px solid var(--color-line); border-radius: .8rem; background: color-mix(in srgb,var(--color-canvas) 58%,var(--color-surface)); }
  .scanner-adjustment-group summary { min-height: 2.5rem; display: flex; cursor: pointer; list-style: none; align-items: center; justify-content: space-between; padding: .55rem .7rem; font-size: .66rem; font-weight: 850; letter-spacing: .06em; text-transform: uppercase; color: var(--color-ink); }
  .scanner-adjustment-group summary::-webkit-details-marker { display: none; }
  .scanner-adjustment-group summary::after { content: '⌄'; font-size: .8rem; color: var(--color-muted); transition: transform 160ms ease; }
  .scanner-adjustment-group:not([open]) summary::after { transform: rotate(-90deg); }
  .scanner-adjustment-group > div { padding: 0 .7rem .7rem; }
  .scanner-slider { display: block; padding-block: .38rem; }
  .scanner-slider > span { display: flex; align-items: center; justify-content: space-between; gap: .65rem; font-size: .67rem; font-weight: 720; color: var(--color-muted); }
  .scanner-slider output { min-width: 2.25rem; border-radius: .42rem; padding: .12rem .3rem; text-align: end; font-family: ui-monospace,SFMono-Regular,Menlo,monospace; font-size: .62rem; color: var(--color-ink); background: var(--color-surface); }
  .scanner-slider input { width: 100%; height: 1.25rem; margin-top: .15rem; cursor: ew-resize; accent-color: var(--color-violet); }
  .scanner-slider input:focus-visible { outline: 2px solid var(--color-violet); outline-offset: 2px; }

  @media (max-width: 1100px) and (min-width: 768px) {
    .scanner-studio { grid-template-columns: 12rem minmax(0,1fr) 17rem; }
    .scanner-stage-button-primary { max-width: 7.5rem; }
  }
  @media (max-width: 767px) {
    .scanner-canvas-workspace [data-workspace-body] { overflow: hidden; }
    .scanner-studio { display: block; height: 100%; }
    .scanner-pages-panel, .scanner-preview-panel, .scanner-inspector-panel { width: 100%; height: 100%; border: 0; }
    .scanner-canvas-workspace[data-mobile-view='canvas'] .scanner-pages-panel, .scanner-canvas-workspace[data-mobile-view='canvas'] .scanner-inspector-panel { display: none; }
    .scanner-canvas-workspace[data-mobile-view='pages'] .scanner-preview-panel, .scanner-canvas-workspace[data-mobile-view='pages'] .scanner-inspector-panel { display: none; }
    .scanner-canvas-workspace[data-mobile-view='inspector'] .scanner-studio { display: grid; grid-template-columns: minmax(0,1fr); grid-template-rows: minmax(11.5rem, 42%) minmax(0, 1fr); }
    .scanner-canvas-workspace[data-mobile-view='inspector'] .scanner-pages-panel { display: none; }
    .scanner-canvas-workspace[data-mobile-view='inspector'] .scanner-preview-panel { height: auto; min-height: 0; }
    .scanner-canvas-workspace[data-mobile-view='inspector'] .scanner-inspector-panel { height: auto; min-height: 0; padding-bottom: max(1rem, env(safe-area-inset-bottom)); }
    .scanner-canvas-workspace[data-mobile-view='inspector'] .scanner-preview-header { padding-block: .45rem; }
    .scanner-canvas-workspace[data-mobile-view='inspector'] .scanner-preview-header .scanner-stage-actions { display: none; }
    .scanner-canvas-workspace[data-mobile-view='inspector'] .scanner-action-status, .scanner-canvas-workspace[data-mobile-view='inspector'] .scanner-preview-footer { display: none; }
    .scanner-canvas-workspace[data-mobile-view='inspector'] .scanner-light-table { padding: .5rem; }
    .scanner-canvas-workspace[data-mobile-view='inspector'] .scanner-preview-image { max-height: 100%; }
    .scanner-preview-header { align-items: flex-start; padding: .65rem .7rem; }
    .scanner-stage-actions { gap: .25rem; }
    .scanner-stage-button { min-width: 2.35rem; min-height: 2.35rem; padding-inline: .55rem; }
    .scanner-stage-button-primary { max-width: 6.9rem; line-height: 1rem; }
    .scanner-light-table { padding: .75rem; }
    .scanner-preview-image { max-height: calc(100dvh - 13rem); }
    .scanner-pages-panel, .scanner-inspector-panel { padding: .85rem; }
