---
import type { LocalePath } from '../i18n/config';
import { chapter3English, chapter3Text } from '../data/chapter3Ui';
interface Props { locale?: LocalePath; }
const { locale = 'en' } = Astro.props;
const c3 = (key: keyof typeof chapter3English) => chapter3Text(locale, key);
const clientMessages = JSON.stringify(Object.fromEntries(Object.keys(chapter3English).map((key) => [key, c3(key as keyof typeof chapter3English)]))).replace(/</g, '\\u003c');
const filters = [['original','original'],['enhanced','enhanced'],['color','color'],['grayscale','grayscale'],['bw','bw'],['contrast','highContrast'],['receipt','receipt']] as const;
---

<section data-workbench data-doc-scanner data-testid="workbench-doc-scanner" class="mx-auto max-w-5xl px-4 py-8 sm:px-6">
  <div class="glass overflow-hidden rounded-[1.75rem] p-4 shadow-2xl shadow-emerald-500/10 sm:p-6">
    <script type="application/json" data-scanner-messages is:inline set:html={clientMessages}></script>
    <button type="button" data-scanner-upload class="flex min-h-32 w-full items-center justify-center gap-3 rounded-2xl border-2 border-dashed border-emerald-200 bg-emerald-50/60 px-5 text-sm font-extrabold text-emerald-800 transition-colors hover:border-emerald-400 focus-visible:ring-2 focus-visible:ring-emerald-500 dark:border-emerald-400/20 dark:bg-emerald-500/[.06] dark:text-emerald-200"><span class="text-2xl" aria-hidden="true">＋</span>{c3('upload')}</button>
    <input data-scanner-input name="scanner-images" type="file" accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp" multiple class="sr-only" />
    <p class="mt-2 text-center text-[11px] font-semibold text-slate-500 dark:text-slate-400" role="status">{c3('localOnly')}</p>

    <div data-scanner-error hidden role="alert" tabindex="-1" class="mt-4 rounded-2xl border border-rose-200 bg-rose-50 p-4 text-sm font-bold text-rose-700 dark:border-rose-400/20 dark:bg-rose-500/10 dark:text-rose-200"></div>
    <div data-scanner-progress hidden role="status" aria-live="polite" class="mt-4 rounded-2xl border border-violet-100 bg-violet-50/70 p-4 text-xs font-bold text-violet-700 dark:border-violet-400/20 dark:bg-violet-500/10 dark:text-violet-200"><span data-scanner-progress-text>{c3('preparing')}</span><button type="button" data-scanner-cancel class="ms-3 min-h-9 rounded-full border border-violet-200 bg-white px-3 text-[11px] font-extrabold dark:border-violet-400/20 dark:bg-white/10">{c3('cancel')}</button></div>

    <div data-scanner-workspace hidden class="mt-5 grid min-w-0 gap-5 lg:grid-cols-[minmax(0,1fr)_17rem]">
      <div class="min-w-0 space-y-4"><div class="flex flex-wrap items-center justify-between gap-3"><div><h2 class="text-sm font-extrabold text-slate-900 dark:text-white">{c3('preview')}</h2><p class="mt-0.5 text-[11px] font-semibold text-slate-500 dark:text-slate-400">{c3('localOnly')}</p></div><div class="flex flex-wrap gap-2"><button type="button" data-scanner-retake class="min-h-11 rounded-full border border-slate-200 bg-white px-4 text-xs font-bold hover:border-violet-300 hover:text-violet-700 focus-visible:ring-2 focus-visible:ring-violet-500 dark:border-white/10 dark:bg-white/5">{c3('retake')}</button><button type="button" data-scanner-recrop class="min-h-11 rounded-full bg-violet-600 px-5 text-xs font-extrabold text-white shadow-lg shadow-violet-500/20 hover:bg-violet-500 focus-visible:ring-2 focus-visible:ring-violet-500">{c3('adjustCorners')}</button></div></div><p data-scanner-action-status class="min-h-5 text-xs font-bold text-emerald-700 dark:text-emerald-300" role="status" aria-live="polite"></p><div class="flex min-h-72 items-center justify-center overflow-hidden rounded-2xl border border-slate-200 bg-slate-100 p-3 dark:border-white/10 dark:bg-slate-950"><img data-scanner-preview alt="" width="1200" height="1600" class="block max-h-[62vh] max-w-full rounded-xl object-contain shadow-xl" /></div>
        <fieldset class="rounded-2xl border border-slate-200/80 bg-white/65 p-4 dark:border-white/10 dark:bg-white/[.03]"><legend class="px-1 text-xs font-extrabold text-slate-700 dark:text-slate-200">{c3('filter')}</legend><div class="flex flex-wrap gap-2">{filters.map(([value,key]) => <label class="flex min-h-11 cursor-pointer items-center gap-2 rounded-full border border-slate-200 bg-white px-3 text-xs font-bold text-slate-600 hover:border-emerald-300 has-[:checked]:border-emerald-500 has-[:checked]:bg-emerald-50 has-[:checked]:text-emerald-800 has-[:checked]:shadow-sm focus-within:ring-2 focus-within:ring-emerald-500 dark:border-white/10 dark:bg-white/5 dark:text-slate-300 dark:has-[:checked]:bg-emerald-500/15 dark:has-[:checked]:text-emerald-200"><input type="radio" name="scan-filter" value={value} checked={value === 'color'} class="h-4 w-4 shrink-0 accent-emerald-600" /><span>{c3(key)}</span></label>)}</div></fieldset>
      </div>
      <aside class="min-w-0"><div class="flex flex-wrap items-center justify-between gap-2"><h2 class="text-sm font-extrabold text-slate-900 dark:text-white">{c3('pages')}</h2><div class="flex gap-2"><button type="button" data-scanner-add class="min-h-10 rounded-full border border-slate-200 bg-white px-3 text-xs font-bold text-violet-600 dark:border-white/10 dark:bg-white/5 dark:text-violet-300">＋ {c3('addPage')}</button><button type="button" data-scanner-reset class="min-h-10 rounded-full px-3 text-xs font-bold text-slate-500 hover:bg-rose-50 hover:text-rose-700 dark:text-slate-400">{c3('startOver')}</button></div></div><ol data-page-list class="mt-3 space-y-2"></ol></aside>
    </div>

    <div data-scanner-export hidden class="mt-5 rounded-2xl border border-slate-200/80 bg-white/65 p-4 dark:border-white/10 dark:bg-white/[.03]"><div class="flex flex-wrap items-center justify-between gap-3"><div><h2 class="text-sm font-extrabold text-slate-900 dark:text-white">{c3('export')}</h2><p data-export-summary class="mt-0.5 text-[11px] font-semibold text-slate-500 dark:text-slate-400"></p><p class="mt-1 text-[11px] font-bold text-emerald-700 dark:text-emerald-300">{c3('quality')}: 97%</p></div><fieldset><legend class="mb-2 text-xs font-extrabold text-slate-700 dark:text-slate-200">{c3('format')}</legend><div class="flex flex-wrap gap-2">{[['pdf','exportPdf'],['jpg','exportJpg'],['png','exportPng']].map(([value,key]) => <label class="flex min-h-11 cursor-pointer items-center gap-2 rounded-full border border-slate-200 bg-white px-3 text-xs font-bold text-slate-600 hover:border-violet-300 has-[:checked]:border-violet-500 has-[:checked]:bg-violet-50 has-[:checked]:text-violet-800 has-[:checked]:shadow-sm focus-within:ring-2 focus-within:ring-violet-500 dark:border-white/10 dark:bg-white/5 dark:text-slate-300 dark:has-[:checked]:bg-violet-500/15 dark:has-[:checked]:text-violet-200"><input data-export-format type="radio" name="scanner-export-format" value={value} checked={value === 'pdf'} class="h-4 w-4 shrink-0 accent-violet-600"/><span>{c3(key as keyof typeof chapter3English)}</span></label>)}</div></fieldset></div><label data-searchable-wrap class="mt-3 flex min-h-11 items-center gap-2 text-xs font-bold text-slate-600 dark:text-slate-300"><input data-searchable-pdf name="scanner-searchable-pdf" type="checkbox" class="h-4 w-4 accent-violet-600" /> {c3('ocr')} <span class="font-medium text-slate-400">— {c3('ocrNote')}</span></label><button type="button" data-export-run class="mt-3 inline-flex min-h-12 w-full items-center justify-center rounded-full bg-slate-900 px-5 text-sm font-extrabold text-white hover:bg-slate-700 focus-visible:ring-2 focus-visible:ring-violet-500 disabled:cursor-wait disabled:opacity-70 dark:bg-white dark:text-slate-900">{c3('exportPdf')}</button><div data-export-result hidden role="status" aria-live="polite" tabindex="-1" class="mt-3 flex flex-wrap items-center justify-between gap-3 rounded-xl border border-emerald-200 bg-emerald-50 p-3 dark:border-emerald-400/20 dark:bg-emerald-500/10"><span data-export-result-text class="text-xs font-bold text-emerald-700 dark:text-emerald-200"></span><a data-export-download download class="inline-flex min-h-10 items-center rounded-full bg-emerald-600 px-4 text-xs font-extrabold text-white">{c3('download')}</a></div></div>
  </div>

  <div data-corner-dialog hidden class="fixed inset-0 z-[100] p-2 sm:p-5" role="dialog" aria-modal="true" aria-labelledby="scanner-corner-title" aria-describedby="scanner-corner-help">
    <button type="button" data-corner-close class="absolute inset-0 h-full w-full cursor-default bg-slate-950/80 backdrop-blur-sm" aria-label={c3('close')}></button>
    <div class="relative mx-auto flex h-full w-full max-w-6xl flex-col overflow-hidden rounded-[1.5rem] border border-white/15 bg-slate-950 shadow-2xl sm:rounded-[2rem]">
      <header class="flex shrink-0 items-center justify-between gap-3 border-b border-white/10 bg-slate-900 px-4 py-3 sm:px-6"><div class="min-w-0"><h2 id="scanner-corner-title" class="text-base font-extrabold text-white sm:text-lg">{c3('adjustCorners')}</h2><p id="scanner-corner-help" class="mt-0.5 text-xs font-semibold text-slate-300">{c3('dragCorners')}</p></div><button type="button" data-corner-close class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-white/10 text-xl font-bold text-white hover:bg-white/20 focus-visible:ring-2 focus-visible:ring-violet-400" aria-label={c3('close')}>×</button></header>
      <div class="min-h-0 flex-1 p-2 sm:p-4"><div data-corner-host tabindex="-1" class="relative h-full min-h-64 touch-none overflow-hidden rounded-xl border border-white/10 bg-slate-950 outline-none ring-violet-400 focus-visible:ring-2 sm:rounded-2xl"></div></div>
      <footer class="shrink-0 border-t border-white/10 bg-slate-900 p-3 sm:px-6 sm:py-4"><p data-corner-status class="mb-2 min-h-4 text-center text-xs font-bold text-violet-200" role="status" aria-live="polite"></p><div class="grid grid-cols-2 gap-2 sm:flex sm:justify-end"><button type="button" data-corners-full class="min-h-12 rounded-full border border-white/15 bg-white/10 px-4 text-xs font-extrabold text-white hover:bg-white/20 focus-visible:ring-2 focus-visible:ring-violet-400">{c3('useFullImage')}</button><button type="button" data-corner-close class="min-h-12 rounded-full border border-white/15 px-4 text-xs font-extrabold text-white hover:bg-white/10 focus-visible:ring-2 focus-visible:ring-violet-400">{c3('cancel')}</button><button type="button" data-corners-apply class="col-span-2 min-h-12 rounded-full bg-violet-500 px-6 text-sm font-extrabold text-white shadow-lg shadow-violet-500/30 hover:bg-violet-400 focus-visible:ring-2 focus-visible:ring-violet-300 disabled:cursor-wait disabled:opacity-70">{c3('applyCorners')}</button></div></footer>
    </div>
  </div>
</section>

<script>
  import { applyScanFilter, type ScanFilter } from '../lib/image/scan-filters';
  type Corners = { topLeft:{x:number;y:number}; topRight:{x:number;y:number}; bottomRight:{x:number;y:number}; bottomLeft:{x:number;y:number} };
  type ScanPage = { id:string; name:string; source:Blob; sourceUrl:string; corners:Corners; filter:ScanFilter; rotation:number; output:Blob; previewUrl:string };
  const root = document.querySelector<HTMLElement>('[data-doc-scanner]');
  if (root) {
    const msg = JSON.parse(root.querySelector<HTMLElement>('[data-scanner-messages]')?.textContent || '{}') as Record<string,string>;
    const input = root.querySelector<HTMLInputElement>('[data-scanner-input]')!; const workspace = root.querySelector<HTMLElement>('[data-scanner-workspace]')!; const exportBox = root.querySelector<HTMLElement>('[data-scanner-export]')!; const progress = root.querySelector<HTMLElement>('[data-scanner-progress]')!; const progressText = root.querySelector<HTMLElement>('[data-scanner-progress-text]')!; const errorBox = root.querySelector<HTMLElement>('[data-scanner-error]')!; const pageList = root.querySelector<HTMLOListElement>('[data-page-list]')!; const previewImage = root.querySelector<HTMLImageElement>('[data-scanner-preview]')!; const cornerDialog = root.querySelector<HTMLElement>('[data-corner-dialog]')!; const cornerHost = root.querySelector<HTMLElement>('[data-corner-host]')!; const cornerStatus = root.querySelector<HTMLElement>('[data-corner-status]')!; const actionStatus = root.querySelector<HTMLElement>('[data-scanner-action-status]')!; const applyCornersButton = root.querySelector<HTMLButtonElement>('[data-corners-apply]')!; const exportRun = root.querySelector<HTMLButtonElement>('[data-export-run]')!; const searchableWrap = root.querySelector<HTMLElement>('[data-searchable-wrap]')!;
    document.body.appendChild(cornerDialog);
    let pages: ScanPage[] = []; let selected = -1; let replaceTarget = -1; let cornerEditor: { getCorners():Corners; setCorners(value:Corners):boolean; destroy():void } | null = null; let editorImage: HTMLImageElement | null = null; let dialogReturnFocus: HTMLElement | null = null; let exportUrl = ''; let operation = 0; let activeAbort: AbortController | null = null;
    const draftKey = 'sorafiles-doc-scanner-draft';
    const openDraftDb = () => new Promise<IDBDatabase>((resolve, reject) => { const request = indexedDB.open('sorafiles-local-tools', 1); request.onupgradeneeded = () => { if (!request.result.objectStoreNames.contains('drafts')) request.result.createObjectStore('drafts'); }; request.onsuccess = () => resolve(request.result); request.onerror = () => reject(request.error); });
    const writeDraft = async () => { try { const db = await openDraftDb(); const transaction = db.transaction('drafts', 'readwrite'); transaction.objectStore('drafts').put(pages.map(({ id,name,source,corners,filter,rotation,output }) => ({ id,name,source,corners,filter,rotation,output })), draftKey); await new Promise<void>((resolve,reject)=>{transaction.oncomplete=()=>resolve();transaction.onerror=()=>reject(transaction.error);}); db.close(); } catch { /* Storage may be unavailable; the active in-memory work remains intact. */ } };
    const clearDraft = async () => { try { const db = await openDraftDb(); const transaction = db.transaction('drafts','readwrite'); transaction.objectStore('drafts').delete(draftKey); db.close(); } catch { /* Best-effort cleanup. */ } };
    const restoreDraft = async () => { try { const db = await openDraftDb(); const transaction = db.transaction('drafts','readonly'); const request = transaction.objectStore('drafts').get(draftKey); const stored = await new Promise<any[]>((resolve,reject)=>{request.onsuccess=()=>resolve(request.result||[]);request.onerror=()=>reject(request.error);}); db.close(); pages = stored.slice(0,20).filter(item=>item?.source instanceof Blob&&item?.output instanceof Blob).map(item=>({...item,sourceUrl:URL.createObjectURL(item.source),previewUrl:URL.createObjectURL(item.output)})); if(pages.length){selected=0;renderPages();await selectPage(0);} } catch { /* No restorable draft. */ } };
    const revokePage = (page: ScanPage) => { URL.revokeObjectURL(page.sourceUrl); URL.revokeObjectURL(page.previewUrl); };
    const setError = (text: string) => { errorBox.textContent = text; errorBox.hidden = false; errorBox.focus(); };
    const imageFromBlob = async (blob: Blob) => { const url = URL.createObjectURL(blob); const image = new Image(); image.decoding = 'async'; image.src = url; try { await image.decode(); return { image, url }; } catch (error) { URL.revokeObjectURL(url); throw error; } };
    const fullCorners = (width:number,height:number):Corners => ({ topLeft:{x:0,y:0}, topRight:{x:width-1,y:0}, bottomRight:{x:width-1,y:height-1}, bottomLeft:{x:0,y:height-1} });
    const canvasBlob = (canvas: HTMLCanvasElement, type = 'image/jpeg', quality = .97) => new Promise<Blob>((resolve,reject) => canvas.toBlob((blob) => blob ? resolve(blob) : reject(new Error('encode')), type, quality));
    const filteredBlob = async (canvas: HTMLCanvasElement, filter: ScanFilter, rotation = 0) => { const context = canvas.getContext('2d', { willReadFrequently:true })!; const filtered = applyScanFilter(context.getImageData(0,0,canvas.width,canvas.height), filter); const sourceCanvas = document.createElement('canvas'); sourceCanvas.width = filtered.width; sourceCanvas.height = filtered.height; sourceCanvas.getContext('2d')!.putImageData(filtered,0,0); const swap = rotation % 180 !== 0; const output = document.createElement('canvas'); output.width = swap ? sourceCanvas.height : sourceCanvas.width; output.height = swap ? sourceCanvas.width : sourceCanvas.height; const target = output.getContext('2d')!; target.imageSmoothingEnabled=true;target.imageSmoothingQuality='high';target.translate(output.width/2, output.height/2); target.rotate(rotation*Math.PI/180); target.drawImage(sourceCanvas,-sourceCanvas.width/2,-sourceCanvas.height/2); const blob = await canvasBlob(output,'image/jpeg',.97); sourceCanvas.width=1;sourceCanvas.height=1;output.width=1;output.height=1; return blob; };
    const scanSource = async (blob: Blob, name: string, existing?: ScanPage) => {
      const current = ++operation; progress.hidden = false; progressText.textContent = msg.preparing; errorBox.hidden = true;
      const { image, url } = await imageFromBlob(blob); if (image.naturalWidth*image.naturalHeight > 40_000_000) { URL.revokeObjectURL(url); throw new Error('too-large'); }
      const scanic = await import('scanic'); const detection = await scanic.scanDocument(image, { mode:'detect', detector:'classical', maxProcessingDimension:900, minDocumentCoverageRatio:.025 }); if (current !== operation) { URL.revokeObjectURL(url); return null; }
      const corners = detection.success && detection.corners ? detection.corners : fullCorners(image.naturalWidth,image.naturalHeight); const extraction = await scanic.extractDocument(image,corners,{output:'canvas'}); if (!extraction.success || !(extraction.output instanceof HTMLCanvasElement)) { URL.revokeObjectURL(url); throw new Error('extract'); }
      const filter:ScanFilter = existing?.filter || 'color'; const rotation = existing?.rotation || 0; const output = await filteredBlob(extraction.output,filter,rotation); const previewUrl=URL.createObjectURL(output); extraction.output.width=1;extraction.output.height=1;
      if (existing) { URL.revokeObjectURL(existing.sourceUrl); URL.revokeObjectURL(existing.previewUrl); existing.source=blob;existing.sourceUrl=url;existing.corners=corners;existing.output=output;existing.previewUrl=previewUrl; }
      else { pages.push({id:crypto.randomUUID(),name,source:blob,sourceUrl:url,corners,filter,rotation,output,previewUrl}); }
      progress.hidden=true; const pageIndex=existing ? pages.indexOf(existing) : pages.length-1; renderPages(); await selectPage(pageIndex); await openCornerDialog(); void writeDraft(); return corners;
    };
    const addFiles = async (files: File[]) => { const accepted=files.slice(0,Math.max(0,replaceTarget>=0?1:20-pages.length)).filter((file)=>/^image\/(jpeg|png|webp)$/.test(file.type)&&file.size>0&&file.size<=60_000_000); if(!accepted.length){setError(msg.invalidImage);return;} for(const file of accepted){try{const target=replaceTarget>=0?pages[replaceTarget]:undefined;await scanSource(file,file.name,target);replaceTarget=-1;}catch(error){replaceTarget=-1;setError(error instanceof Error&&error.message==='too-large'?msg.tooLarge:msg.invalidImage);break;}} input.value=''; };
    const renderPages = () => { pageList.textContent=''; pages.forEach((page,index)=>{const li=document.createElement('li');li.className=`rounded-xl border p-2 ${index===selected?'border-emerald-400 bg-emerald-50 dark:bg-emerald-500/10':'border-slate-200 bg-white dark:border-white/10 dark:bg-white/5'}`;const button=document.createElement('button');button.type='button';button.className='flex w-full items-center gap-2 text-left';button.addEventListener('click',()=>selectPage(index));const img=document.createElement('img');img.src=page.previewUrl;img.alt='';img.width=48;img.height=64;img.className='h-16 w-12 shrink-0 rounded-md bg-slate-100 object-cover';const text=document.createElement('span');text.className='min-w-0 flex-1';const title=document.createElement('span');title.className='block truncate text-xs font-extrabold text-slate-800 dark:text-white';title.textContent=`${msg.page} ${index+1}`;const name=document.createElement('span');name.className='block truncate text-[10px] font-semibold text-slate-500';name.textContent=page.name;text.append(title,name);button.append(img,text);const actions=document.createElement('div');actions.className='mt-2 grid grid-cols-4 gap-1';const action=(symbol:string,label:string,fn:()=>void)=>{const control=document.createElement('button');control.type='button';control.className='min-h-9 rounded-lg bg-slate-100 text-[10px] font-bold text-slate-600 dark:bg-white/10 dark:text-slate-300';control.textContent=symbol;control.setAttribute('aria-label',label);control.addEventListener('click',fn);return control;};actions.append(action('↑',msg.moveUp,()=>movePage(index,-1)),action('↓',msg.moveDown,()=>movePage(index,1)),action('↻',msg.rotate,()=>rotatePage(index)),action('×',msg.deletePage,()=>deletePage(index)));li.append(button,actions);pageList.append(li);}); workspace.hidden=pages.length===0;exportBox.hidden=pages.length===0;root.querySelector<HTMLElement>('[data-export-summary]')!.textContent=`${pages.length} ${msg.pages}`; };
    const movePage=(index:number,delta:number)=>{const next=index+delta;if(next<0||next>=pages.length)return;[pages[index],pages[next]]=[pages[next],pages[index]];selected=next;renderPages();selectPage(next);void writeDraft();};
    const deletePage=(index:number)=>{if(!window.confirm(`${msg.deletePage}?`))return;if(!cornerDialog.hidden)closeCornerDialog(false);revokePage(pages[index]);pages.splice(index,1);selected=Math.min(index,pages.length-1);renderPages();if(selected>=0)selectPage(selected);else previewImage.removeAttribute('src');void writeDraft();};
    const rotatePage=async(index:number)=>{const page=pages[index];page.rotation=(page.rotation+90)%360;await reprocessPage(page);renderPages();await selectPage(index);markCornersApplied();actionStatus.textContent=`✓ ${msg.rotate}`;void writeDraft();};
    const reprocessPage=async(page:ScanPage)=>{const current=++operation;progress.hidden=false;progressText.textContent=msg.processing;const image=new Image();image.src=page.sourceUrl;await image.decode();const {extractDocument}=await import('scanic');const extraction=await extractDocument(image,page.corners,{output:'canvas'});if(current!==operation){if(extraction.success&&extraction.output instanceof HTMLCanvasElement){extraction.output.width=1;extraction.output.height=1;}return;}if(!extraction.success||!(extraction.output instanceof HTMLCanvasElement))throw new Error('extract');const output=await filteredBlob(extraction.output,page.filter,page.rotation);if(current!==operation)return;URL.revokeObjectURL(page.previewUrl);page.output=output;page.previewUrl=URL.createObjectURL(output);extraction.output.width=1;extraction.output.height=1;progress.hidden=true;};
    const markCornersPending=()=>{applyCornersButton.dataset.state='pending';applyCornersButton.textContent=msg.applyCorners;applyCornersButton.classList.add('bg-violet-500');applyCornersButton.classList.remove('bg-emerald-600');cornerStatus.textContent=msg.dragCorners;};
    const markCornersApplied=()=>{applyCornersButton.dataset.state='applied';applyCornersButton.textContent=`✓ ${msg.applyCorners}`;applyCornersButton.classList.remove('bg-violet-500');applyCornersButton.classList.add('bg-emerald-600');actionStatus.textContent=`✓ ${msg.applyCorners}`;};
    const selectPage=async(index:number)=>{if(index<0||index>=pages.length)return;selected=index;renderPages();actionStatus.textContent='';const page=pages[index];previewImage.src=page.previewUrl;await previewImage.decode().catch(()=>{});root.querySelectorAll<HTMLInputElement>('input[name="scan-filter"]').forEach((radio)=>radio.checked=radio.value===page.filter);};
    const closeCornerDialog=(restoreFocus=true)=>{cornerEditor?.destroy();cornerEditor=null;editorImage=null;cornerHost.textContent='';cornerDialog.hidden=true;document.documentElement.style.overflow='';if(restoreFocus)dialogReturnFocus?.focus();dialogReturnFocus=null;};
    const openCornerDialog=async()=>{if(selected<0||selected>=pages.length)return;dialogReturnFocus=document.activeElement instanceof HTMLElement?document.activeElement:root.querySelector<HTMLElement>('[data-scanner-recrop]');cornerEditor?.destroy();cornerEditor=null;cornerHost.textContent='';markCornersPending();cornerDialog.hidden=false;document.documentElement.style.overflow='hidden';await new Promise<void>((resolve)=>requestAnimationFrame(()=>requestAnimationFrame(()=>resolve())));const page=pages[selected];const image=new Image();image.decoding='async';image.src=page.sourceUrl;await image.decode();if(cornerDialog.hidden)return;editorImage=image;const {createCornerEditor}=await import('scanic');cornerEditor=createCornerEditor({container:cornerHost,image,corners:page.corners,magnifier:{enabled:true,size:140,zoom:2.5},nudges:{enabled:false},toolbar:{enabled:false},keyboard:true,injectStyles:true,handleHitArea:72,onChange:()=>markCornersPending(),theme:{accent:'#a78bfa',mask:'rgba(2,6,23,.62)',surface:'rgba(255,255,255,.98)',surfaceColor:'#1e293b',radius:'16px',handleSize:32,handleHit:72}});cornerHost.focus();};
    const applyCorners=async()=>{if(selected<0||!cornerEditor)return;const page=pages[selected];page.corners=cornerEditor.getCorners();applyCornersButton.disabled=true;applyCornersButton.setAttribute('aria-busy','true');cornerStatus.textContent=msg.processing;try{await reprocessPage(page);renderPages();await selectPage(selected);markCornersApplied();closeCornerDialog();void writeDraft();}catch{setError(msg.invalidImage);cornerStatus.textContent=msg.invalidImage;}finally{applyCornersButton.disabled=false;applyCornersButton.removeAttribute('aria-busy');}};
    const exportLabels={pdf:msg.exportPdf,jpg:msg.exportJpg,png:msg.exportPng} as const;let exportFormat:'pdf'|'jpg'|'png'='pdf';
    const setExportFormat=(format:'pdf'|'jpg'|'png')=>{exportFormat=format;exportRun.textContent=exportLabels[format];searchableWrap.hidden=format!=='pdf';root.querySelector<HTMLElement>('[data-export-result]')!.hidden=true;};
    const exportPages=async(format:'pdf'|'jpg'|'png')=>{if(!pages.length){setError(msg.noPages);return;}const current=++operation;activeAbort=new AbortController();exportRun.disabled=true;exportRun.setAttribute('aria-busy','true');progress.hidden=false;progressText.textContent=msg.processing;errorBox.hidden=true;try{let blob:Blob;let filename:string;if(format==='pdf'){const {PDFDocument,StandardFonts,rgb}=await import('pdf-lib');const pdf=await PDFDocument.create();const searchable=root.querySelector<HTMLInputElement>('[data-searchable-pdf]')!.checked;let font:any=null;if(searchable)font=await pdf.embedFont(StandardFonts.Helvetica);let ocrEngine:any=null;if(searchable){const {createLocalOcrEngine}=await import('../lib/ocr/local-engine');ocrEngine=await createLocalOcrEngine('eng',()=>{});}for(let index=0;index<pages.length;index+=1){if(current!==operation||activeAbort.signal.aborted)throw new DOMException('Cancelled','AbortError');const bytes=await pages[index].output.arrayBuffer();const image=await pdf.embedJpg(bytes);const page=pdf.addPage([image.width*.75,image.height*.75]);page.drawImage(image,{x:0,y:0,width:page.getWidth(),height:page.getHeight()});if(searchable&&ocrEngine){const canvas=document.createElement('canvas');canvas.width=image.width;canvas.height=image.height;const bitmap=await createImageBitmap(pages[index].output);canvas.getContext('2d')!.drawImage(bitmap,0,0);bitmap.close();const recognized=await ocrEngine.recognize(canvas,activeAbort.signal);const ascii=recognized.text.replace(/[^\x20-\x7E\n]/g,' ').replace(/\s+/g,' ').slice(0,30000);if(ascii)page.drawText(ascii,{x:2,y:2,size:1,font,color:rgb(1,1,1),opacity:0});canvas.width=1;canvas.height=1;}}if(ocrEngine)await ocrEngine.terminate();blob=new Blob([await pdf.save({useObjectStreams:true}) as BlobPart],{type:'application/pdf'});filename='scanned-document.pdf';}else{const {zipSync}=await import('fflate');const entries:Record<string,Uint8Array>={};for(let index=0;index<pages.length;index+=1){if(current!==operation||activeAbort.signal.aborted)throw new DOMException('Cancelled','AbortError');const page=pages[index];if(format==='jpg')entries[`scan-${String(index+1).padStart(3,'0')}.jpg`]=new Uint8Array(await page.output.arrayBuffer());else{const image=await createImageBitmap(page.output);const canvas=document.createElement('canvas');canvas.width=image.width;canvas.height=image.height;canvas.getContext('2d')!.drawImage(image,0,0);image.close();const png=await canvasBlob(canvas,'image/png');entries[`scan-${String(index+1).padStart(3,'0')}.png`]=new Uint8Array(await png.arrayBuffer());canvas.width=1;canvas.height=1;}}if(pages.length===1){const value=Object.values(entries)[0];blob=new Blob([value as BlobPart],{type:format==='jpg'?'image/jpeg':'image/png'});filename=Object.keys(entries)[0];}else{const zip=zipSync(entries,{level:format==='png'?6:0});blob=new Blob([zip as BlobPart],{type:'application/zip'});filename=`scanned-pages-${format}.zip`;}}if(current!==operation)return;if(exportUrl)URL.revokeObjectURL(exportUrl);exportUrl=URL.createObjectURL(blob);const link=root.querySelector<HTMLAnchorElement>('[data-export-download]')!;link.href=exportUrl;link.download=filename;root.querySelector<HTMLElement>('[data-export-result-text]')!.textContent=`✓ ${exportLabels[format]} · ${pages.length} ${msg.pages} · ${(blob.size/1024).toFixed(1)} KB`;const result=root.querySelector<HTMLElement>('[data-export-result]')!;result.hidden=false;result.focus();}catch(error){if(!(error instanceof DOMException&&error.name==='AbortError'))setError(msg.invalidImage);}finally{if(current===operation)progress.hidden=true;activeAbort=null;exportRun.disabled=false;exportRun.removeAttribute('aria-busy');}};
    root.querySelector('[data-scanner-upload]')?.addEventListener('click',()=>input.click());root.querySelector('[data-scanner-add]')?.addEventListener('click',()=>input.click());input.addEventListener('change',()=>void addFiles(Array.from(input.files||[])));applyCornersButton.addEventListener('click',()=>void applyCorners());cornerDialog.querySelector('[data-corners-full]')?.addEventListener('click',()=>{if(selected<0||!editorImage)return;cornerEditor?.setCorners(fullCorners(editorImage.naturalWidth,editorImage.naturalHeight));markCornersPending();cornerStatus.textContent=msg.useFullImage;});root.querySelector('[data-scanner-retake]')?.addEventListener('click',()=>{if(selected<0)return;replaceTarget=selected;actionStatus.textContent=msg.replace;input.click();});root.querySelector('[data-scanner-recrop]')?.addEventListener('click',()=>{if(selected<0)return;void openCornerDialog();});cornerDialog.querySelectorAll<HTMLElement>('[data-corner-close]').forEach((control)=>control.addEventListener('click',()=>closeCornerDialog()));root.querySelector('[data-scanner-cancel]')?.addEventListener('click',()=>{operation+=1;activeAbort?.abort();activeAbort=null;progress.hidden=true;exportRun.disabled=false;exportRun.removeAttribute('aria-busy');});
    cornerDialog.addEventListener('keydown',(event)=>{if(event.key==='Escape'){event.preventDefault();closeCornerDialog();return;}if(event.key!=='Tab')return;const focusable=Array.from(cornerDialog.querySelectorAll<HTMLElement>('button:not([disabled]), [tabindex]:not([tabindex="-1"])')).filter((element)=>!element.hidden);if(!focusable.length)return;const first=focusable[0];const last=focusable[focusable.length-1];if(event.shiftKey&&document.activeElement===first){event.preventDefault();last.focus();}else if(!event.shiftKey&&document.activeElement===last){event.preventDefault();first.focus();}});
    root.querySelectorAll<HTMLInputElement>('input[name="scan-filter"]').forEach((radio)=>radio.addEventListener('change',async()=>{if(!radio.checked||selected<0)return;pages[selected].filter=radio.value as ScanFilter;await reprocessPage(pages[selected]);renderPages();await selectPage(selected);markCornersApplied();actionStatus.textContent=`✓ ${msg.filter}: ${radio.parentElement?.textContent?.trim()||''}`;void writeDraft();}));
    root.querySelector('[data-scanner-reset]')?.addEventListener('click',()=>{if(!pages.length||!window.confirm(`${msg.startOver}?`))return;closeCornerDialog(false);pages.forEach(revokePage);pages=[];selected=-1;previewImage.removeAttribute('src');renderPages();void clearDraft();});
    root.querySelectorAll<HTMLInputElement>('[data-export-format]').forEach((radio)=>radio.addEventListener('change',()=>{if(radio.checked)setExportFormat(radio.value as 'pdf'|'jpg'|'png');}));exportRun.addEventListener('click',()=>void exportPages(exportFormat));setExportFormat('pdf');
    window.addEventListener('beforeunload',(event)=>{if(pages.length)event.preventDefault();});
    window.addEventListener('pagehide',()=>{closeCornerDialog(false);pages.forEach(revokePage);if(exportUrl)URL.revokeObjectURL(exportUrl);},{once:true});
    void restoreDraft();
  }
</script>
