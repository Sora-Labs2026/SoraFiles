    };
    const scannerDrop=root.querySelector<HTMLElement>('[data-scanner-upload]')!;scannerDrop.addEventListener('click',()=>input.click());for(const eventName of ['dragenter','dragover'])scannerDrop.addEventListener(eventName,(event)=>{event.preventDefault();scannerDrop.dataset.dragActive='true';});for(const eventName of ['dragleave','drop'])scannerDrop.addEventListener(eventName,(event)=>{event.preventDefault();delete scannerDrop.dataset.dragActive;});scannerDrop.addEventListener('drop',(event)=>void addFiles(Array.from(event.dataTransfer?.files||[])));root.querySelector('[data-scanner-add]')?.addEventListener('click',()=>input.click());input.addEventListener('change',()=>void addFiles(Array.from(input.files||[])));applyCornersButton.addEventListener('click',()=>void applyCorners());cornerDialog.querySelector('[data-corners-full]')?.addEventListener('click',()=>{if(selected<0||!editorImage)return;pendingCropMode='full';cornerEditor?.setCorners(fullCorners(editorImage.naturalWidth,editorImage.naturalHeight));markCornersPending();cornerStatus.textContent=msg.useFullImage;});root.querySelector('[data-scanner-full]')?.addEventListener('click',()=>void useFullImage());root.querySelector('[data-scanner-retake]')?.addEventListener('click',()=>{if(selected<0)return;replaceTarget=selected;actionStatus.textContent=msg.replace;input.click();});root.querySelectorAll('[data-scanner-recrop]').forEach((control)=>control.addEventListener('click',()=>{if(selected<0)return;void openCornerDialog();}));root.querySelector('[data-scanner-rotate-left]')?.addEventListener('click',()=>{if(selected>=0)void rotatePage(selected,-90);});root.querySelector('[data-scanner-rotate-right]')?.addEventListener('click',()=>{if(selected>=0)void rotatePage(selected,90);});cornerDialog.querySelectorAll<HTMLElement>('[data-corner-close]').forEach((control)=>control.addEventListener('click',()=>closeCornerDialog()));root.querySelector('[data-scanner-cancel]')?.addEventListener('click',()=>{operation+=1;activeAbort?.abort();activeAbort=null;progress.hidden=true;exportRun.disabled=false;exportRun.removeAttribute('aria-busy');});
    cornerDialog.addEventListener('keydown',(event)=>{if(event.key==='Escape'){event.preventDefault();closeCornerDialog();return;}if(event.key!=='Tab')return;const focusable=Array.from(cornerDialog.querySelectorAll<HTMLElement>('button:not([disabled]), [tabindex]:not([tabindex="-1"])')).filter((element)=>!element.hidden);if(!focusable.length)return;const first=focusable[0];const last=focusable[focusable.length-1];if(event.shiftKey&&document.activeElement===first){event.preventDefault();last.focus();}else if(!event.shiftKey&&document.activeElement===last){event.preventDefault();first.focus();}});
    root.querySelectorAll<HTMLInputElement>('input[name="scan-filter"]').forEach((radio)=>radio.addEventListener('change',async()=>{if(!radio.checked||selected<0)return;pages[selected].filter=radio.value as ScanFilter;await reprocessPage(pages[selected]);renderPages();await selectPage(selected);actionStatus.textContent=`✓ ${msg.filter}: ${radio.parentElement?.textContent?.trim()||''}`;markDirty();void writeDraft();}));
    root.querySelectorAll<HTMLInputElement>('[data-scanner-adjustment]').forEach((control)=>{const update=()=>{if(selected<0)return;const page=pages[selected];const key=control.dataset.scannerAdjustment as ManualAdjustmentKey;page.adjustments[key]=Number(control.value);const output=root.querySelector<HTMLOutputElement>(`[data-scanner-adjustment-output="${key}"]`);if(output)output.value=control.value;actionStatus.textContent=msg.processing;markDirty();queueAdjustmentPreview(page);};control.addEventListener('input',update);control.addEventListener('change',()=>void writeDraft());control.addEventListener('dblclick',()=>{control.value='0';update();void writeDraft();});});
    root.querySelector('[data-scanner-adjustments-reset]')?.addEventListener('click',async()=>{if(selected<0)return;const page=pages[selected];page.adjustments=defaultManualAdjustments();syncAdjustmentControls(page);await reprocessPage(page);renderPages();await selectPage(selected);actionStatus.textContent=`✓ ${msg.reset}`;markDirty();void writeDraft();});
    root.querySelector('[data-scanner-reset]')?.addEventListener('click',()=>{if(!pages.length||!window.confirm(`${msg.startOver}?`))return;window.clearTimeout(adjustmentTimer);closeCornerDialog(false);pages.forEach(revokePage);pages=[];selected=-1;previewImage.removeAttribute('src');renderPages();void clearDraft();});
    root.querySelector('[data-scanner-close]')?.addEventListener('click',()=>{window.clearTimeout(adjustmentTimer);closeCornerDialog(false);adaptiveWorkspace.dispatchEvent(new CustomEvent('workspace-clean'));pages.forEach(revokePage);pages=[];selected=-1;previewImage.removeAttribute('src');renderPages();void clearDraft();});
    root.querySelectorAll<HTMLInputElement>('[data-export-format]').forEach((radio)=>radio.addEventListener('change',()=>{if(radio.checked)setExportFormat(radio.value as 'pdf'|'jpg'|'png');}));exportRun.addEventListener('click',()=>void exportPages(exportFormat));setExportFormat('pdf');
    window.addEventListener('beforeunload',(event)=>{if(pages.length)event.preventDefault();});
    window.addEventListener('pagehide',()=>{window.clearTimeout(adjustmentTimer);closeCornerDialog(false);pages.forEach(revokePage);if(exportUrl)URL.revokeObjectURL(exportUrl);},{once:true});
    void restoreDraft();
  }
</script>
