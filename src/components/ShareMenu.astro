---
import type { LocalePath } from '../i18n/config';
import { shareCopy } from '../data/shareCopy';

interface Props { locale?: LocalePath; }

const { locale = 'en' } = Astro.props;
const copy = shareCopy[locale];
const networks = [
  { id: 'x', label: 'X', path: 'M14.234 10.162 22.977 0h-2.072l-7.591 8.824L7.251 0H.258l9.168 13.343L.258 24H2.33l8.016-9.318L16.749 24h6.993zm-2.837 3.299-.929-1.329L3.076 1.56h3.182l5.965 8.532.929 1.329 7.754 11.09h-3.182z', tone: 'bg-slate-950 text-white dark:bg-white dark:text-slate-950' },
  { id: 'facebook', label: 'Facebook', path: 'M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z', tone: 'bg-blue-600 text-white' },
  { id: 'threads', label: 'Threads', path: 'M18.263 11.097c-.03-3.486-1.92-5.586-5.111-5.586-2.13 0-3.922.963-4.863 2.499l2.062 1.438c.535-.843 1.272-1.543 2.628-1.543 1.528 0 2.318.85 2.544 2.431a15 15 0 0 0-2.236-.173c-4.125 0-6.068 1.867-6.068 4.336s1.943 3.99 4.804 3.99c3.139 0 5.013-2.115 5.781-4.735.798.361 1.348 1.204 1.348 2.47 0 3.387-3.907 5.232-7.22 5.232-4.885 0-8.077-3.207-8.077-8.424 0-6.392 4.223-10.487 9.9-10.487 3.808 0 5.69 1.671 6.97 3.914l2.108-1.475C21.44 2.078 18.331 0 13.663 0 6.227 0 1.168 5.277 1.168 12.934c0 7 4.953 11.066 10.856 11.066 4.878 0 9.809-2.846 9.809-7.716 0-2.545-1.46-4.231-3.569-5.187m-6.33 4.855c-1.077 0-2.026-.512-2.026-1.453 0-1.483 1.822-1.934 3.606-1.934.678 0 1.34.045 1.927.173-.422 1.927-1.671 3.215-3.508 3.214Z', tone: 'bg-slate-950 text-white dark:bg-white dark:text-slate-950' },
  { id: 'reddit', label: 'Reddit', path: 'M12 0C5.373 0 0 5.373 0 12c0 3.314 1.343 6.314 3.515 8.485l-2.286 2.286C.775 23.225 1.097 24 1.738 24H12c6.627 0 12-5.373 12-12S18.627 0 12 0Zm4.388 3.199c1.104 0 1.999.895 1.999 1.999 0 1.105-.895 2-1.999 2-.946 0-1.739-.657-1.947-1.539v.002c-1.147.162-2.032 1.15-2.032 2.341v.007c1.776.067 3.4.567 4.686 1.363.473-.363 1.064-.58 1.707-.58 1.547 0 2.802 1.254 2.802 2.802 0 1.117-.655 2.081-1.601 2.531-.088 3.256-3.637 5.876-7.997 5.876-4.361 0-7.905-2.617-7.998-5.87-.954-.447-1.614-1.415-1.614-2.538 0-1.548 1.255-2.802 2.803-2.802.645 0 1.239.218 1.712.585 1.275-.79 2.881-1.291 4.64-1.365v-.01c0-1.663 1.263-3.034 2.88-3.207.188-.911.993-1.595 1.959-1.595Zm-8.085 8.376c-.784 0-1.459.78-1.506 1.797-.047 1.016.64 1.429 1.426 1.429.786 0 1.371-.369 1.418-1.385.047-1.017-.553-1.841-1.338-1.841Zm7.406 0c-.786 0-1.385.824-1.338 1.841.047 1.017.634 1.385 1.418 1.385.785 0 1.473-.413 1.426-1.429-.046-1.017-.721-1.797-1.506-1.797Zm-3.703 4.013c-.974 0-1.907.048-2.77.135-.147.015-.241.168-.183.305.483 1.154 1.622 1.964 2.953 1.964 1.33 0 2.47-.81 2.953-1.964.057-.137-.037-.29-.184-.305-.863-.087-1.795-.135-2.769-.135Z', tone: 'bg-orange-500 text-white' },
  { id: 'linkedin', label: 'LinkedIn', path: 'M5.337 7.433c1.144 0 2.063-.926 2.063-2.065 0-1.138-.92-2.063-2.063-2.063-1.14 0-2.063.925-2.063 2.063 0 1.139.923 2.065 2.063 2.065zM3.559 20.452h3.556V9H3.559v11.452zM20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.047c.476-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286h-.002z', tone: 'bg-sky-700 text-white' },
  { id: 'whatsapp', label: 'WhatsApp', path: 'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z', tone: 'bg-emerald-600 text-white' },
] as const;
---

<details data-sf-menu data-share-menu class="relative w-full sm:w-auto">
  <summary
    data-testid="share-menu-trigger"
    aria-controls="share-dialog"
    aria-haspopup="dialog"
    aria-expanded="false"
    class="group flex min-h-11 w-full cursor-pointer list-none items-center gap-2.5 rounded-2xl border border-violet-200/70 bg-gradient-to-r from-white/90 via-violet-50/80 to-sky-50/80 px-3 py-2 text-xs font-extrabold text-slate-700 shadow-sm shadow-violet-500/10 transition-[color,border-color,box-shadow,transform] duration-200 hover:-translate-y-0.5 hover:border-violet-300 hover:text-violet-800 hover:shadow-md hover:shadow-violet-500/15 focus-visible:ring-2 focus-visible:ring-violet-500 focus-visible:ring-offset-2 sm:w-auto sm:rounded-full dark:border-violet-400/20 dark:from-white/10 dark:via-violet-500/10 dark:to-sky-500/10 dark:text-slate-100 dark:hover:border-violet-400/50 [&::-webkit-details-marker]:hidden"
  >
    <span class="grid h-8 w-8 shrink-0 place-items-center rounded-xl bg-gradient-to-br from-violet-500 via-fuchsia-500 to-sky-500 text-white shadow-md shadow-violet-500/25 sm:h-7 sm:w-7 sm:rounded-lg">
      <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="18" cy="5" r="2.5"></circle><circle cx="6" cy="12" r="2.5"></circle><circle cx="18" cy="19" r="2.5"></circle><path d="m8.3 10.7 7.3-4.2M8.3 13.3l7.3 4.2"></path>
      </svg>
    </span>
    <span class="min-w-0 flex-1 text-start">{copy.share}</span>
    <svg aria-hidden="true" viewBox="0 0 20 20" class="h-4 w-4 shrink-0 text-violet-400 transition-transform duration-200 group-open:-rotate-180" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m5 8 5 5 5-5"></path></svg>
  </summary>

  <div data-share-portal hidden>
  <button type="button" tabindex="-1" data-share-dismiss aria-hidden="true" class="fixed inset-0 z-[70] cursor-default bg-slate-950/35 backdrop-blur-sm sm:hidden"></button>

  <div id="share-dialog" data-share-panel role="dialog" aria-modal="true" aria-labelledby="share-heading" class="fixed inset-x-3 bottom-[max(0.75rem,env(safe-area-inset-bottom))] z-[71] max-h-[calc(100dvh-1.5rem)] overflow-y-auto overscroll-contain rounded-3xl border border-white/80 bg-white/95 p-4 shadow-2xl shadow-slate-950/25 backdrop-blur-2xl sm:inset-x-auto sm:max-h-[70vh] sm:w-96 sm:rounded-2xl sm:p-3.5 dark:border-white/10 dark:bg-slate-950/95 dark:shadow-black/50">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-24 overflow-hidden rounded-t-3xl sm:rounded-t-2xl">
      <span class="absolute -start-10 -top-14 h-32 w-32 rounded-full bg-violet-300/35 blur-3xl dark:bg-violet-500/20"></span>
      <span class="absolute -end-8 -top-16 h-32 w-32 rounded-full bg-cyan-300/35 blur-3xl dark:bg-cyan-500/15"></span>
    </div>

    <div class="relative mb-3 flex items-center gap-3 px-1">
      <span class="grid h-10 w-10 shrink-0 place-items-center rounded-2xl bg-gradient-to-br from-violet-500 via-fuchsia-500 to-sky-500 text-white shadow-lg shadow-violet-500/25">
        <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="2.5"></circle><circle cx="6" cy="12" r="2.5"></circle><circle cx="18" cy="19" r="2.5"></circle><path d="m8.3 10.7 7.3-4.2M8.3 13.3l7.3 4.2"></path></svg>
      </span>
      <p id="share-heading" class="min-w-0 flex-1 text-pretty text-sm font-extrabold text-slate-900 dark:text-white">{copy.heading}</p>
      <button type="button" data-share-dismiss class="grid min-h-11 min-w-11 place-items-center rounded-full text-slate-500 transition-colors hover:bg-slate-100 hover:text-slate-800 focus-visible:ring-2 focus-visible:ring-violet-500 focus-visible:ring-offset-2 dark:text-slate-400 dark:hover:bg-white/10 dark:hover:text-white" aria-label={copy.close}>
        <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="m7 7 10 10M17 7 7 17"></path></svg>
      </button>
    </div>

    <div class="relative grid grid-cols-2 gap-2 sm:grid-cols-3">
      <button type="button" hidden data-share-native class="col-span-2 flex min-h-12 items-center gap-3 rounded-2xl bg-gradient-to-r from-violet-600 via-fuchsia-600 to-sky-500 px-3.5 text-start text-xs font-extrabold text-white shadow-lg shadow-violet-500/20 transition-[box-shadow,transform] duration-200 hover:-translate-y-0.5 hover:shadow-xl hover:shadow-violet-500/25 focus-visible:ring-2 focus-visible:ring-violet-500 focus-visible:ring-offset-2 sm:col-span-3">
        <span aria-hidden="true" class="grid h-8 w-8 place-items-center rounded-xl bg-white/15 ring-1 ring-white/20">
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16V3M7 8l5-5 5 5M5 13v7h14v-7"></path></svg>
        </span>
        <span class="min-w-0 flex-1">{copy.native}</span><span aria-hidden="true" class="text-base">›</span>
      </button>

      {networks.map((network) => (
        <a href="#" data-share-target={network.id} target="_blank" rel="noopener noreferrer nofollow" class="group/tile flex min-h-20 min-w-0 flex-col items-center justify-center gap-2 rounded-2xl border border-slate-200/80 bg-white/70 px-2 py-2.5 text-center text-[11px] font-extrabold text-slate-600 shadow-sm transition-[color,border-color,box-shadow,transform] duration-200 hover:-translate-y-0.5 hover:border-violet-200 hover:text-slate-950 hover:shadow-md hover:shadow-violet-500/10 focus-visible:ring-2 focus-visible:ring-violet-500 focus-visible:ring-offset-2 dark:border-white/10 dark:bg-white/5 dark:text-slate-300 dark:hover:border-violet-400/30 dark:hover:text-white">
          <span aria-hidden="true" translate="no" class:list={["grid h-8 w-8 place-items-center rounded-xl shadow-sm transition-transform duration-200 group-hover/tile:scale-105", network.tone]}><svg viewBox="0 0 24 24" class="h-4 w-4 fill-current"><path d={network.path}></path></svg></span>
          <span translate="no" class="max-w-full truncate">{network.label}</span>
        </a>
      ))}

      <button type="button" data-share-copy data-copy-label={copy.copy} data-copied-label={copy.copied} class="col-span-2 flex min-h-12 items-center gap-3 rounded-2xl border border-violet-200/80 bg-violet-50/80 px-3.5 text-start text-xs font-extrabold text-violet-800 transition-[color,background-color,border-color,transform] duration-200 hover:-translate-y-0.5 hover:border-violet-300 hover:bg-violet-100 focus-visible:ring-2 focus-visible:ring-violet-500 focus-visible:ring-offset-2 sm:col-span-3 dark:border-violet-400/20 dark:bg-violet-500/10 dark:text-violet-200 dark:hover:bg-violet-500/20">
        <span aria-hidden="true" class="grid h-8 w-8 place-items-center rounded-xl bg-white text-violet-600 shadow-sm dark:bg-white/10 dark:text-violet-200">
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="8" width="11" height="11" rx="2"></rect><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"></path></svg>
        </span>
        <span data-share-copy-text class="min-w-0 flex-1">{copy.copy}</span><span aria-hidden="true" class="text-base text-violet-400">›</span>
      </button>

    </div>
    <p data-share-status class="sr-only" aria-live="polite"></p>
  </div>
  </div>
</details>

<style>
  [data-share-portal][hidden] { display: none !important; }
  [data-share-panel] { transform-origin: bottom center; }
  [data-share-portal][data-open] [data-share-dismiss].fixed { animation: share-backdrop-in 160ms ease-out both; }
  [data-share-portal][data-open] [data-share-panel] { animation: share-panel-in 140ms cubic-bezier(.22, 1, .36, 1) both; }
  @keyframes share-backdrop-in { from { opacity: 0; } to { opacity: 1; } }
  @keyframes share-panel-in { from { opacity: 0; transform: translateY(12px) scale(.98); } to { opacity: 1; transform: translateY(0) scale(1); } }
  @media (min-width: 640px) {
    [data-share-panel] { inset-inline-end: var(--sf-share-inline-end, .75rem); bottom: var(--sf-share-bottom, .75rem); transform-origin: bottom right; }
    :global([dir='rtl']) [data-share-panel] { transform-origin: bottom left; }
  }
  @media (prefers-reduced-motion: reduce) { [data-share-portal][data-open] [data-share-dismiss].fixed, [data-share-portal][data-open] [data-share-panel] { animation: none; } }
</style>

<script>
  const truncatePost = (value: string, max = 210) => {
    const characters = Array.from(value.replace(/\s+/g, ' ').trim());
    return characters.length <= max ? characters.join('') : `${characters.slice(0, max - 1).join('').trimEnd()}…`;
  };
  const copyText = async (value: string) => {
    // Keep the legacy copy attempt synchronous with the trusted click. If the
    // async Clipboard API rejects, browsers have already consumed that user
    // activation and the fallback can no longer work (notably on iOS/Brave).
    const field = document.createElement('textarea');
    field.value = value;
    field.setAttribute('readonly', '');
    field.style.position = 'fixed';
    field.style.inset = '0 auto auto -9999px';
    document.body.append(field);
    field.focus();
    field.select();
    field.setSelectionRange(0, field.value.length);
    let copied = false;
    try {
      const legacyCopy = Reflect.get(document, 'execCommand');
      if (typeof legacyCopy === 'function') copied = Boolean(Reflect.apply(legacyCopy, document, ['copy']));
    } catch {}
    field.remove();
    if (copied) return true;
    try {
      if (navigator.clipboard?.writeText) { await navigator.clipboard.writeText(value); return true; }
    } catch {}
    return false;
  };

  document.querySelectorAll<HTMLDetailsElement>('[data-share-menu]').forEach((menu) => {
    if (menu.dataset.ready === 'true') return;
    menu.dataset.ready = 'true';
    const trigger = menu.querySelector<HTMLElement>('summary');
    const portal = menu.querySelector<HTMLElement>('[data-share-portal]');
    const panel = portal?.querySelector<HTMLElement>('[data-share-panel]');
    if (!trigger || !portal || !panel) return;

    document.body.append(portal);
    portal.hidden = true;
    portal.inert = true;
    // The header closes open <details> menus on outside pointerdown. This
    // panel is portaled to <body>, so its controls would otherwise be treated
    // as outside clicks and the menu would close before their click handlers.
    portal.addEventListener('pointerdown', (event) => event.stopPropagation());

    const focusable = () => [...portal.querySelectorAll<HTMLElement>('[data-share-panel] a[href], [data-share-panel] button:not([disabled]):not([hidden]), [data-share-panel] [tabindex]:not([tabindex="-1"])')].filter((element) => !element.hidden);
    let active = false;
    let openingAnchor: null | { scrollX: number; scrollY: number; triggerTop: number } = null;
    let backgroundState: Array<{ element: HTMLElement; inert: boolean }> = [];
    let bodyState: null | {
      scrollX: number;
      scrollY: number;
      triggerTop: number;
      htmlOverflow: string;
      htmlOverscrollBehavior: string;
      htmlScrollBehavior: string;
      bodyPosition: string;
      bodyTop: string;
      bodyLeft: string;
      bodyRight: string;
      bodyWidth: string;
      bodyOverflow: string;
      bodyPaddingRight: string;
    } = null;

    const positionPanel = () => {
      if (!active || window.innerWidth < 640) {
        portal.style.removeProperty('--sf-share-inline-end');
        portal.style.removeProperty('--sf-share-bottom');
        return;
      }
      const rect = trigger.getBoundingClientRect();
      const viewportWidth = window.visualViewport?.width ?? window.innerWidth;
      const viewportHeight = window.visualViewport?.height ?? window.innerHeight;
      const isRtl = getComputedStyle(document.documentElement).direction === 'rtl';
      const inlineEnd = isRtl ? rect.left : viewportWidth - rect.right;
      const stableTriggerTop = openingAnchor?.triggerTop ?? rect.top;
      const alignedTriggerTop = Math.round(stableTriggerTop / 8) * 8;
      portal.style.setProperty('--sf-share-inline-end', `${Math.max(12, inlineEnd)}px`);
      portal.style.setProperty('--sf-share-bottom', `${Math.max(12, viewportHeight - alignedTriggerTop + 12)}px`);
    };

    const lockScroll = () => {
      if (bodyState) return;
      const body = document.body;
      const root = document.documentElement;
      const anchor = openingAnchor ?? { scrollX: window.scrollX, scrollY: window.scrollY, triggerTop: trigger.getBoundingClientRect().top };
      openingAnchor = null;
      const { scrollX, scrollY } = anchor;
      bodyState = {
        scrollX,
        scrollY,
        triggerTop: anchor.triggerTop,
        htmlOverflow: root.style.overflow,
        htmlOverscrollBehavior: root.style.overscrollBehavior,
        htmlScrollBehavior: root.style.scrollBehavior,
        bodyPosition: body.style.position,
        bodyTop: body.style.top,
        bodyLeft: body.style.left,
        bodyRight: body.style.right,
        bodyWidth: body.style.width,
        bodyOverflow: body.style.overflow,
        bodyPaddingRight: body.style.paddingRight,
      };
      const scrollbarGap = Math.max(0, window.innerWidth - root.clientWidth);
      const currentPadding = Number.parseFloat(getComputedStyle(body).paddingRight) || 0;
      root.style.overflow = 'hidden';
      root.style.overscrollBehavior = 'none';
      root.style.scrollBehavior = 'auto';
      body.style.position = 'fixed';
      body.style.top = `${-scrollY}px`;
      body.style.left = `${-scrollX}px`;
      body.style.right = '0';
      body.style.width = '100%';
      body.style.overflow = 'hidden';
      if (scrollbarGap > 0) body.style.paddingRight = `${currentPadding + scrollbarGap}px`;
      root.dataset.shareScrollLocked = 'true';
    };

    const unlockScroll = () => {
      if (!bodyState) return null;
      const body = document.body;
      const root = document.documentElement;
      const saved = bodyState;
      bodyState = null;
      root.style.overflow = saved.htmlOverflow;
      root.style.overscrollBehavior = saved.htmlOverscrollBehavior;
      body.style.position = saved.bodyPosition;
      body.style.top = saved.bodyTop;
      body.style.left = saved.bodyLeft;
      body.style.right = saved.bodyRight;
      body.style.width = saved.bodyWidth;
      body.style.overflow = saved.bodyOverflow;
      body.style.paddingRight = saved.bodyPaddingRight;
      delete root.dataset.shareScrollLocked;
      window.scrollTo(saved.scrollX, saved.scrollY);
      const triggerOffset = trigger.getBoundingClientRect().top - saved.triggerTop;
      if (Math.abs(triggerOffset) > 0.5) window.scrollTo(saved.scrollX, window.scrollY + triggerOffset);
      return saved;
    };

    const lockBackground = () => {
      if (backgroundState.length > 0) return;
      backgroundState = [...document.body.children]
        .filter((element): element is HTMLElement => element instanceof HTMLElement && element !== portal && element.tagName !== 'SCRIPT' && element.tagName !== 'STYLE')
        .map((element) => ({ element, inert: element.inert }));
      backgroundState.forEach(({ element }) => { element.inert = true; });
    };

    const unlockBackground = () => {
      backgroundState.forEach(({ element, inert }) => { element.inert = inert; });
      backgroundState = [];
    };

    let resetCopyState = () => {};

    const openMenu = () => {
      if (active) return;
      active = true;
      positionPanel();
      lockScroll();
      lockBackground();
      portal.inert = false;
      portal.hidden = false;
      portal.dataset.open = 'true';
      menu.dataset.open = 'true';
      trigger.setAttribute('aria-expanded', 'true');
      requestAnimationFrame(() => focusable()[0]?.focus());
    };

    const closeMenuState = () => {
      trigger.setAttribute('aria-expanded', 'false');
      delete menu.dataset.open;
      if (!active) return;
      active = false;
      portal.removeAttribute('data-open');
      portal.inert = true;
      portal.hidden = true;
      resetCopyState();
      unlockBackground();
      const savedScroll = unlockScroll();
      const restoreAnchor = () => {
        if (!savedScroll) return;
        const offset = trigger.getBoundingClientRect().top - savedScroll.triggerTop;
        if (Math.abs(offset) > 0.5) window.scrollTo(savedScroll.scrollX, window.scrollY + offset);
      };
      requestAnimationFrame(() => {
        trigger.focus({ preventScroll: true });
        restoreAnchor();
        requestAnimationFrame(() => {
          restoreAnchor();
          if (savedScroll) document.documentElement.style.scrollBehavior = savedScroll.htmlScrollBehavior;
        });
      });
    };

    const closeMenu = () => {
      if (menu.open) menu.removeAttribute('open');
      closeMenuState();
    };

    const rememberOpeningAnchor = () => {
      if (!menu.open) openingAnchor = { scrollX: window.scrollX, scrollY: window.scrollY, triggerTop: trigger.getBoundingClientRect().top };
    };
    trigger.addEventListener('pointerdown', rememberOpeningAnchor, { passive: true });
    trigger.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') rememberOpeningAnchor();
    });
    trigger.addEventListener('click', () => { if (!openingAnchor) rememberOpeningAnchor(); });
    menu.addEventListener('toggle', () => { if (menu.open) openMenu(); else closeMenuState(); });
    portal.querySelectorAll<HTMLButtonElement>('[data-share-dismiss]').forEach((button) => button.addEventListener('click', closeMenu));
    document.addEventListener('keydown', (event) => {
      if (!active) return;
      if (event.key === 'Escape') { event.preventDefault(); closeMenu(); return; }
      if (event.key !== 'Tab') return;
      const items = focusable(), first = items[0], last = items[items.length - 1];
      if (!first || !last) { event.preventDefault(); return; }
      if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
      else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
    });
    window.addEventListener('resize', positionPanel, { passive: true });
    window.visualViewport?.addEventListener('resize', positionPanel, { passive: true });

    const canonical = document.querySelector<HTMLLinkElement>('link[rel="canonical"]')?.href ?? window.location.href.split('#')[0];
    const rawTitle = document.querySelector<HTMLMetaElement>('meta[property="og:title"]')?.content ?? document.title;
    const title = rawTitle.replace(/\s+[|—–-]\s+SoraFiles.*$/i, '').trim();
    const description = document.querySelector<HTMLMetaElement>('meta[property="og:description"]')?.content ?? document.querySelector<HTMLMetaElement>('meta[name="description"]')?.content ?? '';
    const post = truncatePost(description ? `${title} — ${description}` : title);
    const sharedText = `${post}\n${canonical}`;
    const encodedUrl = encodeURIComponent(canonical), encodedPost = encodeURIComponent(post), encodedSharedText = encodeURIComponent(sharedText);
    const targets: Record<string, string> = {
      x: `https://twitter.com/intent/tweet?text=${encodedPost}&url=${encodedUrl}`,
      facebook: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
      threads: `https://www.threads.net/intent/post?text=${encodedSharedText}`,
      reddit: `https://www.reddit.com/submit?url=${encodedUrl}&title=${encodeURIComponent(title)}`,
      linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`,
      whatsapp: `https://wa.me/?text=${encodedSharedText}`,
    };
    portal.querySelectorAll<HTMLAnchorElement>('[data-share-target]').forEach((link) => {
      const target = link.dataset.shareTarget; if (target && targets[target]) link.href = targets[target];
    });
    const nativeButton = portal.querySelector<HTMLButtonElement>('[data-share-native]');
    if (nativeButton && typeof navigator.share === 'function') {
      nativeButton.hidden = false;
      nativeButton.addEventListener('click', async () => {
        try { await navigator.share({ title, text: post, url: canonical }); closeMenu(); }
        catch (error) {
          if (error instanceof DOMException && error.name === 'AbortError') return;
          if (await copyText(canonical)) showCopiedState();
        }
      });
    }
    const copyButton = portal.querySelector<HTMLButtonElement>('[data-share-copy]');
    const copyLabel = portal.querySelector<HTMLElement>('[data-share-copy-text]');
    const status = portal.querySelector<HTMLElement>('[data-share-status]');
    let copyResetTimer = 0;
    const showCopiedState = () => {
      const copied = copyButton?.dataset.copiedLabel ?? '';
      if (copyLabel) copyLabel.textContent = copied;
      if (status) status.textContent = copied;
      window.clearTimeout(copyResetTimer);
      copyResetTimer = window.setTimeout(() => { if (copyLabel) copyLabel.textContent = copyButton?.dataset.copyLabel ?? ''; }, 1600);
    };
    resetCopyState = () => {
      window.clearTimeout(copyResetTimer);
      if (copyLabel) copyLabel.textContent = copyButton?.dataset.copyLabel ?? '';
      if (status) status.textContent = '';
    };
    copyButton?.addEventListener('click', async () => {
      if (await copyText(canonical)) showCopiedState();
    });
  });
</script>
