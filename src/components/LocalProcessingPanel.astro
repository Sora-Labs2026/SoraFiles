---
import type { LocalePath } from '../i18n/config';
import { liveText } from '../data/liveI18n';

interface Props { locale?: LocalePath; }
const { locale = 'en' } = Astro.props;
const t = (path: string) => liveText(locale, path);
const flowDelays = [0, 0.45, 0.9];
const checklist = [t('panel.check1'), t('panel.check2'), t('panel.check3'), t('panel.check4')];
---

<section data-motion-region class="sf-deferred-section relative" aria-label={t('panel.title2')}>
  <div class="mx-auto max-w-[1200px] px-4 sm:px-6">
    <div data-reveal data-testid="local-processing-panel" class="sf-reveal relative overflow-hidden rounded-[2rem] bg-[#0b1023] px-6 py-12 shadow-2xl shadow-indigo-950/40 sm:px-10 lg:px-14 lg:py-16">
      <div aria-hidden="true" class="dark-grid absolute inset-0 opacity-60"></div>
      <div aria-hidden="true" class="absolute -left-24 top-0 h-72 w-72 rounded-full bg-violet-600/25 blur-[110px]"></div>
      <div aria-hidden="true" class="absolute -right-16 bottom-0 h-72 w-72 rounded-full bg-cyan-500/20 blur-[110px]"></div>
      <div aria-hidden="true" class="absolute right-[30%] top-[10%] h-40 w-40 rounded-full bg-fuchsia-500/15 blur-[90px]"></div>

      <svg aria-hidden="true" viewBox="0 0 24 24" class="anim-twinkle absolute left-[46%] top-[14%] h-3 w-3 text-violet-300/70 motion-reduce:hidden" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.94 15.5A2 2 0 0 0 8.5 14.06l-6.14-1.58a.5.5 0 0 1 0-.96L8.5 9.94A2 2 0 0 0 9.94 8.5l1.58-6.14a.5.5 0 0 1 .96 0l1.58 6.14a2 2 0 0 0 1.44 1.44l6.14 1.58a.5.5 0 0 1 0 .96l-6.14 1.58a2 2 0 0 0-1.44 1.44l-1.58 6.14a.5.5 0 0 1-.96 0Z"/><path d="M20 3v4M22 5h-4M4 17v2M5 18H3"/></svg>
      <svg aria-hidden="true" viewBox="0 0 24 24" class="anim-twinkle absolute bottom-[16%] left-[38%] h-2.5 w-2.5 text-cyan-300/70 motion-reduce:hidden [animation-delay:-1.6s]" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.94 15.5A2 2 0 0 0 8.5 14.06l-6.14-1.58a.5.5 0 0 1 0-.96L8.5 9.94A2 2 0 0 0 9.94 8.5l1.58-6.14a.5.5 0 0 1 .96 0l1.58 6.14a2 2 0 0 0 1.44 1.44l6.14 1.58a.5.5 0 0 1 0 .96l-6.14 1.58a2 2 0 0 0-1.44 1.44l-1.58 6.14a.5.5 0 0 1-.96 0Z"/><path d="M20 3v4M22 5h-4M4 17v2M5 18H3"/></svg>
      <svg aria-hidden="true" viewBox="0 0 24 24" class="anim-twinkle absolute right-[24%] top-[58%] h-3 w-3 text-fuchsia-300/60 motion-reduce:hidden [animation-delay:-2.8s]" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.94 15.5A2 2 0 0 0 8.5 14.06l-6.14-1.58a.5.5 0 0 1 0-.96L8.5 9.94A2 2 0 0 0 9.94 8.5l1.58-6.14a.5.5 0 0 1 .96 0l1.58 6.14a2 2 0 0 0 1.44 1.44l6.14 1.58a.5.5 0 0 1 0 .96l-6.14 1.58a2 2 0 0 0-1.44 1.44l-1.58 6.14a.5.5 0 0 1-.96 0Z"/><path d="M20 3v4M22 5h-4M4 17v2M5 18H3"/></svg>

      <div class="relative grid items-center gap-12 lg:grid-cols-[1fr_1.7fr_.75fr] lg:gap-10">
        <div>
          <h2 class="text-2xl font-extrabold leading-tight tracking-tight text-white sm:text-3xl">{t('panel.title1')}<span class="block bg-gradient-to-r from-violet-300 via-fuchsia-300 to-cyan-300 bg-clip-text text-transparent">{t('panel.title2')}</span></h2>
          <p class="mt-4 text-sm font-medium leading-relaxed text-slate-400">{t('panel.sub')}</p>
          <span class="mt-6 inline-flex items-center gap-1.5 rounded-full border border-emerald-400/30 bg-emerald-400/10 px-3.5 py-1.5 text-xs font-bold text-emerald-300 shadow-[0_0_24px_rgba(52,211,153,.15)]"><svg aria-hidden="true" viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>{t('panel.badge')}</span>
        </div>

        <div data-testid="processing-flow" aria-hidden="true" class="flex flex-col items-stretch gap-1 sm:flex-row sm:items-center">
          <div data-testid="panel-flow-input" class="sf-input-float flex flex-1 items-center gap-3 rounded-2xl border border-white/10 bg-white/[.06] p-4 shadow-[inset_0_1px_0_rgba(255,255,255,.06)] backdrop-blur">
            <span class="relative flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-violet-500 to-purple-600 shadow-lg shadow-violet-500/30">
              <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5 text-white" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5Z"/><polyline points="14 2 14 8 20 8"/><line x1="16" x2="8" y1="13" y2="13"/><line x1="16" x2="8" y1="17" y2="17"/><line x1="10" x2="8" y1="9" y2="9"/></svg>
              <span aria-hidden="true" class="sf-input-ring absolute inset-0 rounded-xl ring-2 ring-violet-400/50 motion-reduce:hidden"></span>
            </span>
            <span><span class="block text-xs font-bold text-white">Document.pdf</span><span class="block text-[11px] font-semibold text-slate-400">PDF</span></span>
          </div>

          <div aria-hidden="true" class="relative mx-auto h-8 w-px bg-white/10 sm:mx-0 sm:h-px sm:w-9 sm:self-center">
            {flowDelays.map((delay) => <span class="sf-flow-particle motion-reduce:hidden" style={`animation-delay:${delay}s`}></span>)}
          </div>

          <div data-testid="panel-flow-processing" class="relative flex-1 overflow-hidden rounded-2xl p-px">
            <div aria-hidden="true" class="absolute -inset-[120%] animate-[spin_3.2s_linear_infinite] bg-[conic-gradient(from_0deg,transparent_0deg,transparent_290deg,#a78bfa_330deg,#22d3ee_360deg)] motion-reduce:hidden"></div>
            <div class="relative rounded-[15px] border border-violet-400/25 bg-[#111733]/95 p-4">
              <div class="flex items-center gap-2"><svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4 animate-spin text-violet-300 motion-reduce:animate-none" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg><span class="text-xs font-bold text-violet-100">{t('panel.processing')}</span></div>
              <div class="mt-3 h-1.5 overflow-hidden rounded-full bg-white/10"><div data-testid="processing-progress-fill" class="anim-panel-progress relative h-full w-full origin-left rounded-full bg-gradient-to-r from-violet-400 via-fuchsia-400 to-cyan-300 motion-reduce:animate-none motion-reduce:scale-x-[.96]"><span aria-hidden="true" class="sf-progress-sheen absolute inset-y-0 right-0 w-6 bg-gradient-to-r from-transparent to-white/70 motion-reduce:hidden"></span></div></div>
            </div>
          </div>

          <div aria-hidden="true" class="sf-flow-gate relative mx-auto h-8 w-px bg-white/10 sm:mx-0 sm:h-px sm:w-9 sm:self-center motion-reduce:animate-none motion-reduce:opacity-100">
            {flowDelays.map((delay) => <span class="sf-flow-particle motion-reduce:hidden" style={`animation-delay:${delay}s`}></span>)}
          </div>

          <div data-testid="panel-flow-output" class="sf-output-pulse relative flex flex-1 items-center gap-3 rounded-2xl border border-emerald-400/30 bg-emerald-400/10 p-4 motion-reduce:animate-none motion-reduce:opacity-100">
            <span aria-hidden="true" class="sf-success-ring absolute inset-0 rounded-2xl ring-2 ring-emerald-400/60 motion-reduce:hidden"></span>
            <span aria-hidden="true" class="sf-success-check absolute -right-2 -top-2 motion-reduce:hidden"><svg viewBox="0 0 24 24" class="h-5 w-5 rounded-full bg-[#0b1023] text-emerald-400" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg></span>
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-emerald-400 to-teal-600 shadow-lg shadow-emerald-500/30"><svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5 text-white" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5Z"/><polyline points="14 2 14 8 20 8"/><line x1="16" x2="8" y1="13" y2="13"/><line x1="16" x2="8" y1="17" y2="17"/><line x1="10" x2="8" y1="9" y2="9"/></svg></span>
            <span><span class="block text-xs font-bold text-white">Document-Processed.pdf</span><span class="flex items-center gap-1.5 text-[11px] font-semibold text-slate-400"><span class="sf-ready-pulse rounded-full bg-emerald-400/20 px-1.5 py-px font-bold text-emerald-300 motion-reduce:animate-none motion-reduce:opacity-100">{t('panel.ready')}</span></span></span>
          </div>
        </div>

        <ul data-testid="privacy-checklist" class="grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-1 lg:space-y-1">
          {checklist.map((item) => <li class="group flex items-center gap-2.5 text-sm font-bold text-slate-200"><span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-400/15 ring-1 ring-emerald-400/40 transition-shadow duration-300 group-hover:shadow-[0_0_14px_rgba(52,211,153,.45)]"><svg aria-hidden="true" viewBox="0 0 24 24" class="h-3 w-3 text-emerald-400" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m20 6-11 11-5-5"/></svg></span>{item}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .sf-input-float { animation: sf-input-float 3s ease-in-out infinite; }
  .sf-input-ring { animation: sf-input-ring 3s ease-in-out infinite; }
  .sf-flow-particle { position: absolute; left: 50%; top: 0; width: 4px; height: 4px; border-radius: 999px; background: #c4b5fd; box-shadow: 0 0 10px rgba(167,139,250,.95); animation: sf-flow 1.1s ease-in infinite; }
  .sf-flow-gate { animation: sf-flow-gate 4.4s ease-in-out infinite; }
  .sf-progress-sheen { animation: sf-progress-sheen .9s ease-in-out infinite; }
  .sf-output-pulse { animation: sf-output 4.4s ease-in-out infinite; }
  .sf-success-ring { animation: sf-success-ring 4.4s ease-out infinite; }
  .sf-success-check { animation: sf-success-check 4.4s ease-in-out infinite; }
  .sf-ready-pulse { animation: sf-ready-pulse 4.4s ease-in-out infinite; }

  @keyframes sf-input-float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-3px); } }
  @keyframes sf-input-ring { 0%, 100% { opacity: .5; transform: scale(1); } 50% { opacity: 0; transform: scale(1.25); } }
  @keyframes sf-flow { 0% { transform: translate(-50%,-3px); opacity: 0; } 25%, 75% { opacity: 1; } 100% { transform: translate(-50%,30px); opacity: 0; } }
  @keyframes sf-flow-gate { 0%, 55%, 100% { opacity: .15; } 62%, 90% { opacity: 1; } }
  @keyframes sf-progress-sheen { 0%, 100% { opacity: .4; } 50% { opacity: 1; } }
  @keyframes sf-output { 0%, 55%, 100% { opacity: .45; transform: scale(.985); } 66%, 90% { opacity: 1; transform: scale(1); } }
  @keyframes sf-success-ring { 0%, 60% { opacity: 0; transform: scale(1); } 82% { opacity: .55; transform: scale(1.14); } 100% { opacity: 0; transform: scale(1.14); } }
  @keyframes sf-success-check { 0%, 55% { opacity: 0; transform: scale(0); } 64% { opacity: 1; transform: scale(1.3); } 70%, 92% { opacity: 1; transform: scale(1); } 100% { opacity: 0; transform: scale(0); } }
  @keyframes sf-ready-pulse { 0%, 58%, 100% { opacity: 0; } 66%, 90% { opacity: 1; } }

  @media (min-width: 640px) {
    .sf-flow-particle { left: 0; top: 50%; animation-name: sf-flow-x; }
    @keyframes sf-flow-x { 0% { transform: translate(-3px,-50%); opacity: 0; } 25%, 75% { opacity: 1; } 100% { transform: translate(30px,-50%); opacity: 0; } }
  }

  @media (prefers-reduced-motion: reduce) {
    .sf-input-float, .sf-flow-gate, .sf-output-pulse, .sf-ready-pulse { animation: none; opacity: 1; transform: none; }
  }
</style>
