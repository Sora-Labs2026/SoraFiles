---
import type { ToolIcon } from '../data/tools';
interface Props { icon: ToolIcon; }
const { icon } = Astro.props;
---
<svg aria-hidden="true" viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
  {icon === 'compress' && <><path d="M8 3v5H3M16 21v-5h5M3 8l5-5M21 16l-5 5"/><rect x="7" y="7" width="10" height="10" rx="2"/></>}
  {icon === 'merge' && <><rect x="3" y="4" width="8" height="12" rx="2"/><rect x="13" y="8" width="8" height="12" rx="2"/><path d="M8 20h3M9.5 18.5V21.5"/></>}
  {icon === 'split' && <><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M12 3v18M8 12H4M20 12h-4"/></>}
  {icon === 'rotate' && <><path d="M20 7v5h-5M4 17v-5h5M18.5 12A7 7 0 0 0 6 7.5M5.5 12A7 7 0 0 0 18 16.5"/></>}
  {icon === 'image-in' && <><rect x="3" y="4" width="12" height="12" rx="2"/><circle cx="7" cy="8" r="1"/><path d="m5 14 3-3 2.5 2 2-1.5L15 14M18 9v11M15 17l3 3 3-3"/></>}
  {icon === 'image-out' && <><rect x="9" y="8" width="12" height="12" rx="2"/><circle cx="13" cy="12" r="1"/><path d="m11 18 3-3 2 2 1.5-1.5L20 18M6 15V4M3 7l3-3 3 3"/></>}
  {icon === 'word-in' && <><path d="M5 3h10l4 4v14H5zM15 3v5h4"/><path d="m8 12 1.3 5 1.7-3 1.7 3 1.3-5"/></>}
  {icon === 'word-out' && <><path d="M5 3h10l4 4v14H5zM15 3v5h4"/><path d="M8 12h8M8 16h6"/></>}
  {icon === 'spark' && <><path d="m12 3 1.4 4.6L18 9l-4.6 1.4L12 15l-1.4-4.6L6 9l4.6-1.4L12 3ZM18.5 15l.7 2.3 2.3.7-2.3.7-.7 2.3-.7-2.3-2.3-.7 2.3-.7.7-2.3Z"/></>}
</svg>
