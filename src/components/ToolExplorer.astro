---
import { tools, type ToolCategory } from '../data/tools';
import ToolCard from './ToolCard.astro';
import { getLocaleContent } from '../i18n';
import type { LocalePath } from '../i18n/config';
import type { LocaleContent } from '../i18n/types';

interface Props {
  locale?: LocalePath;
  content?: LocaleContent;
}

const { locale = 'en', content = getLocaleContent(locale) } = Astro.props;
const categoriesMap = content.home.categories;
const categories: Array<{ value: 'all' | ToolCategory; label: string }> = [
  { value: 'all', label: categoriesMap.all },
  { value: 'compress', label: categoriesMap.compress },
  { value: 'convert', label: categoriesMap.convert },
  { value: 'organize', label: categoriesMap.organize },
  { value: 'image', label: categoriesMap.image },
];
const prioritySlugs = new Set(['image-converter', 'compress-pdf', 'compress-image', 'merge-pdf']);
const labels = {
  open: content.common.openTool ?? 'Open',
  local: content.common.localProcessing ?? 'Local processing',
  basic: content.common.basic ?? 'Basic conversion',
};
---

<section id="all-tools" aria-labelledby="tools-heading" class="scroll-mt-24 px-4 py-14 sm:px-6 lg:py-16">
  <div class="mx-auto max-w-[1200px]" data-tool-explorer>
    <input data-tool-search-input type="hidden" value="" />
    <div class="mb-8 flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
      <div class="max-w-2xl">
        <h2 id="tools-heading" class="text-xl font-extrabold tracking-tight text-ink sm:text-2xl">{content.home.explorerTitle}</h2>
        <p class="mt-2 text-sm font-medium leading-6 text-muted">{content.home.explorerIntro}</p>
      </div>
      <div class="flex max-w-full gap-2 overflow-x-auto pb-1" aria-label={content.home.searchLabel}>
        <button type="button" data-tool-show-all aria-pressed="false" class="min-h-10 shrink-0 rounded-full bg-ink px-4 text-xs font-bold text-surface shadow-small">{content.home.primaryAction}</button>
        {categories.map((category) => (
          <button type="button" data-tool-filter={category.value} aria-pressed={category.value === 'all' ? 'true' : 'false'} class="min-h-10 shrink-0 rounded-full border border-white/80 bg-surface/75 px-4 text-xs font-bold text-muted shadow-small backdrop-blur transition-colors hover:text-ink aria-pressed:border-violet aria-pressed:bg-violet aria-pressed:text-white">
            {category.label}
          </button>
        ))}
      </div>
    </div>

    <p data-tool-results-status data-status-suffix={content.common.tools} class="sr-only" aria-live="polite">{tools.length} {content.common.tools}</p>

    <div data-tool-grid class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-5">
      {tools.map((tool, index) => {
        const toolCopy = content.tools[tool.slug];
        return (
          <div class="min-w-0" data-tool-wrapper data-extra-tool={index >= 10 ? true : undefined} hidden={index >= 10} data-reveal style={'--reveal-delay: ' + (index % 6)}>
            <ToolCard tool={tool} locale={locale} copy={toolCopy} labels={labels} priority={prioritySlugs.has(tool.slug)} />
          </div>
        );
      })}
    </div>

    <div data-tool-empty hidden class="sf-glass rounded-lg border border-dashed border-line-strong px-6 py-14 text-center">
      <h3 class="text-lg font-bold text-ink">{content.home.noResults}</h3>
      <button type="button" data-tool-clear class="mt-5 min-h-11 rounded-full bg-ink px-5 text-sm font-bold text-surface">{content.home.clearSearch}</button>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-tool-explorer]').forEach((explorer) => {
    const input = explorer.querySelector<HTMLInputElement>('[data-tool-search-input]');
    const buttons = Array.from(explorer.querySelectorAll<HTMLButtonElement>('[data-tool-filter]'));
    const wrappers = Array.from(explorer.querySelectorAll<HTMLElement>('[data-tool-wrapper]'));
    const status = explorer.querySelector<HTMLElement>('[data-tool-results-status]');
    const empty = explorer.querySelector<HTMLElement>('[data-tool-empty]');
    const clear = explorer.querySelector<HTMLButtonElement>('[data-tool-clear]');
    const showAllButton = explorer.querySelector<HTMLButtonElement>('[data-tool-show-all]');
    let category = 'all';
    let showAll = false;

    const update = () => {
      const query = input?.value.trim().toLocaleLowerCase() ?? '';
      let count = 0;
      wrappers.forEach((wrapper) => {
        const card = wrapper.querySelector<HTMLElement>('[data-tool-card]');
        const categoryMatch = category === 'all' || card?.dataset.toolCategory === category;
        const queryMatch = !query || card?.dataset.toolSearch?.includes(query);
        const isExtra = wrapper.hasAttribute('data-extra-tool');
        const visible = Boolean(categoryMatch && queryMatch && (!isExtra || showAll || query));
        wrapper.hidden = !visible;
        if (visible) count += 1;
      });
      if (status) status.textContent = (count + ' ' + (status.dataset.statusSuffix ?? '')).trim();
      if (empty) empty.hidden = count !== 0;
    };

    input?.addEventListener('input', update);
    showAllButton?.addEventListener('click', () => {
      showAll = !showAll;
      showAllButton.setAttribute('aria-pressed', String(showAll));
      update();
    });
    buttons.forEach((button) => button.addEventListener('click', () => {
      category = button.dataset.toolFilter ?? 'all';
      buttons.forEach((candidate) => candidate.setAttribute('aria-pressed', String(candidate === button)));
      update();
    }));
    clear?.addEventListener('click', () => {
      if (input) input.value = '';
      category = 'all';
      showAll = false;
      showAllButton?.setAttribute('aria-pressed', 'false');
      buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.toolFilter === 'all')));
      update();
      document.querySelector<HTMLInputElement>('[data-hero-tool-search]')?.focus();
    });
  });
</script>