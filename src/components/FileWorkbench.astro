---
import type { LocalizedToolCopy } from '../i18n/types';
import type { LocalePath } from '../i18n/config';
import { getWorkbenchMessages } from '../i18n/workbench';
import { liveText } from '../data/liveI18n';
import AdaptiveWorkspace from './AdaptiveWorkspace.astro';
interface Props { locale?: LocalePath; copy?: LocalizedToolCopy; forceJpg?: boolean; }
const { locale = 'en', forceJpg = false, copy = { title: 'Compress Images', description: 'Compress JPG, PNG, WebP, HEIC, or HEIF locally.', note: 'Choose a strength and review the result. Dimensions are retained. Metadata may not be preserved; the original is never changed.' } as LocalizedToolCopy } = Astro.props;
const m = getWorkbenchMessages(locale);
const uploadCopy = { drop: liveText(locale, 'wb.dropOne'), click: liveText(locale, 'wb.orClick') };
const imageActionLabel = locale === 'en' ? (forceJpg ? 'Convert to JPG' : 'Compress image') : m.process;
---
<section data-workbench id="image-tool" aria-labelledby="tool-heading" class="relative mx-auto max-w-5xl scroll-mt-24 px-5 sm:px-6" data-localized={locale !== 'en' ? 'true' : 'false'} data-force-jpg={forceJpg ? 'true' : 'false'} data-copy-description={copy.description} data-copy-note={copy.note} data-preserves-dimensions="true">
  <div class="overflow-hidden rounded-card bg-surface shadow-card">
    <div class="border-b border-line px-5 py-4 sm:px-7">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <p class="eyebrow text-xs font-semibold text-blue">{m.localImageTool}</p>
          <h2 id="tool-heading" class="mt-1 text-lg font-semibold tracking-tight">{copy.title}</h2>
        </div>
        <div class="inline-flex items-center gap-2 rounded-full bg-green-soft px-3 py-1.5 text-xs font-medium text-green">
          <span class="h-2 w-2 rounded-full bg-green" aria-hidden="true"></span>
          {m.processedHere}
        </div>
      </div>
    </div>

    <div id="empty-state" class="p-4 sm:p-7">
      <div id="drop-zone" class="sf-upload-dropzone group relative flex min-h-72 flex-col items-center justify-center px-5 py-12 text-center sm:min-h-80">
        <div class="sf-upload-dropzone__icon flex h-14 w-14 items-center justify-center rounded-xl bg-surface shadow-small motion-reduce:transform-none">
          <svg aria-hidden="true" viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.7">
            <path d="M12 16V4m0 0L7.5 8.5M12 4l4.5 4.5" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M5 13v5a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-5" stroke-linecap="round" />
          </svg>
        </div>
        <h3 class="mt-5 text-xl font-semibold tracking-tight">{uploadCopy.drop}</h3>
        <p class="mt-2 max-w-md text-sm leading-6 text-muted">{forceJpg ? 'HEIC, HEIF → JPG' : 'JPG, PNG, WebP, HEIC, HEIF'} · {m.processedHere}</p>
        <button id="choose-file" type="button" class="mt-6 inline-flex min-h-12 items-center justify-center rounded-control bg-action px-6 text-sm font-medium text-action-contrast shadow-small transition-colors hover:bg-action-hover">
          {m.chooseImage}
        </button>
        <p class="mt-3 text-xs text-muted">{uploadCopy.click}</p>
        <input id="file-input" name="imageFile" class="sr-only" tabindex="-1" type="file" accept={forceJpg ? 'image/heic,image/heif,.heic,.heif' : 'image/jpeg,image/png,image/webp,image/heic,image/heif,.heic,.heif'} aria-label={m.chooseImage} aria-describedby="file-help file-error" />
        <p id="file-help" class="sr-only">{copy.description}</p>
        <p id="file-error" hidden role="alert" tabindex="-1" class="mt-4 max-w-md break-words rounded-control bg-amber-soft px-4 py-3 text-sm leading-6 text-amber"></p>
      </div>
    </div>

    <AdaptiveWorkspace id="work-state" mode="preview" title={copy.title} resetTarget="#clear-file" class="image-preview-workspace">
      <div data-workspace-source class="border-b border-line p-5 sm:p-7 lg:border-b-0 lg:border-r">
        <div class="flex items-start gap-4">
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-control bg-blue-soft text-blue">
            <svg aria-hidden="true" viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.7">
              <rect x="3.5" y="4.5" width="17" height="15" rx="2.5" />
              <circle cx="9" cy="10" r="1.5" />
              <path d="m5 17 4.5-4 3.2 2.8 2.3-2 4 3.2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>
          <div class="min-w-0 flex-1">
            <p id="file-name" data-workspace-source-name class="truncate text-sm font-semibold"></p>
            <p id="file-meta" class="mt-1 text-xs text-muted"></p>
          </div>
          <button id="clear-file" type="button" class="inline-flex min-h-10 items-center rounded-control px-3 text-sm text-muted transition-colors hover:bg-canvas hover:text-ink">{m.remove}</button>
        </div>

        <div class="mt-6 overflow-hidden rounded-xl border border-line bg-canvas">
          <img id="source-preview" src="data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs=" alt={copy.title} width="1600" height="900" class="h-64 w-full object-contain sm:h-80" />
        </div>

        <div id="analysis-note" class="mt-4 rounded-control bg-blue-soft px-4 py-3 text-sm leading-6 text-blue-strong"></div>
      </div>

      <form data-workspace-inspector data-workbench-controls id="settings-form" class="overflow-y-auto p-5 sm:p-7">
        <div hidden={forceJpg}>
          <div class="flex items-center justify-between gap-4">
            <label for="compression-strength" class="text-sm font-semibold">Compression strength</label>
            <output id="strength-output" for="compression-strength" class="font-mono text-sm">60 · Balanced</output>
          </div>
          <input id="compression-strength" name="compressionStrength" type="range" min="0" max="100" step="1" value="60" class="compression-range mt-3 w-full" />
          <p class="mt-2 text-xs leading-5 text-muted">Higher settings make a smaller file. SoraFiles keeps the original format and dimensions by default, and chooses a gentler result if the image changes too much.</p>
        </div>

        <div class="mt-5">
          <label for="output-format" class="text-sm font-medium">{m.outputFormat}</label>
          <select id="output-format" name="outputFormat" disabled class="mt-2 min-h-12 w-full rounded-control border border-line bg-surface px-3 text-sm text-ink disabled:cursor-not-allowed disabled:opacity-70">
            <option value="image/jpeg">JPG</option>
            <option value="image/webp">WebP</option>
            <option value="image/png">PNG</option>
          </select>
        </div>

        <p class="mt-3 text-xs leading-5 text-muted">{forceJpg ? 'HEIC and HEIF images are converted to JPG. Review the preview before downloading.' : 'Compression keeps the source format by default. Use the image converter when you want a different format.'}</p>

        <div id="format-warning" hidden role="status" class="mt-4 rounded-control bg-amber-soft px-4 py-3 text-sm leading-6 text-amber"></div>

        <label id="flatten-confirm-wrap" hidden class="mt-4 cursor-pointer items-start gap-3 rounded-control border border-line bg-surface px-4 py-3 text-sm leading-6">
          <input id="flatten-confirm" type="checkbox" class="mt-1.5 accent-blue" />
          <span>JPG cannot preserve transparency. Replace transparent pixels with white.</span>
        </label>

        <details class="mt-5 rounded-control border border-line px-4 py-3">
          <summary class="cursor-pointer text-sm font-medium">{m.whatChanges}</summary>
          <p class="mt-3 text-sm leading-6 text-muted">{copy.note}</p>
        </details>

        <button id="process-file" type="submit" class="mt-6 inline-flex min-h-12 w-full items-center justify-center rounded-control bg-action px-5 text-sm font-medium text-action-contrast transition-colors hover:bg-action-hover disabled:cursor-wait disabled:opacity-60">
          {imageActionLabel}
        </button>
        <p data-workbench-status id="process-status" class="mt-3 min-h-5 text-center text-xs text-muted" aria-live="polite"></p>
      </form>
    </AdaptiveWorkspace>

    <div data-workbench-result id="result-state" hidden class="border-t border-line bg-canvas p-5 sm:p-7">
      <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-center">
        <div>
          <div class="inline-flex items-center gap-2 text-sm font-semibold text-green">
            <svg aria-hidden="true" viewBox="0 0 20 20" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2"><path d="m4 10 4 4 8-8" stroke-linecap="round" stroke-linejoin="round" /></svg>
            {m.ready}
          </div>
          <p id="result-stats" class="mt-2 text-sm text-muted"></p>
        </div>
        <a id="download-result" class="inline-flex min-h-12 items-center justify-center rounded-control bg-blue px-6 text-sm font-medium text-white transition-colors hover:bg-blue-strong">{m.download}</a>
      </div>
      <div class="mt-5 grid gap-4 sm:grid-cols-2">
        <figure class="overflow-hidden rounded-xl border border-line bg-surface">
          <img id="before-preview" src="data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs=" alt={`${copy.title} · ${m.original}`} width="1600" height="900" class="h-48 w-full object-contain" />
          <figcaption class="border-t border-line px-4 py-2 text-xs text-muted">{m.original}</figcaption>
        </figure>
        <figure class="overflow-hidden rounded-xl border border-line bg-surface">
          <img id="after-preview" src="data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs=" alt={`${copy.title} · ${m.newFile}`} width="1600" height="900" class="h-48 w-full object-contain" />
          <figcaption class="border-t border-line px-4 py-2 text-xs text-muted">{m.newFile}</figcaption>
        </figure>
      </div>
      <p id="result-warning" hidden role="status" class="mt-4 rounded-control bg-amber-soft px-4 py-3 text-sm leading-6 text-amber"></p>
    </div>
  </div>

  <p class="mt-4 text-center text-xs leading-5 text-muted">{copy.note}</p>
</section>

<style is:global>
  .image-preview-workspace [data-workspace-body] { display: grid; grid-template-columns: minmax(0,1fr) clamp(19rem,32vw,26rem); }
  .image-preview-workspace [data-workspace-source] { display: grid; align-content: center; min-height: 0; background: var(--color-canvas); }
  .image-preview-workspace [data-workspace-inspector] { min-height: 0; overflow-y: auto; overscroll-behavior: contain; }
  .image-preview-workspace #source-preview { height: min(58vh,42rem); }
  @media (max-width: 767px) {
    .image-preview-workspace [data-workspace-body] { display: block; overflow: hidden; }
    .image-preview-workspace [data-workspace-source], .image-preview-workspace [data-workspace-inspector] { width: 100%; height: 100%; border: 0; padding: .9rem; }
    .image-preview-workspace [data-workspace-source] { overflow-y: auto; align-content: center; }
    .image-preview-workspace [data-workspace-inspector] { display: flex; flex-direction: column; padding-bottom: max(1rem, env(safe-area-inset-bottom)); }
    .image-preview-workspace #source-preview { height: min(56dvh, 30rem); }
    .image-preview-workspace #process-file { position: sticky; bottom: 0; z-index: 3; margin-top: auto; box-shadow: 0 -10px 24px var(--color-surface); }
  }
</style>

<script type="application/json" id="file-workbench-messages" is:inline set:html={JSON.stringify(m).replace(/</g, '\\u003c')}></script>

<script>
  import { safeOutputStem, setDisplayedFilename } from '../utils/filename';
  import { reductionPercent } from '../lib/compression/targets';
  import { imageProfileForStrength, profileNameForStrength } from '../lib/compression/profiles';
  import { rgbaSsim } from '../lib/compression/ssim';
  import type { WorkbenchMessages } from '../i18n/workbench';

  const fileMessages = JSON.parse(document.querySelector('#file-workbench-messages')?.textContent || '{}') as WorkbenchMessages;

  type InputMime = 'image/jpeg' | 'image/png' | 'image/webp' | 'image/heic';
  type OutputMime = 'image/jpeg' | 'image/png' | 'image/webp';

  const $ = <T extends HTMLElement>(selector: string) => {
    const element = document.querySelector<T>(selector);
    if (!element) throw new Error(`Missing element: ${selector}`);
    return element;
  };

  const input = $('#file-input') as HTMLInputElement;
  const imageToolRoot = $('#image-tool');
  const forceJpg = imageToolRoot.dataset.forceJpg === 'true';
  const localizedWorkbench = imageToolRoot.dataset.localized === 'true';
  const chooseButton = $('#choose-file') as HTMLButtonElement;
  const dropZone = $('#drop-zone');
  const emptyState = $('#empty-state');
  const workState = $('#work-state');
  const resultState = $('#result-state');
  const sourcePreview = $('#source-preview') as HTMLImageElement;
  const formatSelect = $('#output-format') as HTMLSelectElement;
  const strengthInput = $('#compression-strength') as HTMLInputElement | null;
  const strengthOutput = $('#strength-output') as HTMLOutputElement | null;
  const formatWarning = $('#format-warning');
  const flattenConfirmWrap = $('#flatten-confirm-wrap') as HTMLLabelElement;
  const flattenConfirm = $('#flatten-confirm') as HTMLInputElement;
  const status = $('#process-status');
  const fileError = $('#file-error');
  const processButton = $('#process-file') as HTMLButtonElement;
  const processButtonLabel = processButton.textContent?.trim() ?? fileMessages.process;
  const form = $('#settings-form') as HTMLFormElement;

  let selectedFile: File | null = null;
  let selectedMime: InputMime | null = null;
  let sourceUrl: string | null = null;
  let resultUrl: string | null = null;
  let hasTransparency = false;
  let imageWorker: Worker | null = null;
  let workerJob = 0;

  const formatBytes = (bytes: number) => {
    if (bytes < 1000) return `${bytes} B`;
    if (bytes < 1_000_000) return `${(bytes / 1000).toFixed(bytes < 100_000 ? 1 : 0)} KB`;
    return `${(bytes / 1_000_000).toFixed(2)} MB`;
  };

  const detectMime = async (file: File): Promise<InputMime | null> => {
    const bytes = new Uint8Array(await file.slice(0, 16).arrayBuffer());
    if (bytes[0] === 0xff && bytes[1] === 0xd8 && bytes[2] === 0xff) return 'image/jpeg';
    if (bytes[0] === 0x89 && bytes[1] === 0x50 && bytes[2] === 0x4e && bytes[3] === 0x47) return 'image/png';
    const riff = String.fromCharCode(...bytes.slice(0, 4));
    const webp = String.fromCharCode(...bytes.slice(8, 12));
    if (riff === 'RIFF' && webp === 'WEBP') return 'image/webp';
    const ftyp = String.fromCharCode(...bytes.slice(4, 8));
    const brand = String.fromCharCode(...bytes.slice(8, 12));
    if (ftyp === 'ftyp' && ['heic', 'heix', 'hevc', 'hevx', 'heim', 'heis', 'mif1', 'msf1'].includes(brand)) return 'image/heic';
    return null;
  };

  const encodeInWorker = (image: ImageData, mime: OutputMime, quality: number) => new Promise<Blob>((resolve, reject) => {
    imageWorker ??= new Worker(new URL('../workers/image-compression.worker.ts', import.meta.url), { type: 'module' });
    const id = ++workerJob;
    const onMessage = (event: MessageEvent<{ id: number; ok: boolean; bytes?: ArrayBuffer; error?: string }>) => {
      if (event.data.id !== id) return;
      imageWorker?.removeEventListener('message', onMessage);
      imageWorker?.removeEventListener('error', onError);
      if (!event.data.ok || !event.data.bytes) reject(new Error(event.data.error || 'Image encoding failed.'));
      else resolve(new Blob([event.data.bytes], { type: mime }));
    };
    const onError = () => {
      imageWorker?.removeEventListener('message', onMessage);
      imageWorker?.removeEventListener('error', onError);
      reject(new Error('The image compressor stopped unexpectedly. Try again or use a smaller image.'));
    };
    imageWorker.addEventListener('message', onMessage);
    imageWorker.addEventListener('error', onError);
    imageWorker.postMessage({ id, pixels: image.data, width: image.width, height: image.height, mime, quality });
  });

  const imageToCanvas = async (file: File, mime: InputMime) => {
    const bitmap = mime === 'image/heic'
      ? await (await import('heic-to/csp')).heicTo({ blob: file, type: 'bitmap', options: { imageOrientation: 'from-image' } })
      : await createImageBitmap(file, { imageOrientation: 'from-image' });
    if (bitmap.width * bitmap.height > 32_000_000) {
      bitmap.close();
      throw new Error('This image is larger than 32 megapixels. Resize it first to avoid exhausting browser memory.');
    }
    const canvas = document.createElement('canvas');
    canvas.width = bitmap.width;
    canvas.height = bitmap.height;
    const context = canvas.getContext('2d', { alpha: true });
    if (!context) {
      bitmap.close();
      throw new Error('Canvas processing is not available in this browser.');
    }
    context.drawImage(bitmap, 0, 0);
    bitmap.close();
    return { canvas, context };
  };

  const checkTransparency = (canvas: HTMLCanvasElement) => {
    const sample = document.createElement('canvas');
    const maxSide = 320;
    const scale = Math.min(1, maxSide / Math.max(canvas.width, canvas.height));
    sample.width = Math.max(1, Math.round(canvas.width * scale));
    sample.height = Math.max(1, Math.round(canvas.height * scale));
    const sampleContext = sample.getContext('2d', { willReadFrequently: true });
    if (!sampleContext) return false;
    sampleContext.drawImage(canvas, 0, 0, sample.width, sample.height);
    const pixels = sampleContext.getImageData(0, 0, sample.width, sample.height).data;
    for (let index = 3; index < pixels.length; index += 4) {
      if (pixels[index] < 255) return true;
    }
    return false;
  };

  const updateWarning = () => {
    const output = formatSelect.value as OutputMime;
    let message = '';
    if (hasTransparency && output === 'image/jpeg') {
      message = 'JPG cannot keep transparency. Confirm a white background below, or choose WebP or PNG.';
    } else if (output === 'image/png') {
      message = 'PNG compression is lossless. Transparency, pixel colors, and dimensions are preserved.';
    }
    flattenConfirmWrap.hidden = !(hasTransparency && output === 'image/jpeg');
    flattenConfirmWrap.classList.toggle('flex', !flattenConfirmWrap.hidden);
    processButton.disabled = !flattenConfirmWrap.hidden && !flattenConfirm.checked;
    formatWarning.textContent = message;
    formatWarning.hidden = !message;
  };

  const updateStrength = () => {
    if (!strengthInput || !strengthOutput) return;
    const value = Number(strengthInput.value);
    const name = profileNameForStrength(value);
    const label = name === 'max-safe' ? 'Maximum safe' : name[0].toUpperCase() + name.slice(1);
    strengthOutput.textContent = `${value} · ${label}`;
  };

  const clearUrls = () => {
    if (sourceUrl) URL.revokeObjectURL(sourceUrl);
    if (resultUrl) URL.revokeObjectURL(resultUrl);
    sourceUrl = null;
    resultUrl = null;
  };

  const reset = () => {
    workState.dispatchEvent(new CustomEvent('workspace-clean'));
    clearUrls();
    selectedFile = null;
    selectedMime = null;
    hasTransparency = false;
    flattenConfirm.checked = false;
    input.value = '';
    emptyState.hidden = false;
    workState.hidden = true;
    resultState.hidden = true;
    status.textContent = '';
    fileError.textContent = '';
    fileError.hidden = true;
    input.removeAttribute('aria-invalid');
  };

  const loadFile = async (file: File) => {
    reset();
    status.textContent = fileMessages.processing;
    try {
      if (file.size > 50_000_000) throw new Error('Choose an image smaller than 50 MB to protect browser memory.');
      const detectedMime = await detectMime(file);
      if (!detectedMime) throw new Error('Choose a valid JPG, PNG, WebP, HEIC, or HEIF image. The file signature is not supported.');
      const { canvas } = await imageToCanvas(file, detectedMime);
      hasTransparency = detectedMime !== 'image/jpeg' && checkTransparency(canvas);
      selectedFile = file;
      selectedMime = detectedMime;
      const previewBlob = detectedMime === 'image/heic'
        ? await new Promise<Blob>((resolve, reject) => canvas.toBlob(blob => blob ? resolve(blob) : reject(new Error('Image preview could not be prepared.')), 'image/png'))
        : file;
      sourceUrl = URL.createObjectURL(previewBlob);
      sourcePreview.src = sourceUrl;
      setDisplayedFilename($('#file-name'), file.name);
      $('#file-meta').textContent = `${formatBytes(file.size)} · ${canvas.width} × ${canvas.height} · ${detectedMime.replace('image/', '').toUpperCase()}`;
      $('#analysis-note').textContent = localizedWorkbench
        ? (imageToolRoot.dataset.copyDescription || '')
        : detectedMime === 'image/heic'
        ? 'The main HEIC image is ready. Live Photo video, bursts, depth information, and original hidden details are not included.'
        : hasTransparency
        ? 'Transparency detected. PNG or WebP pixels and the original dimensions will be preserved.'
        : 'The image is ready. Balanced compression keeps the original dimensions and automatically avoids visible quality loss.';
      formatSelect.value = forceJpg || detectedMime === 'image/heic' ? 'image/jpeg' : detectedMime;
      emptyState.hidden = true;
      workState.hidden = false;
      workState.dispatchEvent(new CustomEvent('workspace-clean'));
      resultState.hidden = true;
      status.textContent = '';
      updateWarning();
    } catch (error) {
      reset();
      const detail = error instanceof Error ? error.message : '';
      fileError.textContent = localizedWorkbench ? (/size|MB|megapixel/i.test(detail) ? fileMessages.tooLarge : fileMessages.invalidFile) : (detail || fileMessages.failed);
      fileError.hidden = false;
      input.setAttribute('aria-invalid', 'true');
      fileError.focus();
    }
  };

  const blobImageData = async (blob: Blob, width: number, height: number) => {
    const bitmap = await createImageBitmap(blob);
    if (bitmap.width !== width || bitmap.height !== height) {
      bitmap.close();
      throw new Error('The compressed image changed dimensions unexpectedly, so SoraFiles kept it from downloading. Try again.');
    }
    const canvas = document.createElement('canvas');
    canvas.width = width;
    canvas.height = height;
    const context = canvas.getContext('2d', { willReadFrequently: true });
    if (!context) { bitmap.close(); throw new Error('Image validation is unavailable.'); }
    context.drawImage(bitmap, 0, 0);
    bitmap.close();
    return context.getImageData(0, 0, width, height);
  };

  const looksLikeScreenshot = (image: ImageData) => {
    const step = Math.max(1, Math.floor(Math.sqrt((image.width * image.height) / 40_000)));
    let flatEdges = 0;
    let samples = 0;
    for (let y = step; y < image.height; y += step) {
      for (let x = step; x < image.width; x += step) {
        const index = (y * image.width + x) * 4;
        const left = index - step * 4;
        const up = index - step * image.width * 4;
        const deltaLeft = Math.abs(image.data[index] - image.data[left]) + Math.abs(image.data[index + 1] - image.data[left + 1]) + Math.abs(image.data[index + 2] - image.data[left + 2]);
        const deltaUp = Math.abs(image.data[index] - image.data[up]) + Math.abs(image.data[index + 1] - image.data[up + 1]) + Math.abs(image.data[index + 2] - image.data[up + 2]);
        if (deltaLeft < 8 || deltaUp < 8) flatEdges += 1;
        samples += 1;
      }
    }
    return samples > 0 && flatEdges / samples > .72;
  };

  const encodeQualityGuarded = async (image: ImageData, mime: OutputMime, strength: number) => {
    const screenshot = looksLikeScreenshot(image);
    const profile = imageProfileForStrength(strength, screenshot);
    if (mime === 'image/png') {
      status.textContent = 'Compressing image without changing its pixels…';
      return { blob: await encodeInWorker(image, mime, 100), quality: 100, score: 1, profile, screenshot };
    }
    const initial = mime === 'image/jpeg' ? profile.jpegQuality : profile.webpQuality;
    const qualities = [...new Set([initial, Math.min(92, initial + 4), Math.min(94, initial + 8)])];
    let best: { blob: Blob; quality: number; score: number } | null = null;
    for (let index = 0; index < qualities.length; index += 1) {
      const quality = qualities[index];
      status.textContent = `Checking image quality · pass ${index + 1} of ${qualities.length}`;
      const blob = await encodeInWorker(image, mime, quality);
      const decoded = await blobImageData(blob, image.width, image.height);
      const score = rgbaSsim(image, decoded);
      if (score >= profile.ssimFloor) { best = { blob, quality, score }; break; }
      if (!best || score > best.score) best = { blob, quality, score };
    }
    if (!best || best.score < profile.ssimFloor) {
      throw new Error('The compressed image changed too much, so no download was created. Try a gentler compression setting.');
    }
    return { ...best, profile, screenshot };
  };

  const validateEncodedImage = async (blob: Blob, mime: OutputMime) => {
    const bytes = new Uint8Array(await blob.slice(0, 12).arrayBuffer());
    const ascii = new TextDecoder('ascii').decode(bytes);
    const validSignature = mime === 'image/jpeg'
      ? bytes[0] === 0xff && bytes[1] === 0xd8 && bytes[2] === 0xff
      : mime === 'image/png'
        ? bytes[0] === 0x89 && bytes[1] === 0x50 && bytes[2] === 0x4e && bytes[3] === 0x47
        : ascii.startsWith('RIFF') && ascii.slice(8, 12) === 'WEBP';
    if (!validSignature) throw new Error('The browser produced an invalid image. No download was created.');
    const decoded = await createImageBitmap(blob);
    const validDimensions = decoded.width > 0 && decoded.height > 0;
    decoded.close();
    if (!validDimensions) throw new Error('The browser could not verify the compressed image. No download was created.');
  };

  const processImage = async () => {
    if (!selectedFile || !selectedMime) return;
    processButton.disabled = true;
    imageToolRoot.setAttribute('aria-busy', 'true');
    processButton.textContent = fileMessages.processing;
    resultState.hidden = true;
    status.textContent = fileMessages.processing;
    try {
      const mime = forceJpg ? 'image/jpeg' : formatSelect.value as OutputMime;
      if (hasTransparency && mime === 'image/jpeg' && !flattenConfirm.checked) throw new Error('Confirm the white background or choose a format that preserves transparency.');
      const { canvas, context } = await imageToCanvas(selectedFile, selectedMime);
      if (mime === 'image/jpeg' && hasTransparency) {
        context.globalCompositeOperation = 'destination-over';
        context.fillStyle = '#ffffff';
        context.fillRect(0, 0, canvas.width, canvas.height);
      }
      const originalPixels = context.getImageData(0, 0, canvas.width, canvas.height);
      const strength = forceJpg ? 35 : Number(strengthInput?.value ?? 60);
      const encoded = await encodeQualityGuarded(originalPixels, mime, strength);
      const useOriginal = selectedMime === mime && encoded.blob.size >= selectedFile.size;
      const blob = useOriginal ? selectedFile : encoded.blob;
      await validateEncodedImage(blob, mime);

      if (resultUrl) URL.revokeObjectURL(resultUrl);
      resultUrl = URL.createObjectURL(blob);
      const extension = mime === 'image/jpeg' ? 'jpg' : mime.split('/')[1];
      const base = safeOutputStem(selectedFile.name, 'image');
      const download = $('#download-result') as HTMLAnchorElement;
      download.href = resultUrl;
      download.download = `${base}-smaller.${extension}`;
      ($('#before-preview') as HTMLImageElement).src = sourceUrl ?? '';
      ($('#after-preview') as HTMLImageElement).src = resultUrl;

      const saved = selectedFile.size - blob.size;
      const percent = reductionPercent(selectedFile.size, blob.size);
      $('#result-stats').textContent = localizedWorkbench
        ? `${formatBytes(selectedFile.size)} → ${formatBytes(blob.size)}${saved > 0 ? ` · −${percent}%` : ''}`
        : `${formatBytes(selectedFile.size)} → ${formatBytes(blob.size)}${saved > 0 ? ` · ${percent}% smaller` : ' · original retained'}`;

      const resultWarning = $('#result-warning');
      resultWarning.textContent = useOriginal
        ? 'The compressed result was not smaller, so SoraFiles returned the original file unchanged.'
        : mime === 'image/png'
          ? 'The image stayed lossless. Transparency, colors, and dimensions were preserved.'
          : `${encoded.profile.label} compression used. The original dimensions were preserved${encoded.screenshot ? ', with extra protection for sharp text and flat colors' : ''}.`;
      resultWarning.hidden = !resultWarning.textContent;
      resultState.hidden = false;
      workState.dispatchEvent(new CustomEvent('workspace-complete'));
      status.textContent = fileMessages.finished;
      resultState.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'nearest' });
    } catch (error) {
      const detail = error instanceof Error ? error.message : '';
      status.textContent = document.documentElement.lang === 'en' ? (detail || fileMessages.failed) : (/size|MB|megapixel|20 KB/i.test(detail) ? fileMessages.tooLarge : /valid|signature|decode|format/i.test(detail) ? fileMessages.invalidFile : fileMessages.failed);
    } finally {
      imageToolRoot.removeAttribute('aria-busy');
      processButton.disabled = false;
      processButton.textContent = processButtonLabel;
    }
  };

  chooseButton.addEventListener('click', () => input.click());
  input.addEventListener('change', () => input.files?.[0] && void loadFile(input.files[0]));
  $('#clear-file').addEventListener('click', reset);
  strengthInput?.addEventListener('input', updateStrength);
  strengthInput?.addEventListener('change', updateStrength);
  flattenConfirm.addEventListener('change', updateWarning);
  form.addEventListener('submit', event => { event.preventDefault(); void processImage(); });
  updateStrength();

  for (const eventName of ['dragenter', 'dragover']) {
    dropZone.addEventListener(eventName, event => {
      event.preventDefault();
      dropZone.dataset.dragActive = 'true';
      dropZone.classList.add('border-blue', 'bg-blue-soft', 'select-none');
    });
  }
  for (const eventName of ['dragleave', 'drop']) {
    dropZone.addEventListener(eventName, event => {
      event.preventDefault();
      delete dropZone.dataset.dragActive;
      dropZone.classList.remove('border-blue', 'bg-blue-soft', 'select-none');
    });
  }
  dropZone.addEventListener('drop', event => {
    const file = event.dataTransfer?.files[0];
    if (file) void loadFile(file);
  });
  window.addEventListener('beforeunload', () => { clearUrls(); imageWorker?.terminate(); });
</script>
