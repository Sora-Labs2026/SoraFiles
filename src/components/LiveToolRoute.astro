---
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import RelatedGuides from './RelatedGuides.astro';
import LocalizedToolPage from './LocalizedToolPage.astro';
import { getLocaleContent } from '../i18n';
import type { LocalePath } from '../i18n/config';
import { localizedPath } from '../i18n/config';
import { localeByPath } from '../i18n/config';
import type { LiveTool } from '../data/liveTools';
import { liveText, liveToolCopy } from '../data/liveI18n';
import { CONTENT_PROVENANCE } from '../data/contentProvenance';
import type { LocalizedToolCopy } from '../i18n/types';
import { toolMetaDescription } from '../lib/tool-metadata';

interface Props { tool: LiveTool; locale?: LocalePath; }
const { tool, locale = 'en' } = Astro.props;
const content = getLocaleContent(locale);
const canonicalPath = localizedPath(locale, `/${tool.slug}`);
const words = liveToolCopy(locale, tool.id);
const title = `${words.n} — ${liveText(locale, 'common.free')} · ${liveText(locale, 'common.onDevice')} | SoraFiles`;
const reviewedCopy = (content.tools as Record<string, LocalizedToolCopy>)[tool.id];
const description = toolMetaDescription(reviewedCopy, `${words.t} ${words.d}`, locale);
const pageUrl = new URL(canonicalPath, 'https://sorafiles.com').toString();
const faqId = `${pageUrl}#faq`;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebPage', name: `${words.n} — SoraFiles`, url: pageUrl, inLanguage: localeByPath.get(locale)?.code ?? locale, description, isPartOf: { '@id': 'https://sorafiles.com/#website' }, dateModified: CONTENT_PROVENANCE.modifiedIso, author: { '@id': CONTENT_PROVENANCE.publisherId }, publisher: { '@id': CONTENT_PROVENANCE.publisherId }, ...(reviewedCopy?.faqs.length ? { mainEntity: { '@id': faqId } } : {}) },
    { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: liveText(locale, 'nav.home'), item: new URL(localizedPath(locale, '/'), 'https://sorafiles.com').toString() }, { '@type': 'ListItem', position: 2, name: words.n, item: new URL(canonicalPath, 'https://sorafiles.com').toString() }] },
    ...(reviewedCopy?.faqs.length ? [{ '@type': 'FAQPage', '@id': faqId, url: faqId, inLanguage: localeByPath.get(locale)?.code ?? locale, dateModified: CONTENT_PROVENANCE.modifiedIso, author: { '@id': CONTENT_PROVENANCE.publisherId }, publisher: { '@id': CONTENT_PROVENANCE.publisherId }, mainEntity: reviewedCopy.faqs.map((faq) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) }] : []),
  ],
};
---

<Layout {title} {description} {canonicalPath} alternatePath={`/${tool.slug}`} {schema} {locale}>
  <Header {locale} />
  <LocalizedToolPage {locale} {content} {tool} />
  <RelatedGuides toolId={tool.id} {locale} />
  <Footer {locale} />
</Layout>
