---
import type { LocalePath } from '../i18n/config';
import { liveText, liveToolCopy } from '../data/liveI18n';

interface Props { locale?: LocalePath; }
const { locale = 'en' } = Astro.props;
const t = (path: string) => liveText(locale, path);
const scenes = [
  { id: 'merge-pdf', title: liveToolCopy(locale, 'merge-pdf').n },
  { id: 'split-pdf', title: liveToolCopy(locale, 'split-pdf').n },
  { id: 'compress-pdf', title: liveToolCopy(locale, 'compress-pdf').n },
  { id: 'rotate-pdf', title: liveToolCopy(locale, 'rotate-pdf').n },
];
---

<div data-hero-visualization data-motion-region data-testid="hero-visualization" class="relative mx-auto h-[470px] max-w-[620px] sm:h-[540px] lg:h-[580px]" tabindex="-1">
  <div aria-hidden="true" class="absolute -top-10 right-[8%] h-72 w-72 rounded-full bg-fuchsia-400/25 blur-[100px] dark:bg-fuchsia-500/15"></div>
  <div aria-hidden="true" class="absolute bottom-[8%] left-[4%] h-64 w-64 rounded-full bg-blue-400/30 blur-[100px] dark:bg-blue-500/15"></div>
  <div aria-hidden="true" class="absolute right-[28%] top-[38%] h-52 w-52 rounded-full bg-cyan-300/35 blur-[90px] dark:bg-cyan-500/10"></div>

  <svg aria-hidden="true" class="absolute inset-0 hidden h-full w-full sm:block" viewBox="0 0 620 580" fill="none" preserveAspectRatio="none">
    <defs><linearGradient id="sf-curve" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#7c3aed"/><stop offset="55%" stop-color="#3b82f6"/><stop offset="100%" stop-color="#06b6d4"/></linearGradient></defs>
    <path class="anim-dash" d="M52 96 C 170 40, 250 130, 330 150" stroke="url(#sf-curve)" stroke-opacity=".4" stroke-width="1.5" stroke-dasharray="2 8" stroke-linecap="round"/>
    <path class="anim-dash [animation-delay:-2s]" d="M584 138 C 500 170, 500 280, 452 340" stroke="url(#sf-curve)" stroke-opacity=".4" stroke-width="1.5" stroke-dasharray="2 8" stroke-linecap="round"/>
    <path class="anim-dash [animation-delay:-4s]" d="M70 500 C 190 470, 300 540, 420 486" stroke="url(#sf-curve)" stroke-opacity=".35" stroke-width="1.5" stroke-dasharray="2 8" stroke-linecap="round"/>
  </svg>

  <svg aria-hidden="true" viewBox="0 0 24 24" class="anim-twinkle absolute left-[30%] top-[6%] h-3.5 w-3.5 text-violet-400" fill="none" stroke="currentColor" stroke-width="2"><path d="m12 3 1.3 4.2L17.5 8.5l-4.2 1.3L12 14l-1.3-4.2-4.2-1.3 4.2-1.3L12 3Z"/></svg>
  <svg aria-hidden="true" viewBox="0 0 24 24" class="anim-twinkle absolute right-[16%] top-[58%] h-3 w-3 text-cyan-400 [animation-delay:-1.2s]" fill="none" stroke="currentColor" stroke-width="2"><path d="m12 3 1.3 4.2L17.5 8.5l-4.2 1.3L12 14l-1.3-4.2-4.2-1.3 4.2-1.3L12 3Z"/></svg>
  <svg aria-hidden="true" viewBox="0 0 24 24" class="anim-twinkle absolute bottom-[10%] left-[42%] h-3.5 w-3.5 text-fuchsia-400 [animation-delay:-2.3s]" fill="none" stroke="currentColor" stroke-width="2"><path d="m12 3 1.3 4.2L17.5 8.5l-4.2 1.3L12 14l-1.3-4.2-4.2-1.3 4.2-1.3L12 3Z"/></svg>

  {[
    ['left-[1%] top-[2%] -rotate-12', 'PDF', 'from-red-400 to-red-600 shadow-red-500/30', '0s'],
    ['right-[3%] top-[10%] rotate-12', 'PNG', 'from-blue-400 to-indigo-600 shadow-blue-500/30', '-2.5s'],
    ['bottom-[16%] right-[1%] rotate-6', 'JPG', 'from-violet-400 to-purple-600 shadow-violet-500/30', '-4s'],
  ].map(([position, label, tile, delay]) => (
    <div class:list={['absolute', label === 'JPG' ? 'z-40' : 'z-20', position]} aria-hidden="true"><div class="animate-float" style={`animation-delay:${delay}`}><div class:list={['flex h-14 w-11 flex-col items-center justify-center gap-1 rounded-xl bg-gradient-to-b shadow-lg', tile]}><span class="text-[10px] font-extrabold leading-none text-white">{label}</span><span class="space-y-0.5"><span class="block h-0.5 w-5 rounded bg-white/70"></span><span class="block h-0.5 w-4 rounded bg-white/50"></span><span class="block h-0.5 w-5 rounded bg-white/40"></span></span></div></div></div>
  ))}

  <div class="absolute left-[3%] top-[9%] z-10 w-[86%] sm:left-[6%] sm:w-[80%]">
    <div class="sf-float-window will-change-transform">
      <div class="glass sf-mobile-optimized-glass sf-hero-window rounded-2xl shadow-2xl shadow-indigo-500/20 transition-shadow duration-300 hover:shadow-indigo-500/30">
        <div aria-hidden="true" class="flex items-center gap-2 border-b border-slate-900/5 px-4 py-3 dark:border-white/5">
          <span class="flex gap-1.5"><span class="h-2.5 w-2.5 rounded-full bg-[#ff5f57]"></span><span class="h-2.5 w-2.5 rounded-full bg-[#febc2e]"></span><span class="h-2.5 w-2.5 rounded-full bg-[#28c840]"></span></span>
          <span class="relative mx-auto flex h-4 min-w-28 items-center justify-center"><span class="absolute flex items-center gap-1.5 whitespace-nowrap text-xs font-bold text-slate-700 dark:text-slate-200"><svg aria-hidden="true" viewBox="0 0 24 24" class="h-3.5 w-3.5 text-violet-500" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6M8 13h8M8 17h6"/></svg><span data-hero-scene-title>{scenes[0].title}</span></span></span>
          <span class="flex items-center gap-1 rounded-full bg-emerald-100 px-2 py-0.5 text-[9px] font-bold text-emerald-800 dark:bg-emerald-500/15 dark:text-emerald-300"><svg aria-hidden="true" viewBox="0 0 24 24" class="h-2.5 w-2.5" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/></svg>{t('common.onDevice')}</span>
        </div>
        <div class="px-3.5 pb-3 pt-1 sm:px-5">
          <div data-hero-scenes aria-hidden="true" class="relative h-36 sm:h-40">
            <div data-scene="merge-pdf" class="sf-scene sf-merge relative flex h-full items-center justify-center">
              <span class="sf-merge-pulse absolute h-24 w-24 rounded-full border-2 border-sky-400/60"></span>
              {[1,2,3].map((number) => <div class={`sf-merge-chip sf-merge-chip-${number} absolute will-change-transform`}><span class="sf-file-chip sf-file-sm"><span class="sf-file-icon bg-gradient-to-br from-red-400 to-red-600"><svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6"/></svg></span><span class="sf-file-label">PDF {number}</span><span class="sf-file-lines"><i></i><i></i></span></span></div>)}
              <div class="sf-merge-result absolute will-change-transform"><span class="sf-file-chip sf-file-lg sf-file-glow"><span class="sf-file-icon sf-file-icon-lg bg-gradient-to-br from-sky-500 to-blue-600"><svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6"/></svg></span><span class="sf-file-label">PDF</span><span class="sf-file-lines sf-file-lines-lg"><i></i><i></i></span></span></div>
            </div>
            <div data-scene="split-pdf" hidden class="sf-scene sf-split relative flex h-full items-center justify-center">
              <div class="sf-split-input absolute will-change-transform"><span class="sf-file-chip sf-file-lg"><span class="sf-file-icon sf-file-icon-lg bg-gradient-to-br from-red-400 to-red-600"><svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6"/></svg></span><span class="sf-file-label">PDF</span><span class="sf-file-lines sf-file-lines-lg"><i></i><i></i></span></span></div>
              {[1,2,3].map((number) => <div class={`sf-split-page sf-split-page-${number} absolute will-change-transform`}><span class="sf-file-chip sf-file-sm"><span class="sf-file-icon bg-gradient-to-br from-emerald-400 to-teal-600"><svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6"/></svg></span><span class="sf-file-label">{number}</span><span class="sf-file-lines"><i></i><i></i></span></span></div>)}
            </div>
            <div data-scene="compress-pdf" hidden class="sf-scene flex h-full flex-col items-center justify-center gap-3">
              <div class="flex items-center gap-5"><svg aria-hidden="true" viewBox="0 0 24 24" class="sf-squeeze-right h-4 w-4 text-rose-400" fill="none" stroke="currentColor" stroke-width="2"><path d="m13 17 5-5-5-5M6 17l5-5-5-5"/></svg><div class="sf-compress-chip will-change-transform"><span class="sf-file-chip sf-file-lg"><span class="sf-file-icon sf-file-icon-lg bg-gradient-to-br from-rose-500 to-red-600"><svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6"/></svg></span><span class="sf-file-label">PDF</span><span class="sf-file-lines sf-file-lines-lg"><i></i><i></i></span></span></div><svg aria-hidden="true" viewBox="0 0 24 24" class="sf-squeeze-left h-4 w-4 text-rose-400" fill="none" stroke="currentColor" stroke-width="2"><path d="m11 17-5-5 5-5m7 10-5-5 5-5"/></svg></div>
              <div class="h-1.5 w-40 overflow-hidden rounded-full bg-slate-100 dark:bg-white/10"><div class="sf-compress-line h-full rounded-full bg-gradient-to-r from-rose-400 to-amber-400"></div></div>
            </div>
            <div data-scene="rotate-pdf" hidden class="sf-scene relative flex h-full items-center justify-center"><span class="sf-rotate-ring absolute h-32 w-32 rounded-full border border-dashed border-pink-300/70 dark:border-pink-400/30"></span><div class="sf-rotate-chip will-change-transform"><span class="sf-file-chip sf-file-lg"><span class="sf-file-icon sf-file-icon-lg bg-gradient-to-br from-pink-500 to-fuchsia-600"><svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6"/></svg></span><span class="sf-file-label">PDF</span><span class="sf-file-lines sf-file-lines-lg"><i></i><i></i></span></span></div></div>
          </div>
          <div class="flex items-center justify-center gap-0.5 pb-1">{scenes.map((scene, index) => <button type="button" data-hero-scene-dot={index} data-scene-id={scene.id} data-scene-title={scene.title} aria-label={scene.title} aria-current={index === 0 ? 'true' : 'false'} class="group grid h-6 w-6 place-items-center rounded-full"><span aria-hidden="true" data-hero-dot-visual class:list={['h-1.5 rounded-full transition-[width,background-color] duration-300', index === 0 ? 'w-6 bg-gradient-to-r from-violet-500 to-fuchsia-500' : 'w-1.5 bg-slate-300 group-hover:bg-violet-300 dark:bg-white/20']}></span></button>)}</div>
        </div>
      </div>
    </div>
  </div>

  <div aria-hidden="true" class="sf-card-enter absolute bottom-[6%] left-0 z-20 w-[52%] -rotate-[1.5deg] sm:w-[46%] [animation-delay:.8s]" data-testid="compression-preview-card">
    <div class="glass sf-mobile-optimized-glass sf-float-compression will-change-transform overflow-hidden rounded-2xl p-3 shadow-xl shadow-violet-500/15">
      <div class="mb-2 flex items-center justify-between px-0.5"><div class="flex items-center gap-1.5"><span class="anim-twinkle text-xs text-violet-500">✦</span><span class="text-[10px] font-extrabold tracking-tight text-slate-700 dark:text-slate-200">{liveToolCopy(locale, 'compress-pdf').n}</span></div><span class="flex items-center gap-0.5 rounded-full bg-emerald-100 px-1.5 py-0.5 text-[9px] font-extrabold text-emerald-800 dark:bg-emerald-500/15 dark:text-emerald-300">⚡ −80%</span></div>
      <div class="flex items-center gap-2 rounded-lg bg-white/60 p-2 dark:bg-white/[0.05]"><span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-gradient-to-br from-rose-500 to-red-600 text-white shadow-lg shadow-rose-500/30"><svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6"/></svg></span><div class="min-w-0 flex-1"><span class="block truncate text-[11px] font-extrabold text-slate-700 dark:text-slate-100">Document.pdf</span><span class="flex items-center gap-1 text-[10px] font-bold"><span class="text-slate-600 line-through dark:text-slate-500">24.6 MB</span><svg aria-hidden="true" viewBox="0 0 24 24" class="h-2.5 w-2.5 text-violet-500" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg><span class="text-emerald-800 dark:text-emerald-300">4.8 MB</span></span></div></div>
      <div class="relative mt-2 h-1.5 overflow-hidden rounded-full bg-rose-200/70 dark:bg-rose-500/15"><div class="sf-comparison-bar h-full rounded-full bg-gradient-to-r from-emerald-400 to-teal-500"></div></div>
    </div>
  </div>

  <div aria-hidden="true" class="sf-card-enter absolute bottom-[18%] right-[2%] z-20 w-[48%] sm:w-[42%] [animation-delay:1s]" data-testid="local-processing-card">
    <div class="glass sf-mobile-optimized-glass sf-float-local will-change-transform rounded-2xl p-2.5 shadow-xl shadow-blue-500/15">
      <div class="flex items-center gap-2 rounded-xl bg-blue-50/80 px-2 py-1.5 dark:bg-blue-500/10"><svg aria-hidden="true" viewBox="0 0 24 24" class="h-3.5 w-3.5 shrink-0 text-blue-500" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6M8 13h8M8 17h6"/></svg><span class="flex-1 truncate text-[10px] font-bold text-slate-700 dark:text-slate-200">{t('panel.title2')}</span><svg aria-hidden="true" viewBox="0 0 24 24" class="h-3 w-3 text-slate-300" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg></div>
      <div class="flex items-center gap-2 rounded-xl px-2 py-1.5"><svg aria-hidden="true" viewBox="0 0 24 24" class="h-3.5 w-3.5 shrink-0 text-emerald-500" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/></svg><span class="flex-1 truncate text-[10px] font-bold text-slate-700 dark:text-slate-200">{t('panel.check4')}</span><svg aria-hidden="true" viewBox="0 0 24 24" class="h-3 w-3 text-slate-300" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg></div>
      <div class="flex items-center gap-2 rounded-xl px-2 py-1.5"><svg aria-hidden="true" viewBox="0 0 24 24" class="h-3.5 w-3.5 shrink-0 text-amber-500" fill="none" stroke="currentColor" stroke-width="2"><path d="m13 2-9 12h8l-1 8 9-12h-8l1-8Z"/></svg><span class="flex-1 truncate text-[10px] font-bold text-slate-700 dark:text-slate-200">{t('feat.f2t')}</span><svg aria-hidden="true" viewBox="0 0 24 24" class="h-3 w-3 text-slate-300" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg></div>
    </div>
  </div>

  <div aria-hidden="true" class="sf-orb-enter absolute -right-[2%] top-[36%] z-30 sm:right-[1%]" data-testid="privacy-orb"><div class="animate-float-slow [animation-delay:-3s]"><div class="flex h-24 w-24 flex-col items-center justify-center rounded-full sm:h-32 sm:w-32" style="background:radial-gradient(circle at 32% 26%,#7dd3fc 0%,#6366f1 42%,#7c3aed 72%,#4c1d95 100%);box-shadow:0 0 64px rgba(124,58,237,.5),inset 0 0 26px rgba(255,255,255,.35)"><svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5 text-white sm:h-6 sm:w-6" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/></svg><span class="mt-1 text-center text-[10px] font-extrabold uppercase leading-tight tracking-widest text-white sm:text-xs">{t('common.onDevice')}</span></div></div></div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-hero-visualization]').forEach((root) => {
    const order = ['merge-pdf', 'split-pdf', 'compress-pdf', 'rotate-pdf'];
    let index = 0;
    let paused = false;
    const render = (next: number) => {
      index = next;
      root.querySelectorAll<HTMLElement>('[data-scene]').forEach((scene) => { scene.hidden = scene.dataset.scene !== order[index]; });
      const title = root.querySelector<HTMLElement>('[data-hero-scene-title]');
      const activeDot = root.querySelector<HTMLElement>(`[data-hero-scene-dot="${index}"]`);
      if (title) {
        title.textContent = activeDot?.dataset.sceneTitle || '';
        title.classList.remove('sf-pop-enter');
        requestAnimationFrame(() => requestAnimationFrame(() => title.classList.add('sf-pop-enter')));
      }
      root.querySelectorAll<HTMLElement>('[data-hero-scene-dot]').forEach((dot, dotIndex) => { const active = dotIndex === index; dot.setAttribute('aria-current', String(active)); const visual = dot.querySelector<HTMLElement>('[data-hero-dot-visual]'); visual?.classList.toggle('w-6', active); visual?.classList.toggle('w-1.5', !active); visual?.classList.toggle('bg-gradient-to-r', active); visual?.classList.toggle('from-violet-500', active); visual?.classList.toggle('to-fuchsia-500', active); visual?.classList.toggle('bg-slate-300', !active); });
    };
    root.querySelectorAll<HTMLElement>('[data-hero-scene-dot]').forEach((dot, dotIndex) => dot.addEventListener('click', () => { paused = true; render(dotIndex); }));
    root.addEventListener('mouseenter', () => { paused = true; });
    root.addEventListener('mouseleave', () => { paused = false; });
    root.addEventListener('focusin', () => { paused = true; });
    root.addEventListener('focusout', () => { paused = false; });
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) window.setInterval(() => {
      if (!paused && root.dataset.motionPaused !== 'true' && !document.hidden) render((index + 1) % order.length);
    }, 4000);
  });
</script>

<style>
  .sf-hero-window { animation: sf-hero-window .9s .45s cubic-bezier(.22,1,.36,1) both; }
  .sf-card-enter { animation: sf-card-enter .8s cubic-bezier(.22,1,.36,1) both; }
  .sf-orb-enter { animation: sf-orb-enter .9s 1.15s cubic-bezier(.22,1,.36,1) both; }
  .sf-file-chip { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:.25rem; border-radius:.75rem; border:1px solid rgb(241 245 249); background:rgb(255 255 255 / 95%); backdrop-filter:blur(8px); box-shadow:0 10px 15px -3px rgb(15 23 42 / 10%),0 4px 6px -4px rgb(15 23 42 / 10%); }
  .dark .sf-file-chip { border-color:rgb(255 255 255 / 10%); background:rgb(30 41 59 / 95%); }
  .sf-file-sm { width:3rem; height:3.5rem; }
  .sf-file-lg { width:5rem; height:6rem; }
  .sf-file-glow { box-shadow:0 20px 25px -5px rgb(14 165 233 / 25%); outline:1px solid rgb(186 230 253 / 80%); }
  .dark .sf-file-glow { outline-color:rgb(56 189 248 / 25%); }
  .sf-file-icon { display:flex; width:1.25rem; height:1.25rem; align-items:center; justify-content:center; border-radius:.375rem; box-shadow:0 1px 2px rgb(0 0 0 / 5%); }
  .sf-file-icon-lg { width:1.75rem; height:1.75rem; }
  .sf-file-icon svg { width:.625rem; height:.625rem; fill:none; stroke:white; stroke-width:2.4; }
  .sf-file-icon-lg svg { width:.875rem; height:.875rem; }
  .sf-file-label { max-width:100%; overflow:hidden; padding:0 .25rem; text-align:center; font-size:7px; font-weight:800; line-height:1; letter-spacing:.05em; color:#1e293b; text-transform:uppercase; }
  .dark .sf-file-label { color:#cbd5e1; }
  .sf-file-lines { display:block; }
  .sf-file-lines i { display:block; height:2px; width:1.5rem; border-radius:999px; background:#e2e8f0; }
  .sf-file-lines i + i { width:1rem; margin-top:2px; background:rgb(226 232 240 / 80%); }
  .sf-file-lines-lg i { width:2.25rem; }
  .sf-file-lines-lg i + i { width:1.75rem; }
  .dark .sf-file-lines i { background:rgb(255 255 255 / 15%); }
  .dark .sf-file-lines i + i { background:rgb(255 255 255 / 10%); }
  .sf-merge-pulse { animation:sf-merge-pulse 3.4s ease-out infinite; }
  .sf-merge-chip { animation:sf-merge-chip 3.4s ease-in-out infinite; }
  .sf-merge-chip-1 { --chip-x:-86px; --chip-y:-16px; --chip-r:-9deg; }
  .sf-merge-chip-2 { --chip-x:0px; --chip-y:18px; --chip-r:3deg; }
  .sf-merge-chip-3 { --chip-x:86px; --chip-y:-12px; --chip-r:8deg; }
  .sf-merge-result { animation:sf-merge-result 3.4s ease-in-out infinite; }
  .sf-split-input { animation:sf-split-input 3.4s ease-in-out infinite; }
  .sf-split-page { animation:sf-split-page 3.4s ease-in-out infinite; }
  .sf-split-page-1 { --page-x:-80px; --page-r:-10deg; }
  .sf-split-page-2 { --page-x:0px; --page-r:0deg; }
  .sf-split-page-3 { --page-x:80px; --page-r:10deg; }
  .sf-compress-chip { animation:sf-compress-chip 3s ease-in-out infinite; }
  .sf-squeeze-right { animation:sf-squeeze-right 3s ease-in-out infinite; }
  .sf-squeeze-left { animation:sf-squeeze-left 3s ease-in-out infinite; }
  .sf-rotate-ring { animation:sf-ring-rotate 9s linear infinite; }
  .sf-rotate-chip { animation:sf-rotate-chip 4.4s ease-in-out infinite; }
  .sf-compress-line { width:100%; transform-origin:left center; will-change:transform; animation:sf-compress 3s ease-in-out infinite; }
  .sf-comparison-bar { transform-origin:left center; will-change:transform; animation:sf-compare 4.6s ease-in-out infinite; }
  :global([dir='rtl']) .sf-compress-line, :global([dir='rtl']) .sf-comparison-bar { transform-origin:right center; }
  .sf-float-window { animation: sf-float-window 8.9s cubic-bezier(.42,0,.31,1) -2.1s infinite; }
  .sf-float-compression { animation: sf-float-compression 6.7s cubic-bezier(.37,0,.26,1) -4.6s infinite; }
