---
import type { AmbientMode } from '../lib/ambient';

interface Props {
  mode: Exclude<AmbientMode, 'off'>;
}

const { mode } = Astro.props;
---

<div class="ambient-layer" data-ambient-layer data-ambient-mode={mode} data-ambient-state="idle" aria-hidden="true"></div>

<script>
  import { initializeAmbientLayers } from '../scripts/ambient-bubbles';

  initializeAmbientLayers(document);
</script>
