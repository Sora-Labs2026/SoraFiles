---
import copy from '../data/liveCopy';
import {liveRaw} from '../data/liveI18n';
import {getLocaleContent} from '../i18n';
import type {LocalePath} from '../i18n/config';
import {popularityPrivacy} from '../data/popularityPrivacy';
import {localizedSourceNotice} from '../data/localizedSourceNotice';
import PrototypeInfoPage from './PrototypeInfoPage.astro';
import PrototypeContact from './PrototypeContact.astro';

type InfoSlug='about'|'contact'|'privacy'|'terms'|'open-source';
interface InfoCopy {overline:string;title:string;intro:string;cards:{t:string;d:string}[];sections:{h:string;p:string}[]}
interface Props {slug:InfoSlug;locale?:LocalePath}
const {slug,locale='en'}=Astro.props;
const translated=locale==='en'?undefined:liveRaw<InfoCopy>(locale,`page.${slug}`);
const content=locale==='en'?undefined:getLocaleContent(locale);
const reviewed=content?.pages;
const contactForm=locale==='en'?copy.contactForm:liveRaw<typeof copy.contactForm>(locale,'contactForm');
const asSection=(h:string,p:string,index:number)=>({n:String(index+1).padStart(2,'0'),title:h.replace(/^\d+\.\s*/,''),body:[p]});
const reviewedSection=(section:{heading:string;paragraphs:string[]}|undefined,fallback:{h:string;p:string},index:number)=>asSection(section?.heading??fallback.h,section?.paragraphs.join(' ')??fallback.p,index);
const source=localizedSourceNotice[locale];
let localizedPage:undefined|{eyebrow:string;title:string;intro:string;features?:{title:string;body:string[]}[];sections:{n:string;title:string;body:string[]}[]};
if(translated&&slug!=='contact'){
  let sections=translated.sections.map((section,index)=>asSection(section.h,section.p,index));
  if(slug==='privacy'){
    const privacy=reviewed!.privacy.sections;
    const local=privacy.length>=4?privacy[1]:undefined;
    const analytics=privacy.length>=4?privacy[2]:privacy[1];
    const contact=privacy.length>=4?privacy[3]:privacy[2];
    sections=[
      reviewedSection(privacy[0],translated.sections[0],0),
      reviewedSection(local,translated.sections[2],1),
      reviewedSection(analytics,translated.sections[3],2),
      reviewedSection(contact,translated.sections[4],3),
      asSection(source.title,source.body,4),
      asSection(popularityPrivacy[locale].h,popularityPrivacy[locale].p,5),
    ];
  }else if(slug==='open-source'){
    const open=reviewed!.openSource.sections;
    sections=[
      reviewedSection(open[0],translated.sections[0],0),
      reviewedSection(open[1],translated.sections[1],1),
      asSection(source.title,source.body,2),
    ];
  }
  localizedPage={
    eyebrow:translated.overline,title:translated.title,intro:translated.intro,
    features:slug==='about'?translated.cards.map(card=>({title:card.t,body:[card.d]})):undefined,
    sections,
  };
}
const onThisPage=content?.common.information??'On this page';
const featuresLabel=content?.common.about??'Features';
---
{slug==='contact'
  ? <PrototypeContact autoresponse={contactForm.sentBody} {locale} page={translated} formCopy={contactForm}/>
  : <PrototypeInfoPage {slug} page={localizedPage} {onThisPage} {featuresLabel}/>}
