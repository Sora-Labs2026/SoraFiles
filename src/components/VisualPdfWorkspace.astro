---
interface Props { tool: string; }
const { tool } = Astro.props;
const canReorder = tool === 'merge-pdf';
const canRemove = tool === 'merge-pdf';
const canDuplicate = tool === 'merge-pdf';
---

<section data-pdf-workspace data-tool={tool} hidden aria-labelledby="pdf-workspace-heading" class="pdf-visual-workspace">
  <aside data-workspace-pages class="pdf-page-rail">
    <div class="pdf-page-rail__heading">
      <div>
        <h3 id="pdf-workspace-heading" class="text-sm font-semibold">Pages</h3>
        <p data-pdf-workspace-summary class="mt-1 text-xs text-muted" aria-live="polite"></p>
      </div>
      <div class="pdf-local-history flex items-center gap-1">
        <button data-pdf-undo type="button" disabled class="pdf-rail-icon" aria-label="Undo page change">↶</button>
        <button data-pdf-redo type="button" disabled class="pdf-rail-icon" aria-label="Redo page change">↷</button>
      </div>
    </div>

    <details class="pdf-page-rail__selection">
      <summary>Page selection</summary>
      <div class="mt-3 grid grid-cols-2 gap-1.5" aria-label="Page selection shortcuts">
        <button data-pdf-select="all" type="button">All</button>
        <button data-pdf-select="none" type="button">None</button>
        <button data-pdf-select="odd" type="button">Odd</button>
        <button data-pdf-select="even" type="button">Even</button>
        <button data-pdf-select="portrait" type="button">Portrait</button>
        <button data-pdf-select="landscape" type="button">Landscape</button>
      </div>
      <div class="mt-2 flex min-w-0 gap-1.5">
        <label class="sr-only" for={`pdf-page-range-${tool}`}>Page range</label>
        <input id={`pdf-page-range-${tool}`} data-pdf-range type="text" inputmode="text" autocomplete="off" placeholder="1-3, 7" class="min-h-10 min-w-0 flex-1 rounded-control border border-line bg-surface px-2.5 text-xs text-ink focus:border-blue focus:outline-none focus:ring-2 focus:ring-blue/15"/>
        <button data-pdf-apply-range type="button" class="min-h-10 shrink-0 rounded-control bg-action px-3 text-xs font-semibold text-action-contrast">Select</button>
      </div>
      <p data-pdf-range-error hidden role="alert" class="mt-2 text-xs font-medium text-amber"></p>
    </details>

    <div class="pdf-page-rail__actions" aria-label="Actions for selected pages">
      <button data-pdf-rotate="-90" type="button">↶ <span>Left</span></button>
      <button data-pdf-rotate="90" type="button">↷ <span>Right</span></button>
      {canReorder && <button data-pdf-move="-1" type="button">← <span>Earlier</span></button>}
      {canReorder && <button data-pdf-move="1" type="button"><span>Later</span> →</button>}
      {canDuplicate && <button data-pdf-duplicate type="button"><span>Duplicate</span></button>}
      {canRemove && <button data-pdf-delete type="button" class="text-coral"><span>Remove</span></button>}
    </div>

    <ol data-pdf-page-grid class="pdf-page-grid" aria-label="PDF pages"></ol>
  </aside>

  <section data-workspace-canvas class="pdf-canvas-area" aria-label="PDF preview">
    <div class="pdf-canvas-area__bar">
      <p data-pdf-active-title class="truncate text-xs font-semibold text-muted">Page preview</p>
      <p class="text-[11px] text-muted">Click a page to preview · check it to select</p>
    </div>
    <div data-pdf-main-stage class="pdf-main-stage">
      {tool === 'sign-pdf' ? (
        <div id="signature-placement" hidden class="signature-placement">
          <label class="sr-only" for="signature-page">Page</label>
          <input id="signature-page" type="number" inputmode="numeric" min="1" value="1" class="sr-only"/>
          <div id="signature-page-stage" class="signature-page-stage" aria-label="PDF page. Click to place the current signature.">
            <canvas id="signature-page-preview" class="block h-auto max-h-full w-auto max-w-full bg-white"></canvas>
            <div id="signature-selection" data-signature-instance data-page="1" hidden class="signature-selection" tabindex="0" aria-label="Selected signature. Drag to move; use the corner handles to resize.">
              <img id="signature-overlay" alt="Signature placement" draggable="false" class="h-full w-full select-none object-contain [-webkit-user-drag:none] [-webkit-user-select:none]"/>
              <button data-sign-handle="nw" type="button" tabindex="-1" aria-label="Resize signature from top left"></button>
              <button data-sign-handle="ne" type="button" tabindex="-1" aria-label="Resize signature from top right"></button>
              <button data-sign-handle="sw" type="button" tabindex="-1" aria-label="Resize signature from bottom left"></button>
              <button data-sign-handle="se" type="button" tabindex="-1" aria-label="Resize signature from bottom right"></button>
            </div>
          </div>
          <p class="signature-placement__hint">Click the page to place, then drag or resize. Changes are committed when you release.</p>
        </div>
      ) : (
        <div class="pdf-main-page">
          <canvas data-pdf-main-canvas class="block h-auto max-h-full w-auto max-w-full bg-white" aria-label="Selected PDF page preview"></canvas>
          <div data-pdf-live-overlay class="pdf-live-overlay" aria-hidden="true"><span data-pdf-overlay-content></span><button data-pdf-overlay-resize type="button" tabindex="-1" aria-label="Resize overlay"></button></div>
        </div>
      )}
    </div>
  </section>

  <dialog data-pdf-preview-dialog class="m-auto max-h-[calc(100dvh-2rem)] w-[min(58rem,calc(100vw-2rem))] rounded-card border border-line bg-surface p-0 text-ink shadow-card backdrop:bg-slate-950/70">
    <div class="sticky top-0 z-10 flex items-center justify-between gap-3 border-b border-line bg-surface/95 px-4 py-3 backdrop-blur">
      <p data-pdf-preview-title class="min-w-0 truncate text-sm font-semibold">Page preview</p>
      <button data-pdf-preview-close type="button" class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-control border border-line text-xl text-muted hover:text-ink" aria-label="Close page preview">×</button>
    </div>
    <div class="grid max-h-[calc(100dvh-6rem)] place-items-center overflow-auto bg-canvas p-4 sm:p-6">
      <canvas data-pdf-preview-canvas class="block h-auto max-w-full rounded bg-white shadow-small" aria-label="PDF page preview"></canvas>
    </div>
  </dialog>
</section>

<style>
  .pdf-visual-workspace { min-width: 0; min-height: 0; display: grid; grid-template-columns: clamp(12rem, 16vw, 17rem) minmax(21rem, 1fr); background: var(--color-canvas); }
  .pdf-page-rail { min-width: 0; min-height: 0; display: flex; flex-direction: column; padding: .8rem; border-right: 1px solid var(--color-line); background: color-mix(in srgb, var(--color-surface) 94%, var(--color-canvas)); }
  .pdf-page-rail__heading { display: flex; align-items: center; justify-content: space-between; gap: .75rem; padding: .15rem .15rem .65rem; }
  .pdf-rail-icon { display: inline-grid; min-width: 2.4rem; min-height: 2.4rem; place-items: center; border-radius: .55rem; color: var(--color-muted); }
  .pdf-rail-icon:hover { color: var(--color-ink); background: var(--color-canvas); }
  .pdf-rail-icon:disabled { opacity: .35; cursor: not-allowed; }
  .pdf-page-rail__selection { flex: none; border-top: 1px solid var(--color-line); border-bottom: 1px solid var(--color-line); padding: .6rem .15rem; }
  .pdf-page-rail__selection summary { cursor: pointer; font-size: .7rem; font-weight: 700; color: var(--color-muted); }
  .pdf-page-rail__selection button { min-height: 2.35rem; border-radius: .5rem; background: var(--color-canvas); font-size: .7rem; font-weight: 650; color: var(--color-ink); }
  .pdf-page-rail__actions { flex: none; display: flex; flex-wrap: wrap; gap: .3rem; padding: .65rem 0 .55rem; }
  .pdf-page-rail__actions button { min-height: 2.35rem; flex: 0 0 auto; border-radius: .5rem; padding: 0 .55rem; background: var(--color-canvas); font-size: .68rem; font-weight: 700; color: var(--color-muted); }
  .pdf-page-rail__actions button:hover { color: var(--color-ink); }
  .pdf-page-grid { min-height: 0; flex: 1; display: grid; align-content: start; grid-template-columns: repeat(2, minmax(0,1fr)); gap: .55rem; overflow-y: auto; overscroll-behavior: contain; padding: .1rem .2rem .5rem .1rem; }
  .pdf-canvas-area { min-width: 0; min-height: 0; display: grid; grid-template-rows: auto minmax(0,1fr); overflow: hidden; }
  .pdf-canvas-area__bar { display: flex; min-width: 0; align-items: center; justify-content: space-between; gap: 1rem; min-height: 2.7rem; padding: .45rem .8rem; border-bottom: 1px solid color-mix(in srgb, var(--color-line) 70%, transparent); }
  .pdf-main-stage { min-width: 0; min-height: 0; display: grid; place-items: center; overflow: auto; padding: clamp(.75rem, 2vw, 2rem); background-color: var(--color-canvas); background-image: radial-gradient(circle, color-mix(in srgb, var(--color-muted) 18%, transparent) .65px, transparent .7px); background-size: 15px 15px; }
  .pdf-main-page, .signature-page-stage { position: relative; display: grid; place-items: center; max-width: 100%; max-height: 100%; background: white; box-shadow: 0 12px 40px rgb(15 23 42 / .16), 0 1px 3px rgb(15 23 42 / .18); }
  .pdf-live-overlay { position: absolute; inset: 0; pointer-events: none; display: grid; place-items: center; color: #343b51; font-weight: 700; opacity: .24; transform: rotate(35deg); }
  .pdf-live-overlay:empty, .pdf-live-overlay:has([data-pdf-overlay-content]:empty) { display: none; }
  :global([data-tool='watermark-pdf']) .pdf-live-overlay { inset: auto; left: 50%; top: 50%; display: block; width: max-content; max-width: 78%; padding: .45rem .7rem; border: 1.5px solid var(--color-blue); opacity: 1; color: #343b51; transform: translate(-50%,-50%) rotate(35deg); cursor: move; pointer-events: auto; touch-action: none; }
  :global([data-tool='watermark-pdf']) .pdf-live-overlay [data-pdf-overlay-content] { display: block; opacity: .25; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pdf-live-overlay [data-pdf-overlay-resize] { display: none; }
  :global([data-tool='watermark-pdf']) .pdf-live-overlay [data-pdf-overlay-resize] { position: absolute; right: -.6rem; bottom: -.6rem; display: block; width: 1.15rem; height: 1.15rem; min-width: 1.15rem; min-height: 1.15rem; border: 2px solid white; border-radius: 999px; background: var(--color-blue); box-shadow: 0 1px 4px rgb(15 23 42 / .22); cursor: nwse-resize; }
  .signature-placement { position: relative; width: 100%; height: 100%; min-height: 0; }
  .signature-page-stage { width: fit-content; height: fit-content; margin: auto; overflow: hidden; touch-action: none; user-select: none; }
  .signature-selection { position: absolute; left: 62%; top: 76%; width: 30%; min-width: 4rem; aspect-ratio: 3 / 1; border: 2px solid var(--color-blue); cursor: move; touch-action: none; }
  .signature-selection:not([data-selected]) { border-color: transparent; }
  .signature-selection:not([data-selected]) [data-sign-handle] { display: none; }
  .signature-selection:focus-visible { outline: 3px solid color-mix(in srgb, var(--color-blue) 30%, transparent); outline-offset: 3px; }
  .signature-selection [data-sign-handle] { position: absolute; width: 1rem; height: 1rem; min-width: 1rem; min-height: 1rem; border: 2px solid white; border-radius: 999px; background: var(--color-blue); box-shadow: 0 1px 4px rgb(15 23 42 / .25); touch-action: none; }
  .signature-selection [data-sign-handle='nw'] { left: -.55rem; top: -.55rem; cursor: nwse-resize; }
  .signature-selection [data-sign-handle='ne'] { right: -.55rem; top: -.55rem; cursor: nesw-resize; }
  .signature-selection [data-sign-handle='sw'] { left: -.55rem; bottom: -.55rem; cursor: nesw-resize; }
  .signature-selection [data-sign-handle='se'] { right: -.55rem; bottom: -.55rem; cursor: nwse-resize; }
  .signature-placement__hint { position: absolute; left: 50%; bottom: .65rem; transform: translateX(-50%); width: max-content; max-width: calc(100% - 1.5rem); border-radius: 999px; padding: .4rem .75rem; background: rgb(15 23 42 / .82); color: white; font-size: .68rem; text-align: center; pointer-events: none; }
  :global([data-pdf-page-card][aria-selected='true']) { border-color: var(--color-blue); box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-blue) 24%, transparent); }
  :global([data-pdf-page-card][aria-selected='true'] [data-pdf-selected-mark]) { opacity: 1; transform: scale(1); }
  :global([data-pdf-page-card] canvas) { content-visibility: auto; }
  :global([data-pdf-preview-dialog][open]) { display: block; }
  @media (max-width: 1050px) {
    .pdf-visual-workspace { grid-template-columns: 11rem minmax(18rem,1fr); }
    .pdf-page-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 767px) {
    .pdf-local-history { display: none; }
    .pdf-page-rail__actions button, .pdf-page-rail__selection button { min-height: 2.75rem; }
    .pdf-page-rail__selection summary { min-height: 2.75rem; display: flex; align-items: center; }
    :global(.action-workspace[data-mobile-view='inspector']) .pdf-page-rail { display: none; }
    .pdf-visual-workspace { width: 100%; height: 100%; display: block; }
    .pdf-page-rail, .pdf-canvas-area { width: 100%; height: 100%; border: 0; }
    :global(.action-workspace[data-mobile-view='canvas']) .pdf-page-rail { display: none; }
    :global(.action-workspace[data-mobile-view='pages']) .pdf-canvas-area { display: none; }
    :global(.action-workspace[data-mobile-view='pages']) .pdf-page-rail { display: flex; }
    .pdf-page-grid { grid-template-columns: repeat(3,minmax(0,1fr)); }
    .pdf-main-stage { padding: .7rem; }
    .pdf-canvas-area__bar { min-height: 2.5rem; }
    .pdf-canvas-area__bar p:last-child { display: none; }
    .signature-selection [data-sign-handle] { width: 1.35rem; height: 1.35rem; min-width: 1.35rem; min-height: 1.35rem; }
    .signature-selection [data-sign-handle='nw'] { left: -.72rem; top: -.72rem; }
    .signature-selection [data-sign-handle='ne'] { right: -.72rem; top: -.72rem; }
    .signature-selection [data-sign-handle='sw'] { left: -.72rem; bottom: -.72rem; }
    .signature-selection [data-sign-handle='se'] { right: -.72rem; bottom: -.72rem; }
  }
</style>
