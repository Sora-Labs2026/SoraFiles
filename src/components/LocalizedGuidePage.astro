---
import PrototypeBreadcrumb from './PrototypeBreadcrumb.astro';
import PrototypeGuide from './PrototypeGuide.astro';
import {publishedGuides} from '../data/guides';
import {guideText,localizedGuides,guideLink} from '../i18n/guides';
import {localeByPath,type LocalePath} from '../i18n/config';
import '../styles/v10-site-exact.css';
interface Props {locale:LocalePath;basePath:string}
const {locale,basePath}=Astro.props;
const t=(s:string)=>guideText(locale,s);
const publicSlugs=new Set(publishedGuides().map(g=>g.slug));
const published=localizedGuides(locale).filter(g=>publicSlugs.has(g.slug));
const groups=[{title:'SoraFiles Desktop',id:'desktop',guides:published.filter(g=>g.category===t('SoraFiles Desktop'))},{title:'Working with files',id:'files',guides:published.filter(g=>g.category!==t('SoraFiles Desktop'))}];
const date=(s:string)=>new Intl.DateTimeFormat(localeByPath.get(locale)!.code,{year:'numeric',month:'long',day:'numeric',timeZone:'UTC'}).format(new Date(s));
---
{basePath!=='/guides'?<PrototypeGuide slug={basePath.slice('/guides/'.length)} {locale}/>:<main id="main" data-prototype-info>
 <header class="container page-intro"><PrototypeBreadcrumb {locale} items={[{label:t('Home'),href:guideLink(locale,'/')},{label:t('Guides')}]}/><h1 class="t-h1 page-intro__title"><span class="line-reveal"><span class="line-reveal__inner">{t('Guides')}</span></span></h1></header>
 <div class="container guides-hub">{groups.filter(group=>group.guides.length).map(group=><section class="guide-group" data-testid={`guide-group-${group.id}`} aria-labelledby={`guide-group-${group.id}`}><h2 class="t-h3 guide-group__title" id={`guide-group-${group.id}`}>{t(group.title)}</h2><ul class="guide-list">{group.guides.map((g,i)=><li style={`--i:${i}`}><a class="guide-card" href={guideLink(locale,`/guides/${g.slug}`)}><span class="t-label guide-card__cat">{g.category}</span><span class="guide-card__title">{g.title}</span><span class="t-small guide-card__desc">{g.description}</span>{('published' in g?g.published:undefined)&&<time class="t-caption tnum guide-card__date" datetime={('published' in g?g.published:undefined)}>{date(String('published' in g?g.published:''))}</time>}<svg class="guide-card__arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14m-7-7 7 7-7 7"/></svg></a></li>)}</ul></section>)}</div>
</main>}
