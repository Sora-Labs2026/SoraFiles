---
import type { LocalizedToolCopy } from '../i18n/types';
import type { LocalePath } from '../i18n/config';
import { getWorkbenchMessages } from '../i18n/workbench';
import { getOcrMessages } from '../i18n/ocr';
interface Props { locale?: LocalePath; copy?: LocalizedToolCopy; }
const { locale = 'en', copy = { title: 'Compress PDF', description: 'Compress a PDF locally in this browser.', note: 'Every page is rebuilt as an image. Selectable text, forms, links, bookmarks, signatures, layers, and accessibility structure are flattened.' } as LocalizedToolCopy } = Astro.props;
const m = getWorkbenchMessages(locale);
const cancelLabel = getOcrMessages(locale).cancel;
---
<section data-workbench id="pdf-tool" aria-labelledby="pdf-tool-heading" class="mx-auto max-w-5xl px-5 sm:px-6" data-localized={locale !== 'en' ? 'true' : 'false'} data-copy-note={copy.note}>
  <div class="overflow-hidden rounded-card bg-surface shadow-card">
    <div class="border-b border-line px-5 py-4 sm:px-7">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <p class="eyebrow text-xs font-semibold text-blue">{m.localPdfTool}</p>
          <h2 id="pdf-tool-heading" class="mt-1 text-lg font-semibold tracking-tight">{copy.title}</h2>
        </div>
        <div class="inline-flex items-center gap-2 rounded-full bg-green-soft px-3 py-1.5 text-xs font-medium text-green"><span class="h-2 w-2 rounded-full bg-green" aria-hidden="true"></span>{m.noUpload}</div>
      </div>
    </div>

    <div id="pdf-empty" class="p-4 sm:p-7">
      <div id="pdf-drop-zone" class="group flex min-h-72 flex-col items-center justify-center rounded-xl border border-dashed border-line-strong bg-canvas px-5 py-12 text-center transition-colors hover:border-blue/60 hover:bg-surface">
        <div class="flex h-14 w-14 items-center justify-center rounded-xl bg-surface shadow-small"><svg aria-hidden="true" viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M7 3.5h7l4 4V20a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 6 20V5a1.5 1.5 0 0 1 1-1.5Z"/><path d="M14 3.5v4h4M9 13h6M9 17h4" stroke-linecap="round"/></svg></div>
        <h3 class="mt-5 text-xl font-semibold tracking-tight">{m.choosePdf}</h3>
        <p class="mt-2 max-w-md text-sm leading-6 text-muted">50 MB · 40 PDF · {m.processedHere}</p>
        <button id="pdf-choose" type="button" class="mt-6 inline-flex min-h-12 items-center justify-center rounded-control bg-action px-6 text-sm font-medium text-action-contrast shadow-small transition-colors hover:bg-action-hover">{m.choosePdf}</button>
        <input id="pdf-input" name="pdfFile" class="sr-only" type="file" accept="application/pdf,.pdf" aria-label={m.choosePdf} aria-describedby="pdf-file-help" />
        <p id="pdf-file-help" class="sr-only">{copy.description}</p>
        <p id="pdf-file-error" hidden role="alert" tabindex="-1" class="mt-4 max-w-md break-words rounded-control bg-amber-soft px-4 py-3 text-sm leading-6 text-amber"></p>
      </div>
    </div>

    <div id="pdf-work" hidden class="grid lg:grid-cols-[0.9fr_1.1fr]">
      <div class="border-b border-line p-5 sm:p-7 lg:border-b-0 lg:border-r">
        <div class="flex items-start justify-between gap-4"><div class="min-w-0"><p id="pdf-name" class="truncate text-sm font-semibold"></p><p id="pdf-meta" class="mt-1 text-xs text-muted"></p></div><button id="pdf-remove" type="button" class="min-h-10 rounded-control px-3 text-sm text-muted hover:bg-canvas hover:text-ink">{m.remove}</button></div>
        <div class="mt-6 overflow-hidden rounded-xl border border-line bg-canvas p-3"><canvas id="pdf-preview" width="800" height="1040" class="mx-auto max-h-96 w-auto max-w-full rounded bg-white shadow-small" aria-label={copy.title}></canvas></div>
      </div>
      <form data-workbench-controls id="pdf-form" class="p-5 sm:p-7">
        <fieldset><legend class="text-sm font-semibold">{m.compressionLevel}</legend>
          <div class="mt-3 grid gap-2">
            <label class="flex cursor-pointer gap-3 rounded-control border border-line p-4 has-checked:border-blue has-checked:bg-blue-soft"><input type="radio" name="pdfLevel" value="balanced" checked class="mt-1 accent-blue"/><span><strong class="block text-sm">{m.balanced}</strong><span class="mt-1 block text-xs leading-5 text-muted">108 DPI</span></span></label>
            <label class="flex cursor-pointer gap-3 rounded-control border border-line p-4 has-checked:border-blue has-checked:bg-blue-soft"><input type="radio" name="pdfLevel" value="small" class="mt-1 accent-blue"/><span><strong class="block text-sm">{m.smallerFile}</strong><span class="mt-1 block text-xs leading-5 text-muted">86 DPI</span></span></label>
            <label class="flex cursor-pointer gap-3 rounded-control border border-line p-4 has-checked:border-blue has-checked:bg-blue-soft"><input type="radio" name="pdfLevel" value="quality" class="mt-1 accent-blue"/><span><strong class="block text-sm">{m.betterQuality}</strong><span class="mt-1 block text-xs leading-5 text-muted">144 DPI</span></span></label>
          </div>
        </fieldset>
        <div class="mt-5 rounded-control bg-amber-soft px-4 py-3 text-sm leading-6 text-amber">{copy.note}</div>
        <label class="mt-5 flex cursor-pointer items-start gap-3 text-sm leading-6"><input id="pdf-confirm" type="checkbox" name="pdfConfirm" class="mt-1.5 accent-blue"/><span>{m.confirmLimitation}</span></label>
        <button id="pdf-process" type="submit" class="mt-6 inline-flex min-h-12 w-full items-center justify-center rounded-control bg-action px-5 text-sm font-medium text-action-contrast transition-colors hover:bg-action-hover disabled:cursor-not-allowed disabled:opacity-50">{m.process}</button>
        <button id="pdf-cancel" type="button" hidden class="mt-3 inline-flex min-h-10 w-full items-center justify-center rounded-control border border-line bg-canvas text-sm font-medium text-ink hover:bg-surface">{cancelLabel}</button>
        <p data-workbench-status id="pdf-status" class="mt-3 min-h-5 text-center text-xs text-muted" aria-live="polite"></p>
      </form>
    </div>

    <div data-workbench-result id="pdf-result" hidden class="border-t border-line bg-canvas p-5 sm:p-7">
      <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-center"><div><p class="text-sm font-semibold text-green">{m.ready}</p><p id="pdf-result-stats" class="mt-2 text-sm text-muted"></p></div><a id="pdf-download" class="inline-flex min-h-12 items-center justify-center rounded-control bg-blue px-6 text-sm font-medium text-white hover:bg-blue-strong">{m.download}</a></div>
      <p id="pdf-result-warning" hidden class="mt-4 rounded-control bg-amber-soft px-4 py-3 text-sm leading-6 text-amber"></p>
    </div>
  </div>
</section>

<script type="application/json" id="pdf-workbench-messages" is:inline set:html={JSON.stringify(m).replace(/</g, '\\u003c')}></script>

<script>
  import type { WorkbenchMessages } from '../i18n/workbench';
  import pdfWorkerUrl from 'pdfjs-dist/build/pdf.worker.min.mjs?url';
  import { JobController } from '../lib/processing/controller';
  import { pdfEngine } from '../lib/processing/engines/pdf';
  import { ProcessingError } from '../lib/processing/errors';
  import { validateOutput } from '../lib/processing/output-validation';
  import { assertAcceptedInput } from '../lib/processing/signatures';
  import { setDisplayedFilename } from '../utils/filename';

  const messages = JSON.parse(document.querySelector('#pdf-workbench-messages')?.textContent || '{}') as WorkbenchMessages;
  const el = <T extends HTMLElement>(selector: string) => { const node = document.querySelector<T>(selector); if (!node) throw new Error(`Missing element: ${selector}`); return node; };
  const root = el('#pdf-tool'); const input = el<HTMLInputElement>('#pdf-input'); const empty = el('#pdf-empty'); const work = el('#pdf-work'); const resultEl = el('#pdf-result'); const errorEl = el('#pdf-file-error'); const status = el('#pdf-status'); const processButton = el<HTMLButtonElement>('#pdf-process'); const cancelButton = el<HTMLButtonElement>('#pdf-cancel'); const form = el<HTMLFormElement>('#pdf-form'); const preview = el<HTMLCanvasElement>('#pdf-preview');
  const localized = root.dataset.localized === 'true';
  const jobs = new JobController();
  const terminalJobs = new Set<string>();
  let sourceFile: File | null = null;
  let resultUrl: string | null = null;
  let activeJobId: string | null = null;

  const readableSize = (bytes: number) => bytes < 1000 ? `${bytes} B` : bytes < 1_000_000 ? `${(bytes / 1000).toFixed(0)} KB` : `${(bytes / 1_000_000).toFixed(2)} MB`;
  const setTerminal = (jobId: string, terminal: 'result' | 'error' | 'cancelled') => { if (!terminalJobs.has(jobId)) { terminalJobs.add(jobId); root.dataset.jobTerminal = terminal; } };
  const clearResult = () => { if (resultUrl) URL.revokeObjectURL(resultUrl); resultUrl = null; resultEl.hidden = true; };
  const cancelActive = async (visible: boolean) => { const jobId = activeJobId; activeJobId = null; await jobs.cancelAndDispose(); if (visible && jobId) { setTerminal(jobId, 'cancelled'); cancelButton.hidden = true; processButton.disabled = false; processButton.textContent = messages.process; } };
  const reset = async () => { await cancelActive(Boolean(activeJobId)); clearResult(); sourceFile = null; input.value = ''; preview.width = 1; preview.height = 1; empty.hidden = false; work.hidden = true; errorEl.hidden = true; status.textContent = ''; cancelButton.hidden = true; };

  const load = async (file: File) => {
    await reset();
    try {
      if (file.size > 50_000_000) throw new Error('Choose a PDF smaller than 50 MB. Large documents can exhaust browser memory.');
      const job = await jobs.start();
      await assertAcceptedInput(file, ['pdf']);
      jobs.transition('ready'); jobs.transition('processing');
      const pdfjs = await import('pdfjs-dist');
      pdfjs.GlobalWorkerOptions.workerSrc = pdfWorkerUrl;
      const loadingTask = pdfjs.getDocument({ data: new Uint8Array(await file.arrayBuffer()), wasmUrl: '/pdfjs/wasm/' });
      let destroyed = false;
      job.resources.defer(async () => { if (!destroyed) { destroyed = true; await loadingTask.destroy(); } });
      const documentProxy = await loadingTask.promise;
      if (documentProxy.numPages > 40) throw new Error(`This PDF has ${documentProxy.numPages} pages. The local compressor currently supports up to 40 pages.`);
      const page = await documentProxy.getPage(1);
      let pageCleaned = false;
      job.resources.defer(() => { if (!pageCleaned) { pageCleaned = true; page.cleanup(); } });
      const base = page.getViewport({ scale: 1 }); const viewport = page.getViewport({ scale: Math.min(1.25, 760 / base.width) });
      preview.width = Math.ceil(viewport.width); preview.height = Math.ceil(viewport.height);
      const context = preview.getContext('2d'); if (!context) throw new Error('Canvas rendering is unavailable in this browser.');
      const render = page.render({ canvas: preview, canvasContext: context, viewport });
      let rendering = true; job.resources.defer(() => { if (rendering) render.cancel(); });
      await render.promise; rendering = false; page.cleanup(); pageCleaned = true;
      if (job.signal.aborted) return;
      sourceFile = file;
      setDisplayedFilename(el('#pdf-name'), file.name);
      el('#pdf-meta').textContent = localized ? `${readableSize(file.size)} · ${documentProxy.numPages} PDF` : `${readableSize(file.size)} · ${documentProxy.numPages} ${documentProxy.numPages === 1 ? 'page' : 'pages'}`;
      jobs.transition('success'); jobs.transition('result');
      await jobs.cancelAndDispose();
      empty.hidden = true; work.hidden = false;
    } catch (error) {
      await jobs.cancelAndDispose().catch(() => {});
      const detail = error instanceof ProcessingError ? messages.invalidFile : error instanceof Error ? error.message : '';
      errorEl.textContent = error instanceof Error && error.name === 'PasswordException' ? messages.password : localized ? (/50 MB|40 pages|memory/i.test(detail) ? messages.tooLarge : messages.invalidFile) : (detail || messages.invalidFile);
      errorEl.hidden = false; errorEl.focus();
    }
  };

  const compress = async () => {
    if (!sourceFile) return;
    if (!el<HTMLInputElement>('#pdf-confirm').checked) { status.textContent = messages.confirmLimitation; el<HTMLInputElement>('#pdf-confirm').focus(); return; }
    const file = sourceFile;
    clearResult(); processButton.disabled = true; processButton.textContent = messages.processing; cancelButton.hidden = false;
    let jobId: string | null = null;
    try {
      const job = await jobs.start(); jobId = job.jobId; activeJobId = job.jobId; jobs.transition('ready'); jobs.transition('processing');
      const level = new FormData(form).get('pdfLevel'); const preset = level === 'small' || level === 'quality' ? level : 'balanced';
      const output = await pdfEngine.run({ operation: 'compress', bytes: await file.arrayBuffer(), preset }, { job, onEvent: (event) => { if (jobs.accept(event) && event.type === 'progress') status.textContent = `${messages.processing} ${event.completed}/${event.total}`; } });
      if (job.signal.aborted || activeJobId !== job.jobId) return;
      const blob = new Blob([output.bytes], { type: 'application/pdf' }); await validateOutput(blob, 'pdf');
      if (job.signal.aborted || activeJobId !== job.jobId) return;
      resultUrl = URL.createObjectURL(blob); const link = el<HTMLAnchorElement>('#pdf-download'); link.href = resultUrl; link.download = `${file.name.replace(/\.pdf$/i, '')}-smaller.pdf`;
      const delta = Math.round((1 - blob.size / file.size) * 100);
      el('#pdf-result-stats').textContent = localized ? `${readableSize(file.size)} → ${readableSize(blob.size)}${delta > 0 ? ` · −${delta}%` : ''}` : `${readableSize(file.size)} → ${readableSize(blob.size)}${delta > 0 ? ` · ${delta}% smaller` : ' · larger than the original'}`;
      const warning = el('#pdf-result-warning'); warning.textContent = localized ? messages.review : blob.size >= file.size ? 'This document was already efficient. The image-based version is larger, so keep the original unless you specifically need flattened pages.' : 'Review the downloaded document before deleting or replacing the original.'; warning.hidden = false;
      jobs.transition('success'); jobs.transition('result'); setTerminal(job.jobId, 'result');
      resultEl.hidden = false; status.textContent = messages.finished; resultEl.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'nearest' });
    } catch (error) {
      if (error instanceof ProcessingError && error.value.code === 'cancelled') { if (jobId) setTerminal(jobId, 'cancelled'); }
      else { if (jobId) setTerminal(jobId, 'error'); const detail = error instanceof ProcessingError ? messages.failed : error instanceof Error ? error.message : ''; status.textContent = localized ? messages.failed : (detail || messages.failed); }
    } finally { if (activeJobId === jobId) activeJobId = null; cancelButton.hidden = true; processButton.disabled = false; processButton.textContent = messages.process; }
  };

  el<HTMLButtonElement>('#pdf-choose').addEventListener('click', () => input.click());
  input.addEventListener('change', () => input.files?.[0] && void load(input.files[0]));
  el<HTMLButtonElement>('#pdf-remove').addEventListener('click', () => void reset());
  cancelButton.addEventListener('click', () => void cancelActive(true));
  form.addEventListener('submit', event => { event.preventDefault(); void compress(); });
  const drop = el('#pdf-drop-zone');
  for (const eventName of ['dragenter', 'dragover']) drop.addEventListener(eventName, event => { event.preventDefault(); drop.classList.add('border-blue', 'bg-blue-soft', 'select-none'); });
  for (const eventName of ['dragleave', 'drop']) drop.addEventListener(eventName, event => { event.preventDefault(); drop.classList.remove('border-blue', 'bg-blue-soft', 'select-none'); });
  drop.addEventListener('drop', event => { const file = event.dataTransfer?.files[0]; if (file) void load(file); });
  window.addEventListener('beforeunload', () => { clearResult(); void jobs.cancelAndDispose(); });
</script>
