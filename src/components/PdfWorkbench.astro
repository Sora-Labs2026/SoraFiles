---
import type { LocalizedToolCopy } from '../i18n/types';
import type { LocalePath } from '../i18n/config';
import { getWorkbenchMessages } from '../i18n/workbench';
interface Props { locale?: LocalePath; copy?: LocalizedToolCopy; }
const { locale = 'en', copy = { title: 'Compress PDF', description: 'Compress a PDF locally in this browser.', note: 'Every page is rebuilt as an image. Selectable text, forms, links, bookmarks, signatures, layers, and accessibility structure are flattened.' } as LocalizedToolCopy } = Astro.props;
const m = getWorkbenchMessages(locale);
---
<section data-workbench id="pdf-tool" aria-labelledby="pdf-tool-heading" class="mx-auto max-w-5xl px-5 sm:px-6" data-localized={locale !== 'en' ? 'true' : 'false'} data-copy-note={copy.note}>
  <div class="overflow-hidden rounded-card bg-surface shadow-card">
    <div class="border-b border-line px-5 py-4 sm:px-7">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <p class="eyebrow text-xs font-semibold text-blue">{m.localPdfTool}</p>
          <h2 id="pdf-tool-heading" class="mt-1 text-lg font-semibold tracking-tight">{copy.title}</h2>
        </div>
        <div class="inline-flex items-center gap-2 rounded-full bg-green-soft px-3 py-1.5 text-xs font-medium text-green"><span class="h-2 w-2 rounded-full bg-green" aria-hidden="true"></span>{m.noUpload}</div>
      </div>
    </div>

    <div id="pdf-empty" class="p-4 sm:p-7">
      <div id="pdf-drop-zone" class="group flex min-h-72 flex-col items-center justify-center rounded-xl border border-dashed border-line-strong bg-canvas px-5 py-12 text-center transition-colors hover:border-blue/60 hover:bg-surface">
        <div class="flex h-14 w-14 items-center justify-center rounded-xl bg-surface shadow-small"><svg aria-hidden="true" viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M7 3.5h7l4 4V20a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 6 20V5a1.5 1.5 0 0 1 1-1.5Z"/><path d="M14 3.5v4h4M9 13h6M9 17h4" stroke-linecap="round"/></svg></div>
        <h3 class="mt-5 text-xl font-semibold tracking-tight">{m.choosePdf}</h3>
        <p class="mt-2 max-w-md text-sm leading-6 text-muted">50 MB · 40 PDF · {m.processedHere}</p>
        <button id="pdf-choose" type="button" class="mt-6 inline-flex min-h-12 items-center justify-center rounded-control bg-action px-6 text-sm font-medium text-action-contrast shadow-small transition-colors hover:bg-action-hover">{m.choosePdf}</button>
        <input id="pdf-input" name="pdfFile" class="sr-only" type="file" accept="application/pdf,.pdf" aria-label={m.choosePdf} aria-describedby="pdf-file-help" />
        <p id="pdf-file-help" class="sr-only">{copy.description}</p>
        <p id="pdf-file-error" hidden role="alert" tabindex="-1" class="mt-4 max-w-md break-words rounded-control bg-amber-soft px-4 py-3 text-sm leading-6 text-amber"></p>
      </div>
    </div>

    <div id="pdf-work" hidden class="grid lg:grid-cols-[0.9fr_1.1fr]">
      <div class="border-b border-line p-5 sm:p-7 lg:border-b-0 lg:border-r">
        <div class="flex items-start justify-between gap-4"><div class="min-w-0"><p id="pdf-name" class="truncate text-sm font-semibold"></p><p id="pdf-meta" class="mt-1 text-xs text-muted"></p></div><button id="pdf-remove" type="button" class="min-h-10 rounded-control px-3 text-sm text-muted hover:bg-canvas hover:text-ink">{m.remove}</button></div>
        <div class="mt-6 overflow-hidden rounded-xl border border-line bg-canvas p-3"><canvas id="pdf-preview" width="800" height="1040" class="mx-auto max-h-96 w-auto max-w-full rounded bg-white shadow-small" aria-label={copy.title}></canvas></div>
      </div>
      <form data-workbench-controls id="pdf-form" class="p-5 sm:p-7">
        <fieldset><legend class="text-sm font-semibold">{m.compressionLevel}</legend>
          <div class="mt-3 grid gap-2">
            <label class="flex cursor-pointer gap-3 rounded-control border border-line p-4 has-checked:border-blue has-checked:bg-blue-soft"><input type="radio" name="pdfLevel" value="balanced" checked class="mt-1 accent-blue"/><span><strong class="block text-sm">{m.balanced}</strong><span class="mt-1 block text-xs leading-5 text-muted">108 DPI</span></span></label>
            <label class="flex cursor-pointer gap-3 rounded-control border border-line p-4 has-checked:border-blue has-checked:bg-blue-soft"><input type="radio" name="pdfLevel" value="small" class="mt-1 accent-blue"/><span><strong class="block text-sm">{m.smallerFile}</strong><span class="mt-1 block text-xs leading-5 text-muted">86 DPI</span></span></label>
            <label class="flex cursor-pointer gap-3 rounded-control border border-line p-4 has-checked:border-blue has-checked:bg-blue-soft"><input type="radio" name="pdfLevel" value="quality" class="mt-1 accent-blue"/><span><strong class="block text-sm">{m.betterQuality}</strong><span class="mt-1 block text-xs leading-5 text-muted">144 DPI</span></span></label>
          </div>
        </fieldset>
        <div class="mt-5 rounded-control bg-amber-soft px-4 py-3 text-sm leading-6 text-amber">{copy.note}</div>
        <label class="mt-5 flex cursor-pointer items-start gap-3 text-sm leading-6"><input id="pdf-confirm" type="checkbox" name="pdfConfirm" class="mt-1.5 accent-blue"/><span>{m.confirmLimitation}</span></label>
        <button id="pdf-process" type="submit" class="mt-6 inline-flex min-h-12 w-full items-center justify-center rounded-control bg-action px-5 text-sm font-medium text-action-contrast transition-colors hover:bg-action-hover disabled:cursor-not-allowed disabled:opacity-50">{m.process}</button>
        <p data-workbench-status id="pdf-status" class="mt-3 min-h-5 text-center text-xs text-muted" aria-live="polite"></p>
      </form>
    </div>

    <div data-workbench-result id="pdf-result" hidden class="border-t border-line bg-canvas p-5 sm:p-7">
      <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-center"><div><p class="text-sm font-semibold text-green">{m.ready}</p><p id="pdf-result-stats" class="mt-2 text-sm text-muted"></p></div><a id="pdf-download" class="inline-flex min-h-12 items-center justify-center rounded-control bg-blue px-6 text-sm font-medium text-white hover:bg-blue-strong">{m.download}</a></div>
      <p id="pdf-result-warning" hidden class="mt-4 rounded-control bg-amber-soft px-4 py-3 text-sm leading-6 text-amber"></p>
    </div>
  </div>
</section>

<script type="application/json" id="pdf-workbench-messages" is:inline set:html={JSON.stringify(m).replace(/</g, '\\u003c')}></script>

<script>
  import type { PDFDocumentProxy } from 'pdfjs-dist';
  import type { WorkbenchMessages } from '../i18n/workbench';
  import pdfWorkerUrl from 'pdfjs-dist/build/pdf.worker.min.mjs?url';
  import { setDisplayedFilename } from '../utils/filename';
  const pdfMessages = JSON.parse(document.querySelector('#pdf-workbench-messages')?.textContent || '{}') as WorkbenchMessages;
  const pdfEl = <T extends HTMLElement>(selector: string) => { const node = document.querySelector<T>(selector); if (!node) throw new Error(`Missing element: ${selector}`); return node; };
  const pdfInput = pdfEl<HTMLInputElement>('#pdf-input');
  const pdfEmpty = pdfEl('#pdf-empty');
  const pdfWork = pdfEl('#pdf-work');
  const pdfResult = pdfEl('#pdf-result');
  const pdfError = pdfEl('#pdf-file-error');
  const pdfStatus = pdfEl('#pdf-status');
  const pdfButton = pdfEl<HTMLButtonElement>('#pdf-process');
  const pdfForm = pdfEl<HTMLFormElement>('#pdf-form');
  const pdfCanvas = pdfEl<HTMLCanvasElement>('#pdf-preview');
  const localizedPdf = pdfEl('#pdf-tool').dataset.localized === 'true';
  let pdfFile: File | null = null;
  let pdfSource: PDFDocumentProxy | null = null;
  let pdfResultUrl: string | null = null;

  const pdfBytes = (bytes: number) => bytes < 1000 ? `${bytes} B` : bytes < 1_000_000 ? `${(bytes / 1000).toFixed(0)} KB` : `${(bytes / 1_000_000).toFixed(2)} MB`;
  const validPdfSignature = async (file: File) => new TextDecoder('ascii').decode(await file.slice(0, 5).arrayBuffer()) === '%PDF-';
  const clearPdfResult = () => { if (pdfResultUrl) URL.revokeObjectURL(pdfResultUrl); pdfResultUrl = null; pdfResult.hidden = true; };
  const resetPdf = async () => { clearPdfResult(); await pdfSource?.cleanup(); pdfSource = null; pdfFile = null; pdfInput.value = ''; pdfEmpty.hidden = false; pdfWork.hidden = true; pdfError.hidden = true; pdfStatus.textContent = ''; };

  const renderPreview = async () => {
    if (!pdfSource) return;
    const page = await pdfSource.getPage(1);
    const base = page.getViewport({ scale: 1 });
    const scale = Math.min(1.25, 760 / base.width);
    const viewport = page.getViewport({ scale });
    pdfCanvas.width = Math.ceil(viewport.width);
    pdfCanvas.height = Math.ceil(viewport.height);
    const context = pdfCanvas.getContext('2d');
    if (!context) throw new Error('Canvas rendering is unavailable in this browser.');
    await page.render({ canvas: pdfCanvas, canvasContext: context, viewport }).promise;
    page.cleanup();
  };

  const loadPdf = async (file: File) => {
    await resetPdf();
    pdfError.hidden = true;
    try {
      if (file.size > 50_000_000) throw new Error('Choose a PDF smaller than 50 MB. Large documents can exhaust browser memory.');
      if (!(await validPdfSignature(file))) throw new Error('This file does not have a valid PDF signature. Choose an actual PDF document.');
      const data = new Uint8Array(await file.arrayBuffer());
      const pdfjs = await import('pdfjs-dist');
      pdfjs.GlobalWorkerOptions.workerSrc = pdfWorkerUrl;
      pdfSource = await pdfjs.getDocument({ data, wasmUrl: '/pdfjs/wasm/' }).promise;
      if (pdfSource.numPages > 40) throw new Error(`This PDF has ${pdfSource.numPages} pages. The local compressor currently supports up to 40 pages.`);
      pdfFile = file;
      setDisplayedFilename(pdfEl('#pdf-name'), file.name);
      pdfEl('#pdf-meta').textContent = localizedPdf ? `${pdfBytes(file.size)} · ${pdfSource.numPages} PDF` : `${pdfBytes(file.size)} · ${pdfSource.numPages} ${pdfSource.numPages === 1 ? 'page' : 'pages'}`;
      await renderPreview();
      pdfEmpty.hidden = true;
      pdfWork.hidden = false;
    } catch (error) {
      await pdfSource?.cleanup(); pdfSource = null;
      const detail = error instanceof Error ? error.message : '';
      pdfError.textContent = error instanceof Error && error.name === 'PasswordException' ? pdfMessages.password : localizedPdf ? (/50 MB|40 pages|memory/i.test(detail) ? pdfMessages.tooLarge : pdfMessages.invalidFile) : (detail || pdfMessages.invalidFile);
      pdfError.hidden = false; pdfError.focus();
    }
  };

  const canvasJpeg = (canvas: HTMLCanvasElement, quality: number) => new Promise<Blob>((resolve, reject) => canvas.toBlob(blob => blob ? resolve(blob) : reject(new Error('The browser could not encode a PDF page.')), 'image/jpeg', quality));

  const compressPdf = async () => {
    if (!pdfFile || !pdfSource) return;
    if (!pdfEl<HTMLInputElement>('#pdf-confirm').checked) { pdfStatus.textContent = pdfMessages.confirmLimitation; pdfEl<HTMLInputElement>('#pdf-confirm').focus(); return; }
    const level = new FormData(pdfForm).get('pdfLevel');
    const setting = level === 'small' ? { scale: 1.2, quality: 0.58 } : level === 'quality' ? { scale: 2, quality: 0.82 } : { scale: 1.5, quality: 0.72 };
    clearPdfResult(); pdfButton.disabled = true; pdfButton.textContent = pdfMessages.processing;
    try {
      const { PDFDocument } = await import('pdf-lib');
      const output = await PDFDocument.create();
      output.setProducer('Sora Files local PDF compressor');
      for (let index = 1; index <= pdfSource.numPages; index += 1) {
        pdfStatus.textContent = `${pdfMessages.processing} ${index}/${pdfSource.numPages}`;
        const sourcePage = await pdfSource.getPage(index);
        const points = sourcePage.getViewport({ scale: 1 });
        let scale = setting.scale;
        const pixelCount = points.width * scale * points.height * scale;
        if (pixelCount > 16_000_000) scale *= Math.sqrt(16_000_000 / pixelCount);
        const viewport = sourcePage.getViewport({ scale });
        const canvas = document.createElement('canvas'); canvas.width = Math.ceil(viewport.width); canvas.height = Math.ceil(viewport.height);
        const context = canvas.getContext('2d', { alpha: false }); if (!context) throw new Error('Canvas rendering is unavailable.');
        context.fillStyle = '#ffffff'; context.fillRect(0, 0, canvas.width, canvas.height);
        await sourcePage.render({ canvas, canvasContext: context, viewport, background: '#ffffff' }).promise;
        const jpegBlob = await canvasJpeg(canvas, setting.quality);
        const image = await output.embedJpg(await jpegBlob.arrayBuffer());
        const page = output.addPage([points.width, points.height]);
        page.drawImage(image, { x: 0, y: 0, width: points.width, height: points.height });
        sourcePage.cleanup(); canvas.width = 1; canvas.height = 1;
      }
      pdfStatus.textContent = pdfMessages.processing;
      const bytes = await output.save({ useObjectStreams: true, addDefaultPage: false });
      const blob = new Blob([bytes as BlobPart], { type: 'application/pdf' });
      pdfResultUrl = URL.createObjectURL(blob);
      const link = pdfEl<HTMLAnchorElement>('#pdf-download'); link.href = pdfResultUrl; link.download = `${pdfFile.name.replace(/\.pdf$/i, '')}-smaller.pdf`;
      const delta = Math.round((1 - blob.size / pdfFile.size) * 100);
      pdfEl('#pdf-result-stats').textContent = localizedPdf ? `${pdfBytes(pdfFile.size)} → ${pdfBytes(blob.size)}${delta > 0 ? ` · −${delta}%` : ''}` : `${pdfBytes(pdfFile.size)} → ${pdfBytes(blob.size)}${delta > 0 ? ` · ${delta}% smaller` : ' · larger than the original'}`;
      const warning = pdfEl('#pdf-result-warning'); warning.textContent = localizedPdf ? pdfMessages.review : blob.size >= pdfFile.size ? 'This document was already efficient. The image-based version is larger, so keep the original unless you specifically need flattened pages.' : 'Review the downloaded document before deleting or replacing the original.'; warning.hidden = false;
      pdfResult.hidden = false; pdfStatus.textContent = pdfMessages.finished; pdfResult.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'nearest' });
    } catch (error) { const detail = error instanceof Error ? error.message : ''; pdfStatus.textContent = localizedPdf ? pdfMessages.failed : (detail || pdfMessages.failed); }
    finally { pdfButton.disabled = false; pdfButton.textContent = pdfMessages.process; }
  };

  pdfEl<HTMLButtonElement>('#pdf-choose').addEventListener('click', () => pdfInput.click());
  pdfInput.addEventListener('change', () => pdfInput.files?.[0] && void loadPdf(pdfInput.files[0]));
  pdfEl<HTMLButtonElement>('#pdf-remove').addEventListener('click', () => void resetPdf());
  pdfForm.addEventListener('submit', event => { event.preventDefault(); void compressPdf(); });
  const pdfDrop = pdfEl('#pdf-drop-zone');
  for (const eventName of ['dragenter', 'dragover']) pdfDrop.addEventListener(eventName, event => { event.preventDefault(); pdfDrop.classList.add('border-blue', 'bg-blue-soft', 'select-none'); });
  for (const eventName of ['dragleave', 'drop']) pdfDrop.addEventListener(eventName, event => { event.preventDefault(); pdfDrop.classList.remove('border-blue', 'bg-blue-soft', 'select-none'); });
  pdfDrop.addEventListener('drop', event => { const file = event.dataTransfer?.files[0]; if (file) void loadPdf(file); });
  window.addEventListener('beforeunload', () => { if (pdfResultUrl) URL.revokeObjectURL(pdfResultUrl); void pdfSource?.cleanup(); });
</script>
