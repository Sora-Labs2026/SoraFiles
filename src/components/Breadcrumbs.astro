---
interface Crumb { label: string; href?: string; }
interface Props { items: Crumb[]; label?: string; }
const { items, label = 'Breadcrumb' } = Astro.props;
---
<nav aria-label={label} class="text-sm text-muted">
  <ol class="flex flex-wrap items-center gap-2">
    {items.map((item, index) => (
      <li class="flex items-center gap-2">
        {index > 0 && <svg aria-hidden="true" viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m6 3 5 5-5 5" stroke-linecap="round" stroke-linejoin="round"/></svg>}
        {item.href ? <a href={item.href} class="rounded-sm underline decoration-line-strong underline-offset-4 hover:text-ink">{item.label}</a> : <span aria-current="page" class="font-medium text-ink">{item.label}</span>}
      </li>
    ))}
  </ol>
</nav>
