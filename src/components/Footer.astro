---
import { localizedPath, type LocalePath } from '../i18n/config';
import { liveText } from '../data/liveI18n';
import ShareMenu from './ShareMenu.astro';
interface Props { locale?: LocalePath; }
const { locale = 'en' } = Astro.props;
const hrefFor = (path: string) => localizedPath(locale, path);
const links = [[liveText(locale, 'nav.about'), '/about'], [liveText(locale, 'nav.openSource'), '/open-source'], [liveText(locale, 'nav.contact'), '/contact'], [liveText(locale, 'nav.privacy'), '/privacy'], [liveText(locale, 'nav.terms'), '/terms'], [liveText(locale, 'nav.allTools'), '/tools'], ...(locale === 'en' ? [['Guides', '/guides']] : [])];
const tagline = liveText(locale, 'footer.tagline');
---

<footer data-testid="site-footer" class="sf-deferred-section relative">
  <div class="mx-auto flex max-w-[1200px] flex-col items-start justify-between gap-5 border-t border-slate-200/70 px-4 py-10 sm:flex-row sm:items-center sm:px-6 dark:border-white/10">
    <a href={hrefFor('/')} data-testid="footer-logo-link" class="flex items-center gap-2.5">
      <span><img class="sf-logo sf-logo-light" src="/brand/sorafiles-logo-full-color.svg" alt="SoraFiles" width="110" height="30"/><img class="sf-logo sf-logo-dark" src="/brand/sorafiles-logo-full-color-dark.svg" alt="SoraFiles" width="110" height="30"/><span class="block mt-2 text-[11px] font-medium text-slate-600 dark:text-slate-400">{tagline}</span></span>
    </a>
    <div class="flex w-full flex-col gap-4 sm:w-auto sm:items-end">
      <nav aria-label={liveText(locale, 'nav.allTools')} class="flex flex-wrap items-center gap-x-6 gap-y-2">
        {links.map(([label, path]) => <a href={hrefFor(path)} data-testid={`footer-link-${path.slice(1)}`} class="text-xs font-bold text-slate-600 transition-colors hover:text-violet-600 dark:text-slate-400 dark:hover:text-violet-300">{label}</a>)}
      </nav>

      <div class="flex w-full flex-col items-stretch gap-3 sm:flex-row sm:items-center sm:justify-end">
        <ShareMenu {locale} />
        <span class="text-center text-[11px] font-medium text-slate-600 sm:text-start dark:text-slate-400">© {new Date().getFullYear()} <span translate="no">Sora Labs · SoraFiles</span></span>
      </div>
      <p class="max-w-full text-[11px] font-medium text-slate-600 sm:text-end dark:text-slate-400">Made with ❤️ by <a href="https://x.com/Dri_shy_a" target="_blank" rel="noopener noreferrer" class="rounded-sm transition-colors hover:text-violet-600 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-violet-600 dark:hover:text-violet-300 dark:focus-visible:outline-violet-300">Drishya Thapa</a></p>
    </div>
  </div>
</footer>
