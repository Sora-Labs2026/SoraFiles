---
interface Props {
  analyticsId?: string;
}

const {
  analyticsId = 'G-GQ973RY74K',
} = Astro.props;
---

<script is:inline define:vars={{ analyticsId }}>
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    dataLayer.push(arguments);
  }
  gtag('consent', 'default', {
    ad_storage: 'denied',
    analytics_storage: 'denied',
    ad_user_data: 'denied',
    ad_personalization: 'denied',
    wait_for_update: 500,
  });
  gtag('js', new Date());
  gtag('config', analyticsId, { anonymize_ip: true });

  const loadAnalytics = () => {
    if (document.querySelector('script[data-sf-google-analytics]')) return;
    const script = document.createElement('script');
    script.async = true;
    script.dataset.sfGoogleAnalytics = 'true';
    script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(analyticsId)}`;
    document.head.append(script);
  };

  const scheduleAnalytics = () => {
    const timeoutId = window.setTimeout(loadAnalytics, 15_000);
    const loadAfterInteraction = () => {
      window.clearTimeout(timeoutId);
      loadAnalytics();
    };
    for (const eventName of ['pointerdown', 'touchstart', 'keydown']) {
      window.addEventListener(eventName, loadAfterInteraction, { once: true, passive: true });
    }
  };

  if (document.readyState === 'complete') scheduleAnalytics();
  else window.addEventListener('load', scheduleAnalytics, { once: true });
</script>
