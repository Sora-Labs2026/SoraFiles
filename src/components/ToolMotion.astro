---
import type { LiveTool } from '../data/liveTools';
import ToolIcon from './ToolIcon.astro';
import ToolMotionFileChip from './ToolMotionFileChip.astro';

interface Props { tool: LiveTool; compact?: boolean; class?: string; }
const { tool, compact = false, class: className = '' } = Astro.props;

const motionKindFor = (toolId: string) => {
  if (toolId === 'merge-pdf') return 'merge';
  if (toolId === 'split-pdf') return 'split';
  if (['compress-pdf', 'compress-image'].includes(toolId)) return 'compress';
  if (toolId === 'rotate-pdf') return 'rotate';
  if (['pdf-to-word', 'word-to-pdf', 'jpg-to-pdf', 'pdf-to-jpg', 'image-converter', 'heic-to-jpg'].includes(toolId)) return 'convert';
  return 'process';
};
const inputSummary = (accept: string) => {
  const value = accept.toLowerCase();
  if (value.includes('heic')) return 'HEIC · HEIF';
  if (value.includes('wordprocessingml')) return 'DOCX';
  if (value.includes('excel') || value.includes('spreadsheet') || value.includes('csv')) return 'XLSX · XLS · CSV';
  if (value.includes('image/')) return 'JPG · PNG · WebP';
  return 'PDF';
};

const kind = motionKindFor(tool.id);
const inputLabel = tool.id === 'jpg-to-pdf' ? 'JPG' : inputSummary(tool.accept);
const outputLabel = tool.outputLabel.split('/')[0].trim();
---

<div data-tool-motion data-motion-region data-motion-kind={kind} data-tool-id={tool.id} class:list={['sf-tool-motion relative', compact ? 'h-28 sm:h-32' : 'h-32 sm:h-36', className]} aria-hidden="true">
  {kind === 'merge' && <>
    <div class="sf-motion-animated relative flex h-full items-center justify-center">
      <span class="sf-merge-ring absolute h-24 w-24 rounded-full border-2 border-sky-400/60"></span>
      {[
        ['-86px', '-16px', '-9deg'],
        ['0px', '18px', '3deg'],
        ['86px', '-12px', '8deg'],
      ].map(([x,y,r], index) => <span class="sf-merge-input absolute will-change-transform" style={`--motion-x:${x};--motion-y:${y};--motion-r:${r}`}><ToolMotionFileChip size="sm" tile="from-red-400 to-red-600" label={`PDF ${index + 1}`} /></span>)}
      <span class="sf-merge-result absolute will-change-transform"><ToolMotionFileChip size="lg" tile={tool.tile} label="PDF" icon={tool.icon} glow /></span>
    </div>
    <div class="sf-motion-static hidden h-full items-center justify-center"><ToolMotionFileChip size="lg" tile={tool.tile} label="PDF" icon={tool.icon} glow /></div>
  </>}

  {kind === 'split' && <>
    <div class="sf-motion-animated relative flex h-full items-center justify-center">
      <span class="sf-split-source absolute will-change-transform"><ToolMotionFileChip size="lg" tile="from-red-400 to-red-600" label="PDF" /></span>
      {[
        ['-80px', '-10deg'],
        ['0px', '0deg'],
        ['80px', '10deg'],
      ].map(([x,r], index) => <span class="sf-split-page absolute will-change-transform" style={`--motion-x:${x};--motion-r:${r}`}><ToolMotionFileChip size="sm" tile={tool.tile} label={`PAGE ${index + 1}`} icon={tool.icon} /></span>)}
    </div>
    <div class="sf-motion-static hidden h-full items-center justify-center gap-3">
      {['-8deg','0deg','8deg'].map((r,index) => <ToolMotionFileChip size="sm" tile={tool.tile} label={`PAGE ${index + 1}`} icon={tool.icon} style={`transform:rotate(${r})`} />)}
    </div>
  </>}

  {kind === 'compress' && <>
    <div class="sf-motion-animated flex h-full flex-col items-center justify-center gap-3">
      <div class="flex items-center gap-5">
        <span class="sf-compress-chevron sf-compress-chevron-right text-rose-400"><svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2"><path d="m7 7 5 5-5 5m5-10 5 5-5 5"/></svg></span>
        <span class="sf-compress-file will-change-transform"><ToolMotionFileChip size="lg" tile={tool.tile} label={outputLabel || inputLabel} icon={tool.icon} /></span>
        <span class="sf-compress-chevron sf-compress-chevron-left text-rose-400"><svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2"><path d="m17 7-5 5 5 5m-5-10-5 5 5 5"/></svg></span>
      </div>
      <span class="h-1.5 w-40 overflow-hidden rounded-full bg-slate-100 dark:bg-white/10"><span class="sf-compress-bar block h-full rounded-full bg-gradient-to-r from-rose-400 to-amber-400"></span></span>
    </div>
    <div class="sf-motion-static hidden h-full flex-col items-center justify-center gap-3">
      <ToolMotionFileChip size="lg" tile={tool.tile} label={outputLabel || inputLabel} icon={tool.icon} style="transform:scale(.86)" />
      <span class="h-1.5 w-40 overflow-hidden rounded-full bg-slate-100 dark:bg-white/10"><span class="block h-full w-[55%] rounded-full bg-gradient-to-r from-rose-400 to-amber-400"></span></span>
    </div>
  </>}

  {kind === 'rotate' && <>
    <div class="sf-motion-animated relative flex h-full items-center justify-center">
      <span class="sf-rotate-ring absolute h-32 w-32 rounded-full border border-dashed border-pink-300/70 dark:border-pink-400/30"></span>
      <span class="sf-rotate-file will-change-transform"><ToolMotionFileChip size="lg" tile={tool.tile} label="PDF" icon={tool.icon} /></span>
    </div>
    <div class="sf-motion-static relative hidden h-full items-center justify-center">
      <span class="absolute h-32 w-32 rounded-full border border-dashed border-pink-300/70 dark:border-pink-400/30"></span>
      <ToolMotionFileChip size="lg" tile={tool.tile} label="PDF" icon={tool.icon} style="transform:rotate(90deg)" />
    </div>
  </>}

  {kind === 'convert' && <>
    <div class="sf-motion-animated relative flex h-full items-center justify-center gap-8">
      <span class="sf-convert-input will-change-transform"><ToolMotionFileChip size="md" tile="from-red-400 to-red-600" label={inputLabel} /></span>
      <span class="sf-convert-zap flex h-8 w-8 items-center justify-center rounded-full bg-gradient-to-br from-violet-500 to-fuchsia-500 text-white shadow-lg shadow-violet-500/40"><svg viewBox="0 0 24 24" class="h-4 w-4 fill-white" fill="currentColor"><path d="m13 2-9 12h7l-1 8 9-12h-7z"/></svg></span>
      <span class="sf-convert-output will-change-transform"><ToolMotionFileChip size="md" tile={tool.tile} label={outputLabel} icon={tool.icon} glow /></span>
    </div>
    <div class="sf-motion-static hidden h-full items-center justify-center gap-7">
      <ToolMotionFileChip size="md" tile="from-red-400 to-red-600" label={inputLabel} />
      <svg viewBox="0 0 24 24" class="h-4 w-4 fill-violet-500 text-violet-500" fill="currentColor"><path d="m13 2-9 12h7l-1 8 9-12h-7z"/></svg>
      <ToolMotionFileChip size="md" tile={tool.tile} label={outputLabel} icon={tool.icon} glow />
    </div>
  </>}

  {kind === 'process' && <>
    <div class="sf-motion-animated relative flex h-full items-center justify-center">
      <span class="relative">
        <ToolMotionFileChip size="lg" tile="from-red-400 to-red-600" label={inputLabel === 'JPG · PNG · WebP' ? 'IMAGE' : 'PDF'} />
        <span class="pointer-events-none absolute inset-0 overflow-hidden rounded-xl"><span class="sf-process-shimmer absolute inset-y-0 w-10 bg-gradient-to-r from-transparent via-white/80 to-transparent dark:via-white/25"></span></span>
        <span class:list={['sf-process-badge absolute -right-3 -top-3 flex h-7 w-7 items-center justify-center rounded-full bg-gradient-to-br text-white shadow-lg [&_svg]:h-3.5 [&_svg]:w-3.5', tool.tile]}><ToolIcon icon={tool.icon} /></span>
      </span>
    </div>
    <div class="sf-motion-static hidden h-full items-center justify-center">
      <span class="relative"><ToolMotionFileChip size="lg" tile="from-red-400 to-red-600" label={inputLabel === 'JPG · PNG · WebP' ? 'IMAGE' : 'PDF'} /><span class:list={['absolute -right-3 -top-3 flex h-7 w-7 items-center justify-center rounded-full bg-gradient-to-br text-white shadow-lg [&_svg]:h-3.5 [&_svg]:w-3.5', tool.tile]}><ToolIcon icon={tool.icon} /></span></span>
    </div>
  </>}
</div>

<style>
  .sf-merge-ring { animation:sf-merge-ring 3.4s ease-out infinite; }
  .sf-merge-input { animation:sf-merge-input 3.4s ease-in-out infinite; }
  .sf-merge-result { animation:sf-merge-result 3.4s ease-in-out infinite; }
  .sf-split-source { animation:sf-split-source 3.4s ease-in-out infinite; }
  .sf-split-page { animation:sf-split-page 3.4s ease-in-out infinite; }
  .sf-compress-file { animation:sf-compress-file 3s ease-in-out infinite; }
  .sf-compress-bar { animation:sf-compress-bar 3s ease-in-out infinite; }
  .sf-compress-chevron { animation:sf-compress-chevron-right 3s ease-in-out infinite; }
  .sf-compress-chevron-left { animation-name:sf-compress-chevron-left; }
  .sf-rotate-ring { animation:sf-rotate-ring 9s linear infinite; }
  .sf-rotate-file { animation:sf-rotate-file 4.4s ease-in-out infinite; }
  .sf-convert-input { animation:sf-convert-input 3.4s ease-in-out infinite; }
  .sf-convert-zap { animation:sf-convert-zap 1.1s ease-in-out infinite; }
  .sf-convert-output { animation:sf-convert-output 3.4s ease-in-out infinite; }
  .sf-process-shimmer { animation:sf-process-shimmer 2.5s ease-in-out infinite; }
  .sf-process-badge { animation:sf-process-badge 3.4s ease-in-out infinite; }

  @keyframes sf-merge-ring { 0%,52%{transform:scale(.5);opacity:0}72%{transform:scale(1.9);opacity:.7}100%{transform:scale(1.9);opacity:0} }
  @keyframes sf-merge-input { 0%{transform:translate(var(--motion-x),var(--motion-y)) rotate(var(--motion-r));opacity:0}14%{transform:translate(var(--motion-x),var(--motion-y)) rotate(var(--motion-r));opacity:1}52%{transform:translate(0,0) rotate(0) scale(.82);opacity:1}60%{transform:translate(0,0) rotate(0) scale(.82);opacity:0}78%,100%{transform:translate(var(--motion-x),var(--motion-y)) rotate(var(--motion-r));opacity:0} }
  @keyframes sf-merge-result { 0%,52%{transform:scale(.4);opacity:0}62%{transform:scale(1.08);opacity:1}70%{transform:scale(1);opacity:1}90%{transform:scale(1);opacity:1}100%{transform:scale(.9);opacity:0} }
  @keyframes sf-split-source { 0%{transform:scale(.92);opacity:0}12%{transform:scale(1);opacity:1}40%{transform:scale(1);opacity:1}50%{transform:scale(.94);opacity:0}100%{transform:scale(.92);opacity:0} }
  @keyframes sf-split-page { 0%,42%{transform:translateX(0) rotate(0) scale(.6);opacity:0}58%{transform:translateX(var(--motion-x)) rotate(var(--motion-r)) scale(1);opacity:1}86%{transform:translateX(var(--motion-x)) rotate(var(--motion-r)) scale(1);opacity:1}98%,100%{transform:translateX(0) rotate(0) scale(.9);opacity:0} }
  @keyframes sf-compress-file { 0%,100%{transform:scale(1)}50%{transform:scale(.76)} }
  @keyframes sf-compress-bar { 0%,100%{width:100%}50%{width:48%} }
  @keyframes sf-compress-chevron-right { 0%,100%{transform:translateX(8px);opacity:.5}50%{transform:translateX(-3px);opacity:1} }
  @keyframes sf-compress-chevron-left { 0%,100%{transform:translateX(-8px);opacity:.5}50%{transform:translateX(3px);opacity:1} }
  @keyframes sf-rotate-ring { to{transform:rotate(360deg)} }
  @keyframes sf-rotate-file { 0%{transform:rotate(0)}25%{transform:rotate(90deg)}50%{transform:rotate(180deg)}75%{transform:rotate(270deg)}100%{transform:rotate(360deg)} }
  @keyframes sf-convert-input { 0%{transform:translateX(-6px) scale(.92);opacity:0}12%{transform:translateX(0) scale(1);opacity:1}42%{transform:translateX(0) scale(1);opacity:1}54%{transform:translateX(6px) scale(.9);opacity:0}100%{transform:translateX(-6px) scale(.92);opacity:0} }
  @keyframes sf-convert-zap { 0%,100%{transform:scale(1);opacity:.55}50%{transform:scale(1.35);opacity:1} }
  @keyframes sf-convert-output { 0%,54%{transform:scale(.9);opacity:0}66%{transform:scale(1);opacity:1}92%{transform:scale(1);opacity:1}100%{transform:scale(.94);opacity:0} }
  @keyframes sf-process-shimmer { 0%{transform:translateX(-48px)}60%{transform:translateX(100px)}100%{transform:translateX(100px)} }
  @keyframes sf-process-badge { 0%,50%{transform:scale(0);opacity:0}60%{transform:scale(1.2) rotate(-14deg);opacity:1}68%{transform:scale(1) rotate(0);opacity:1}90%{transform:scale(1);opacity:1}100%{transform:scale(0);opacity:0} }

  @media (prefers-reduced-motion: reduce) {
    .sf-tool-motion .sf-motion-animated { display:none; }
    .sf-tool-motion .sf-motion-static { display:flex; }
  }
</style>
