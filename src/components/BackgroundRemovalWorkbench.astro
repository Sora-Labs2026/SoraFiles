---
import type { LocalePath } from '../i18n/config';
import { getBackgroundRemovalMessages } from '../i18n/backgroundRemoval';
import { liveText } from '../data/liveI18n';

interface Props { locale?: LocalePath; }
const { locale = 'en' } = Astro.props;
const m = getBackgroundRemovalMessages(locale);
const common = {
  drop: liveText(locale, 'wb.dropOne'),
  click: liveText(locale, 'wb.orClick'),
  download: liveText(locale, 'wb.download'),
  newTask: liveText(locale, 'wb.newTask'),
  local: liveText(locale, 'panel.check4'),
  loading: liveText(locale, 'wb.processing'),
  failed: liveText(locale, 'wb.err.generic'),
};
---

<section data-workbench id="background-removal-workbench" class="mx-auto max-w-5xl px-5 sm:px-6">
  <div class="overflow-hidden rounded-card bg-surface shadow-card">
    <script type="application/json" data-background-messages is:inline set:html={JSON.stringify({ ...m, ...common }).replace(/</g, '\u003c')}></script>
    <div data-background-empty class="p-4 sm:p-6">
      <button type="button" data-background-drop aria-controls="background-file" class="flex w-full cursor-pointer flex-col items-center justify-center gap-3 rounded-2xl border-2 border-dashed border-line bg-canvas px-6 py-10 text-center transition-colors hover:border-violet-300 focus-visible:ring-2 focus-visible:ring-violet-500">
        <span class="grid h-14 w-14 place-items-center rounded-2xl bg-gradient-to-br from-violet-500 to-cyan-500 text-2xl text-white shadow-lg shadow-violet-500/20" aria-hidden="true">✦</span>
        <span class="text-sm font-semibold text-ink">{common.drop}</span>
        <span class="text-xs text-muted">{common.click} · JPG, PNG, WebP</span>
      </button>
      <input id="background-file" data-background-input type="file" accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp" class="sr-only" />
    </div>

    <div data-background-editor hidden class="p-4 sm:p-6">
      <div class="grid gap-4 sm:grid-cols-2">
        <figure class="overflow-hidden rounded-2xl border border-line bg-canvas">
          <figcaption class="border-b border-line px-4 py-2.5 text-xs font-semibold text-muted">{m.before}</figcaption>
          <div class="grid aspect-square place-items-center p-3"><img data-background-before alt={m.before} class="max-h-full max-w-full object-contain" /></div>
        </figure>
        <figure class="overflow-hidden rounded-2xl border border-line bg-canvas">
          <figcaption class="border-b border-line px-4 py-2.5 text-xs font-semibold text-muted">{m.after}</figcaption>
          <div class="sf-transparency-grid grid aspect-square place-items-center p-3"><span data-background-placeholder class="px-5 text-center text-xs leading-5 text-muted">{m.tagline}</span><img data-background-after hidden alt={m.after} class="max-h-full max-w-full object-contain" /></div>
        </figure>
      </div>
      <div class="mt-4 flex flex-wrap items-center gap-3">
        <button type="button" data-background-process class="inline-flex min-h-12 flex-1 items-center justify-center rounded-control bg-action px-6 text-sm font-semibold text-action-contrast hover:bg-action-hover disabled:cursor-wait disabled:opacity-50">{m.remove}</button>
        <button type="button" data-background-reset class="inline-flex min-h-12 items-center justify-center rounded-control border border-line bg-surface px-5 text-sm font-medium text-muted hover:border-line-strong hover:text-ink">{common.newTask}</button>
      </div>
      <div data-background-progress hidden role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="1" class="mt-4 rounded-control border border-violet-100 bg-violet-50/70 p-4 dark:border-violet-400/20 dark:bg-violet-500/10"><div class="flex items-center justify-between gap-4 text-xs font-semibold"><span data-background-status class="text-violet-800 dark:text-violet-200">{common.loading}</span><span data-background-percent class="text-violet-600 dark:text-violet-300">1%</span></div><div class="mt-2 h-2 overflow-hidden rounded-full bg-white/80 dark:bg-white/10"><div data-background-bar class="h-full w-[1%] rounded-full bg-gradient-to-r from-violet-500 to-cyan-500 transition-[width] duration-200"></div></div></div>
      <p data-background-error hidden role="alert" tabindex="-1" class="mt-4 rounded-control border border-rose-200 bg-rose-50 p-4 text-sm font-semibold text-rose-700 dark:border-rose-400/20 dark:bg-rose-500/10 dark:text-rose-200"></p>
      <div data-background-result hidden role="status" tabindex="-1" class="mt-4 rounded-control border border-emerald-200 bg-emerald-50 p-4 dark:border-emerald-400/20 dark:bg-emerald-500/10"><p class="text-sm font-semibold text-emerald-800 dark:text-emerald-200">{m.result}</p><a data-background-download class="mt-3 inline-flex min-h-11 items-center justify-center rounded-control bg-emerald-700 px-5 text-sm font-semibold text-white hover:bg-emerald-800">{common.download}</a></div>
      <p class="mt-4 flex items-center gap-2 text-xs font-medium text-emerald-700 dark:text-emerald-300"><span aria-hidden="true">✓</span>{common.local}</p>
    </div>
  </div>
</section>

<style>
  .sf-transparency-grid {
    background-color: #fff;
    background-image: linear-gradient(45deg, #e2e8f0 25%, transparent 25%), linear-gradient(-45deg, #e2e8f0 25%, transparent 25%), linear-gradient(45deg, transparent 75%, #e2e8f0 75%), linear-gradient(-45deg, transparent 75%, #e2e8f0 75%);
    background-position: 0 0, 0 8px, 8px -8px, -8px 0;
    background-size: 16px 16px;
  }
</style>

<script>
  import { safeOutputStem } from '../utils/filename';

  const root = document.querySelector<HTMLElement>('#background-removal-workbench');
  if (root) {
    const messages = JSON.parse(root.querySelector<HTMLElement>('[data-background-messages]')?.textContent || '{}') as Record<string, string>;
    const empty = root.querySelector<HTMLElement>('[data-background-empty]')!;
    const editor = root.querySelector<HTMLElement>('[data-background-editor]')!;
    const input = root.querySelector<HTMLInputElement>('[data-background-input]')!;
    const drop = root.querySelector<HTMLButtonElement>('[data-background-drop]')!;
    const before = root.querySelector<HTMLImageElement>('[data-background-before]')!;
    const after = root.querySelector<HTMLImageElement>('[data-background-after]')!;
    const placeholder = root.querySelector<HTMLElement>('[data-background-placeholder]')!;
    const process = root.querySelector<HTMLButtonElement>('[data-background-process]')!;
    const progress = root.querySelector<HTMLElement>('[data-background-progress]')!;
    const status = root.querySelector<HTMLElement>('[data-background-status]')!;
    const percent = root.querySelector<HTMLElement>('[data-background-percent]')!;
    const bar = root.querySelector<HTMLElement>('[data-background-bar]')!;
    const error = root.querySelector<HTMLElement>('[data-background-error]')!;
    const result = root.querySelector<HTMLElement>('[data-background-result]')!;
    const download = root.querySelector<HTMLAnchorElement>('[data-background-download]')!;
    let file: File | null = null;
    let sourceUrl = '';
    let resultUrl = '';
    let processing = false;
    let enginePromise: Promise<typeof import('@imgly/background-removal')> | null = null;
    const loadEngine = () => enginePromise ??= import('@imgly/background-removal');

    const revoke = () => { if (sourceUrl) URL.revokeObjectURL(sourceUrl); if (resultUrl) URL.revokeObjectURL(resultUrl); sourceUrl = ''; resultUrl = ''; };
    const setProgress = (value: number, label: string) => { const safe = Math.max(1, Math.min(100, Math.round(value))); progress.hidden = false; progress.setAttribute('aria-valuenow', String(safe)); percent.textContent = `${safe}%`; bar.style.width = `${safe}%`; status.textContent = label; };
    const reset = () => { if (processing) return; revoke(); file = null; input.value = ''; before.removeAttribute('src'); after.removeAttribute('src'); after.hidden = true; placeholder.hidden = false; empty.hidden = false; editor.hidden = true; progress.hidden = true; result.hidden = true; error.hidden = true; root.removeAttribute('aria-busy'); };

    const selectFile = async (candidate?: File) => {
      if (!candidate) return;
      error.hidden = true;
      if (candidate.size <= 0 || candidate.size > 50_000_000 || !/^image\/(?:jpeg|png|webp)$/i.test(candidate.type)) { error.textContent = candidate.size > 50_000_000 ? messages.tooLarge : messages.invalid; error.hidden = false; error.focus(); return; }
      try {
        const bitmap = await createImageBitmap(candidate, { imageOrientation: 'from-image' });
        const pixels = bitmap.width * bitmap.height;
        bitmap.close();
        if (!pixels || pixels > 40_000_000) throw new Error(messages.tooLarge);
      } catch (reason) { error.textContent = reason instanceof Error && reason.message === messages.tooLarge ? messages.tooLarge : messages.invalid; error.hidden = false; error.focus(); return; }
      revoke();
      file = candidate;
      sourceUrl = URL.createObjectURL(candidate);
      before.src = sourceUrl;
      empty.hidden = true;
      editor.hidden = false;
      result.hidden = true;
      progress.hidden = true;
      after.hidden = true;
      placeholder.hidden = false;
      void loadEngine();
      process.focus();
    };

    drop.addEventListener('click', () => input.click());
    input.addEventListener('change', () => void selectFile(input.files?.[0]));
    root.querySelector('[data-background-reset]')?.addEventListener('click', reset);
    process.addEventListener('click', async () => {
      if (!file || processing) return;
      processing = true;
      process.disabled = true;
      error.hidden = true;
      result.hidden = true;
      root.setAttribute('aria-busy', 'true');
      setProgress(1, messages.loading);
      try {
        const module = await loadEngine();
        const blob = await module.removeBackground(file, {
          model: 'isnet_quint8',
          device: 'cpu',
          rescale: true,
          output: { format: 'image/png', quality: 1 },
          progress: (key: string, current: number, total: number) => {
            if (key.startsWith('compute:')) setProgress(65 + (current / Math.max(1, total)) * 34, messages.processing);
            else setProgress(2 + (current / Math.max(1, total)) * 60, messages.loading);
          },
        });
        if (resultUrl) URL.revokeObjectURL(resultUrl);
        resultUrl = URL.createObjectURL(blob);
        after.src = resultUrl;
        after.hidden = false;
        placeholder.hidden = true;
        download.href = resultUrl;
        download.download = `${safeOutputStem(file.name, 'image')}-transparent.png`;
        setProgress(100, messages.processing);
        progress.hidden = true;
        result.hidden = false;
        result.focus();
      } catch (reason) {
        console.error('SoraFiles background removal failed.', reason);
        error.textContent = messages.failed;
        error.hidden = false;
        error.focus();
        progress.hidden = true;
      } finally {
        processing = false;
        process.disabled = false;
        root.removeAttribute('aria-busy');
      }
    });
    addEventListener('beforeunload', revoke);
  }
</script>
