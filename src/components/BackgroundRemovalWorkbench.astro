---
import type { LocalePath } from '../i18n/config';
import { getBackgroundRemovalMessages } from '../i18n/backgroundRemoval';
import { liveText } from '../data/liveI18n';
import AdaptiveWorkspace from './AdaptiveWorkspace.astro';

interface Props { locale?: LocalePath; }
const { locale = 'en' } = Astro.props;
const m = getBackgroundRemovalMessages(locale);
const common = {
  drop: liveText(locale, 'wb.dropOne'),
  click: liveText(locale, 'wb.orClick'),
  download: liveText(locale, 'wb.download'),
  newTask: liveText(locale, 'wb.newTask'),
  local: liveText(locale, 'panel.check4'),
  loading: m.loading,
  failed: liveText(locale, 'wb.err.generic'),
};
---

<section data-workbench id="background-removal-workbench" class="mx-auto max-w-5xl px-5 sm:px-6">
  <div class="overflow-hidden rounded-card bg-surface shadow-card">
    <script type="application/json" data-background-messages is:inline set:html={JSON.stringify({ ...m, ...common }).replace(/</g, '\u003c')}></script>
    <div data-background-empty class="p-4 sm:p-6">
      <button type="button" data-background-drop aria-controls="background-file" class="sf-upload-dropzone flex w-full cursor-pointer flex-col items-center justify-center gap-3 px-6 py-10 text-center">
        <span class="sf-upload-dropzone__icon grid h-14 w-14 place-items-center rounded-2xl bg-gradient-to-br from-violet-500 to-cyan-500 text-2xl text-white shadow-lg shadow-violet-500/20" aria-hidden="true">✦</span>
        <span class="text-sm font-semibold text-ink">{common.drop}</span>
        <span class="text-xs text-muted">{common.click} · JPG, PNG, WebP</span>
      </button>
      <input id="background-file" data-background-input aria-label={common.drop} type="file" accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp" class="sr-only" />
    </div>

    <AdaptiveWorkspace id="background-removal-editor" mode="canvas" canvasControls={false} title={m.name} resetTarget="[data-background-reset]" class="background-canvas-workspace">
    <div data-background-editor data-workspace-canvas class="p-4 sm:p-6">
      <div class="mb-3 grid grid-cols-2 gap-1 rounded-control bg-canvas p-1 sm:hidden" aria-label={m.name}>
        <button data-background-view="before" type="button" aria-pressed="true" class="min-h-11 rounded-control px-3 text-xs font-semibold text-muted aria-pressed:bg-surface aria-pressed:text-ink">{m.before}</button>
        <button data-background-view="after" type="button" aria-pressed="false" disabled class="min-h-11 rounded-control px-3 text-xs font-semibold text-muted aria-pressed:bg-surface aria-pressed:text-ink disabled:opacity-50">{m.after}</button>
      </div>
      <div data-background-comparison class="grid gap-4 sm:grid-cols-2">
        <figure class="overflow-hidden rounded-2xl border border-line bg-canvas">
          <figcaption class="border-b border-line px-4 py-2.5 text-xs font-semibold text-muted">{m.before}</figcaption>
          <div class="grid aspect-square place-items-center p-3"><img data-background-before alt={m.before} class="max-h-full max-w-full object-contain" /></div>
        </figure>
        <figure class="overflow-hidden rounded-2xl border border-line bg-canvas">
          <figcaption class="border-b border-line px-4 py-2.5 text-xs font-semibold text-muted">{m.after}</figcaption>
          <div class="sf-transparency-grid grid aspect-square place-items-center p-3"><span data-background-placeholder class="px-5 text-center text-xs leading-5 text-muted">{m.tagline}</span><img data-background-after hidden alt={m.after} class="max-h-full max-w-full object-contain" /></div>
        </figure>
      </div>
      <label class="mt-4 flex items-start gap-3 rounded-control border border-line p-3 text-sm text-ink">
        <input data-background-cleanup type="checkbox" class="mt-1 h-4 w-4 shrink-0 accent-violet-600" />
        <span><span class="font-semibold">{m.cleanup}</span><span class="mt-1 block text-xs leading-5 text-muted">{m.cleanupHint}</span></span>
      </label>
      <div data-background-actionbar class="mt-4 flex flex-wrap items-center gap-3">
        <button type="button" data-background-process class="inline-flex min-h-12 flex-1 items-center justify-center rounded-control bg-action px-6 text-sm font-semibold text-action-contrast hover:bg-action-hover disabled:cursor-wait disabled:opacity-50">{m.remove}</button>
        <button type="button" data-background-cancel hidden class="min-h-12 rounded-control border border-line bg-surface px-5 text-sm font-semibold text-ink">{liveText(locale, 'wb.cancel')}</button><button type="button" data-background-reset class="inline-flex min-h-12 items-center justify-center rounded-control border border-line bg-surface px-5 text-sm font-medium text-muted hover:border-line-strong hover:text-ink">{common.newTask}</button>
      </div>
      <div data-background-progress hidden role="status" aria-live="polite" class="mt-4 rounded-control border border-line bg-canvas p-4"><span data-background-status class="text-sm font-semibold text-muted">{common.loading}</span></div>
      <p data-background-error hidden role="alert" tabindex="-1" class="mt-4 rounded-control border border-rose-200 bg-rose-50 p-4 text-sm font-semibold text-rose-700 dark:border-rose-400/20 dark:bg-rose-500/10 dark:text-rose-200"></p>
      <div data-background-result hidden role="status" tabindex="-1" class="mt-4 rounded-control border border-emerald-200 bg-emerald-50 p-4 dark:border-emerald-400/20 dark:bg-emerald-500/10"><p class="text-sm font-semibold text-emerald-800 dark:text-emerald-200">{m.result}</p><a data-background-download class="mt-3 inline-flex min-h-11 items-center justify-center rounded-control bg-emerald-700 px-5 text-sm font-semibold text-white hover:bg-emerald-800">{common.download}</a></div>
      <p class="mt-4 flex items-center gap-2 text-xs font-medium text-emerald-700 dark:text-emerald-300"><span aria-hidden="true">✓</span>{common.local}</p>
    </div>
    </AdaptiveWorkspace>
  </div>
</section>

<style is:global>
  .sf-transparency-grid {
    background-color: #fff;
    background-image: linear-gradient(45deg, #e2e8f0 25%, transparent 25%), linear-gradient(-45deg, #e2e8f0 25%, transparent 25%), linear-gradient(45deg, transparent 75%, #e2e8f0 75%), linear-gradient(-45deg, transparent 75%, #e2e8f0 75%);
    background-position: 0 0, 0 8px, 8px -8px, -8px 0;
    background-size: 16px 16px;
  }
  .background-canvas-workspace [data-workspace-body] { overflow-y: auto; overscroll-behavior: contain; background: var(--color-canvas); }
  .background-canvas-workspace [data-background-editor] { width: min(100%,84rem); margin: auto; }
  .background-canvas-workspace [data-background-comparison] { min-height: min(62vh,46rem); align-items: stretch; }
  @media (max-width: 767px) {
    .background-canvas-workspace [data-workspace-body] { overflow: hidden; }
    .background-canvas-workspace [data-background-editor] { height: 100%; overflow-y: auto; overscroll-behavior: contain; padding: .7rem .65rem max(1rem,env(safe-area-inset-bottom)); }
    .background-canvas-workspace [data-background-comparison] { display: block; min-height: 0; }
    .background-canvas-workspace [data-background-comparison]::-webkit-scrollbar { display: none; }
    .background-canvas-workspace [data-background-comparison] > figure { width: 100%; }
    .background-canvas-workspace [data-background-comparison] > figure > div { height: min(32dvh,20rem); aspect-ratio: auto; }
    [data-background-preview='before'] [data-background-comparison] > figure:last-child, [data-background-preview='after'] [data-background-comparison] > figure:first-child { display: none; }
    .background-canvas-workspace [data-background-actionbar] { position: static; }
    .background-canvas-workspace [data-background-process] { flex-basis: 100%; }
    .background-canvas-workspace [data-background-reset] { width: 100%; }
  }
</style>

<script>
  import { initializeBackgroundWorkbench } from '../lib/background-workbench';
  const root = document.querySelector<HTMLElement>('#background-removal-workbench');
  if (root) initializeBackgroundWorkbench(root);
</script>
