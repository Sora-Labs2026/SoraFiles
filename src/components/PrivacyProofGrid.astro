---
import type { HomePrivacyProof } from '../i18n/types';
import TrustIcon from './TrustIcon.astro';

interface Props {
  proof: HomePrivacyProof;
}

const { proof } = Astro.props;
---

<section data-privacy-proof aria-labelledby="privacy-proof-heading" class="border-b border-line bg-surface px-5 py-16 sm:px-6 sm:py-20">
  <div class="mx-auto max-w-6xl">
    <div class="max-w-3xl" data-reveal style="--reveal-delay: 0">
      <p class="eyebrow text-xs font-semibold tracking-wider text-blue">{proof.eyebrow}</p>
      <h2 id="privacy-proof-heading" class="mt-3 text-balance text-[clamp(1.75rem,4vw,2.75rem)] font-semibold tracking-[-0.04em] text-ink">
        {proof.title}
      </h2>
      <p class="mt-4 text-base leading-7 text-muted">
        {proof.intro}
      </p>
    </div>

    <dl class="module-grid mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {proof.items.map((item, index) => (
        <div
          data-privacy-proof-card
          data-reveal
          style={`--reveal-delay: ${index + 1}`}
          class="module-surface group flex flex-col justify-between border border-line bg-canvas p-6 transition-[border-color,box-shadow] duration-200 hover:border-line-strong hover:shadow-small"
        >
          <div class="flex items-center justify-between gap-3">
            <span class="icon-pop flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-surface border border-line">
              <TrustIcon icon={item.icon} />
            </span>
            <span class="rounded-full bg-surface border border-line px-2.5 py-1 font-mono text-xs font-semibold text-ink">
              {item.value}
            </span>
          </div>

          <div class="mt-6">
            <dt class="text-sm font-semibold tracking-tight text-ink">{item.title}</dt>
            <dd class="mt-2 text-xs leading-5 text-muted">{item.description}</dd>
          </div>
        </div>
      ))}
    </dl>
  </div>
</section>
