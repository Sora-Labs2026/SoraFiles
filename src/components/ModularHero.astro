---
interface Props {
  eyebrow?: string;
  title: string;
  intro: string;
  compact?: boolean;
  liveShell?: boolean;
}

const { eyebrow, title, intro, compact = false, liveShell = false } = Astro.props;
const showRightColumn = Astro.slots.has('proof') || !compact;
---

<section data-live-shell-hero={liveShell ? true : undefined} class:list={['sf-hero relative overflow-hidden border-b border-white/70 px-4 sm:px-6', compact ? 'py-10 sm:py-14' : 'pb-14 pt-12 sm:pb-16 sm:pt-16 lg:pb-20 lg:pt-20']}>
  <div class="relative mx-auto grid max-w-[1200px] grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-6">
    <div class="min-w-0 lg:col-span-5" data-reveal style="--reveal-delay: 0">
      {eyebrow && (
        <p class="inline-flex min-h-8 items-center gap-2 rounded-full border border-green/20 bg-surface/75 px-3.5 text-xs font-semibold text-muted shadow-small backdrop-blur-xl">
          <svg aria-hidden="true" viewBox="0 0 20 20" class="h-4 w-4 text-green" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M10 2.5 16 5v4.5c0 3.7-2.5 6.2-6 8-3.5-1.8-6-4.3-6-8V5z"/><path d="m7 10 2 2 4-4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>{eyebrow}</span>
        </p>
      )}
      <h1 class:list={['mt-6 max-w-xl text-balance font-extrabold leading-[1.06] text-ink', compact ? 'text-[clamp(2rem,5vw,3.5rem)]' : 'text-[clamp(2.4rem,4vw,3rem)]']}>
        <span class="sf-gradient-text">{title}</span>
      </h1>
      <p class="mt-5 max-w-lg text-pretty text-[15px] font-medium leading-7 text-muted sm:text-base">
        {intro}
      </p>
      {Astro.slots.has('actions') && (
        <div class="mt-7 max-w-lg">
          <slot name="actions" />
        </div>
      )}
    </div>

    {showRightColumn && (
      <div class="min-w-0 lg:col-span-7" data-reveal style="--reveal-delay: 1">
        <slot name="proof" />
      </div>
    )}
  </div>
</section>