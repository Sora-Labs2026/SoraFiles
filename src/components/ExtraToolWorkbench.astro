        for (const result of output) { const url = URL.createObjectURL(result.blob); objectUrls.push(url); const item = document.createElement('li'); item.className = 'flex items-start gap-3 rounded-xl bg-white/90 p-2.5 shadow-sm dark:bg-white/5'; const text = document.createElement('span'); text.className = 'min-w-0 flex-1'; const name = document.createElement('span'); name.className = 'block truncate text-xs font-bold text-slate-800 dark:text-slate-100'; name.textContent = result.name; const size = document.createElement('span'); size.className = 'block text-[10px] font-semibold text-slate-500 dark:text-slate-400'; size.textContent = formatBytes(result.blob.size); text.append(name, size); if (result.detail) { const detail = document.createElement('span'); detail.className = 'mt-1 block text-[10px] font-medium leading-4 text-slate-600 dark:text-slate-300'; detail.textContent = result.detail; text.append(detail); } const link = document.createElement('a'); link.href = url; link.download = result.name; link.className = 'inline-flex min-h-9 shrink-0 items-center rounded-full bg-slate-900 px-4 text-xs font-bold text-white dark:bg-white dark:text-slate-900'; link.textContent = messages.download; item.append(text, link); resultList.append(item); }
        progress.hidden = true; resultsBox.hidden = false; resultsBox.focus();
      } catch (error) { if (token !== generation) return; progress.hidden = true; const code = error instanceof Error ? error.message : 'generic'; showError(code === 'cancelled' ? messages.cancelled : messages[code] || messages.generic); }
      finally { if (token === generation) { root.removeAttribute('aria-busy'); start.hidden = false; cancel.hidden = true; control = null; } }
    };
    let appendSelection = false;
    const passwordInput = root.querySelector<HTMLInputElement>('[data-extra-password]');
    const passwordStrength = root.querySelector<HTMLElement>('[data-password-strength]');
    passwordInput?.addEventListener('input', () => { if (!passwordStrength || toolId !== 'protect-pdf') return; const value = passwordInput.value; const variety = [/[a-z]/, /[A-Z]/, /\d/, /[^\w\s]/].filter((pattern) => pattern.test(value)).length; const score = Math.min(4, (value.length >= 8 ? 1 : 0) + (value.length >= 12 ? 1 : 0) + (value.length >= 16 ? 1 : 0) + (variety >= 3 ? 1 : 0)); passwordStrength.textContent = score <= 1 ? 'Weak — use at least 12 characters.' : score === 2 ? 'Fair — add length or character variety.' : score === 3 ? 'Strong password.' : 'Very strong password.'; passwordStrength.className = `mt-1.5 block text-[10px] font-bold ${score >= 3 ? 'text-emerald-600 dark:text-emerald-300' : score === 2 ? 'text-amber-600 dark:text-amber-300' : 'text-rose-600 dark:text-rose-300'}`; });
    if (toolId === 'edit-image') {
      root.querySelectorAll<HTMLInputElement>('[data-edit-control]').forEach(input => { input.addEventListener('input', () => { const key = input.dataset.editControl as EditNumericKey; const value = Number(input.value); if (editState[key] === value) return; rememberEdit(); setEditControl(key, value); if (manualAdjustmentKeys.includes(key as ManualAdjustmentKey)) setActivePreset(null); if (editStatus) editStatus.textContent = `✓ ${messages.adjustments[key] || messages.edit[key] || messages.edit.edit}`; queueEditPreview(); }); input.addEventListener('dblclick',()=>{const key=input.dataset.editControl as EditNumericKey;const resetValue=key==='zoom'?100:0;if(editState[key]===resetValue)return;rememberEdit();setEditControl(key,resetValue);if(manualAdjustmentKeys.includes(key as ManualAdjustmentKey))setActivePreset(null);queueEditPreview();}); });
      root.querySelectorAll<HTMLInputElement>('[data-edit-ratio]').forEach(input => input.addEventListener('change', () => { if (input.checked && editState.ratio !== input.value) { rememberEdit(); editState.ratio = input.value; setEditControl('x', 0); setEditControl('y', 0); if (editStatus) editStatus.textContent = `✓ ${messages.edit.crop}: ${input.parentElement?.textContent?.trim() || ''}`; queueEditPreview(); } }));
      root.querySelectorAll<HTMLButtonElement>('[data-edit-preset]').forEach((button) => button.addEventListener('click', () => { const name = button.dataset.editPreset || ''; const preset = editPresets[name]; if (!preset) return; rememberEdit(); manualAdjustmentKeys.forEach((key)=>setEditControl(key,preset[key])); setActivePreset(name); if (editStatus) editStatus.textContent = `✓ ${button.textContent?.trim() || messages.edit.enhanced}`; queueEditPreview(); }));
      let drag: { id: number; x: number; y: number; stateX: number; stateY: number } | null = null;
      editPreview?.addEventListener('pointerdown', (event) => { if (!editBitmap) return; rememberEdit(); drag = { id: event.pointerId, x: event.clientX, y: event.clientY, stateX: editState.x, stateY: editState.y }; editPreview.setPointerCapture(event.pointerId); });
      editPreview?.addEventListener('pointermove', (event) => { if (!drag || drag.id !== event.pointerId) return; const width = Math.max(1, editPreview.clientWidth); const height = Math.max(1, editPreview.clientHeight); setEditControl('x', Math.round(Math.max(-100, Math.min(100, drag.stateX - (event.clientX - drag.x) / width * 200)))); setEditControl('y', Math.round(Math.max(-100, Math.min(100, drag.stateY - (event.clientY - drag.y) / height * 200)))); if (editStatus) editStatus.textContent = `✓ ${messages.edit.crop}`; queueEditPreview(); });
      const endDrag = (event: PointerEvent) => { if (!drag || drag.id !== event.pointerId) return; if (editPreview?.hasPointerCapture(event.pointerId)) editPreview.releasePointerCapture(event.pointerId); drag = null; };
      editPreview?.addEventListener('pointerup', endDrag); editPreview?.addEventListener('pointercancel', endDrag);
      editPreview?.addEventListener('keydown', (event) => { const amount = event.shiftKey ? 10 : 3; if (!['ArrowLeft','ArrowRight','ArrowUp','ArrowDown'].includes(event.key)) return; event.preventDefault(); if (event.key === 'ArrowLeft') setEditControl('x', Math.max(-100, editState.x - amount)); if (event.key === 'ArrowRight') setEditControl('x', Math.min(100, editState.x + amount)); if (event.key === 'ArrowUp') setEditControl('y', Math.max(-100, editState.y - amount)); if (event.key === 'ArrowDown') setEditControl('y', Math.min(100, editState.y + amount)); if (editStatus) editStatus.textContent = `✓ ${messages.edit.crop}`; queueEditPreview(); });
      root.querySelector('[data-edit-rotate-left]')?.addEventListener('click', () => { rememberEdit(); editState.rotation = (editState.rotation + 270) % 360; if (editStatus) editStatus.textContent = `✓ ${messages.edit.rotate}`; queueEditPreview(); }); root.querySelector('[data-edit-rotate-right]')?.addEventListener('click', () => { rememberEdit(); editState.rotation = (editState.rotation + 90) % 360; if (editStatus) editStatus.textContent = `✓ ${messages.edit.rotate}`; queueEditPreview(); }); root.querySelector('[data-edit-flip]')?.addEventListener('click', () => { rememberEdit(); editState.flip = !editState.flip; if (editStatus) editStatus.textContent = `✓ ${messages.edit.stretch}`; queueEditPreview(); }); root.querySelector('[data-edit-reset]')?.addEventListener('click', () => { rememberEdit(); resetEditState(false); if (editStatus) editStatus.textContent = `✓ ${messages.edit.reset}`; queueEditPreview(); });
      root.querySelector<HTMLElement>('[data-adaptive-workspace]')?.addEventListener('workspace-command', (event) => {
        const command = (event as CustomEvent<{ command?: string }>).detail?.command;
        if (command === 'undo') { const previous = editUndo.pop(); if (!previous) return; editRedo.push({ ...editState }); restoreEdit(previous); }
        if (command === 'redo') { const next = editRedo.pop(); if (!next) return; editUndo.push({ ...editState }); restoreEdit(next); }
      });
    }
    input.addEventListener('change', () => void load([...input.files || []], appendSelection));
    root.querySelector('[data-extra-add]')?.addEventListener('click', () => { appendSelection = true; input.click(); });
    drop.addEventListener('click', () => { appendSelection = files.length > 0; input.click(); });
    for (const eventName of ['dragenter','dragover']) drop.addEventListener(eventName, (event) => { event.preventDefault(); drop.dataset.dragActive = 'true'; drop.classList.add('border-violet-400','bg-violet-50/70'); });
    for (const eventName of ['dragleave','drop']) drop.addEventListener(eventName, (event) => { event.preventDefault(); delete drop.dataset.dragActive; drop.classList.remove('border-violet-400','bg-violet-50/70'); });
    drop.addEventListener('drop', (event) => void load([...event.dataTransfer?.files || []], files.length > 0));
    root.querySelector('[data-extra-clear]')?.addEventListener('click', reset); root.querySelector('[data-extra-new]')?.addEventListener('click', reset); start.addEventListener('click', () => void run()); cancel.addEventListener('click', () => { if (control) { control.cancelled = true; control.abortController.abort(); } });
    addEventListener('beforeunload', () => { cleanUrls(); editBitmap?.close(); });
  }
</script>
