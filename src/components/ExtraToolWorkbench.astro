---
import type { LiveTool } from '../data/liveTools';
import type { LocalePath } from '../i18n/config';
import { liveText } from '../data/liveI18n';
import ToolIcon from './ToolIcon.astro';
import { OCR_LANGUAGE_BY_LOCALE, OCR_LANGUAGE_OPTIONS } from '../lib/ocr/languages';
import { chapter3English, chapter3Text } from '../data/chapter3Ui';
import { getConversionFidelityMessages } from '../i18n/documentTools';
import { getSpreadsheetToolMessages } from '../i18n/spreadsheetTools';
interface Props { tool: LiveTool; locale?: LocalePath; }
const { tool, locale = 'en' } = Astro.props;
const t = (path: string) => liveText(locale, path);
const defaultOcrCode = OCR_LANGUAGE_BY_LOCALE[locale] ?? 'eng';
const c3 = (key: keyof typeof chapter3English) => chapter3Text(locale, key);
const spreadsheetMsg = getSpreadsheetToolMessages(locale);
const officeMsg = getConversionFidelityMessages(locale);
const clientMessages = JSON.stringify({
  wrongType: t('wb.err.wrongType'),
  generic: t('wb.err.generic'),
  processing: t('wb.processing'),
  download: t('wb.download'),
  cancelled: t('wb.cancel'),
  noPassword: t('wb.err.noPassword'),
  wrongPassword: t('wb.err.wrongPassword'),
  needPassword: t('wb.err.needPassword'),
  alreadyEncrypted: t('wb.err.alreadyEncrypted'),
  badExcel: t('wb.err.badExcel'),
  noText: t('wb.err.noText'),
  ocrFailed: t('wb.err.ocrFailed'),
  officeIsolation: officeMsg.officeIsolation,
  officeFailed: officeMsg.officeFailed,
  spreadsheet: spreadsheetMsg,
  edit: Object.fromEntries(Object.keys(chapter3English).map((key) => [key, c3(key as keyof typeof chapter3English)])),
}).replace(/</g, '\\u003c');
---

<div data-extra-workbench data-testid={`workbench-${tool.slug}`} data-tool={tool.id} data-accept={tool.accept} data-multiple={String(tool.multiple)} class="glass rounded-[1.75rem] p-4 shadow-2xl shadow-indigo-500/10 sm:p-6">
  <script type="application/json" data-extra-messages is:inline set:html={clientMessages}></script>
  <button type="button" data-extra-drop aria-controls="extra-file-input" aria-describedby="extra-drop-help" class="flex w-full cursor-pointer flex-col items-center justify-center gap-3 rounded-2xl border-2 border-dashed border-slate-300/80 bg-white/50 px-6 py-10 text-center transition-colors hover:border-violet-300 dark:border-white/15 dark:bg-white/[.03]">
    <span class:list={['flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br text-white shadow-lg', tool.tile]}><ToolIcon icon={tool.icon}/></span>
    <span class="text-sm font-extrabold tracking-tight text-slate-800 dark:text-slate-100">{tool.multiple ? t('wb.dropMany') : t('wb.dropOne')}</span>
    <span id="extra-drop-help" class="text-xs font-medium text-slate-500 dark:text-slate-400">{t('wb.orClick')}</span>
  </button>
  <input id="extra-file-input" data-extra-input type="file" tabindex="-1" class="sr-only" accept={tool.accept} multiple={tool.multiple} aria-label={tool.multiple ? t('wb.dropMany') : t('wb.dropOne')} aria-describedby="extra-drop-help extra-error" />

  <div data-extra-selected hidden class="mt-4">
    <div class="mb-2 flex flex-wrap items-center justify-between gap-2"><span class="text-xs font-extrabold uppercase tracking-wider text-slate-500 dark:text-slate-400">{t('wb.files')}</span><span class="flex items-center gap-1">{tool.multiple && <button type="button" data-extra-add class="min-h-10 rounded-lg border border-slate-200 bg-white px-3 text-xs font-bold text-violet-600 dark:border-white/10 dark:bg-white/5 dark:text-violet-300">+ {t('wb.files')}</button>}<button type="button" data-extra-clear class="min-h-10 rounded-lg px-2 text-xs font-bold text-slate-500 transition-colors hover:text-rose-600 dark:text-slate-400 dark:hover:text-rose-300">{t('wb.clearAll')}</button></span></div>
    <ul data-extra-list class="space-y-2"></ul>
  </div>

  {(tool.id === 'protect-pdf' || tool.id === 'unlock-pdf') && <label class="mt-4 block rounded-2xl border border-slate-100 bg-white/60 p-4 dark:border-white/10 dark:bg-white/[.03]"><span class="mb-1.5 block text-xs font-bold text-slate-600 dark:text-slate-300">{tool.id === 'protect-pdf' ? t('opt.password') : t('opt.passwordUnlock')}</span><input data-extra-password type="password" autocomplete="new-password" placeholder={tool.id === 'protect-pdf' ? t('opt.password') : t('opt.passwordUnlock')} class="h-10 w-full rounded-xl border border-slate-200 bg-white/90 px-3 text-sm font-semibold text-slate-700 outline-none focus:border-violet-300 dark:border-white/10 dark:bg-white/5 dark:text-slate-200"/><span class="mt-1 block text-[10px] font-medium text-slate-500 dark:text-slate-400">{tool.id === 'protect-pdf' ? t('opt.passwordHint') : t('opt.passwordUnlockHint')}</span></label>}
  {tool.id === 'pdf-ocr' && <label class="mt-4 block rounded-2xl border border-slate-100 bg-white/60 p-4 dark:border-white/10 dark:bg-white/[.03]"><span class="mb-1.5 block text-xs font-bold text-slate-600 dark:text-slate-300">{t('opt.ocrLang')}</span><select data-extra-lang class="h-10 w-full rounded-xl border border-slate-200 bg-white/90 px-3 text-sm font-semibold text-slate-700 dark:border-white/10 dark:bg-white/5 dark:text-slate-200">{OCR_LANGUAGE_OPTIONS.map((option) => <option value={option.code} selected={option.code === defaultOcrCode} dir={option.direction}>{option.nativeName}</option>)}</select></label>}
  {tool.id === 'pdf-to-excel' && <fieldset class="mt-4 rounded-2xl border border-slate-100 bg-white/60 p-4 dark:border-white/10 dark:bg-white/[.03]"><legend class="px-1 text-xs font-extrabold uppercase tracking-wider text-slate-500 dark:text-slate-400">{spreadsheetMsg.resultMode}</legend><div class="mt-2 grid gap-3 sm:grid-cols-2"><label class="flex min-h-14 cursor-pointer items-center rounded-2xl border border-emerald-200 bg-emerald-50/70 p-4 has-[:checked]:ring-2 has-[:checked]:ring-emerald-500 dark:border-emerald-400/20 dark:bg-emerald-500/10"><span class="flex items-center gap-2 text-sm font-extrabold text-emerald-800 dark:text-emerald-200"><input data-spreadsheet-mode type="radio" name="spreadsheetMode" value="exact" checked class="h-4 w-4 accent-emerald-600"/>{spreadsheetMsg.exactAppearance}</span></label><label class="flex min-h-14 cursor-pointer items-center rounded-2xl border border-slate-200 bg-white/70 p-4 has-[:checked]:ring-2 has-[:checked]:ring-violet-500 dark:border-white/10 dark:bg-white/5"><span class="flex items-center gap-2 text-sm font-extrabold text-slate-800 dark:text-slate-100"><input data-spreadsheet-mode type="radio" name="spreadsheetMode" value="editable" class="h-4 w-4 accent-violet-600"/>{spreadsheetMsg.editableCells}</span></label></div></fieldset>}
  {tool.id === 'edit-image' && <section data-edit-editor hidden aria-labelledby="edit-image-heading" class="mt-4 overflow-hidden rounded-2xl border border-slate-200 bg-white/70 dark:border-white/10 dark:bg-white/[.03]">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 p-4 dark:border-white/10"><h2 id="edit-image-heading" class="text-sm font-extrabold text-slate-900 dark:text-white">{c3('edit')}</h2><div class="flex gap-2"><button type="button" data-edit-rotate-left aria-label={`${c3('rotate')} −90°`} class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-full border border-slate-200 bg-white text-lg hover:border-violet-300 focus-visible:ring-2 focus-visible:ring-violet-500 dark:border-white/10 dark:bg-white/5">↶</button><button type="button" data-edit-rotate-right aria-label={`${c3('rotate')} +90°`} class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-full border border-slate-200 bg-white text-lg hover:border-violet-300 focus-visible:ring-2 focus-visible:ring-violet-500 dark:border-white/10 dark:bg-white/5">↷</button><button type="button" data-edit-flip aria-label={c3('stretch')} class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-full border border-slate-200 bg-white text-base hover:border-violet-300 focus-visible:ring-2 focus-visible:ring-violet-500 dark:border-white/10 dark:bg-white/5">↔</button></div></div>
    <figure class="bg-slate-950 p-3 sm:p-5"><canvas data-edit-preview width="960" height="640" tabindex="0" role="img" aria-label={`${c3('preview')}. ${c3('crop')}: ${c3('dragCorners')}`} class="mx-auto block max-h-[65vh] w-full max-w-3xl touch-none cursor-grab rounded-xl object-contain shadow-2xl outline-none focus-visible:ring-2 focus-visible:ring-violet-400 active:cursor-grabbing"></canvas><figcaption class="mt-2 text-center text-xs font-semibold text-slate-300">{c3('preview')} · {c3('crop')}</figcaption></figure>
    <div class="grid gap-5 p-4 lg:grid-cols-2">
      <fieldset><legend class="text-xs font-extrabold uppercase tracking-wider text-slate-500 dark:text-slate-400">{c3('crop')}</legend><div class="mt-3 grid grid-cols-2 gap-2 text-xs sm:grid-cols-4">{[['original',c3('originalRatio')],['1',c3('square')],['1.333333','4:3'],['1.777778','16:9']].map(([value,label])=><label class="flex min-h-11 cursor-pointer items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-2 text-center font-bold text-slate-600 hover:border-violet-300 has-[:checked]:border-violet-500 has-[:checked]:bg-violet-50 has-[:checked]:text-violet-800 has-[:checked]:shadow-sm focus-within:ring-2 focus-within:ring-violet-500 dark:border-white/10 dark:bg-white/5 dark:text-slate-300 dark:has-[:checked]:bg-violet-500/15 dark:has-[:checked]:text-violet-200"><input data-edit-ratio type="radio" name="editCropRatio" value={value} checked={value==='original'} class="h-4 w-4 shrink-0 accent-violet-600"/><span>{label}</span></label>)}</div>{[[c3('dimensions'),'zoom','100','300','100'],[`↔ ${c3('width')}`,'x','-100','100','0'],[`↕ ${c3('height')}`,'y','-100','100','0']].map(([label,key,min,max,value])=><label class="mt-4 block"><span class="flex items-center justify-between gap-3 text-xs font-bold text-slate-600 dark:text-slate-300"><span>{label}</span><output data-edit-output={key} class="font-mono text-slate-500">{value}{key==='zoom'?'%':''}</output></span><input data-edit-control={key} type="range" min={min} max={max} value={value} class="mt-2 w-full accent-violet-600"/></label>)}</fieldset>
      <fieldset><legend class="text-xs font-extrabold uppercase tracking-wider text-slate-500 dark:text-slate-400">{c3('enhanced')}</legend><div class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-3">{[['original',c3('original')],['enhanced',c3('enhanced')],['color',c3('color')],['light',c3('moreLight')],['contrast',c3('highContrast')],['bw',c3('bw')]].map(([value,label])=><button type="button" data-edit-preset={value} aria-pressed={value === 'original' ? 'true' : 'false'} class="min-h-11 rounded-xl border border-slate-200 bg-white px-3 text-xs font-bold text-slate-600 hover:border-violet-300 aria-pressed:border-violet-500 aria-pressed:bg-violet-50 aria-pressed:text-violet-800 aria-pressed:shadow-sm focus-visible:ring-2 focus-visible:ring-violet-500 dark:border-white/10 dark:bg-white/5 dark:text-slate-300 dark:aria-pressed:bg-violet-500/15 dark:aria-pressed:text-violet-200">{label}</button>)}</div>{[[c3('moreLight'),'brightness'],[c3('highContrast'),'contrast'],[c3('color'),'saturation']].map(([label,key])=><label class="mt-3 block"><span class="flex items-center justify-between gap-3 text-xs font-bold text-slate-600 dark:text-slate-300"><span>{label}</span><output data-edit-output={key} class="font-mono text-slate-500">0</output></span><input data-edit-control={key} type="range" min="-100" max="100" value="0" class="mt-2 w-full accent-violet-600"/></label>)}</fieldset>
    </div>
    <p data-edit-status role="status" aria-live="polite" class="min-h-5 px-4 text-xs font-bold text-emerald-700 dark:text-emerald-300"></p><div class="grid gap-3 border-t border-slate-200 p-4 sm:grid-cols-[1fr_1fr_auto] dark:border-white/10"><label><span class="mb-1.5 block text-xs font-bold text-slate-600 dark:text-slate-300">{c3('format')}</span><select data-extra-format class="min-h-11 w-full rounded-xl border border-slate-200 bg-white px-3 text-sm font-semibold text-slate-900 focus-visible:ring-2 focus-visible:ring-violet-500 dark:border-white/10 dark:bg-slate-900 dark:text-white"><option value="image/jpeg">JPG</option><option value="image/png">PNG</option><option value="image/webp">WebP</option></select></label><label><span class="mb-1.5 block text-xs font-bold text-slate-600 dark:text-slate-300">{c3('quality')}</span><select data-edit-quality class="min-h-11 w-full rounded-xl border border-slate-200 bg-white px-3 text-sm font-semibold text-slate-900 focus-visible:ring-2 focus-visible:ring-violet-500 dark:border-white/10 dark:bg-slate-900 dark:text-white"><option value="0.82">82%</option><option value="0.9" selected>90%</option><option value="0.96">96%</option></select></label><button type="button" data-edit-reset class="min-h-11 self-end rounded-xl border border-slate-200 bg-white px-4 text-xs font-bold text-slate-600 hover:border-violet-300 hover:text-violet-700 dark:border-white/10 dark:bg-white/5 dark:text-slate-200">{c3('reset')}</button></div>
  </section>}

  {tool.limitationKey && <p class="mt-4 flex items-start gap-2 rounded-xl border border-blue-100 bg-blue-50/70 px-3 py-2.5 text-[11px] font-medium leading-snug text-blue-700/80 dark:border-blue-400/20 dark:bg-blue-500/10 dark:text-blue-300/80"><span class="font-extrabold">ⓘ</span><span><strong class="font-extrabold">{t('wb.limitation')}:</strong> {t(tool.limitationKey)}</span></p>}

  <div class="mt-5 flex flex-wrap items-center gap-3"><button type="button" data-extra-start disabled class="inline-flex h-11 items-center gap-2 rounded-full bg-slate-900 px-7 text-sm font-bold text-white shadow-lg shadow-slate-900/20 transition-shadow hover:shadow-xl disabled:cursor-not-allowed disabled:opacity-40 dark:bg-white dark:text-slate-900">{tool.id === 'edit-image' ? c3('export') : t('wb.start')}</button><button type="button" data-extra-cancel hidden class="inline-flex h-11 items-center rounded-full border border-slate-300 bg-white px-6 text-sm font-bold text-slate-600 dark:border-white/15 dark:bg-white/5 dark:text-slate-200">{t('wb.cancel')}</button><span class="flex items-center gap-1.5 text-[11px] font-semibold text-emerald-600 dark:text-emerald-400">✓ {t('panel.check4')}</span></div>
  <div data-extra-progress hidden role="progressbar" aria-labelledby="extra-progress-label" aria-valuemin="0" aria-valuemax="100" aria-valuenow="4" class="mt-4 overflow-hidden rounded-2xl border border-violet-100/80 bg-gradient-to-b from-violet-50/70 via-white/60 to-white/40 p-4 dark:border-violet-400/15 dark:from-violet-500/[.08] dark:via-transparent"><div class="flex items-center justify-between text-[11px] font-bold"><span id="extra-progress-label" data-extra-status class="text-slate-500 dark:text-slate-400">{t('wb.processing')}</span><span data-extra-percent class="text-violet-600 dark:text-violet-300">4%</span></div><div aria-hidden="true" class="mt-2 h-2 overflow-hidden rounded-full bg-slate-100 dark:bg-white/10"><div data-extra-bar class="h-full w-[4%] rounded-full bg-gradient-to-r from-blue-500 via-violet-500 to-fuchsia-500 transition-[width] duration-200"></div></div></div>
  <div id="extra-error" data-extra-error hidden role="alert" tabindex="-1" class="mt-4 rounded-2xl border border-rose-200 bg-rose-50/80 p-4 text-sm font-bold text-rose-700 dark:border-rose-400/20 dark:bg-rose-500/10 dark:text-rose-300"></div>
  <div data-extra-results hidden role="status" tabindex="-1" class="sf-pop-enter mt-4 rounded-2xl border border-emerald-200 bg-emerald-50/70 p-4 dark:border-emerald-400/20 dark:bg-emerald-500/10"><div class="mb-3 flex items-center gap-2 text-sm font-extrabold text-emerald-700 dark:text-emerald-300">✓ {t('wb.done')}</div><ul data-extra-result-list class="space-y-2"></ul><div class="mt-3 flex items-center justify-between gap-3"><span class="text-[11px] font-medium text-emerald-700 dark:text-emerald-300">{t('wb.original')}</span><button type="button" data-extra-new class="text-xs font-bold text-slate-500 hover:text-violet-600">{t('wb.newTask')}</button></div></div>
</div>

<script>
  import { protectPdf, unlockPdf, repairPdf, removeMetadata, excelToPdf, pdfToExcel, ocr } from '../engines/liveExtra.js';
  import { safeOutputStem } from '../utils/filename';
  const root = document.querySelector<HTMLElement>('[data-extra-workbench]');
  if (root) {
    const messages = JSON.parse(root.querySelector<HTMLElement>('[data-extra-messages]')?.textContent || '{}') as Record<string, string> & { edit: Record<string, string>; spreadsheet: Record<string, string> };
    const input = root.querySelector<HTMLInputElement>('[data-extra-input]')!;
    const drop = root.querySelector<HTMLElement>('[data-extra-drop]')!;
    const selected = root.querySelector<HTMLElement>('[data-extra-selected]')!;
    const list = root.querySelector<HTMLUListElement>('[data-extra-list]')!;
    const start = root.querySelector<HTMLButtonElement>('[data-extra-start]')!;
    const cancel = root.querySelector<HTMLButtonElement>('[data-extra-cancel]')!;
    const progress = root.querySelector<HTMLElement>('[data-extra-progress]')!;
    const status = root.querySelector<HTMLElement>('[data-extra-status]')!;
    const percent = root.querySelector<HTMLElement>('[data-extra-percent]')!;
    const bar = root.querySelector<HTMLElement>('[data-extra-bar]')!;
    const errorBox = root.querySelector<HTMLElement>('[data-extra-error]')!;
    const resultsBox = root.querySelector<HTMLElement>('[data-extra-results]')!;
    const resultList = root.querySelector<HTMLUListElement>('[data-extra-result-list]')!;
    const toolId = root.dataset.tool || '';
    let files: File[] = [];
    let objectUrls: string[] = [];
    let control: { cancelled: boolean; abortController: AbortController } | null = null;
    let editBitmap: ImageBitmap | null = null;
    let editFrame = 0;
    const editState = { rotation: 0, flip: false, ratio: 'original', zoom: 100, x: 0, y: 0, brightness: 0, contrast: 0, saturation: 0 };
    const editPreview = root.querySelector<HTMLCanvasElement>('[data-edit-preview]');
    const editStatus = root.querySelector<HTMLElement>('[data-edit-status]');
    const editPresets = {
      original: { brightness: 0, contrast: 0, saturation: 0 },
      enhanced: { brightness: 4, contrast: 8, saturation: 8 },
      color: { brightness: 3, contrast: 8, saturation: 24 },
      light: { brightness: 14, contrast: -3, saturation: 5 },
      contrast: { brightness: -4, contrast: 28, saturation: -5 },
      bw: { brightness: 2, contrast: 18, saturation: -100 },
    } as const;
    const formatBytes = (bytes: number) => bytes < 1024 ? `${bytes} B` : bytes < 1048576 ? `${(bytes / 1024).toFixed(1)} KB` : `${(bytes / 1048576).toFixed(1)} MB`;
    const cleanUrls = () => { objectUrls.forEach((url) => URL.revokeObjectURL(url)); objectUrls = []; };
    const setEditControl = (key: 'zoom'|'x'|'y'|'brightness'|'contrast'|'saturation', value: number) => { editState[key] = value; const input = root.querySelector<HTMLInputElement>(`[data-edit-control="${key}"]`); const output = root.querySelector<HTMLOutputElement>(`[data-edit-output="${key}"]`); if (input) input.value = String(value); if (output) output.value = key === 'zoom' ? `${value}%` : String(value); };
    const setActivePreset = (name: string | null) => root.querySelectorAll<HTMLButtonElement>('[data-edit-preset]').forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.editPreset === name)));
    const resetEditState = () => { Object.assign(editState, { rotation: 0, flip: false, ratio: 'original', zoom: 100, x: 0, y: 0, brightness: 0, contrast: 0, saturation: 0 }); root.querySelectorAll<HTMLInputElement>('[data-edit-control]').forEach(input => { input.value = input.dataset.editControl === 'zoom' ? '100' : '0'; }); root.querySelectorAll<HTMLOutputElement>('[data-edit-output]').forEach(output => { const key = output.dataset.editOutput; output.value = key === 'zoom' ? '100%' : '0'; }); const original = root.querySelector<HTMLInputElement>('[data-edit-ratio][value="original"]'); if (original) original.checked = true; setActivePreset('original'); if (editStatus) editStatus.textContent = '';
    };
    const renderEditCanvas = (fullResolution = false) => {
      if (!editBitmap) throw new Error('generic');
      const swap = editState.rotation % 180 !== 0; const rotatedWidth = swap ? editBitmap.height : editBitmap.width; const rotatedHeight = swap ? editBitmap.width : editBitmap.height;
      const temp = document.createElement('canvas'); temp.width = rotatedWidth; temp.height = rotatedHeight; if (temp.width * temp.height > 40_000_000) throw new Error('generic');
      const tempContext = temp.getContext('2d'); if (!tempContext) throw new Error('generic'); tempContext.imageSmoothingEnabled = true; tempContext.imageSmoothingQuality = 'high'; tempContext.translate(rotatedWidth / 2, rotatedHeight / 2); tempContext.rotate(editState.rotation * Math.PI / 180); tempContext.scale(editState.flip ? -1 : 1, 1); tempContext.drawImage(editBitmap, -editBitmap.width / 2, -editBitmap.height / 2);
      const ratio = editState.ratio === 'original' ? rotatedWidth / rotatedHeight : Number(editState.ratio); let baseWidth = rotatedWidth; let baseHeight = baseWidth / ratio; if (baseHeight > rotatedHeight) { baseHeight = rotatedHeight; baseWidth = baseHeight * ratio; }
      const zoom = Math.max(1, editState.zoom / 100); const cropWidth = Math.max(1, baseWidth / zoom); const cropHeight = Math.max(1, baseHeight / zoom); const maxSourceX = Math.max(0, rotatedWidth - cropWidth); const maxSourceY = Math.max(0, rotatedHeight - cropHeight); const sourceX = Math.max(0, Math.min(maxSourceX, maxSourceX / 2 + editState.x / 200 * maxSourceX)); const sourceY = Math.max(0, Math.min(maxSourceY, maxSourceY / 2 + editState.y / 200 * maxSourceY));
      const scale = fullResolution ? 1 : Math.min(1, 1200 / Math.max(cropWidth, cropHeight)); const output = fullResolution ? document.createElement('canvas') : root.querySelector<HTMLCanvasElement>('[data-edit-preview]')!; output.width = Math.max(1, Math.round(cropWidth * scale)); output.height = Math.max(1, Math.round(cropHeight * scale));
      const context = output.getContext('2d'); if (!context) throw new Error('generic'); context.imageSmoothingEnabled = true; context.imageSmoothingQuality = 'high'; context.clearRect(0,0,output.width,output.height); context.filter = `brightness(${100 + editState.brightness}%) contrast(${100 + editState.contrast}%) saturate(${100 + editState.saturation}%)`; context.drawImage(temp, sourceX, sourceY, cropWidth, cropHeight, 0, 0, output.width, output.height); context.filter = 'none'; temp.width = 1; temp.height = 1; return output;
    };
    const queueEditPreview = () => { if (!editBitmap) return; cancelAnimationFrame(editFrame); editFrame = requestAnimationFrame(() => { try { renderEditCanvas(false); } catch { /* The export action presents a localized error if rendering is unavailable. */ } }); };
    const setupEditImage = async (source: File) => { editBitmap?.close(); editBitmap = await createImageBitmap(source, { imageOrientation: 'from-image' }); if (editBitmap.width * editBitmap.height > 40_000_000) { editBitmap.close(); editBitmap = null; throw new Error('generic'); } resetEditState(); const editor = root.querySelector<HTMLElement>('[data-edit-editor]'); if (editor) editor.hidden = false; queueEditPreview(); };
    const validateFiles = async (incoming: File[]) => {
      const accepted = incoming.slice(0, root.dataset.multiple === 'true' ? 20 : 1);
      const total = accepted.reduce((sum, file) => sum + file.size, 0);
      if (!accepted.length) throw new Error('wrongType');
      if (total > 100_000_000) throw new Error('generic');
      for (const file of accepted) {
        if (file.size <= 0) throw new Error('wrongType');
        if (toolId.includes('pdf') || ['repair-pdf','metadata-remover'].includes(toolId)) {
          const wantsPdf = file.name.toLowerCase().endsWith('.pdf') || file.type === 'application/pdf';
          if (wantsPdf && new TextDecoder('ascii').decode(await file.slice(0, 5).arrayBuffer()) !== '%PDF-') throw new Error('wrongType');
        }
      }
      return accepted;
    };
    const renderFiles = () => {
      list.textContent = '';
      files.forEach((file, index) => { const item = document.createElement('li'); item.className = 'flex items-center gap-3 rounded-xl border border-slate-100 bg-white/90 p-2.5 shadow-sm dark:border-white/10 dark:bg-white/5'; const icon = document.createElement('span'); icon.className = 'flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-[9px] font-bold text-slate-500 dark:bg-white/10'; icon.textContent = file.name.split('.').pop()?.toUpperCase() || '—'; const text = document.createElement('span'); text.className = 'min-w-0 flex-1'; const name = document.createElement('span'); name.className = 'block truncate text-xs font-bold text-slate-800 dark:text-slate-100'; name.textContent = file.name; const size = document.createElement('span'); size.className = 'block text-[10px] font-semibold text-slate-500 dark:text-slate-400'; size.textContent = formatBytes(file.size); text.append(name, size); const remove = document.createElement('button'); remove.type = 'button'; remove.className = 'inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg text-lg text-slate-400 hover:bg-rose-50 hover:text-rose-600'; remove.textContent = '×'; remove.setAttribute('aria-label', `Remove ${file.name}`); remove.addEventListener('click', () => { files.splice(index, 1); renderFiles(); resultsBox.hidden = true; }); item.append(icon, text, remove); list.append(item); });
      selected.hidden = files.length === 0; start.disabled = files.length === 0; if (toolId === 'edit-image' && files.length === 0) { editBitmap?.close(); editBitmap = null; const editor = root.querySelector<HTMLElement>('[data-edit-editor]'); if (editor) editor.hidden = true; }
    };
    const load = async (incoming: File[], append = false) => { errorBox.hidden = true; input.removeAttribute('aria-invalid'); resultsBox.hidden = true; try { const valid = await validateFiles(incoming); const combined = append ? [...files, ...valid] : valid; if (combined.length > 20 || combined.reduce((sum, file) => sum + file.size, 0) > 100_000_000) throw new Error('generic'); files = combined; input.value = ''; renderFiles(); if (toolId === 'edit-image') await setupEditImage(files[0]); } catch (error) { const code = error instanceof Error ? error.message : 'generic'; if (!append) files = []; renderFiles(); errorBox.textContent = messages[code] || messages.generic; errorBox.hidden = false; input.setAttribute('aria-invalid', 'true'); errorBox.focus(); } };
    const reset = () => { cleanUrls(); editBitmap?.close(); editBitmap = null; cancelAnimationFrame(editFrame); files = []; input.value = ''; input.removeAttribute('aria-invalid'); root.removeAttribute('aria-busy'); renderFiles(); progress.hidden = true; resultsBox.hidden = true; errorBox.hidden = true; };
    const editImage = async (source: File) => {
      if (!editBitmap) await setupEditImage(source);
      const canvas = renderEditCanvas(true); const mime = root.querySelector<HTMLSelectElement>('[data-extra-format]')?.value || 'image/jpeg'; const quality = Number(root.querySelector<HTMLSelectElement>('[data-edit-quality]')?.value || .9);
      if (mime === 'image/jpeg') { const context = canvas.getContext('2d'); if (!context) throw new Error('generic'); context.globalCompositeOperation = 'destination-over'; context.fillStyle = '#fff'; context.fillRect(0,0,canvas.width,canvas.height); context.globalCompositeOperation = 'source-over'; }
      const blob = await new Promise<Blob>((resolve, reject) => canvas.toBlob((value) => value ? resolve(value) : reject(new Error('generic')), mime, quality)); canvas.width = 1; canvas.height = 1;
      const ext = mime === 'image/jpeg' ? 'jpg' : mime.split('/')[1];
      return [{ name: `${safeOutputStem(source.name, 'image')}-edited.${ext}`, blob }];
    };
    const run = async () => {
      if (!files.length) return;
      control = { cancelled: false, abortController: new AbortController() }; errorBox.hidden = true; resultsBox.hidden = true; progress.hidden = false; root.setAttribute('aria-busy', 'true'); start.hidden = true; cancel.hidden = false;
      const update = (done: number, total: number) => { const value = Math.max(4, Math.round((done / Math.max(1, total)) * 100)); percent.textContent = `${value}%`; bar.style.width = `${value}%`; progress.setAttribute('aria-valuenow', String(value)); status.textContent = messages.processing; };
      try {
        const opts = { password: root.querySelector<HTMLInputElement>('[data-extra-password]')?.value || '', lang: root.querySelector<HTMLSelectElement>('[data-extra-lang]')?.value || 'eng', spreadsheetMode: root.querySelector<HTMLInputElement>('[data-spreadsheet-mode]:checked')?.value || 'exact', messages: messages.spreadsheet };
        const engines: Record<string, Function> = { 'protect-pdf': protectPdf, 'unlock-pdf': unlockPdf, 'repair-pdf': repairPdf, 'metadata-remover': removeMetadata, 'excel-to-pdf': excelToPdf, 'pdf-to-excel': pdfToExcel, 'pdf-ocr': ocr };
        const output = toolId === 'edit-image' ? await editImage(files[0]) : await engines[toolId](files, opts, update, control);
        if (control.cancelled) throw new Error('cancelled');
        resultList.textContent = ''; cleanUrls();
        for (const result of output) { const url = URL.createObjectURL(result.blob); objectUrls.push(url); const item = document.createElement('li'); item.className = 'flex items-center gap-3 rounded-xl bg-white/90 p-2.5 shadow-sm dark:bg-white/5'; const text = document.createElement('span'); text.className = 'min-w-0 flex-1'; const name = document.createElement('span'); name.className = 'block truncate text-xs font-bold text-slate-800 dark:text-slate-100'; name.textContent = result.name; const size = document.createElement('span'); size.className = 'block text-[10px] font-semibold text-slate-500 dark:text-slate-400'; size.textContent = formatBytes(result.blob.size); text.append(name, size); const link = document.createElement('a'); link.href = url; link.download = result.name; link.className = 'inline-flex h-9 items-center rounded-full bg-slate-900 px-4 text-xs font-bold text-white dark:bg-white dark:text-slate-900'; link.textContent = messages.download; item.append(text, link); resultList.append(item); }
        progress.hidden = true; resultsBox.hidden = false; resultsBox.focus();
      } catch (error) { progress.hidden = true; const code = error instanceof Error ? error.message : 'generic'; errorBox.textContent = code === 'cancelled' ? messages.cancelled : messages[code] || messages.generic; errorBox.hidden = false; errorBox.focus(); }
      finally { root.removeAttribute('aria-busy'); start.hidden = false; cancel.hidden = true; control = null; }
    };
    let appendSelection = false;
    if (toolId === 'edit-image') {
      root.querySelectorAll<HTMLInputElement>('[data-edit-control]').forEach(input => input.addEventListener('input', () => { const key = input.dataset.editControl as 'zoom'|'x'|'y'|'brightness'|'contrast'|'saturation'; setEditControl(key, Number(input.value)); if (['brightness','contrast','saturation'].includes(key)) setActivePreset(null); if (editStatus) editStatus.textContent = `✓ ${messages.edit[key] || messages.edit.edit}`; queueEditPreview(); }));
      root.querySelectorAll<HTMLInputElement>('[data-edit-ratio]').forEach(input => input.addEventListener('change', () => { if (input.checked) { editState.ratio = input.value; setEditControl('x', 0); setEditControl('y', 0); if (editStatus) editStatus.textContent = `✓ ${messages.edit.crop}: ${input.parentElement?.textContent?.trim() || ''}`; queueEditPreview(); } }));
      root.querySelectorAll<HTMLButtonElement>('[data-edit-preset]').forEach((button) => button.addEventListener('click', () => { const name = button.dataset.editPreset as keyof typeof editPresets; const preset = editPresets[name]; if (!preset) return; setEditControl('brightness', preset.brightness); setEditControl('contrast', preset.contrast); setEditControl('saturation', preset.saturation); setActivePreset(name); if (editStatus) editStatus.textContent = `✓ ${button.textContent?.trim() || messages.edit.enhanced}`; queueEditPreview(); }));
      let drag: { id: number; x: number; y: number; stateX: number; stateY: number } | null = null;
      editPreview?.addEventListener('pointerdown', (event) => { if (!editBitmap) return; drag = { id: event.pointerId, x: event.clientX, y: event.clientY, stateX: editState.x, stateY: editState.y }; editPreview.setPointerCapture(event.pointerId); });
      editPreview?.addEventListener('pointermove', (event) => { if (!drag || drag.id !== event.pointerId) return; const width = Math.max(1, editPreview.clientWidth); const height = Math.max(1, editPreview.clientHeight); setEditControl('x', Math.round(Math.max(-100, Math.min(100, drag.stateX - (event.clientX - drag.x) / width * 200)))); setEditControl('y', Math.round(Math.max(-100, Math.min(100, drag.stateY - (event.clientY - drag.y) / height * 200)))); if (editStatus) editStatus.textContent = `✓ ${messages.edit.crop}`; queueEditPreview(); });
      const endDrag = (event: PointerEvent) => { if (!drag || drag.id !== event.pointerId) return; if (editPreview?.hasPointerCapture(event.pointerId)) editPreview.releasePointerCapture(event.pointerId); drag = null; };
      editPreview?.addEventListener('pointerup', endDrag); editPreview?.addEventListener('pointercancel', endDrag);
      editPreview?.addEventListener('keydown', (event) => { const amount = event.shiftKey ? 10 : 3; if (!['ArrowLeft','ArrowRight','ArrowUp','ArrowDown'].includes(event.key)) return; event.preventDefault(); if (event.key === 'ArrowLeft') setEditControl('x', Math.max(-100, editState.x - amount)); if (event.key === 'ArrowRight') setEditControl('x', Math.min(100, editState.x + amount)); if (event.key === 'ArrowUp') setEditControl('y', Math.max(-100, editState.y - amount)); if (event.key === 'ArrowDown') setEditControl('y', Math.min(100, editState.y + amount)); if (editStatus) editStatus.textContent = `✓ ${messages.edit.crop}`; queueEditPreview(); });
      root.querySelector('[data-edit-rotate-left]')?.addEventListener('click', () => { editState.rotation = (editState.rotation + 270) % 360; if (editStatus) editStatus.textContent = `✓ ${messages.edit.rotate}`; queueEditPreview(); }); root.querySelector('[data-edit-rotate-right]')?.addEventListener('click', () => { editState.rotation = (editState.rotation + 90) % 360; if (editStatus) editStatus.textContent = `✓ ${messages.edit.rotate}`; queueEditPreview(); }); root.querySelector('[data-edit-flip]')?.addEventListener('click', () => { editState.flip = !editState.flip; if (editStatus) editStatus.textContent = `✓ ${messages.edit.stretch}`; queueEditPreview(); }); root.querySelector('[data-edit-reset]')?.addEventListener('click', () => { resetEditState(); if (editStatus) editStatus.textContent = `✓ ${messages.edit.reset}`; queueEditPreview(); });
    }
    input.addEventListener('change', () => void load([...input.files || []], appendSelection));
    root.querySelector('[data-extra-add]')?.addEventListener('click', () => { appendSelection = true; input.click(); });
    drop.addEventListener('click', () => { appendSelection = files.length > 0; input.click(); });
    for (const eventName of ['dragenter','dragover']) drop.addEventListener(eventName, (event) => { event.preventDefault(); drop.classList.add('border-violet-400','bg-violet-50/70'); });
    for (const eventName of ['dragleave','drop']) drop.addEventListener(eventName, (event) => { event.preventDefault(); drop.classList.remove('border-violet-400','bg-violet-50/70'); });
    drop.addEventListener('drop', (event) => void load([...event.dataTransfer?.files || []], files.length > 0));
    root.querySelector('[data-extra-clear]')?.addEventListener('click', reset); root.querySelector('[data-extra-new]')?.addEventListener('click', reset); start.addEventListener('click', () => void run()); cancel.addEventListener('click', () => { if (control) { control.cancelled = true; control.abortController.abort(); } });
    addEventListener('beforeunload', () => { cleanUrls(); editBitmap?.close(); });
  }
</script>
