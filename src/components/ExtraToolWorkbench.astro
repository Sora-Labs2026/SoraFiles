---
import type { LiveTool } from '../data/liveTools';
import type { LocalePath } from '../i18n/config';
import { liveText } from '../data/liveI18n';
import ToolIcon from './ToolIcon.astro';
import { OCR_LANGUAGE_BY_LOCALE, OCR_LANGUAGE_OPTIONS } from '../lib/ocr/languages';
import { chapter3English, chapter3Text } from '../data/chapter3Ui';
import { imageAdjustmentText } from '../data/imageAdjustmentsUi';
import { getConversionFidelityMessages } from '../i18n/documentTools';
import { getSpreadsheetToolMessages } from '../i18n/spreadsheetTools';
import AdaptiveWorkspace from './AdaptiveWorkspace.astro';
interface Props { tool: LiveTool; locale?: LocalePath; }
const { tool, locale = 'en' } = Astro.props;
const t = (path: string) => liveText(locale, path);
const defaultOcrCode = OCR_LANGUAGE_BY_LOCALE[locale] ?? 'eng';
const c3 = (key: keyof typeof chapter3English) => chapter3Text(locale, key);
const adjust = (key: Parameters<typeof imageAdjustmentText>[1]) => imageAdjustmentText(locale, key);
const editLightAdjustments = [['exposure',adjust('exposure'),-100,100],['highlights',adjust('highlights'),-100,100],['shadows',adjust('shadows'),-100,100],['contrast',adjust('contrast'),-100,100],['brightness',adjust('brightness'),-100,100],['blackPoint',adjust('blackPoint'),0,100],['saturation',adjust('saturation'),-100,100]] as const;
const editDetailAdjustments = [['definition',adjust('definition'),0,100],['sharpness',adjust('sharpness'),0,100],['noiseReduction',adjust('noiseReduction'),0,100]] as const;
const spreadsheetMsg = getSpreadsheetToolMessages(locale);
const officeMsg = getConversionFidelityMessages(locale);
const quickToolIds = new Set(['protect-pdf', 'unlock-pdf', 'repair-pdf', 'metadata-remover']);
const extraWorkspaceMode = tool.id === 'edit-image' ? 'canvas' : quickToolIds.has(tool.id) ? 'quick' : 'preview';
const englishActions: Record<string, string> = {
  'edit-image': 'Save image',
  'protect-pdf': 'Protect PDF',
  'unlock-pdf': 'Unlock PDF',
  'repair-pdf': 'Try to repair',
  'metadata-remover': 'Remove metadata',
  'pdf-to-excel': 'Convert to Excel',
  'excel-to-pdf': 'Convert to PDF',
  'pdf-ocr': 'Run OCR',
};
const englishSuccess: Record<string, string> = {
  'edit-image': 'Image saved',
  'protect-pdf': 'Password added',
  'unlock-pdf': 'PDF unlocked',
  'repair-pdf': 'Repair finished',
  'metadata-remover': 'Metadata removed',
  'pdf-to-excel': 'Spreadsheet created',
  'excel-to-pdf': 'PDF created',
  'pdf-ocr': 'Text recognition finished',
};
const primaryAction = locale === 'en' ? (englishActions[tool.id] ?? t('wb.start')) : t('wb.start');
const successLabel = locale === 'en' ? (englishSuccess[tool.id] ?? t('wb.done')) : t('wb.done');
const pageVisualLabel: Record<LocalePath, string> = {
  en: 'Page visual reference', ja: 'ページ画像の参照', ko: '페이지 이미지 참조', es: 'Referencia visual de página', fr: 'Référence visuelle de page', de: 'Visuelle Seitenreferenz', pt: 'Referência visual da página',
  'zh-cn': '页面视觉参考', 'zh-tw': '頁面視覺參考', hi: 'पृष्ठ दृश्य संदर्भ', ar: 'مرجع مرئي للصفحة', ru: 'Визуальный образ страницы', id: 'Referensi visual halaman', it: 'Riferimento visivo pagina', nl: 'Visuele paginareferentie', tr: 'Sayfa görseli referansı', vi: 'Tham chiếu hình ảnh trang', th: 'ภาพอ้างอิงของหน้า', pl: 'Wizualny podgląd strony',
};
const clientMessages = JSON.stringify({
  wrongType: t('wb.err.wrongType'),
  generic: t('wb.err.generic'),
  processing: t('wb.processing'),
  download: t('wb.download'),
  cancelled: t('wb.cancel'),
  noPassword: t('wb.err.noPassword'),
  wrongPassword: t('wb.err.wrongPassword'),
  needPassword: t('wb.err.needPassword'),
  alreadyEncrypted: t('wb.err.alreadyEncrypted'),
  badExcel: t('wb.err.badExcel'),
  noText: t('wb.err.noText'),
  ocrFailed: t('wb.err.ocrFailed'),
  officeIsolation: officeMsg.officeIsolation,
  officeFailed: officeMsg.officeFailed,
  spreadsheet: spreadsheetMsg,
  edit: Object.fromEntries(Object.keys(chapter3English).map((key) => [key, c3(key as keyof typeof chapter3English)])),
  adjustments: Object.fromEntries(['adjustments','light','detail','exposure','highlights','shadows','contrast','brightness','blackPoint','definition','sharpness','noiseReduction','saturation'].map((key) => [key, adjust(key as Parameters<typeof imageAdjustmentText>[1])])),
}).replace(/</g, '\\u003c');
---

<div data-extra-workbench data-testid={`workbench-${tool.slug}`} data-tool={tool.id} data-accept={tool.accept} data-multiple={String(tool.multiple)} class="glass rounded-[1.75rem] p-4 shadow-2xl shadow-indigo-500/10 sm:p-6">
  <script type="application/json" data-extra-messages is:inline set:html={clientMessages}></script>
  <button type="button" data-extra-drop aria-controls="extra-file-input" aria-describedby="extra-drop-help" class="sf-upload-dropzone flex w-full cursor-pointer flex-col items-center justify-center gap-3 px-6 py-10 text-center">
    <span class:list={['sf-upload-dropzone__icon flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br text-white shadow-lg', tool.tile]}><ToolIcon icon={tool.icon}/></span>
    <span class="text-sm font-extrabold tracking-tight text-slate-800 dark:text-slate-100">{tool.multiple ? t('wb.dropMany') : t('wb.dropOne')}</span>
    <span id="extra-drop-help" class="text-xs font-medium text-slate-500 dark:text-slate-400">{t('wb.orClick')}</span>
  </button>
  <input id="extra-file-input" data-extra-input type="file" tabindex="-1" class="sr-only" accept={tool.accept} multiple={tool.multiple} aria-label={tool.multiple ? t('wb.dropMany') : t('wb.dropOne')} aria-describedby="extra-drop-help extra-error" />

  <AdaptiveWorkspace id={`extra-workspace-${tool.id}`} mode={extraWorkspaceMode} title={tool.name} resetTarget="[data-extra-clear]" class="extra-adaptive-workspace">
  <div data-extra-selected hidden class="mt-4">
    <div class="mb-2 flex flex-wrap items-center justify-between gap-2"><span class="text-xs font-extrabold uppercase tracking-wider text-slate-500 dark:text-slate-400">{t('wb.files')}</span><span class="flex items-center gap-1">{tool.multiple && <button type="button" data-extra-add class="min-h-10 rounded-lg border border-slate-200 bg-white px-3 text-xs font-bold text-violet-600 dark:border-white/10 dark:bg-white/5 dark:text-violet-300">+ {t('wb.files')}</button>}<button type="button" data-extra-clear class="min-h-10 rounded-lg px-2 text-xs font-bold text-slate-500 transition-colors hover:text-rose-600 dark:text-slate-400 dark:hover:text-rose-300">{t('wb.clearAll')}</button></span></div>
    <ul data-extra-list class="space-y-2"></ul>
  </div>

  {tool.id === 'unlock-pdf' && <label class="mt-4 block rounded-2xl border border-slate-100 bg-white/60 p-4 dark:border-white/10 dark:bg-white/[.03]"><span class="mb-1.5 block text-xs font-bold text-slate-600 dark:text-slate-300">{t('opt.passwordUnlock')}</span><input data-extra-password type="password" autocomplete="current-password" placeholder={t('opt.passwordUnlock')} class="h-11 w-full rounded-xl border border-slate-200 bg-white/90 px-3 text-sm font-semibold text-slate-700 outline-none focus:border-violet-300 dark:border-white/10 dark:bg-white/5 dark:text-slate-200"/><span class="mt-1 block text-[10px] font-medium text-slate-500 dark:text-slate-400">{t('opt.passwordUnlockHint')}</span></label>}
  {tool.id === 'protect-pdf' && <fieldset class="mt-4 rounded-2xl border border-slate-100 bg-white/60 p-4 dark:border-white/10 dark:bg-white/[.03]"><legend class="px-1 text-xs font-extrabold uppercase tracking-wider text-slate-500 dark:text-slate-400">PDF protection</legend><div class="mt-2 grid gap-4 sm:grid-cols-2"><label><span class="mb-1.5 block text-xs font-bold text-slate-600 dark:text-slate-300">Open password</span><input data-extra-password type="password" autocomplete="new-password" placeholder="Required to open the PDF" class="h-11 w-full rounded-xl border border-slate-200 bg-white/90 px-3 text-sm font-semibold text-slate-700 outline-none focus:border-violet-300 dark:border-white/10 dark:bg-white/5 dark:text-slate-200"/><span data-password-strength class="mt-1.5 block text-[10px] font-bold text-slate-500" aria-live="polite">Use 12+ characters with a mix of words, numbers, or symbols.</span></label><label><span class="mb-1.5 block text-xs font-bold text-slate-600 dark:text-slate-300">Permissions password</span><input data-owner-password type="password" autocomplete="new-password" placeholder="Optional separate password" class="h-11 w-full rounded-xl border border-slate-200 bg-white/90 px-3 text-sm font-semibold text-slate-700 outline-none focus:border-violet-300 dark:border-white/10 dark:bg-white/5 dark:text-slate-200"/><span class="mt-1.5 block text-[10px] font-medium text-slate-500">Leave blank to use the open password for these choices too.</span></label></div><div class="mt-4 grid gap-2 sm:grid-cols-3"><label class="flex min-h-11 items-center gap-2 rounded-xl border border-slate-200 px-3 text-xs font-bold dark:border-white/10"><input data-pdf-permission="printing" type="checkbox" checked class="h-4 w-4 accent-violet-600"/> Allow printing</label><label class="flex min-h-11 items-center gap-2 rounded-xl border border-slate-200 px-3 text-xs font-bold dark:border-white/10"><input data-pdf-permission="copying" type="checkbox" checked class="h-4 w-4 accent-violet-600"/> Allow copying</label><label class="flex min-h-11 items-center gap-2 rounded-xl border border-slate-200 px-3 text-xs font-bold dark:border-white/10"><input data-pdf-permission="modifying" type="checkbox" checked class="h-4 w-4 accent-violet-600"/> Allow editing</label></div><p class="mt-3 text-[11px] font-medium leading-5 text-slate-500 dark:text-slate-400">The open password protects the PDF. Printing, copying, and editing choices depend on the PDF reader and may not prevent every workaround.</p></fieldset>}
  {tool.id === 'pdf-ocr' && <div class="mt-4 grid gap-3 rounded-2xl border border-slate-100 bg-white/60 p-4 sm:grid-cols-2 dark:border-white/10 dark:bg-white/[.03]"><label><span class="mb-1.5 block text-xs font-bold text-slate-600 dark:text-slate-300">{t('opt.ocrLang')}</span><select data-extra-lang class="h-11 w-full rounded-xl border border-slate-200 bg-white/90 px-3 text-sm font-semibold text-slate-700 dark:border-white/10 dark:bg-white/5 dark:text-slate-200">{OCR_LANGUAGE_OPTIONS.map((option) => <option value={option.code} selected={option.code === defaultOcrCode} dir={option.direction}>{option.nativeName}</option>)}</select></label><label><span class="mb-1.5 block text-xs font-bold text-slate-600 dark:text-slate-300">Output</span><select data-ocr-output class="h-11 w-full rounded-xl border border-slate-200 bg-white/90 px-3 text-sm font-semibold text-slate-700 dark:border-white/10 dark:bg-white/5 dark:text-slate-200"><option value="pdf" selected>Searchable PDF</option><option value="txt">Plain text (TXT)</option></select></label><p class="text-[11px] font-medium leading-5 text-slate-500 sm:col-span-2 dark:text-slate-400">Pages with readable text are kept as they are. SoraFiles adds searchable text only where needed. Review the result for recognition mistakes.</p></div>}
  {tool.id === 'pdf-to-excel' && <fieldset class="mt-4 rounded-2xl border border-slate-100 bg-white/60 p-4 dark:border-white/10 dark:bg-white/[.03]"><legend class="px-1 text-xs font-extrabold uppercase tracking-wider text-slate-500 dark:text-slate-400">{spreadsheetMsg.resultMode}</legend><div class="mt-2 grid gap-3 sm:grid-cols-2"><label class="flex min-h-14 cursor-pointer items-center rounded-2xl border border-emerald-200 bg-emerald-50/70 p-4 has-[:checked]:ring-2 has-[:checked]:ring-emerald-500 dark:border-emerald-400/20 dark:bg-emerald-500/10"><span class="flex items-center gap-2 text-sm font-extrabold text-emerald-800 dark:text-emerald-200"><input data-spreadsheet-mode type="radio" name="spreadsheetMode" value="editable" checked class="h-4 w-4 accent-emerald-600"/>{spreadsheetMsg.editableCells}</span></label><label class="flex min-h-14 cursor-pointer items-center rounded-2xl border border-slate-200 bg-white/70 p-4 has-[:checked]:ring-2 has-[:checked]:ring-violet-500 dark:border-white/10 dark:bg-white/5"><span class="flex items-center gap-2 text-sm font-extrabold text-slate-800 dark:text-slate-100"><input data-spreadsheet-mode type="radio" name="spreadsheetMode" value="visual" class="h-4 w-4 accent-violet-600"/>{pageVisualLabel[locale]}</span></label></div><p class="mt-3 text-[11px] font-medium leading-5 text-slate-500 dark:text-slate-400">Editable mode finds tables and places their values into spreadsheet cells. Page visual mode keeps each whole page as an image. Complex or scanned tables may need review.</p></fieldset>}
  {tool.id === 'metadata-remover' && <fieldset class="mt-4 rounded-2xl border border-slate-100 bg-white/60 p-4 dark:border-white/10 dark:bg-white/[.03]"><legend class="px-1 text-xs font-extrabold uppercase tracking-wider text-slate-500 dark:text-slate-400">Hidden file details</legend><div class="mt-2 flex flex-wrap gap-4 text-xs font-bold"><label class="flex min-h-10 items-center gap-2"><input type="radio" name="metadataMode" value="all" checked class="h-4 w-4 accent-violet-600"/> Remove all hidden details</label><label class="flex min-h-10 items-center gap-2"><input type="radio" name="metadataMode" value="selective" class="h-4 w-4 accent-violet-600"/> Choose PDF details</label></div><div data-metadata-choices hidden class="mt-3 grid gap-2 sm:grid-cols-3">{[['title','Title'],['author','Author'],['subject','Subject'],['keywords','Keywords'],['creator','Creating app'],['dates','Creation and edit dates'],['xmp','Other document details']].map(([value,label]) => <label class="flex min-h-10 items-center gap-2 rounded-xl border border-slate-200 px-3 text-xs font-semibold dark:border-white/10"><input data-metadata-category={value} type="checkbox" checked class="h-4 w-4 accent-violet-600"/> {label}</label>)}</div><p class="mt-3 text-[11px] font-medium leading-5 text-slate-500 dark:text-slate-400">The result lists what was found and checks that it was removed. PDF details can be chosen separately; image and Office file details are removed together.</p></fieldset>}
  {tool.id === 'edit-image' && <section data-edit-editor hidden aria-labelledby="edit-image-heading" class="mt-4 overflow-hidden rounded-2xl border border-slate-200 bg-white dark:border-white/10 dark:bg-slate-950">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 p-4 dark:border-white/10"><h2 id="edit-image-heading" class="text-sm font-extrabold text-slate-900 dark:text-white">{c3('edit')}</h2><div class="flex gap-2"><button type="button" data-edit-rotate-left aria-label={`${c3('rotate')} −90°`} class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-full border border-slate-200 bg-white text-lg hover:border-violet-300 focus-visible:ring-2 focus-visible:ring-violet-500 dark:border-white/10 dark:bg-white/5">↶</button><button type="button" data-edit-rotate-right aria-label={`${c3('rotate')} +90°`} class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-full border border-slate-200 bg-white text-lg hover:border-violet-300 focus-visible:ring-2 focus-visible:ring-violet-500 dark:border-white/10 dark:bg-white/5">↷</button><button type="button" data-edit-flip aria-label={c3('stretch')} class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-full border border-slate-200 bg-white text-base hover:border-violet-300 focus-visible:ring-2 focus-visible:ring-violet-500 dark:border-white/10 dark:bg-white/5">↔</button></div></div>
    <figure data-workspace-canvas class="bg-slate-950 p-3 sm:p-5"><canvas data-edit-preview width="960" height="640" tabindex="0" role="img" aria-label={`${c3('preview')}. ${c3('crop')}: ${c3('dragCorners')}`} class="mx-auto block max-h-[65vh] w-full max-w-3xl touch-none cursor-grab rounded-xl object-contain shadow-2xl outline-none focus-visible:ring-2 focus-visible:ring-violet-400 active:cursor-grabbing"></canvas><figcaption class="mt-2 text-center text-xs font-semibold text-slate-300">{c3('preview')} · {c3('crop')}</figcaption></figure>
    <div data-workspace-inspector class="edit-mobile-inspector"><div class="grid gap-5 p-4 lg:grid-cols-2">
      <fieldset><legend class="text-xs font-extrabold uppercase tracking-wider text-slate-500 dark:text-slate-400">{c3('crop')}</legend><div class="mt-3 grid grid-cols-2 gap-2 text-xs sm:grid-cols-4">{[['original',c3('originalRatio')],['1',c3('square')],['1.333333','4:3'],['1.777778','16:9']].map(([value,label])=><label class="flex min-h-11 cursor-pointer items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-2 text-center font-bold text-slate-600 hover:border-violet-300 has-[:checked]:border-violet-500 has-[:checked]:bg-violet-50 has-[:checked]:text-violet-800 has-[:checked]:shadow-sm focus-within:ring-2 focus-within:ring-violet-500 dark:border-white/10 dark:bg-white/5 dark:text-slate-300 dark:has-[:checked]:bg-violet-500/15 dark:has-[:checked]:text-violet-200"><input data-edit-ratio type="radio" name="editCropRatio" value={value} checked={value==='original'} class="h-4 w-4 shrink-0 accent-violet-600"/><span>{label}</span></label>)}</div>{[[c3('dimensions'),'zoom','100','300','100'],[`↔ ${c3('width')}`,'x','-100','100','0'],[`↕ ${c3('height')}`,'y','-100','100','0']].map(([label,key,min,max,value])=><label class="mt-4 block"><span class="flex items-center justify-between gap-3 text-xs font-bold text-slate-600 dark:text-slate-300"><span>{label}</span><output data-edit-output={key} class="font-mono text-slate-500">{value}{key==='zoom'?'%':''}</output></span><input data-edit-control={key} type="range" min={min} max={max} value={value} class="mt-2 w-full accent-violet-600"/></label>)}</fieldset>
      <fieldset><legend class="text-xs font-extrabold uppercase tracking-wider text-slate-500 dark:text-slate-400">{adjust('adjustments')}</legend><div class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-3">{[['original',c3('original')],['enhanced',c3('enhanced')],['color',c3('color')],['light',c3('moreLight')],['contrast',c3('highContrast')],['bw',c3('bw')]].map(([value,label])=><button type="button" data-edit-preset={value} aria-pressed={value === 'original' ? 'true' : 'false'} class="min-h-11 rounded-xl border border-slate-200 bg-white px-3 text-xs font-bold text-slate-600 hover:border-violet-300 aria-pressed:border-violet-500 aria-pressed:bg-violet-50 aria-pressed:text-violet-800 aria-pressed:shadow-sm focus-visible:ring-2 focus-visible:ring-violet-500 dark:border-white/10 dark:bg-white/5 dark:text-slate-300 dark:aria-pressed:bg-violet-500/15 dark:aria-pressed:text-violet-200">{label}</button>)}</div><div class="mt-3 grid items-start gap-3 xl:grid-cols-2"><details open class="edit-adjustment-group"><summary>{adjust('light')}</summary><div>{editLightAdjustments.map(([key,label,min,max])=><label class="edit-adjustment-slider"><span><span>{label}</span><output data-edit-output={key}>0</output></span><input data-edit-control={key} aria-label={label} type="range" min={min} max={max} value="0"/></label>)}</div></details><details open class="edit-adjustment-group"><summary>{adjust('detail')}</summary><div>{editDetailAdjustments.map(([key,label,min,max])=><label class="edit-adjustment-slider"><span><span>{label}</span><output data-edit-output={key}>0</output></span><input data-edit-control={key} aria-label={label} type="range" min={min} max={max} value="0"/></label>)}</div></details></div></fieldset>
    </div>
    <p data-edit-status role="status" aria-live="polite" class="min-h-5 px-4 text-xs font-bold text-emerald-700 dark:text-emerald-300"></p><div class="grid gap-3 border-t border-slate-200 p-4 sm:grid-cols-[1fr_1fr_auto] dark:border-white/10"><label><span class="mb-1.5 block text-xs font-bold text-slate-600 dark:text-slate-300">{c3('format')}</span><select data-extra-format class="min-h-11 w-full rounded-xl border border-slate-200 bg-white px-3 text-sm font-semibold text-slate-900 focus-visible:ring-2 focus-visible:ring-violet-500 dark:border-white/10 dark:bg-slate-900 dark:text-white"><option value="image/jpeg">JPG</option><option value="image/png">PNG</option><option value="image/webp">WebP</option></select></label><label><span class="mb-1.5 block text-xs font-bold text-slate-600 dark:text-slate-300">{c3('quality')}</span><select data-edit-quality class="min-h-11 w-full rounded-xl border border-slate-200 bg-white px-3 text-sm font-semibold text-slate-900 focus-visible:ring-2 focus-visible:ring-violet-500 dark:border-white/10 dark:bg-slate-900 dark:text-white"><option value="0.82">82%</option><option value="0.9" selected>90%</option><option value="0.96">96%</option></select></label><button type="button" data-edit-reset class="min-h-11 self-end rounded-xl border border-slate-200 bg-white px-4 text-xs font-bold text-slate-600 hover:border-violet-300 hover:text-violet-700 dark:border-white/10 dark:bg-white/5 dark:text-slate-200">{c3('reset')}</button></div></div>
  </section>}

  {tool.limitationKey && <p class="mt-4 flex items-start gap-2 rounded-xl border border-blue-100 bg-blue-50/70 px-3 py-2.5 text-[11px] font-medium leading-snug text-blue-700/80 dark:border-blue-400/20 dark:bg-blue-500/10 dark:text-blue-300/80"><span class="font-extrabold">ⓘ</span><span><strong class="font-extrabold">{t('wb.limitation')}:</strong> {t(tool.limitationKey)}</span></p>}

  <div data-mobile-actionbar class="mt-5 flex flex-wrap items-center gap-3"><button type="button" data-extra-start disabled class="inline-flex h-11 items-center gap-2 rounded-full bg-slate-900 px-7 text-sm font-bold text-white shadow-lg shadow-slate-900/20 transition-shadow hover:shadow-xl disabled:cursor-not-allowed disabled:opacity-40 dark:bg-white dark:text-slate-900">{primaryAction}</button><button type="button" data-extra-cancel hidden class="inline-flex h-11 items-center rounded-full border border-slate-300 bg-white px-6 text-sm font-bold text-slate-600 dark:border-white/15 dark:bg-white/5 dark:text-slate-200">{t('wb.cancel')}</button><span class="flex items-center gap-1.5 text-[11px] font-semibold text-emerald-600 dark:text-emerald-400">✓ {t('panel.check4')}</span></div>
  <div data-extra-progress hidden role="progressbar" aria-labelledby="extra-progress-label" aria-valuemin="0" aria-valuemax="100" aria-valuenow="4" class="mt-4 overflow-hidden rounded-2xl border border-violet-100/80 bg-gradient-to-b from-violet-50/70 via-white/60 to-white/40 p-4 dark:border-violet-400/15 dark:from-violet-500/[.08] dark:via-transparent"><div class="flex items-center justify-between text-[11px] font-bold"><span id="extra-progress-label" data-extra-status class="text-slate-500 dark:text-slate-400">{t('wb.processing')}</span><span data-extra-percent class="text-violet-600 dark:text-violet-300">4%</span></div><div aria-hidden="true" class="mt-2 h-2 overflow-hidden rounded-full bg-slate-100 dark:bg-white/10"><div data-extra-bar class="h-full w-[4%] rounded-full bg-gradient-to-r from-blue-500 via-violet-500 to-fuchsia-500 transition-[width] duration-200"></div></div></div>
  <div id="extra-error" data-extra-error hidden role="alert" tabindex="-1" class="mt-4 rounded-2xl border border-rose-200 bg-rose-50/80 p-4 text-sm font-bold text-rose-700 dark:border-rose-400/20 dark:bg-rose-500/10 dark:text-rose-300"></div>
