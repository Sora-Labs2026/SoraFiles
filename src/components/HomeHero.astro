---
import type { LocaleContent } from '../i18n/types';
import TrustIcon from './TrustIcon.astro';

interface Props {
  content: LocaleContent;
}

const { content } = Astro.props;
---

<section data-home-hero class="relative overflow-hidden border-b border-line bg-surface px-5 py-12 text-start sm:px-6 sm:py-16">
  <div class="grid-surface pointer-events-none absolute inset-0 z-0 opacity-70" aria-hidden="true"></div>
  <div class="relative z-[1] mx-auto max-w-6xl border-x border-line bg-surface">
    <div class="grid gap-8 border-b border-line px-5 py-8 sm:px-8 sm:py-10 lg:grid-cols-[1.25fr_0.75fr] lg:items-end">
      <div class="max-w-4xl">
        <h1 class="type-display text-ink">
          {content.home.h1}
        </h1>
        <p class="mt-5 max-w-2xl text-pretty text-base leading-7 text-muted sm:text-lg sm:leading-8">
          {content.home.intro}
        </p>
        <a href="#all-tools" class="mt-7 inline-flex min-h-12 items-center justify-center gap-2 rounded-control bg-action px-5 text-sm font-semibold text-action-contrast transition-colors duration-200 hover:bg-action-hover">
          {content.home.primaryAction}
          <svg aria-hidden="true" viewBox="0 0 16 16" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6">
            <path d="M8 3v10M4.5 9.5 8 13l3.5-3.5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>

      <div class="border border-line bg-canvas p-5 lg:justify-self-end">
        <p class="text-sm font-semibold text-ink">{content.home.proofTitle}</p>
        <p class="mt-2 text-sm leading-6 text-muted">{content.home.privacyProof.intro}</p>
      </div>
    </div>

    <ul class="grid grid-cols-2 lg:grid-cols-4">
      {content.home.privacyProof.items.map((item) => (
        <li data-home-trust-item class="-mb-px -me-px min-w-0 border-b border-e border-line bg-canvas p-4 text-start sm:p-5">
          <div class="flex items-center justify-between gap-3">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-control border border-line bg-surface text-ink">
              <TrustIcon icon={item.icon} />
            </span>
            <span data-home-trust-value class="font-mono text-xs font-semibold text-green">{item.value}</span>
          </div>
          <p data-home-trust-title class="mt-4 text-sm font-semibold text-ink">{item.title}</p>
          <p data-home-trust-description class="mt-2 text-xs leading-5 text-muted">{item.description}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
